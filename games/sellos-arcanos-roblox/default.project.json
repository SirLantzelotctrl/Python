{
  "name": "SellosArcanos",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "ServerStorage": {
      "CreatureModels": { "$className": "Folder" }
    },
    "StarterPlayer": {
      "$properties": { "CameraMaxZoomDistance": 120, "CameraMinZoomDistance": 8 },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 96,
        "StreamingTargetRadius": 640,
        "FallenPartsDestroyHeight": -500
      }
    }
  }
}
