				<Item class="ModuleScript" referent="RBX6566B50E0E2142839AFCF72652E14057">
					<Properties>
						<string name="Name">Menus</string>
						<ProtectedString name="Source"><![CDATA[-- Ventanas: elección de inicial, Ciudadela (rango, diaria, contratos),
-- Bestiario y ficha, Tienda (Robux y cristales), Pase Arcano y Ajustes.
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameData = require(Shared.GameData)
local Formulas = require(Shared.Formulas)
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local Fx = require(script.Parent.Fx)
local Hud = require(script.Parent.Hud)

local Menus = {}
local C = UI.C
local player = Players.LocalPlayer
Menus.current = nil

-- Precio real de cada producto: Roblox puede cambiarlo (precios regionales u
-- optimización de precios), así que se consulta y se guarda. Mientras llega se
-- muestra «R$ …» y, si la consulta falla, el precio de Config.
local prices = {}
local function priceText(id, infoType, fallback)
	local key = infoType.Name .. ":" .. tostring(id)
	local v = prices[key]
	if v == nil then
		prices[key] = false
		task.spawn(function()
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfoAsync(id, infoType)
			end)
			prices[key] = (ok and info and info.PriceInRobux) or fallback
			if Menus.current == "shop" and Menus.shop then
				Menus.shop(Menus.shopTab)
			end
		end)
		v = false
	end
	return "R$ " .. (v and tostring(v) or "…")
end

local function action(name, a, b, c)
	local ok, res, err = pcall(function()
		return Net.get("Action"):InvokeServer(name, a, b, c)
	end)
	if ok and not res and err then
		UI.toast(UI.t(err), "bad")
	end
	return ok and res
end

local function rewardText(g)
	local parts = {}
	if g.essence then
		table.insert(parts, UI.fmt(g.essence) .. " " .. UI.t("essence"))
	end
	if g.ink then
		table.insert(parts, g.ink .. " " .. UI.t("ink"))
	end
	if g.crystals then
		table.insert(parts, g.crystals .. " " .. UI.t("crystals"))
	end
	if g.fragments then
		table.insert(parts, g.fragments .. " Frag.")
	end
	if g.tint then
		table.insert(parts, UI.L(GameData.TintById[g.tint].name))
	end
	if g.seal then
		table.insert(parts, UI.L(GameData.SealById[g.seal].name))
	end
	if g.effect then
		table.insert(parts, UI.L(GameData.EffectById[g.effect].name))
	end
	return table.concat(parts, " · ")
end

local function colorOf(id)
	return Color3.fromHex(GameData.CreatureById[id].color)
end

local function creatureTile(parent, id, size, known)
	local f = UI.panel(parent, { Size = UDim2.fromOffset(size, size), BackgroundColor3 = C.night })
	local st = f:FindFirstChildOfClass("UIStroke")
	if known then
		st.Color = colorOf(id)
		st.Thickness = 2
	end
	-- sello estilizado con la inicial
	local ring = UI.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.78, 0.78), BackgroundTransparency = 1 }, f)
	UI.corner(ring, size)
	UI.stroke(ring, known and colorOf(id) or C.line2, 2, known and 0.2 or 0.5)
	UI.label(f, known and string.sub(Hud.shortName(id), 1, 1) or "?", math.floor(size * 0.42), UI.F.title, known and colorOf(id) or C.dim, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	return f
end

-- --- primera criatura ---------------------------------------------------------------------
function Menus.starter()
	local body = UI.window(UI.t("chooseTitle"), 1000, 520)
	UI.label(body, UI.t("chooseHelp"), 16, UI.F.medium, C.ink, { Size = UDim2.new(1, 0, 0, 44), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
	local row = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 1, -60) }, body)
	UI.list(row, Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center)
	for i, id in ipairs(GameData.Starters) do
		local c = GameData.CreatureById[id]
		local card = UI.panel(row, { Size = UDim2.new(1 / 3, -10, 1, 0), LayoutOrder = i, StrokeColor = colorOf(id) })
		UI.pad(card, 14)
		UI.list(card, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center)
		creatureTile(card, id, 96, true)
		local el = GameData.Elements[c.el]
		UI.label(card, string.upper(UI.L(el) .. " · " .. UI.L(GameData.Domains[el.domain]) .. " · " .. UI.L(GameData.Roles[c.role])), 12, UI.F.bold, colorOf(id), { TextXAlignment = Enum.TextXAlignment.Center })
		UI.label(card, UI.L(c.name), 24, UI.F.title, C.bright, { TextXAlignment = Enum.TextXAlignment.Center })
		UI.label(card, UI.L(c.lore), 15, UI.F.lore, C.ink, { Size = UDim2.new(1, 0, 0, 76), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top })
		UI.button(card, UI.t("choose"), { Primary = true, Size = UDim2.new(1, 0, 0, 44) }, function()
			Net.get("ChooseStarter"):FireServer(id)
			UI.closeWindow()
			task.delay(1.5, function()
				UI.toast(UI.t("tutorial1"))
				task.wait(5)
				UI.toast(UI.t("tutorial2"))
				task.wait(5)
				UI.toast(UI.t("tutorial3"))
			end)
		end)
	end
	Menus.current = "starter"
end

-- --- Ciudadela: rango, recompensa diaria y contratos ---------------------------------------
function Menus.citadel()
	local p = State.profile
	if not p then
		return
	end
	local body = UI.window(UI.t("citadel"), 820, 560)
	local r = Formulas.rankInfo(p.rankXp)
	local title = Formulas.rankTitle(r.rank)
	UI.label(body, UI.t("rank", { n = r.rank }) .. " · " .. string.upper(UI.L(title)), 18, UI.F.bold, Color3.fromHex("#cbb8ff"))
	local _, fill = UI.bar(body, Color3.fromHex("#cbb8ff"), 6, { Position = UDim2.fromOffset(0, 28) })
	UI.setBar(fill, r.xp / r.need)
	UI.label(body, UI.fmt(r.xp) .. " / " .. UI.fmt(r.need) .. " XP · " .. UI.t("formsSealed", { n = Formulas.formsSealed(p) }), 13, UI.F.medium, C.muted, { Position = UDim2.fromOffset(0, 38) })

	local daily = UI.panel(body, { Position = UDim2.fromOffset(0, 70), Size = UDim2.new(1, 0, 0, 74), StrokeColor = C.gold })
	UI.pad(daily, 14, 10)
	local day = (p.daily.day % 7) + 1
	UI.label(daily, UI.t("daily"), 18, UI.F.bold, C.bright, { Size = UDim2.new(1, -170, 0, 22) })
	UI.label(daily, UI.t("dayOf", { n = day }) .. " · " .. rewardText(GameData.Daily[day]), 14, UI.F.medium, C.muted, { Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, -170, 0, 20) })
	local can = p.daily.last ~= State.today()
	UI.button(daily, can and UI.t("claim") or UI.t("claimed"), { Primary = can, Position = UDim2.new(1, -150, 0.5, -20), Size = UDim2.fromOffset(150, 40), BackgroundColor3 = can and C.gold or C.panel2, TextColor3 = can and Color3.fromRGB(29, 22, 8) or C.dim, StrokeColor = C.gold }, function()
		if can and action("claimDaily") then
			Fx.sound("ping", 1.2, 0.5)
			Menus.citadel()
		end
	end)

	UI.label(body, string.upper(UI.t("dailyContracts")), 13, UI.F.bold, C.muted, { Position = UDim2.fromOffset(0, 158) })
	local list = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 182), Size = UDim2.new(1, 0, 1, -182) }, body)
	UI.list(list, Enum.FillDirection.Vertical, 8)
	for i, c in ipairs(p.contracts.list or {}) do
		local row = UI.panel(list, { Size = UDim2.new(1, 0, 0, 62), LayoutOrder = i, StrokeColor = (c.progress >= c.goal) and C.ok or C.line })
		UI.pad(row, 14, 8)
		UI.label(row, Hud.contractText(c), 16, UI.F.bold, C.bright, { Size = UDim2.new(1, -170, 0, 22) })
		local _, f = UI.bar(row, C.ok, 4, { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, -170, 0, 4) })
		UI.setBar(f, c.progress / c.goal)
		UI.label(row, c.progress .. " / " .. c.goal .. " · +" .. UI.fmt(c.essence) .. " " .. UI.t("essence"), 12, UI.F.medium, C.muted, { Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, -170, 0, 14) })
		if c.claimed then
			UI.label(row, UI.t("claimed"), 14, UI.F.bold, C.dim, { Position = UDim2.new(1, -150, 0, 10), Size = UDim2.fromOffset(150, 24), TextXAlignment = Enum.TextXAlignment.Right })
		elseif c.progress >= c.goal then
			UI.button(row, UI.t("claim"), { Position = UDim2.new(1, -150, 0.5, -20), Size = UDim2.fromOffset(150, 40), BackgroundColor3 = C.gold, TextColor3 = Color3.fromRGB(29, 22, 8), StrokeColor = C.gold }, function()
				if action("claimContract", i) then
					Fx.sound("ping", 1.2, 0.5)
					Menus.citadel()
				end
			end)
		end
	end
	Menus.current = "citadel"
end

-- --- Bestiario ------------------------------------------------------------------------------
function Menus.bestiary()
	local p = State.profile
	if not p then
		return
	end
	local body = UI.window(UI.t("bestiary") .. " · " .. UI.t("formsSealed", { n = Formulas.formsSealed(p) }), 1100, 640)
	local scroll = UI.scroll(body)
	local grid = UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(160, 210), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	local _ = grid
	for i, c in ipairs(GameData.Creatures) do
		local b = p.bestiary[c.id]
		local own = p.creatures[c.id]
		local card = UI.button(scroll, "", { LayoutOrder = i, BackgroundColor3 = C.panel, StrokeColor = own and colorOf(c.id) or C.line }, function()
			if b.seen then
				Menus.ficha(c.id)
			else
				UI.toast(UI.t("livesIn", { n = c.island, isle = UI.L(GameData.Islands[c.island].name) }))
			end
		end)
		UI.pad(card, 10)
		UI.list(card, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center)
		creatureTile(card, c.id, 96, b.seen)
		UI.label(card, "Nº " .. c.num, 12, UI.F.title, C.muted, { TextXAlignment = Enum.TextXAlignment.Center })
		UI.label(card, b.seen and UI.L(c.name) or "???", 14, UI.F.bold, C.bright, { TextXAlignment = Enum.TextXAlignment.Center, TextScaled = false })
		local sub = own and (UI.t("lvl") .. " " .. own.level .. " · " .. UI.t("form" .. own.form)) or (b.seen and UI.t("seenNot") or UI.t("unknown"))
		UI.label(card, sub, 12, UI.F.medium, C.muted, { TextXAlignment = Enum.TextXAlignment.Center })
		local forms = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14) }, card)
		UI.list(forms, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center)
		for k = 1, 3 do
			local d = UI.new("Frame", { Size = UDim2.fromOffset(10, 10), Rotation = 45, BackgroundColor3 = b.forms[k] and colorOf(c.id) or C.night, BorderSizePixel = 0 }, forms)
			UI.stroke(d, b.forms[k] and colorOf(c.id) or C.line2, 1.5)
		end
		if table.find(p.team, c.id) then
			UI.label(card, UI.t("inTeam"), 11, UI.F.bold, colorOf(c.id), { TextXAlignment = Enum.TextXAlignment.Center })
		end
	end
	Menus.current = "bestiary"
end

function Menus.ficha(id)
	local p = State.profile
	local c = GameData.CreatureById[id]
	local own = p.creatures[id]
	local body = UI.window(UI.L(c.name), 1100, 640)
	local col = colorOf(id)
	local left = UI.scroll(body, { Size = UDim2.new(0.56, 0, 1, 0) })
	UI.list(left, Enum.FillDirection.Vertical, 8)
	local el = GameData.Elements[c.el]
	UI.label(left, string.upper("Nº " .. c.num .. " · " .. UI.L(el) .. " · " .. UI.L(GameData.Domains[el.domain]) .. " · " .. UI.L(GameData.Roles[c.role])), 13, UI.F.bold, col, { LayoutOrder = 1 })
	UI.label(left, UI.L(c.sub), 14, UI.F.bold, C.muted, { LayoutOrder = 2 })
	UI.label(left, UI.L(c.lore), 17, UI.F.lore, C.ink, { LayoutOrder = 3, Size = UDim2.new(1, -10, 0, 48), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
	if own then
		local need = Formulas.xpToNext(own.level)
		UI.label(left, UI.t("level") .. " " .. own.level .. " · " .. UI.t("form" .. own.form) .. " · " .. UI.t("bond") .. " " .. own.bond .. "/5", 16, UI.F.bold, C.bright, { LayoutOrder = 4 })
		local _, xf = UI.bar(left, col, 6, { LayoutOrder = 5, Size = UDim2.new(1, -10, 0, 6) })
		UI.setBar(xf, own.level >= Formulas.MaxLevel and 1 or own.xp / need)
		local row = UI.new("Frame", { BackgroundTransparency = 1, LayoutOrder = 6, Size = UDim2.new(1, -10, 0, 44) }, left)
		UI.list(row, Enum.FillDirection.Horizontal, 8)
		local inTeam = table.find(p.team, id) ~= nil
		UI.button(row, inTeam and UI.t("removeTeam") or UI.t("addTeam"), { Size = UDim2.fromOffset(180, 42), StrokeColor = col }, function()
			if action("team", id) then
				Menus.ficha(id)
			end
		end)
		if inTeam and p.team[1] ~= id then
			UI.button(row, UI.t("makeLeader"), { Size = UDim2.fromOffset(140, 42) }, function()
				if action("leader", id) then
					Menus.ficha(id)
				end
			end)
		end
		if own.level < Formulas.MaxLevel then
			UI.button(row, UI.t("train", { c = UI.fmt(Formulas.trainCost(own.level)) }), { Size = UDim2.fromOffset(220, 42) }, function()
				if action("train", id) then
					Fx.sound("ping", 1.4, 0.4)
					Menus.ficha(id)
				end
			end)
		end
		local evo = Formulas.evolveInfo(p, id)
		if evo then
			local erow = UI.new("Frame", { BackgroundTransparency = 1, LayoutOrder = 7, Size = UDim2.new(1, -10, 0, 44) }, left)
			UI.button(erow, UI.t("evolve", { f = UI.t("form" .. evo.to) }), { Size = UDim2.fromOffset(240, 42), BackgroundColor3 = evo.ok and C.gold or C.panel2, TextColor3 = evo.ok and Color3.fromRGB(29, 22, 8) or C.dim, StrokeColor = C.gold }, function()
				if evo.ok and action("evolve", id) then
					Fx.sound("glass", 1, 0.5)
					Menus.ficha(id)
				end
			end)
			if not evo.ok then
				UI.label(erow, evo.to == 2 and UI.t("evoReq1", { h = evo.have }) or UI.t("evoReq2"), 13, UI.F.medium, C.muted, { Position = UDim2.fromOffset(252, 0), Size = UDim2.new(1, -252, 1, 0), TextWrapped = true })
			end
		end
	else
		UI.label(left, UI.t("livesIn", { n = c.island, isle = UI.L(GameData.Islands[c.island].name) }), 15, UI.F.bold, C.bright, { LayoutOrder = 4 })
	end
	UI.label(left, string.upper(UI.t("stats")), 12, UI.F.bold, C.muted, { LayoutOrder = 10 })
	local names = { { "power", c.stats.pow }, { "defense", c.stats.def }, { "agility", c.stats.agi }, { "magic", c.stats.mag } }
	for i, s in ipairs(names) do
		local row = UI.new("Frame", { BackgroundTransparency = 1, LayoutOrder = 10 + i, Size = UDim2.new(1, -10, 0, 18) }, left)
		UI.label(row, UI.t(s[1]), 13, UI.F.medium, C.ink, { Size = UDim2.fromOffset(90, 18) })
		local _, f = UI.bar(row, col, 6, { Position = UDim2.new(0, 96, 0.5, -3), Size = UDim2.new(1, -140, 0, 6) })
		UI.setBar(f, s[2] / 100)
		UI.label(row, tostring(s[2]), 13, UI.F.bold, C.bright, { Position = UDim2.new(1, -36, 0, 0), Size = UDim2.fromOffset(36, 18), TextXAlignment = Enum.TextXAlignment.Right })
	end
	UI.label(left, string.upper(UI.t("abilities")), 12, UI.F.bold, C.muted, { LayoutOrder = 20 })
	for i, a in ipairs(c.abilities) do
		local locked = a.key == "r" and (not own or own.form < 2)
		local txt = "<b>" .. string.upper(a.key) .. " · " .. UI.L(a.name) .. "</b>" .. (a.key == "f" and (" · " .. UI.t("ultimateTag")) or "") .. "\n" .. UI.L(a.desc) .. (locked and (" · " .. UI.t("unlocksAdult")) or "")
		UI.label(left, txt, 14, UI.F.medium, locked and C.dim or C.ink, { LayoutOrder = 20 + i, Size = UDim2.new(1, -10, 0, 40), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
	end
	-- derecha: formas y tintes
	local right = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0.6, 0, 0, 0), Size = UDim2.new(0.4, 0, 1, 0) }, body)
	UI.list(right, Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center)
	creatureTile(right, id, 150, true)
	local forms = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40) }, right)
	UI.list(forms, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	for k = 1, 3 do
		local has = p.bestiary[id].forms[k]
		local f = UI.panel(forms, { Size = UDim2.fromOffset(110, 36), StrokeColor = has and col or C.line })
		UI.label(f, UI.t("form" .. k), 13, UI.F.bold, has and C.bright or C.dim, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	end
	if own then
		UI.label(right, string.upper(UI.t("tints")), 12, UI.F.bold, C.muted, { TextXAlignment = Enum.TextXAlignment.Center })
		local tints = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 110) }, right)
		UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(110, 40), CellPadding = UDim2.fromOffset(8, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center }, tints)
		UI.button(tints, UI.t("original"), { StrokeColor = (own.tint == "" and C.bright) or col }, function()
			if action("untint", id) then
				Menus.ficha(id)
			end
		end)
		for _, t in ipairs(GameData.Tints) do
			if t.creature == id then
				local owned = table.find(p.cosmetics.tints, t.id) ~= nil
				local swatch = (t.color == "prisma" or t.color == "aurora") and C.bright or Color3.fromHex(t.color)
				local b = UI.button(tints, UI.L(t.name) .. (owned and "" or (" · " .. t.price)), { TextSize = 12, StrokeColor = (own.tint == t.id) and C.bright or swatch, TextColor3 = owned and swatch or C.muted }, function()
					if owned then
						if action("equip", "tint", t.id) then
							Menus.ficha(id)
						end
					else
						UI.confirm(UI.t("confirmBuy", { name = UI.L(t.name), p = t.price }), function()
							if action("buyCosmetic", "tint", t.id) then
								Fx.sound("glass", 1.3, 0.5)
								Menus.ficha(id)
							end
						end)
					end
				end)
				local _ = b
			end
		end
	end
	Menus.current = "ficha"
end

-- --- Tienda ---------------------------------------------------------------------------------
-- Pestaña «Códigos»: canjear un código y la recompensa por unirse al grupo
function Menus.codesTab(scroll, card)
	local p = State.profile
	local f = card(1, UI.t("codesTitle"), UI.t("codesHelp"), C.crystal, UI.t("redeem"), true, nil)
	local box = UI.new("TextBox", {
		Name = "CodeBox",
		PlaceholderText = UI.t("codePlaceholder"),
		Text = "",
		ClearTextOnFocus = false,
		TextSize = 16,
		Font = UI.F.bold,
		TextColor3 = C.bright,
		PlaceholderColor3 = C.muted,
		BackgroundColor3 = C.night,
		Position = UDim2.new(0, 0, 1, -86),
		Size = UDim2.new(1, 0, 0, 38),
	}, f)
	UI.corner(box, 6)
	UI.stroke(box, C.line2, 1)
	local btn = f:FindFirstChildOfClass("TextButton")
	local busy = false
	btn.Activated:Connect(function()
		local code = box.Text
		if busy or #code == 0 then
			return
		end
		busy = true
		local ok, res, info = pcall(function()
			return Net.get("Action"):InvokeServer("redeem", code)
		end)
		busy = false
		if ok and res then
			box.Text = ""
			Fx.sound("glass", 1.3, 0.5)
			UI.toast(UI.t("codeOk", { r = rewardText(info or {}) }), "gold")
		else
			UI.toast(UI.t((ok and info) or "codeInvalid"), "bad")
		end
	end)
	if Config.GroupId and Config.GroupId ~= 0 and p and not p.perks.group then
		card(2, UI.t("groupTitle"), UI.t("groupDesc", { r = rewardText(Config.GroupReward) }), C.gold, UI.t("groupClaim"), false, function()
			local ok, res, info = pcall(function()
				return Net.get("Action"):InvokeServer("groupReward")
			end)
			if ok and res then
				Fx.sound("glass", 1.3, 0.5)
				UI.toast(UI.t("groupDone") .. " · " .. rewardText(info or {}), "gold")
				Menus.shop("codes")
			else
				UI.toast(UI.t((ok and info) or "groupJoin"), "bad")
			end
		end)
	end
end

function Menus.shop(tab)
	local p = State.profile
	if not p then
		return
	end
	tab = tab or "crystals"
	local body = UI.window(UI.t("shop") .. " · " .. UI.fmt(p.crystals) .. " " .. UI.t("crystals"), 1100, 640)
	local tabs = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40) }, body)
	UI.list(tabs, Enum.FillDirection.Horizontal, 8)
	for i, k in ipairs({ "crystals", "passes", "tints", "seals", "effects", "codes" }) do
		local key = "tab" .. string.upper(string.sub(k, 1, 1)) .. string.sub(k, 2)
		UI.button(tabs, UI.t(key), { LayoutOrder = i, Size = UDim2.fromOffset(150, 38), Primary = (k == tab) }, function()
			Menus.shop(k)
		end)
	end
	UI.label(body, UI.t("rules"), 13, UI.F.medium, C.muted, { Position = UDim2.fromOffset(0, 46) })
	local scroll = UI.scroll(body, { Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 1, -74) })
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(240, 150), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	local function card(order, title, desc, color, buttonText, primary, onBuy)
		local f = UI.panel(scroll, { LayoutOrder = order, StrokeColor = color or C.line })
		UI.pad(f, 12)
		UI.label(f, title, 17, UI.F.bold, C.bright, { Size = UDim2.new(1, 0, 0, 22) })
		UI.label(f, desc or "", 13, UI.F.medium, C.muted, { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 52), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
		UI.button(f, buttonText, { Primary = primary, Position = UDim2.new(0, 0, 1, -40), Size = UDim2.new(1, 0, 0, 40) }, onBuy)
		return f
	end
	if tab == "crystals" then
		local any = false
		for i, prod in ipairs(Config.Products) do
			if prod.id ~= 0 and not (prod.founder and p.purchases.founder) then
				any = true
				local desc = prod.founder and UI.t("pack_fundador_desc") or (prod.tag and UI.t("tag_" .. prod.tag) or "")
				card(i, UI.t(prod.key), desc, prod.founder and C.gold or C.crystal, priceText(prod.id, Enum.InfoType.Product, prod.robux), true, function()
					MarketplaceService:PromptProductPurchase(player, prod.id)
				end)
			end
		end
		if not any then
			UI.label(scroll, UI.t("productsOff"), 15, UI.F.medium, C.muted)
		end
	elseif tab == "passes" then
		local order = 1
		for key, pass in pairs(Config.GamePasses) do
			if pass.id ~= 0 then
				card(order, UI.t(key), UI.t(key .. "_desc"), C.gold, priceText(pass.id, Enum.InfoType.GamePass, pass.robux), true, function()
					MarketplaceService:PromptGamePassPurchase(player, pass.id)
				end)
				order = order + 1
			end
		end
		if not p.pass.premium then
			card(order, UI.t("pase_premium"), UI.t("pase_premium_desc"), C.crystal, UI.t("unlockPremium", { c = Config.PassPremiumCrystals }), false, function()
				UI.confirm(UI.t("confirmBuy", { name = UI.t("pase_premium"), p = Config.PassPremiumCrystals }), function()
					if action("passPremiumCrystals") then
						Menus.shop("passes")
					end
				end)
			end)
		end
	elseif tab == "tints" then
		for i, t in ipairs(GameData.Tints) do
			local owned = table.find(p.cosmetics.tints, t.id) ~= nil
			local swatch = (t.color == "prisma" or t.color == "aurora") and C.bright or Color3.fromHex(t.color)
			local name = UI.L(t.name) .. (t.season and " ★" or "")
			card((t.season and 0 or 100) + i, name, UI.t("tintFor", { name = UI.L(GameData.CreatureById[t.creature].name) }), swatch, owned and UI.t("owned") or (tostring(t.price) .. " " .. UI.t("crystals")), not owned, function()
				if owned then
					return
				end
				UI.confirm(UI.t("confirmBuy", { name = UI.L(t.name), p = t.price }), function()
					if action("buyCosmetic", "tint", t.id) then
						Fx.sound("glass", 1.3, 0.5)
						Menus.shop("tints")
					end
				end)
			end)
		end
	elseif tab == "codes" then
		Menus.codesTab(scroll, card)
	else
		local list = (tab == "seals") and GameData.Seals or GameData.Effects
		local kind = (tab == "seals") and "seal" or "effect"
		local ownedList = (tab == "seals") and p.cosmetics.seals or p.cosmetics.effects
		local equipped = (tab == "seals") and p.cosmetics.seal or p.cosmetics.effect
		for i, s in ipairs(list) do
			local owned = table.find(ownedList, s.id) ~= nil
			local label = owned and ((equipped == s.id) and UI.t("equipped") or UI.t("equip")) or (tostring(s.price) .. " " .. UI.t("crystals"))
			card(i, UI.L(s.name), s.desc and UI.L(s.desc) or "", s.season and C.gold or C.line2, label, not owned, function()
				if owned then
					if equipped ~= s.id and action("equip", kind, s.id) then
						Menus.shop(tab)
					end
					return
				end
				UI.confirm(UI.t("confirmBuy", { name = UI.L(s.name), p = s.price }), function()
					if action("buyCosmetic", kind, s.id) then
						Fx.sound("glass", 1.3, 0.5)
						Menus.shop(tab)
					end
				end)
			end)
		end
	end
	Menus.current = "shop"
	Menus.shopTab = tab
end

-- --- Pase Arcano -----------------------------------------------------------------------------
function Menus.pass()
	local p = State.profile
	if not p then
		return
	end
	local tier = Formulas.passTier(p.pass.xp)
	local body = UI.window(UI.t("pass") .. " · " .. UI.t("passLevel", { n = tier }), 1100, 560)
	UI.label(body, UI.t("passHelp"), 14, UI.F.medium, C.muted, { Size = UDim2.new(1, -330, 0, 20) })
	local _, f = UI.bar(body, Color3.fromHex("#c9a0ff"), 6, { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, -330, 0, 6) })
	UI.setBar(f, (p.pass.xp % GameData.PassXpPerTier) / GameData.PassXpPerTier)
	if p.pass.premium then
		UI.label(body, UI.t("premiumActive"), 15, UI.F.bold, C.gold, { Position = UDim2.new(1, -310, 0, 0), Size = UDim2.fromOffset(310, 30), TextXAlignment = Enum.TextXAlignment.Right })
	else
		UI.button(body, UI.t("unlockPremium", { c = Config.PassPremiumCrystals }), { Position = UDim2.new(1, -310, 0, 0), Size = UDim2.fromOffset(310, 40), BackgroundColor3 = C.gold, TextColor3 = Color3.fromRGB(29, 22, 8), StrokeColor = C.gold }, function()
			Menus.shop("passes")
		end)
	end
	local scroll = UI.scroll(body, { Position = UDim2.fromOffset(0, 52), Size = UDim2.new(1, 0, 1, -52), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X })
	UI.list(scroll, Enum.FillDirection.Horizontal, 10)
	for _, tr in ipairs(GameData.PassTiers) do
		local col = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 130, 1, -12), LayoutOrder = tr.n }, scroll)
		UI.label(col, tostring(tr.n), 18, UI.F.title, tier >= tr.n and C.bright or C.dim, { TextXAlignment = Enum.TextXAlignment.Center })
		local function slot(y, reward, track, claimedList)
			local claimedIt = table.find(claimedList, tr.n) ~= nil
			local reachable = tier >= tr.n and (track == "free" or p.pass.premium)
			local s = UI.panel(col, { Position = UDim2.new(0, 0, 0, y), Size = UDim2.new(1, 0, 0.42, -16), StrokeColor = (reachable and not claimedIt) and C.ok or (track == "prem" and C.gold or C.line) })
			UI.label(s, rewardText(reward), 13, UI.F.bold, claimedIt and C.dim or C.bright, { Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 0.6, 0), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center })
			if reachable and not claimedIt then
				UI.button(s, UI.t("claim"), { Position = UDim2.new(0, 6, 1, -38), Size = UDim2.new(1, -12, 0, 32), TextSize = 13 }, function()
					if action("claimPass", tr.n, track) then
						Fx.sound("ping", 1.2, 0.5)
						Menus.pass()
					end
				end)
			elseif claimedIt then
				UI.label(s, UI.t("claimed"), 12, UI.F.bold, C.dim, { Position = UDim2.new(0, 0, 1, -24), TextXAlignment = Enum.TextXAlignment.Center })
			end
		end
		slot(28, tr.free, "free", p.pass.free)
		slot(28 + 210, tr.prem, "prem", p.pass.prem)
	end
	Menus.current = "pass"
end

-- --- Ajustes ---------------------------------------------------------------------------------
function Menus.settings()
	local p = State.profile
	local body = UI.window(UI.t("settings"), 760, 520)
	UI.list(body, Enum.FillDirection.Vertical, 12)
	local function volumeRow(order, key, value, setter)
		local row = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), LayoutOrder = order }, body)
		UI.label(row, UI.t(key), 16, UI.F.bold, C.bright, { Size = UDim2.fromOffset(200, 42) })
		local valL = UI.label(row, math.floor(value * 100) .. " %", 16, UI.F.bold, C.bright, { Position = UDim2.fromOffset(300, 0), Size = UDim2.fromOffset(80, 42), TextXAlignment = Enum.TextXAlignment.Center })
		local function change(d)
			value = math.clamp(value + d, 0, 1)
			valL.Text = math.floor(value * 100 + 0.5) .. " %"
			setter(value)
		end
		UI.button(row, "−", { Position = UDim2.fromOffset(240, 0), Size = UDim2.fromOffset(50, 42), TextSize = 22 }, function()
			change(-0.1)
		end)
		UI.button(row, "+", { Position = UDim2.fromOffset(390, 0), Size = UDim2.fromOffset(50, 42), TextSize = 22 }, function()
			change(0.1)
		end)
	end
	local music = p and p.settings.music or 0.5
	local sfx = p and p.settings.sfx or 0.8
	volumeRow(1, "music", music, function(v)
		music = v
		Fx.setMusic(v)
		action("settings", music, sfx)
	end)
	volumeRow(2, "sounds", sfx, function(v)
		sfx = v
		Fx.volume = v
		action("settings", music, sfx)
	end)
	local langRow = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), LayoutOrder = 3 }, body)
	UI.label(langRow, UI.t("language"), 16, UI.F.bold, C.bright, { Size = UDim2.fromOffset(200, 42) })
	UI.button(langRow, "Español", { Primary = UI.lang == "es", Position = UDim2.fromOffset(240, 0), Size = UDim2.fromOffset(130, 42) }, function()
		UI.lang = "es"
		Menus.settings()
	end)
	UI.button(langRow, "English", { Primary = UI.lang == "en", Position = UDim2.fromOffset(380, 0), Size = UDim2.fromOffset(130, 42) }, function()
		UI.lang = "en"
		Menus.settings()
	end)
	UI.label(body, string.upper(UI.t("controls")), 13, UI.F.bold, C.muted, { LayoutOrder = 4 })
	UI.label(body, UI.t("controlsText"), 14, UI.F.medium, C.ink, { LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 110), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
	UI.label(body, "Sellos Arcanos v" .. Config.Version, 12, UI.F.medium, C.dim, { LayoutOrder = 6 })
	Menus.current = "settings"
end

-- refresca la ventana abierta cuando cambia el perfil
function Menus.refresh()
	if Menus.current == "citadel" then
		Menus.citadel()
	elseif Menus.current == "shop" and Menus.shopTab ~= "codes" then
		-- (en «Códigos» no se redibuja para no borrar lo que se está escribiendo)
		Menus.shop(Menus.shopTab)
	end
end

function Menus.init()
	UI.onWindowClosed = function()
		Menus.current = nil
	end
	Hud.onMenu = function(name)
		if Menus.current == name then
			UI.closeWindow()
			return
		end
		if name == "citadel" then
			Menus.citadel()
		elseif name == "bestiary" then
			Menus.bestiary()
		elseif name == "shop" then
			Menus.shop()
		elseif name == "pass" then
			Menus.pass()
		elseif name == "settings" then
			Menus.settings()
		end
	end
end

return Menus
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXC0DF19F8DC2841D282E345031E3A9657">
					<Properties>
						<string name="Name">Sealing</string>
						<ProtectedString name="Source"><![CDATA[-- Minijuego de sellado: une los nodos de la runa en orden antes de que el
-- círculo se apague. Se traza con el dedo, el ratón o el stick del mando.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameData = require(Shared.GameData)
local Formulas = require(Shared.Formulas)
local Net = require(Shared.Net)

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local Fx = require(script.Parent.Fx)

local Sealing = {}
local player = Players.LocalPlayer
local C = UI.C

local function gcd(a, b)
	while b ~= 0 do
		a, b = b, a % b
	end
	return a
end

-- N nodos alrededor del círculo recorridos como un polígono estrellado
local function runePoints(n, seed)
	local rng = Random.new(seed)
	local k = math.max(1, math.floor(n / 2) - ((n % 2 == 0) and 1 or 0))
	while gcd(n, k) ~= 1 and k > 1 do
		k = k - 1
	end
	local rot = rng:NextNumber() * math.pi * 2
	local pts = {}
	for i = 0, n - 1 do
		local idx = (i * k) % n
		local a = rot + (idx / n) * math.pi * 2
		local r = 0.5 + rng:NextNumber() * 0.32
		table.insert(pts, { bx = math.cos(a) * r, by = math.sin(a) * r, ph = rng:NextNumber() * 10 })
	end
	return pts
end

local function ringFrame(parent, cx, cy, r, color, thick, transp)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromOffset(cx, cy)
	f.Size = UDim2.fromOffset(r * 2, r * 2)
	f.BackgroundTransparency = 1
	f.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = f
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thick
	s.Transparency = transp or 0
	s.Parent = f
	return f, s
end

local function segment(parent, color, thick)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.Size = UDim2.fromOffset(0, thick)
	f.Parent = parent
	return f
end

local function placeSegment(f, a, b)
	local d = b - a
	f.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
	f.Size = UDim2.fromOffset(d.Magnitude, f.Size.Y.Offset)
	f.Rotation = math.deg(math.atan2(d.Y, d.X))
end

function Sealing.start(model)
	if State.sealing then
		return
	end
	State.sealing = true
	local entId = model:GetAttribute("EntityId")
	local ok, params = pcall(function()
		return Net.get("SealRequest"):InvokeServer(entId)
	end)
	if not ok or not params or params.error then
		State.sealing = false
		UI.toast(UI.t((params and params.error) or "resist"), "bad")
		return
	end
	local def = GameData.CreatureById[params.id]
	local color = Formulas.resolveColor(params.color or def.color, os.clock())
	local cam = Workspace.CurrentCamera
	local vs = cam.ViewportSize
	local k = math.clamp(math.min(vs.X / 1280, vs.Y / 720), 0.55, 1.6)

	local gui = Instance.new("ScreenGui")
	gui.Name = "SA_Sealing"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 20
	gui.ResetOnSpawn = false
	gui.Parent = player:WaitForChild("PlayerGui")
	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = C.night
	back.BackgroundTransparency = 0.25
	back.Active = true
	back.Parent = gui

	local function text(t, size, font, col, y)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.AnchorPoint = Vector2.new(0.5, 0)
		l.Position = UDim2.new(0.5, 0, 0, y)
		l.Size = UDim2.new(1, 0, 0, size + 8)
		l.Text = t
		l.TextSize = size
		l.Font = font
		l.TextColor3 = col
		l.TextStrokeTransparency = 0.5
		l.Parent = back
		return l
	end
	text(UI.t("sealing"), math.floor(15 * k), UI.F.bold, color, math.floor(18 * k))
	text(UI.t("traceTitle", { name = UI.L(def.name) }), math.floor(34 * k), UI.F.title, C.bright, math.floor(40 * k))
	local help = text(UI.t("traceHelp") .. "  " .. UI.t("struggle"), math.floor(16 * k), UI.F.medium, C.ink, math.floor(84 * k))
	local timerL = text("", math.floor(30 * k), UI.F.title, C.bright, vs.Y - math.floor(70 * k))
	local resultL = text("", math.floor(56 * k), UI.F.title, C.gold, vs.Y / 2 - math.floor(40 * k))
	resultL.ZIndex = 5

	local R = math.min(vs.X, vs.Y) * 0.33
	local cx, cy = vs.X / 2, vs.Y / 2 + math.floor(30 * k)
	local _, timerStroke = ringFrame(back, cx, cy, R * 1.05, color, 5, 0)
	ringFrame(back, cx, cy, R * 0.99, color, 1.5, 0.5)
	ringFrame(back, cx, cy, R * 0.9, color, 1, 0.75)
	ringFrame(back, cx, cy, R * 0.4, color, 1, 0.8)

	local pts = runePoints(params.nodes, params.seed or 1)
	local hitR = math.max(26, R * 0.1)
	local nodes, guides, done = {}, {}, {}
	for i = 1, #pts - 1 do
		local g = segment(back, color, 2)
		g.BackgroundTransparency = 0.6
		guides[i] = g
	end
	for i = 1, #pts do
		local n, st = ringFrame(back, 0, 0, hitR * 0.55, color, 3, 0)
		n.BackgroundTransparency = 0
		n.BackgroundColor3 = Color3.fromRGB(6, 16, 12)
		local num = Instance.new("TextLabel")
		num.BackgroundTransparency = 1
		num.Size = UDim2.fromScale(1, 1)
		num.Text = tostring(i)
		num.TextColor3 = C.bright
		num.Font = UI.F.bold
		num.TextSize = math.floor(14 * k)
		num.Parent = n
		nodes[i] = { frame = n, stroke = st }
	end
	local cursor = ringFrame(back, cx, cy, 14, C.bright, 2, 0)
	cursor.Visible = false
	local trailSeg = segment(back, Color3.new(1, 1, 1), 4)
	trailSeg.Visible = false

	local state = { idx = 0, errors = 0, left = params.time, intro = 0.45, done = false, down = false, pointer = Vector2.new(cx, cy), lastWrong = nil, tt = 0 }

	local function nodePos(i)
		local p = pts[i]
		local x = cx + p.bx * R + math.sin(state.tt * 37 + p.ph) * (params.boss and 3.5 or 2.5)
		local y = cy + p.by * R + math.cos(state.tt * 41 + p.ph) * (params.boss and 3.5 or 2.5)
		if params.moving then
			x = x + math.sin(state.tt * 0.9 + p.ph) * R * 0.08
			y = y + math.cos(state.tt * 0.7 + p.ph * 2) * R * 0.08
		end
		return Vector2.new(x, y)
	end

	local conns = {}
	local function finish(result)
		if state.done then
			return
		end
		state.done = true
		if result == "fail" then
			resultL.Text = UI.t("failed")
			resultL.TextColor3 = C.danger
			Fx.sound("boom", 0.5, 0.4)
		else
			resultL.Text = (result == "perfect") and UI.t("perfect") or UI.t("sealed")
			resultL.TextColor3 = (result == "perfect") and C.gold or C.bright
			if result == "perfect" then
				help.Text = UI.t("perfectBonus")
			end
			Fx.sound("glass", 1.2, 0.5)
		end
		Net.get("SealResult"):FireServer(entId, { done = result ~= "fail", errors = state.errors })
		task.delay(1.2, function()
			for _, c in ipairs(conns) do
				c:Disconnect()
			end
			ContextActionService:UnbindAction("SA_SealCursor")
			gui:Destroy()
			State.sealing = false
		end)
	end

	local function tryNode(pos)
		for i = state.idx + 1, #pts do
			if (nodePos(i) - pos).Magnitude < hitR then
				if i == state.idx + 1 then
					state.idx = i
					done[i] = true
					Fx.sound("ping", 0.8 + i * 0.12, 0.45)
					if state.idx >= #pts then
						local perfect = state.errors == 0 and state.left / params.time >= (params.boss and 0.3 or 0.4)
						finish(perfect and "perfect" or "ok")
					end
				elseif state.lastWrong ~= i then
					state.errors = state.errors + 1
					state.lastWrong = i
					Fx.sound("boom", 1.8, 0.25)
					back.BackgroundColor3 = Color3.fromRGB(60, 10, 20)
					task.delay(0.12, function()
						back.BackgroundColor3 = C.night
					end)
					if state.errors >= 3 then
						finish("fail")
					end
				end
				return
			end
		end
		state.lastWrong = nil
	end

	local function screenPos(input)
		local inset = GuiService:GetGuiInset()
		return Vector2.new(input.Position.X + inset.X, input.Position.Y + inset.Y)
	end

	table.insert(conns, UserInputService.InputBegan:Connect(function(input)
		if state.done then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			state.down = true
			state.pointer = screenPos(input)
			tryNode(state.pointer)
		end
	end))
	table.insert(conns, UserInputService.InputChanged:Connect(function(input)
		if state.done then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			state.pointer = screenPos(input)
			if state.down then
				tryNode(state.pointer)
			end
		end
	end))
	table.insert(conns, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			state.down = false
		end
	end))
	-- stick o WASD mueven un cursor (y no al personaje mientras sellas)
	local stick = Vector2.zero
	local keys = {}
	ContextActionService:BindActionAtPriority("SA_SealCursor", function(_, inputState, input)
		if input.KeyCode == Enum.KeyCode.Thumbstick1 then
			stick = Vector2.new(input.Position.X, -input.Position.Y)
			if stick.Magnitude < 0.2 then
				stick = Vector2.zero
			end
		else
			keys[input.KeyCode] = inputState == Enum.UserInputState.Begin or inputState == Enum.UserInputState.Change
		end
		return Enum.ContextActionResult.Sink
	end, false, 3000, Enum.KeyCode.Thumbstick1, Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left, Enum.KeyCode.Right)

	local useCursor = false
	table.insert(conns, RunService.RenderStepped:Connect(function(dt)
		state.tt = state.tt + dt
		if state.intro > 0 then
			state.intro = state.intro - dt
		elseif not state.done then
			state.left = state.left - dt
			if state.left <= 0 then
				state.left = 0
				finish("fail")
			end
		end
		local mv = stick
		local kx = ((keys[Enum.KeyCode.D] or keys[Enum.KeyCode.Right]) and 1 or 0) - ((keys[Enum.KeyCode.A] or keys[Enum.KeyCode.Left]) and 1 or 0)
		local ky = ((keys[Enum.KeyCode.S] or keys[Enum.KeyCode.Down]) and 1 or 0) - ((keys[Enum.KeyCode.W] or keys[Enum.KeyCode.Up]) and 1 or 0)
		if kx ~= 0 or ky ~= 0 then
			mv = Vector2.new(kx, ky)
		end
		if mv.Magnitude > 0.1 and not state.done then
			if not useCursor then
				useCursor = true
				state.pointer = (state.idx > 0) and nodePos(state.idx) or nodePos(1) + Vector2.new(-40, -40)
			end
			state.pointer = state.pointer + mv.Unit * math.max(520, R * 2.4) * dt * math.min(1, mv.Magnitude)
			tryNode(state.pointer)
		end
		-- dibujo
		timerStroke.Transparency = 1 - math.clamp(state.left / params.time, 0, 1)
		timerL.Text = string.format("%.1f s", state.left)
		for i = 1, #pts do
			local p = nodePos(i)
			local n = nodes[i]
			n.frame.Position = UDim2.fromOffset(p.X, p.Y)
			if done[i] then
				n.frame.BackgroundColor3 = Color3.new(1, 1, 1)
				n.stroke.Color = color
			elseif i == state.idx + 1 then
				n.stroke.Thickness = 3 + math.abs(math.sin(state.tt * 8)) * 3
				n.frame.BackgroundColor3 = Color3.fromRGB(6, 16, 12)
			else
				n.stroke.Thickness = 2
				n.stroke.Transparency = 0.3
			end
		end
		for i = 1, #pts - 1 do
			placeSegment(guides[i], nodePos(i), nodePos(i + 1))
			guides[i].BackgroundColor3 = (i < state.idx) and Color3.new(1, 1, 1) or color
			guides[i].BackgroundTransparency = (i < state.idx) and 0 or 0.65
			guides[i].Size = UDim2.fromOffset(guides[i].Size.X.Offset, (i < state.idx) and 5 or 2)
		end
		local showTrail = state.idx > 0 and (state.down or useCursor) and not state.done
		trailSeg.Visible = showTrail
		if showTrail then
			placeSegment(trailSeg, nodePos(state.idx), state.pointer)
		end
		cursor.Visible = useCursor and not state.done
		cursor.Position = UDim2.fromOffset(state.pointer.X, state.pointer.Y)
	end))
end

function Sealing.init()
	State.onSeal = Sealing.start
end

return Sealing
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX246AD09D523A4D07BDD4CE2A4B4A635D">
					<Properties>
						<string name="Name">State</string>
						<ProtectedString name="Source"><![CDATA[-- Estado del cliente y controles: perfil, equipo, objetivo y teclas/botones.
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local State = {}
local player = Players.LocalPlayer

State.profile = nil
State.team = nil
State.sealing = false
State.lockedTarget = nil
State.onSeal = nil

function State.today()
	return os.date("!%Y-%m-%d")
end

local function creaturesFolder()
	return Workspace:FindFirstChild("Criaturas")
end

local function myRoot()
	local ch = player.Character
	return ch and ch:FindFirstChild("HumanoidRootPart")
end

local function modelPos(m)
	local ok, cf = pcall(function()
		return m:GetPivot()
	end)
	return ok and cf.Position or nil
end
State.modelPos = modelPos

local function isFoe(m)
	local kind = m:GetAttribute("Kind")
	return (kind == "wild" or kind == "boss" or kind == "anchor") and m:GetAttribute("Island") == player:GetAttribute("Island")
end

local function foes()
	local list = {}
	local f = creaturesFolder()
	if not f then
		return list
	end
	for _, m in ipairs(f:GetChildren()) do
		if isFoe(m) then
			table.insert(list, m)
		end
	end
	return list
end
State.foes = foes

function State.targetModel()
	local root = myRoot()
	if not root then
		return nil
	end
	local t = State.lockedTarget
	if t and t.Parent and isFoe(t) then
		local p = modelPos(t)
		if p and (p - root.Position).Magnitude < 110 then
			return t
		end
	end
	State.lockedTarget = nil
	local best, bd = nil, 70
	for _, m in ipairs(foes()) do
		local p = modelPos(m)
		if p then
			local d = (p - root.Position).Magnitude
			if d < bd then
				best, bd = m, d
			end
		end
	end
	return best
end

function State.sealableModel()
	local root = myRoot()
	if not root then
		return nil
	end
	local best, bd = nil, 90
	for _, m in ipairs(foes()) do
		if m:GetAttribute("Sealable") and not m:GetAttribute("Invuln") then
			local p = modelPos(m)
			if p then
				local d = (p - root.Position).Magnitude
				if d < bd then
					best, bd = m, d
				end
			end
		end
	end
	return best
end

function State.cycleTarget()
	local list = foes()
	if #list == 0 then
		return
	end
	local idx = table.find(list, State.lockedTarget) or 0
	State.lockedTarget = list[(idx % #list) + 1]
end

function State.switch(i)
	Net.get("Switch"):FireServer(i)
end

function State.press(key)
	if State.sealing then
		return
	end
	if key == "seal" then
		local m = State.sealableModel()
		if m and State.onSeal then
			State.onSeal(m)
		end
		return
	end
	if key == "target" then
		State.cycleTarget()
		return
	end
	if key == "dodge" then
		local ch = player.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		local dir = hum and hum.MoveDirection or Vector3.zero
		if dir.Magnitude < 0.1 then
			local cam = Workspace.CurrentCamera
			dir = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
		end
		Net.get("Dodge"):FireServer(Vector3.new(dir.X, 0, dir.Z))
		return
	end
	local m = State.targetModel()
	Net.get("Cast"):FireServer(key, m and m:GetAttribute("EntityId") or "")
	if m and not State.lockedTarget then
		State.lockedTarget = m
	end
end

-- --- controles ---------------------------------------------------------------------
local BINDS = {
	{ "SA_Q", "q", { Enum.KeyCode.Q, Enum.KeyCode.ButtonX } },
	{ "SA_E", "e", { Enum.KeyCode.E, Enum.KeyCode.ButtonY } },
	{ "SA_R", "r", { Enum.KeyCode.R, Enum.KeyCode.ButtonB } },
	{ "SA_F", "f", { Enum.KeyCode.F, Enum.KeyCode.ButtonR1 } },
	{ "SA_Dodge", "dodge", { Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL1 } },
	{ "SA_Seal", "seal", { Enum.KeyCode.G, Enum.KeyCode.ButtonR2 } },
	{ "SA_Target", "target", { Enum.KeyCode.Tab, Enum.KeyCode.ButtonL2 } },
	{ "SA_Sw1", "sw1", { Enum.KeyCode.One, Enum.KeyCode.DPadLeft } },
	{ "SA_Sw2", "sw2", { Enum.KeyCode.Two, Enum.KeyCode.DPadUp } },
	{ "SA_Sw3", "sw3", { Enum.KeyCode.Three, Enum.KeyCode.DPadRight } },
}

function State.bindControls()
	for _, b in ipairs(BINDS) do
		local action = b[2]
		ContextActionService:BindAction(b[1], function(_, inputState)
			if inputState ~= Enum.UserInputState.Begin then
				return Enum.ContextActionResult.Pass
			end
			if UserInputService:GetFocusedTextBox() then
				return Enum.ContextActionResult.Pass
			end
			if string.sub(action, 1, 2) == "sw" then
				State.switch(tonumber(string.sub(action, 3)))
			else
				State.press(action)
			end
			-- dejamos pasar la tecla para no bloquear los avisos de interacción (E)
			return Enum.ContextActionResult.Pass
		end, false, table.unpack(b[3]))
	end
	-- clic en un enemigo para fijarlo
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local cam = Workspace.CurrentCamera
			local ray = cam:ScreenPointToRay(input.Position.X, input.Position.Y)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			local f = creaturesFolder()
			if not f then
				return
			end
			params.FilterDescendantsInstances = { f }
			local hit = Workspace:Raycast(ray.Origin, ray.Direction * 400, params)
			if hit and hit.Instance then
				local m = hit.Instance:FindFirstAncestorOfClass("Model")
				while m and m.Parent ~= f do
					m = m:FindFirstAncestorOfClass("Model")
				end
				if m and isFoe(m) then
					State.lockedTarget = m
				end
			end
		end
	end)
end

function State.init()
	Net.get("ProfileSync").OnClientEvent:Connect(function(p)
		State.profile = p
		if State.onProfile then
			State.onProfile(p)
		end
	end)
	local function readTeam()
		local json = player:GetAttribute("TeamState")
		if json then
			local ok, data = pcall(function()
				return HttpService:JSONDecode(json)
			end)
			if ok then
				State.team = data
			end
		end
	end
	player:GetAttributeChangedSignal("TeamState"):Connect(readTeam)
	readTeam()
end

return State
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXCA757C22776F414389DD0C2F83B601F5">
					<Properties>
						<string name="Name">UI</string>
						<ProtectedString name="Source"><![CDATA[-- Utilidades de interfaz: paleta del diseño, marcos, textos, botones, barras,
-- avisos, carteles y ventanas. Todo se dibuja en una resolución de diseño de
-- 1280×720 y un UIScale lo adapta a móvil, tableta, PC y consola.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared.Strings)

local UI = {}
local player = Players.LocalPlayer

UI.C = {
	night = Color3.fromHex("#090817"),
	panel = Color3.fromRGB(15, 12, 32),
	panel2 = Color3.fromRGB(30, 25, 58),
	line = Color3.fromHex("#3b3658"),
	line2 = Color3.fromHex("#57517a"),
	ink = Color3.fromHex("#c4bfdc"),
	bright = Color3.fromHex("#f4f1fb"),
	muted = Color3.fromHex("#9e99bd"),
	dim = Color3.fromHex("#7d789c"),
	gold = Color3.fromHex("#ffd76a"),
	ok = Color3.fromHex("#7dffb0"),
	danger = Color3.fromHex("#ff6b7d"),
	inkBlue = Color3.fromHex("#8fd8ff"),
	crystal = Color3.fromHex("#ff9ee6"),
	essence = Color3.fromHex("#e3d4ff"),
	accent = Color3.fromHex("#b06bff"),
}
UI.F = {
	title = Enum.Font.Garamond,
	bold = Enum.Font.GothamBold,
	medium = Enum.Font.GothamMedium,
	body = Enum.Font.Gotham,
	lore = Enum.Font.SourceSansItalic,
}

UI.lang = "es"
local loc = string.lower(player.LocaleId or "es")
if string.sub(loc, 1, 2) ~= "es" then
	UI.lang = "en"
end

function UI.t(key, vars)
	return Strings.get(key, UI.lang, vars)
end

function UI.L(obj)
	if type(obj) ~= "table" then
		return tostring(obj)
	end
	return obj[UI.lang] or obj.es or ""
end

function UI.fmt(n)
	n = math.floor((n or 0) + 0.5)
	local s = tostring(n)
	local out = string.reverse(string.gsub(string.reverse(s), "(%d%d%d)", "%1 "))
	return (string.gsub(out, "^ ", ""))
end

-- --- raíz -----------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "SellosArcanosUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")
UI.gui = gui

local root = Instance.new("Frame")
root.Name = "Root"
root.BackgroundTransparency = 1
root.Size = UDim2.fromScale(1, 1)
root.Parent = gui
local scale = Instance.new("UIScale")
scale.Parent = root
UI.root = root

local function rescale()
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local v = cam.ViewportSize
	local k = math.min(v.X / 1280, v.Y / 720)
	scale.Scale = math.clamp(k, 0.62, 1.5)
	-- el marco interior mide la pantalla dividida por la escala
	root.Size = UDim2.fromOffset(v.X / scale.Scale, v.Y / scale.Scale)
end
rescale()
Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

function UI.isTouch()
	local UIS = game:GetService("UserInputService")
	return UIS.TouchEnabled and not UIS.KeyboardEnabled
end

-- --- constructores ----------------------------------------------------------------
function UI.new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		o[k] = v
	end
	if parent then
		o.Parent = parent
	end
	return o
end

function UI.corner(o, r)
	UI.new("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o)
end

function UI.stroke(o, color, thick, transp)
	return UI.new("UIStroke", { Color = color or UI.C.line, Thickness = thick or 1.5, Transparency = transp or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end

function UI.pad(o, l, t, r, b)
	UI.new("UIPadding", {
		PaddingLeft = UDim.new(0, l or 10), PaddingTop = UDim.new(0, t or l or 10),
		PaddingRight = UDim.new(0, r or l or 10), PaddingBottom = UDim.new(0, b or t or l or 10),
	}, o)
end

function UI.list(o, dir, gap, align)
	return UI.new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
	}, o)
end

function UI.panel(parent, props)
	local f = UI.new("Frame", {
		BackgroundColor3 = UI.C.panel,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
	}, parent)
	for k, v in pairs(props or {}) do
		if k ~= "StrokeColor" then
			f[k] = v
		end
	end
	UI.corner(f, 8)
	UI.stroke(f, (props and props.StrokeColor) or UI.C.line, 1.5)
	return f
end

function UI.label(parent, text, size, font, color, props)
	local l = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text or "",
		TextSize = size or 16,
		Font = font or UI.F.medium,
		TextColor3 = color or UI.C.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.new(1, 0, 0, (size or 16) + 6),
		TextWrapped = false,
		RichText = true,
	}, parent)
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	return l
end

function UI.button(parent, text, props, onClick)
	local primary = props and props.Primary
	local b = UI.new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = primary and UI.C.bright or UI.C.panel2,
		BackgroundTransparency = 0.02,
		Text = text or "",
		TextSize = 15,
		Font = UI.F.bold,
		TextColor3 = primary and Color3.fromRGB(18, 15, 38) or UI.C.bright,
		Size = UDim2.fromOffset(160, 40),
		BorderSizePixel = 0,
	}, parent)
	for k, v in pairs(props or {}) do
		if k ~= "Primary" and k ~= "StrokeColor" then
			b[k] = v
		end
	end
	UI.corner(b, 6)
	local st = UI.stroke(b, (props and props.StrokeColor) or (primary and UI.C.bright or UI.C.line2), 1.5)
	b.MouseEnter:Connect(function()
		st.Color = UI.C.bright
	end)
	b.MouseLeave:Connect(function()
		st.Color = (props and props.StrokeColor) or (primary and UI.C.bright or UI.C.line2)
	end)
	if onClick then
		b.Activated:Connect(function()
			UI.click()
			onClick(b)
		end)
	end
	return b
end

function UI.bar(parent, color, height, props)
	local back = UI.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.92,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, height or 6),
		ClipsDescendants = true,
	}, parent)
	for k, v in pairs(props or {}) do
		back[k] = v
	end
	local fill = UI.new("Frame", { BackgroundColor3 = color or UI.C.bright, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1) }, back)
	return back, fill
end

function UI.setBar(fill, k)
	fill.Size = UDim2.fromScale(math.clamp(k or 0, 0, 1), 1)
end

-- --- sonido de interfaz -------------------------------------------------------------
local clickSound = UI.new("Sound", { SoundId = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.25 }, gui)
function UI.click()
	clickSound.PlaybackSpeed = 1.4
	clickSound:Play()
end

-- --- avisos y carteles ---------------------------------------------------------------
local toastBox = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 300), Position = UDim2.new(0, 0, 0, 92), ZIndex = 50 }, root)
UI.list(toastBox, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)

function UI.toast(text, kind)
	local color = (kind == "gold" and UI.C.gold) or (kind == "good" and UI.C.ok) or (kind == "bad" and UI.C.danger) or UI.C.line2
	local f = UI.panel(toastBox, { AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 0), ZIndex = 50 })
	f:FindFirstChildOfClass("UIStroke").Color = color
	UI.pad(f, 14, 8)
	local l = UI.label(f, text, 16, UI.F.bold, UI.C.bright, { AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 0), ZIndex = 51, TextWrapped = true })
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(720, 200) }, l)
	task.delay(3.2, function()
		local tw = TweenService:Create(f, TweenInfo.new(0.3), { BackgroundTransparency = 1 })
		tw:Play()
		for _, d in ipairs(f:GetDescendants()) do
			if d:IsA("TextLabel") then
				TweenService:Create(d, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			elseif d:IsA("UIStroke") then
				TweenService:Create(d, TweenInfo.new(0.3), { Transparency = 1 }):Play()
			end
		end
		task.wait(0.35)
		f:Destroy()
	end)
end

local bannerLabel = UI.label(root, "", 44, UI.F.title, UI.C.bright, {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.new(1, 0, 0, 60),
	TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.4, TextStrokeColor3 = UI.C.night, TextTransparency = 1, ZIndex = 40,
})
local bannerSub = UI.label(root, "", 16, UI.F.bold, UI.C.muted, {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.3, 40), Size = UDim2.new(1, 0, 0, 22),
	TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 1, ZIndex = 40,
})
local bannerToken = 0
function UI.banner(text, kind, sub, dur)
	bannerToken = bannerToken + 1
	local my = bannerToken
	bannerLabel.Text = string.upper(text)
	bannerLabel.TextColor3 = (kind == "gold" or kind == "seal") and UI.C.gold or UI.C.bright
	bannerLabel.TextSize = (kind == "boss") and 54 or 42
	bannerSub.Text = sub and string.upper(sub) or ""
	bannerLabel.TextTransparency = 0
	bannerSub.TextTransparency = 0
	bannerLabel.Position = UDim2.fromScale(0.5, 0.28)
	TweenService:Create(bannerLabel, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Position = UDim2.fromScale(0.5, 0.3) }):Play()
	task.delay(dur or 2, function()
		if my == bannerToken then
			TweenService:Create(bannerLabel, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			TweenService:Create(bannerSub, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		end
	end)
end

-- --- ventanas -------------------------------------------------------------------------
local modalLayer = UI.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 20, Active = true }, root)
UI.modalLayer = modalLayer
local current = nil

function UI.closeWindow()
	if current then
		current:Destroy()
		current = nil
	end
	modalLayer.Visible = false
	modalLayer.BackgroundTransparency = 1
	if UI.onWindowClosed then
		UI.onWindowClosed()
	end
end

-- ventana grande con título y botón de cerrar; devuelve el contenedor del cuerpo
function UI.window(title, w, h)
	UI.closeWindow()
	modalLayer.Visible = true
	modalLayer.BackgroundTransparency = 0.45
	local f = UI.panel(modalLayer, {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(math.min(0.94, (w or 1000) / 1280 * 1.15), 0, math.min(0.92, (h or 600) / 720 * 1.12), 0),
		ZIndex = 21, BackgroundTransparency = 0.02,
	})
	local sizeLimit = UI.new("UISizeConstraint", { MaxSize = Vector2.new(w or 1000, h or 600) }, f)
	local _ = sizeLimit
	current = f
	UI.label(f, title, 30, UI.F.title, UI.C.bright, { Position = UDim2.fromOffset(22, 12), Size = UDim2.new(1, -110, 0, 38), ZIndex = 22 })
	local close = UI.button(f, "✕", { Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -52, 0, 12), ZIndex = 23, TextSize = 18 }, function()
		UI.closeWindow()
	end)
	local _2 = close
	local body = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(22, 62), Size = UDim2.new(1, -44, 1, -80), ZIndex = 22 }, f)
	return body, f
end

function UI.scroll(parent, props)
	local s = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = UI.C.line2,
		ZIndex = 22,
	}, parent)
	for k, v in pairs(props or {}) do
		s[k] = v
	end
	return s
end

-- confirmación sencilla dentro de la ventana actual
function UI.confirm(text, onYes)
	local layer = UI.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, Size = UDim2.fromScale(1, 1), ZIndex = 60, Active = true }, root)
	local f = UI.panel(layer, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(440, 170), ZIndex = 61 })
	UI.label(f, text, 18, UI.F.bold, UI.C.bright, { Position = UDim2.fromOffset(20, 18), Size = UDim2.new(1, -40, 0, 70), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 62 })
	UI.button(f, UI.t("no"), { Position = UDim2.new(1, -310, 1, -58), Size = UDim2.fromOffset(140, 42), ZIndex = 62 }, function()
		layer:Destroy()
	end)
	UI.button(f, UI.t("yes"), { Primary = true, Position = UDim2.new(1, -160, 1, -58), Size = UDim2.fromOffset(140, 42), ZIndex = 62 }, function()
		layer:Destroy()
		onYes()
	end)
end

-- ZIndex a todos los descendientes (los elementos dentro de ventanas)
function UI.z(o, z)
	if o:IsA("GuiObject") then
		o.ZIndex = z
	end
	for _, d in ipairs(o:GetDescendants()) do
		if d:IsA("GuiObject") then
			d.ZIndex = z
		end
	end
end

return UI
]]></ProtectedString>
