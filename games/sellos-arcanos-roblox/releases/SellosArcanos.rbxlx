	pack_fundador_desc = s("500 Cristales + tinte Prisma + Corona Solar + Lluvia de estrellas (una vez)", "500 Crystals + Prism tint + Solar Crown + Starfall (once)"),
	pase_premium = s("Pase Arcano Premium", "Arcane Pass Premium"),
