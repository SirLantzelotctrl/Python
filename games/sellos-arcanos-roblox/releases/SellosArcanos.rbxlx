	c_advantage = s("Golpea {n} veces con ventaja de dominio", "Land {n} hits with domain advantage"),
	-- ajustes
	music = s("Música", "Music"),
	sounds = s("Sonidos", "Sounds"),
	language = s("Idioma", "Language"),
	controls = s("Controles", "Controls"),
	controlsText = s(
		"PC: Q · E · R habilidades · F Definitiva · Shift esquivar · 1 2 3 cambiar de criatura · Tab objetivo · G trazar sello · clic en un enemigo para fijarlo.\nMóvil: botones de la derecha.\nMando: X · Y · B habilidades · RB Definitiva · LB esquivar · cruceta cambiar · RT sellar.",
		"PC: Q · E · R abilities · F Ultimate · Shift dodge · 1 2 3 switch creature · Tab target · G trace seal · click an enemy to lock it.\nMobile: buttons on the right.\nGamepad: X · Y · B abilities · RB Ultimate · LB dodge · D-pad switch · RT seal."
	),
	-- mundo
	travel = s("Viajar", "Travel"),
	returnCitadel = s("Volver a la Ciudadela", "Return to the Citadel"),
	challenge = s("Desafiar al Primordial", "Challenge the Primordial"),
	restore = s("Restaurar equipo", "Restore team"),
	fountain = s("Fuente del Sello", "Seal Fountain"),
	locked = s("Bloqueada", "Locked"),
	islandLevels = s("Isla {n} · Nv {a}–{b}", "Island {n} · Lv {a}–{b}"),
	tutorial1 = s("Muévete con WASD o el joystick. Tu criatura te sigue y ataca sola al enemigo fijado.", "Move with WASD or the joystick. Your creature follows you and auto-attacks your target."),
	tutorial2 = s("Usa Q · E · R (o los botones) para sus habilidades. Sal de los círculos rojos.", "Use Q · E · R (or the buttons) for abilities. Get out of the red circles."),
	tutorial3 = s("Bájale la vida a menos del 25 % y pulsa TRAZAR SELLO para capturarla.", "Drop its HP below 25% and press TRACE SEAL to capture it."),
}

function S.get(key, lang, vars)
	local e = S.T[key]
	local str = e and (e[lang] or e.es) or key
	if vars then
		for k, v in pairs(vars) do
			str = string.gsub(str, "{" .. k .. "}", tostring(v))
		end
	end
	return str
end

return S
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBXA2F8F3DF0FF641CF99E92D2D00A45D74">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Folder" referent="RBX151E1B088BB641449722B6398F36DDFF">
			<Properties>
				<string name="Name">Server</string>
			</Properties>
			<Item class="ModuleScript" referent="RBXB59F2DB8DC684666B09CA39D7E8ADB67">
				<Properties>
					<string name="Name">Codes</string>
					<ProtectedString name="Source"><![CDATA[-- Códigos canjeables. Están en el servidor (ServerScriptService) para que nadie
-- pueda leerlos desde el cliente: así puedes dar códigos exclusivos a cada
-- creador de contenido y medir cuál funciona mejor.
--
-- Escribe el código en MAYÚSCULAS y sin espacios. Cada cuenta puede canjear cada
-- código una vez. «expires» (opcional) es el último día válido, en UTC.
-- Recompensas posibles: crystals, essence, ink.
return {
	SELLOS = { essence = 500, crystals = 25 },
	LANZAMIENTO = { crystals = 100, expires = "2027-03-31" },
	PRIMORDIAL = { essence = 1500, ink = 5 },
	-- Ejemplo de código para un creador de contenido (cámbialo por su nombre):
	-- CREADOR1 = { crystals = 60 },
}
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX7521293D9E9347EEA18DFA979C231271">
				<Properties>
					<string name="Name">CombatCore</string>
					<ProtectedString name="Source"><![CDATA[-- Núcleo del combate (servidor): entidades, daño, estados, habilidades,
-- proyectiles, zonas, rayos y minas. Los efectos visuales se envían a los
-- clientes de la misma isla en lotes (evento remoto «Fx»).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameData = require(Shared.GameData)
local Formulas = require(Shared.Formulas)
local Net = require(Shared.Net)

local Factory = require(script.Parent.CreatureFactory)
local World = require(script.Parent.WorldService)

local Core = {}
Core.entities = {}
Core.hooks = {}
Core.time = 0

local uid = 0
local projectiles, zones, timers, mines = {}, {}, {}, {}
local fxQueue = {} -- island -> lista de efectos

local folder = Instance.new("Folder")
folder.Name = "Criaturas"
folder.Parent = workspace

local CC = { stun = true, freeze = true, petrify = true }
local NEG = { burn = true, poison = true, slow = true, stun = true, freeze = true, petrify = true, root = true, blind = true, mark = true }

-- --- efectos visuales -----------------------------------------------------
function Core.fx(island, payload)
	if island == nil then
		return
	end
	local q = fxQueue[island]
	if not q then
		q = {}
		fxQueue[island] = q
	end
	if #q < 120 then
		table.insert(q, payload)
	end
end

local function flushFx()
	local fxEvent = Net.get("Fx")
	for island, list in pairs(fxQueue) do
		if #list > 0 then
			for _, player in ipairs(Players:GetPlayers()) do
				if player:GetAttribute("Island") == island then
					fxEvent:FireClient(player, list)
				end
			end
		end
	end
	fxQueue = {}
end

function Core.later(t, fn)
	table.insert(timers, { t = Core.time + t, fn = fn })
end

-- --- utilidades -------------------------------------------------------------
local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function dist(a, b)
	return (flat(a) - flat(b)).Magnitude
end
Core.dist = dist

function Core.dirTo(from, to)
	local d = flat(to - from)
	if d.Magnitude < 0.01 then
		return Vector3.new(0, 0, -1)
	end
	return d.Unit
end

local function rotateY(v, ang)
	local c, s = math.cos(ang), math.sin(ang)
	return Vector3.new(v.X * c - v.Z * s, 0, v.X * s + v.Z * c)
end
Core.rotateY = rotateY

local function inCone(src, dir, tgt, range, arcDeg)
	local d = flat(tgt.pos - src.pos)
	local m = d.Magnitude
	if m > range + tgt.radius then
		return false
	end
	if m < tgt.radius + 1 then
		return true
	end
	local ang = math.acos(math.clamp(d.Unit:Dot(dir), -1, 1))
	return ang <= math.rad(arcDeg / 2) + math.atan2(tgt.radius, m)
end

function Core.has(ent, t)
	for _, s in ipairs(ent.statuses) do
		if s.t == t then
			return true
		end
	end
	return false
end

function Core.stunned(ent)
	for _, s in ipairs(ent.statuses) do
		if CC[s.t] then
			return true
		end
	end
	return false
end

function Core.rooted(ent)
	return Core.stunned(ent) or Core.has(ent, "root") or ent.sealingBy ~= nil
end

local function speedMul(ent)
	local m = 1
	for _, s in ipairs(ent.statuses) do
		if s.t == "slow" then
			m = math.min(m, 1 - s.val)
		end
	end
	for _, b in ipairs(ent.buffs) do
		if b.spd then
			m = m * (1 + b.spd)
		end
	end
	return m
end
Core.speedMul = speedMul

local function atkMul(ent)
	local m = 1
	for _, b in ipairs(ent.buffs) do
		if b.atk then
			m = m * (1 + b.atk)
		end
	end
	if Core.has(ent, "blind") then
		m = m * 0.5
	end
	return m
end

function Core.cdrMul(ent)
	local m = ent.stats.cdr
	for _, b in ipairs(ent.buffs) do
		if b.cdr then
			m = m * (1 - b.cdr)
		end
	end
	return m
end

local function lifesteal(ent)
	local l = 0
	for _, b in ipairs(ent.buffs) do
		if b.lifesteal then
			l = l + b.lifesteal
		end
	end
	return l
end

function Core.addStatus(ent, st, src, baseDmg)
	if ent.kind == "anchor" or not ent.alive then
		return
	end
	local dur = st.dur
	if ent.boss and (CC[st.t] or st.t == "root") then
		dur = dur * 0.35
	end
	local entry = { t = st.t, dur = dur, val = st.val or 0, src = src, tickT = 0.5 }
	if st.t == "burn" or st.t == "poison" then
		entry.dps = ((baseDmg or 10) * (st.val or 0.5) * 2) / math.max(1, st.dur)
	end
	for i, s in ipairs(ent.statuses) do
		if s.t == st.t then
			ent.statuses[i] = entry
			return
		end
	end
	table.insert(ent.statuses, entry)
end

function Core.cleanse(ent)
	local keep = {}
	for _, s in ipairs(ent.statuses) do
		if not NEG[s.t] then
			table.insert(keep, s)
		end
	end
	ent.statuses = keep
end

function Core.addShield(ent, amount, dur, reflect)
	ent.shield = math.max(ent.shield, amount)
	ent.shieldT = math.max(ent.shieldT, dur)
	ent.reflect = math.max(ent.reflect, reflect or 0)
end

function Core.heal(ent, amount, show)
	if not ent.alive then
		return 0
	end
	if ent.kind == "bench" then
		local s = ent.benchSlot
		s.hp = math.min(s.maxHp, s.hp + amount)
		ent.hp = s.hp
		return amount
	end
	local before = ent.hp
	ent.hp = math.min(ent.maxHp, ent.hp + amount)
	local h = ent.hp - before
	if h > 0 and show ~= false then
		Core.fx(ent.island, { t = "dmg", p = ent.pos + Vector3.new(0, ent.height + 1, 0), v = math.floor(h), k = "heal" })
	end
	return h
end

-- --- entidades ---------------------------------------------------------------
-- opts: creature, kind ("companion"|"wild"|"boss"|"anchor"), level, form, boss, owner, island, pos, glow, seal
function Core.spawn(opts)
	uid = uid + 1
	local def = GameData.CreatureById[opts.creature]
	local stats = Formulas.stats(opts.creature, opts.level, opts.form or 1, opts.boss)
	local ent = {
		id = "e" .. uid, kind = opts.kind, creature = opts.creature, def = def,
		level = opts.level, form = opts.form or 1, boss = opts.boss == true, owner = opts.owner,
		stats = stats, maxHp = stats.hp, hp = opts.hp or stats.hp, energy = 100, seal = 0,
		cds = { q = 0, e = 0, r = 0 }, statuses = {}, buffs = {}, shield = 0, shieldT = 0, reflect = 0,
		pos = opts.pos, facing = opts.facing or 0, island = opts.island, alive = true,
		knock = Vector3.zero, castLock = 0, iframes = 0.8, dodgeCd = 0, aiGcd = 1 + math.random(),
		strafe = (math.random() < 0.5) and 1 or -1, home = opts.pos, contributors = {}, moving = false,
	}
	local model, root, ap, ao, info = Factory.build(opts.creature, { form = ent.form, boss = ent.boss, glow = opts.glow, seal = opts.seal })
	ent.model, ent.root, ent.ap, ent.ao = model, root, ap, ao
	ent.height, ent.radius, ent.flyer = info.height, info.radius, info.flyer
	ap.MaxVelocity = math.max(stats.speed * 1.6, 30)
	local y = World.GroundY + (ent.flyer and info.height * 0.25 or 0)
	model:PivotTo(CFrame.new(Vector3.new(ent.pos.X, y, ent.pos.Z)) * CFrame.Angles(0, ent.facing, 0))
	ap.Position = Vector3.new(ent.pos.X, y, ent.pos.Z)
	ao.CFrame = CFrame.Angles(0, ent.facing, 0)
	model:SetAttribute("EntityId", ent.id)
	model:SetAttribute("Kind", ent.kind)
	model:SetAttribute("Level", ent.level)
	model:SetAttribute("Form", ent.form)
	model:SetAttribute("Boss", ent.boss)
	model:SetAttribute("HP", ent.hp)
	model:SetAttribute("MaxHP", ent.maxHp)
	model:SetAttribute("Sealable", false)
	model:SetAttribute("Island", ent.island)
	if opts.owner then
		model:SetAttribute("OwnerId", opts.owner.UserId)
	end
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	Core.entities[ent.id] = ent
	Core.fx(ent.island, { t = "summon", p = ent.pos, c = def.color, e = opts.effect or "anillo", h = ent.height })
	return ent
end

function Core.despawn(ent, fade)
	if not Core.entities[ent.id] then
		return
	end
	ent.alive = false
	Core.entities[ent.id] = nil
	if ent.model then
		if fade then
			Core.fx(ent.island, { t = "burst", p = ent.pos + Vector3.new(0, ent.height * 0.5, 0), c = ent.def.color, n = 30 })
		end
		ent.model:Destroy()
	end
end

-- enemigos de una entidad en su isla
function Core.foesOf(ent)
	local out = {}
	for _, e in pairs(Core.entities) do
		if e.alive and e.island == ent.island and e ~= ent and not e.sealingBy then
			if ent.kind == "companion" then
				if e.kind ~= "companion" then
					table.insert(out, e)
				end
			elseif e.kind == "companion" then
				table.insert(out, e)
			end
		end
	end
	return out
end

function Core.teamOf(ent)
	if ent.kind == "companion" and Core.hooks.teamOf then
		return Core.hooks.teamOf(ent)
	end
	return { ent }
end

-- --- daño ---------------------------------------------------------------------
function Core.damage(src, tgt, power, stat, ab, opts)
	opts = opts or {}
	if not tgt.alive then
		return 0
	end
	local island = tgt.island
	local labelPos = tgt.pos + Vector3.new(0, tgt.height + 1, 0)
	if tgt.iframes > 0 and not opts.dot then
		Core.fx(island, { t = "dmg", p = labelPos, v = 0, k = "miss" })
		return 0
	end
	if tgt.invuln then
		if not opts.dot and math.random() < 0.3 then
			Core.fx(island, { t = "dmg", p = labelPos, v = 0, k = "immune" })
		end
		return 0
	end
	local statVal = (stat == "m") and src.stats.mag or src.stats.atk
	local elem = opts.dot and 1 or Formulas.domainMult(src.def.el, tgt.def.el)
	local crit = (not opts.dot) and math.random() < 0.05 + src.def.stats.agi * 0.001
	local dmg = opts.raw or (power * statVal * 0.06 * (170 / (100 + tgt.def.stats.def)))
	if not opts.raw then
		dmg = dmg * elem * (crit and 1.5 or 1) * atkMul(src) * (0.92 + math.random() * 0.16)
	end
	if Core.has(tgt, "mark") then
		dmg = dmg * 1.15
	end
	if tgt.kind == "anchor" then
		dmg = math.max(dmg, tgt.maxHp * 0.04)
	end
	dmg = math.max(1, dmg)
	if tgt.shield > 0 then
		local absorbed = math.min(tgt.shield, dmg)
		tgt.shield = tgt.shield - absorbed
		dmg = dmg - absorbed
		if tgt.reflect > 0 and not opts.dot and src.alive and src ~= tgt then
			local r = absorbed * tgt.reflect
			if r > 1 then
				Core.later(0.05, function()
					Core.damage(tgt, src, 0, "m", nil, { raw = r, dot = true })
				end)
			end
		end
		if dmg <= 0 then
			Core.fx(island, { t = "dmg", p = labelPos, v = math.floor(absorbed), k = "shield" })
			return 0
		end
	end
	-- los jefes no caen: hay que sellarlos
	if tgt.boss and not tgt.sealed then
		dmg = math.min(dmg, tgt.hp - 1)
	end
	tgt.hp = tgt.hp - dmg
	tgt.lastHit = Core.time
	if src.owner then
		tgt.contributors[src.owner] = (tgt.contributors[src.owner] or 0) + dmg
	end
	if dmg > 0 then
		local ls = lifesteal(src)
		if ls > 0 and not opts.dot then
			Core.heal(src, dmg * ls, false)
		end
		local kind = (opts.dot and "dot") or (crit and "crit") or (elem > 1 and "adv") or (tgt.kind == "companion" and "taken") or ""
		Core.fx(island, { t = "dmg", p = labelPos, v = math.floor(dmg + 0.5), k = kind })
		if not opts.dot then
			Core.fx(island, { t = "hit", id = tgt.id, p = tgt.pos + Vector3.new(0, tgt.height * 0.5, 0), c = src.def.color, s = (crit or power > 7) and 1 or 0 })
			if src.kind == "companion" and (not ab or ab.key ~= "f") then
				src.seal = math.min(100, src.seal + 2.6)
			end
			if tgt.kind == "companion" then
				tgt.seal = math.min(100, tgt.seal + (dmg / tgt.maxHp) * 30)
			end
			if elem > 1 and Core.hooks.onAdvantage and src.owner then
				Core.hooks.onAdvantage(src.owner)
			end
		end
	end
	if ab and ab.status and not opts.dot then
		Core.addStatus(tgt, ab.status, src, dmg)
	end
	if tgt.model then
		tgt.model:SetAttribute("HP", math.max(0, tgt.hp))
	end
	-- umbral de sellado
	if tgt.kind == "wild" and tgt.hp > 0 and tgt.hp / tgt.maxHp < 0.25 and not tgt.sealable then
		tgt.sealable = true
		tgt.model:SetAttribute("Sealable", true)
		if Core.hooks.onSealable then
			Core.hooks.onSealable(tgt)
		end
	end
	if tgt.boss and tgt.phaseReady3 and tgt.hp / tgt.maxHp < 0.25 and not tgt.sealable and not tgt.invuln then
		tgt.sealable = true
		tgt.model:SetAttribute("Sealable", true)
		if Core.hooks.onSealable then
			Core.hooks.onSealable(tgt)
		end
	end
	if tgt.hp <= 0 then
		tgt.hp = 0
		if Core.hooks.onDown then
			Core.hooks.onDown(tgt, src)
		end
	end
	return dmg
end

function Core.knockback(t, dir, amount)
	if t.boss or t.kind == "anchor" then
		amount = amount * 0.2
	end
	t.knock = t.knock + dir * amount * 4
end

-- --- habilidades ----------------------------------------------------------------
local function clampIsland(ent, p, margin)
	return World.clampToIsland(ent.island, p, margin or 4)
end

local function clampRange(p, from, range)
	local d = flat(p - from)
	if d.Magnitude > range then
		d = d.Unit * range
	end
	return Vector3.new(from.X + d.X, World.GroundY, from.Z + d.Z)
end

function Core.cast(f, ab, aim)
	local color = f.def.color
	local glow = f.model and f.model:GetAttribute("Glow") or color
	f.facing = math.atan2(-aim.dir.X, -aim.dir.Z)
	f.castLock = (ab.type == "cone" and ab.dur and ab.dur > 0) and ab.dur or 0.22
	Core.fx(f.island, { t = "lunge", id = f.id })
	local island = f.island

	if ab.type == "melee" then
		if aim.target then
			local d = dist(f.pos, aim.target.pos) - aim.target.radius - f.radius * 0.5
			if d > ab.range * 0.7 and d < ab.range + 12 then
				f.dash = { dir = aim.dir, left = math.min(12, d - ab.range * 0.5), speed = 70, hit = {} }
			end
		end
		for h = 0, (ab.hits or 1) - 1 do
			Core.later(h * 0.13, function()
				if not f.alive then
					return
				end
				local front = f.pos + aim.dir * ab.range * 0.55
				Core.fx(island, { t = "slash", p = front + Vector3.new(0, f.height * 0.4, 0), d = aim.dir, c = glow, r = ab.range })
				for _, t in ipairs(Core.foesOf(f)) do
					if inCone(f, aim.dir, t, ab.range + f.radius * 0.5, ab.arc) then
						Core.damage(f, t, ab.power, ab.stat, ab)
					end
				end
			end)
		end
	elseif ab.type == "projectile" then
		local n = ab.count or 1
		local spread = math.rad(ab.spread or 0)
		for i = 0, n - 1 do
			local a = (n == 1) and 0 or (-spread / 2 + spread * i / (n - 1))
			local dir = rotateY(aim.dir, a)
			local start = f.pos + dir * f.radius * 0.8 + Vector3.new(0, math.min(5, f.height * 0.5), 0)
			table.insert(projectiles, { f = f, ab = ab, dir = dir, pos = start, left = ab.range, hit = {}, side = f.kind == "companion" })
			Core.fx(island, { t = "proj", p = start, d = dir, s = ab.speed, r = ab.range, c = glow, z = ab.radius })
		end
	elseif ab.type == "cone" then
		local ticks = ab.ticks or 1
		local dur = ab.dur or 0
		Core.fx(island, { t = "breath", p = f.pos + Vector3.new(0, f.height * 0.5, 0), d = aim.dir, r = ab.range, a = ab.arc, c = glow, dur = math.max(0.3, dur) })
		for i = 0, ticks - 1 do
			Core.later(dur * i / ticks, function()
				if not f.alive or (dur > 0 and Core.stunned(f)) then
					return
				end
				for _, t in ipairs(Core.foesOf(f)) do
					if inCone(f, aim.dir, t, ab.range, ab.arc) then
						Core.damage(f, t, ab.power, ab.stat, ab)
						if ab.knock then
							Core.knockback(t, aim.dir, ab.knock)
						end
						if i == ticks - 1 and ab.endStatus then
							Core.addStatus(t, ab.endStatus, f)
						end
					end
				end
			end)
		end
	elseif ab.type == "aoe" then
		local follow = (ab.range or 0) == 0
		local center = follow and f.pos or clampIsland(f, clampRange(aim.pos, f.pos, ab.range))
		local function doIt()
			if not f.alive then
				return
			end
			local c = follow and f.pos or center
			Core.fx(island, { t = "ring", p = c, r = ab.radius, c = glow })
			local ticks = ab.ticks or 1
			for i = 0, ticks - 1 do
				Core.later((ab.dur or 0) * i / ticks, function()
					local cc = follow and f.pos or c
					if ticks > 1 then
						Core.fx(island, { t = "ring", p = cc, r = ab.radius * 0.8, c = glow })
					end
					for _, t in ipairs(Core.foesOf(f)) do
						if dist(t.pos, cc) <= ab.radius + t.radius then
							if ab.power and ab.power > 0 then
								Core.damage(f, t, ab.power, ab.stat, ab)
							elseif ab.status then
								Core.addStatus(t, ab.status, f)
							end
							if ab.pull then
								t.pullTo = { pos = cc, speed = ab.pull, t = math.max(0.4, ab.dur or 0.5) }
							end
						end
					end
					if ab.selfHeal then
						Core.heal(f, f.maxHp * ab.selfHeal)
					end
				end)
			end
			if ab.final then
				Core.later((ab.dur or 0) + 0.05, function()
					local cc = follow and f.pos or c
					Core.fx(island, { t = "ring", p = cc, r = ab.radius * 0.6, c = glow, big = true })
					for _, t in ipairs(Core.foesOf(f)) do
						if dist(t.pos, cc) <= ab.radius * 0.6 + t.radius then
							Core.damage(f, t, ab.final, ab.stat, ab)
						end
					end
				end)
			end
		end
		if ab.delay and ab.delay > 0 then
			Core.fx(island, { t = "tele", p = follow and f.pos or center, r = ab.radius, c = color, time = ab.delay })
			Core.later(ab.delay, doIt)
		else
			doIt()
		end
	elseif ab.type == "dash" then
		local d = ab.range
		if aim.target then
			d = math.min(ab.range, dist(f.pos, aim.target.pos) + 3)
		end
		f.dash = { dir = aim.dir, left = d, speed = ab.speed, ab = ab, hit = {} }
		f.iframes = math.max(f.iframes, 0.2)
		Core.fx(island, { t = "trail", id = f.id, c = glow, time = d / ab.speed })
	elseif ab.type == "heal" then
		for _, t in ipairs(ab.team and Core.teamOf(f) or { f }) do
			if ab.cleanse then
				Core.cleanse(t)
			end
			local amount = t.maxHp * ab.pct
			if not ab.dur or ab.dur == 0 then
				Core.heal(t, amount)
			else
				local steps = math.ceil(ab.dur / 0.5)
				for i = 1, steps do
					Core.later(i * 0.5, function()
						Core.heal(t, amount / steps, i == 1)
					end)
				end
			end
		end
		Core.fx(island, { t = "pillar", p = f.pos, c = glow, h = 14 })
		if ab.burst then
			Core.fx(island, { t = "ring", p = f.pos, r = ab.burst.radius, c = glow })
			for _, t in ipairs(Core.foesOf(f)) do
				if dist(t.pos, f.pos) <= ab.burst.radius + t.radius then
					Core.damage(f, t, ab.burst.power, ab.burst.stat, ab)
				end
			end
		end
	elseif ab.type == "shield" then
		Core.addShield(f, f.maxHp * ab.pct, ab.dur, ab.reflect)
		Core.fx(island, { t = "shield", id = f.id, c = glow, time = ab.dur })
	elseif ab.type == "buff" then
		table.insert(f.buffs, { atk = ab.atk, spd = ab.spd, cdr = ab.cdr, lifesteal = ab.lifesteal, t = ab.dur })
		Core.fx(island, { t = "pillar", p = f.pos, c = glow, h = 18 })
	elseif ab.type == "zone" then
		local center = (ab.range and ab.range > 0) and clampIsland(f, clampRange(aim.pos, f.pos, ab.range)) or f.pos
		table.insert(zones, { f = f, ab = ab, pos = center, t = ab.dur, tickT = 0, inside = {} })
		Core.fx(island, { t = "zone", p = center, r = ab.radius, c = glow, time = ab.dur })
	elseif ab.type == "strike" then
		local foes = Core.foesOf(f)
		local marked = {}
		for _, t in ipairs(foes) do
			if Core.has(t, "mark") then
				table.insert(marked, t)
			end
		end
		local pool = (#marked > 0) and marked or foes
		for i = 1, ab.count do
			local p
			if ab.area or #pool == 0 then
				local base = (#pool > 0) and pool[(i - 1) % #pool + 1].pos or f.pos
				p = base + Vector3.new((math.random() - 0.5) * 20, 0, (math.random() - 0.5) * 20)
			else
				local t = pool[(i - 1) % #pool + 1]
				p = t.pos + Vector3.new((math.random() - 0.5) * 3, 0, (math.random() - 0.5) * 3)
			end
			p = clampIsland(f, p)
			Core.later((i - 1) * (ab.interval or 0.15), function()
				Core.fx(island, { t = "tele", p = p, r = ab.radius, c = color, time = ab.delay })
				Core.later(ab.delay, function()
					Core.fx(island, { t = (f.creature == "tortuga") and "tower" or "bolt", p = p, c = glow, r = ab.radius })
					for _, t in ipairs(Core.foesOf(f)) do
						if dist(t.pos, p) <= ab.radius + t.radius then
							Core.damage(f, t, ab.power, ab.stat, ab)
						end
					end
				end)
			end)
		end
	elseif ab.type == "mines" then
		for i = 1, ab.count do
			local a = f.facing + (i - (ab.count + 1) / 2) * 0.9
			local p = clampIsland(f, f.pos + Vector3.new(-math.sin(a) * 7, 0, -math.cos(a) * 7))
			table.insert(mines, { f = f, ab = ab, pos = p, arm = 0.6, life = 12 })
			Core.fx(island, { t = "mine", p = p, c = glow, time = 12 })
		end
	elseif ab.type == "revive" then
		if f.kind == "companion" and Core.hooks.reviveTeam then
			Core.hooks.reviveTeam(f, ab.pct)
		end
		Core.heal(f, f.maxHp * ab.pct)
		Core.fx(island, { t = "pillar", p = f.pos, c = glow, h = 30 })
		Core.fx(island, { t = "ring", p = f.pos, r = ab.radius, c = glow, big = true })
		for _, t in ipairs(Core.foesOf(f)) do
			if dist(t.pos, f.pos) <= ab.radius + t.radius then
				Core.damage(f, t, ab.power, ab.stat, ab)
				Core.addStatus(t, { t = "burn", dur = 3, val = 0.5 }, f, 10)
			end
		end
	end

	if ab.also then
		local a = ab.also
		if a.type == "shield" then
			local targets = (ab.key == "f" or ab.team) and Core.teamOf(f) or { f }
			for _, t in ipairs(targets) do
				Core.addShield(t, t.maxHp * a.pct, a.dur, a.reflect)
			end
			Core.fx(island, { t = "shield", id = f.id, c = glow, time = a.dur })
		elseif a.type == "buff" then
			table.insert(f.buffs, { atk = a.atk, spd = a.spd, cdr = a.cdr, lifesteal = a.lifesteal, t = a.dur })
		end
	end
end

-- --- simulación ----------------------------------------------------------------
local function stepEntity(e, dt)
	for _, k in ipairs({ "q", "e", "r" }) do
		e.cds[k] = math.max(0, e.cds[k] - dt)
	end
	e.energy = math.min(100, e.energy + dt * 10)
	e.iframes = math.max(0, e.iframes - dt)
	e.dodgeCd = math.max(0, e.dodgeCd - dt)
	e.castLock = math.max(0, e.castLock - dt)
	if e.shieldT > 0 then
		e.shieldT = e.shieldT - dt
		if e.shieldT <= 0 then
			e.shield, e.reflect = 0, 0
		end
	end
	for i = #e.buffs, 1, -1 do
		e.buffs[i].t = e.buffs[i].t - dt
		if e.buffs[i].t <= 0 then
			table.remove(e.buffs, i)
		end
	end
	local tint = nil
	for i = #e.statuses, 1, -1 do
		local s = e.statuses[i]
		s.dur = s.dur - dt
		if s.dps then
			s.tickT = s.tickT - dt
			if s.tickT <= 0 then
				s.tickT = s.tickT + 0.5
				local src = (s.src and s.src.alive) and s.src or e
				Core.damage(src, e, 0, "m", nil, { raw = s.dps * 0.5, dot = true })
			end
		end
		if not tint and (s.t == "freeze" or s.t == "petrify" or s.t == "poison" or s.t == "burn" or s.t == "stun" or s.t == "root") then
			tint = s.t
		end
		if s.dur <= 0 then
			table.remove(e.statuses, i)
		end
	end
	if e.model and e.model:GetAttribute("Status") ~= (tint or "") then
		e.model:SetAttribute("Status", tint or "")
	end
	-- embestidas y esquivas
	if e.dash then
		local step = math.min(e.dash.left, e.dash.speed * dt)
		e.pos = e.pos + e.dash.dir * step
		e.dash.left = e.dash.left - step
		e.facing = math.atan2(-e.dash.dir.X, -e.dash.dir.Z)
		if e.dash.ab then
			for _, t in ipairs(Core.foesOf(e)) do
				if not e.dash.hit[t] and dist(t.pos, e.pos) < t.radius + e.dash.ab.width then
					e.dash.hit[t] = true
					Core.damage(e, t, e.dash.ab.power, e.dash.ab.stat, e.dash.ab)
					if e.dash.ab.knock then
						Core.knockback(t, e.dash.dir, e.dash.ab.knock)
					end
				end
			end
		end
		if e.dash.left <= 0.05 then
			e.dash = nil
		end
	end
	if e.knock.Magnitude > 0.1 then
		e.pos = e.pos + e.knock * dt
		e.knock = e.knock * math.max(0, 1 - dt * 6)
	end
	if e.pullTo then
		local d = dist(e.pos, e.pullTo.pos)
		if d > 3 then
			e.pos = e.pos + Core.dirTo(e.pos, e.pullTo.pos) * math.min(d - 3, e.pullTo.speed * dt * (e.boss and 0.15 or 1))
		end
		e.pullTo.t = e.pullTo.t - dt
		if e.pullTo.t <= 0 then
			e.pullTo = nil
		end
	end
	e.pos = World.clampToIsland(e.island, e.pos, e.radius * 0.5 + 2)
end

local function applyMotion(e)
	if not e.root or not e.root.Parent then
		return
	end
	local y = World.GroundY + (e.flyer and e.height * 0.25 or 0)
	e.ap.Position = Vector3.new(e.pos.X, y, e.pos.Z)
	e.ao.CFrame = CFrame.Angles(0, e.facing, 0)
end

local function stepProjectiles(dt)
	for i = #projectiles, 1, -1 do
		local pr = projectiles[i]
		local step = pr.ab.speed * dt
		pr.pos = pr.pos + pr.dir * step
		pr.left = pr.left - step
		local done = pr.left <= 0 or not Core.entities[pr.f.id] and pr.f.kind ~= "companion"
		if not done then
			for _, t in ipairs(Core.foesOf(pr.f)) do
				if not pr.hit[t] and dist(t.pos, pr.pos) < t.radius + pr.ab.radius then
					pr.hit[t] = true
					if pr.ab.explode then
						Core.fx(pr.f.island, { t = "ring", p = pr.pos, r = pr.ab.explode, c = pr.f.def.color })
						for _, o in ipairs(Core.foesOf(pr.f)) do
							if dist(o.pos, pr.pos) < pr.ab.explode + o.radius then
								Core.damage(pr.f, o, pr.ab.power, pr.ab.stat, pr.ab)
							end
						end
					else
						Core.damage(pr.f, t, pr.ab.power, pr.ab.stat, pr.ab)
					end
					if pr.ab.pullBack and t.alive then
						t.pullTo = { pos = pr.f.pos, speed = 50, t = 0.5 }
					end
					if not pr.ab.pierce then
						done = true
						break
					end
				end
			end
		end
		if done then
			table.remove(projectiles, i)
		end
	end
end

local function stepZones(dt)
	for i = #zones, 1, -1 do
		local z = zones[i]
		z.t = z.t - dt
		z.tickT = z.tickT - dt
		if z.tickT <= 0 then
			z.tickT = z.tickT + (z.ab.tick or 0.5)
			if z.ab.heal then
				for _, t in ipairs(Core.teamOf(z.f)) do
					if t.alive and t.island == z.f.island and dist(t.pos, z.pos) < z.ab.radius + t.radius then
						Core.heal(t, t.maxHp * z.ab.heal)
					end
				end
			else
				for _, t in ipairs(Core.foesOf(z.f)) do
					if dist(t.pos, z.pos) < z.ab.radius + t.radius then
						Core.damage(z.f, t, z.ab.power, z.ab.stat, z.ab)
						if z.ab.freezeAfter then
							z.inside[t] = (z.inside[t] or 0) + (z.ab.tick or 0.5)
							if z.inside[t] >= z.ab.freezeAfter and not Core.has(t, "freeze") then
								Core.addStatus(t, { t = "freeze", dur = 1.5 }, z.f)
							end
						end
					end
				end
			end
		end
		if z.t <= 0 then
			table.remove(zones, i)
		end
	end
end

local function stepMines(dt)
	for i = #mines, 1, -1 do
		local m = mines[i]
		m.arm = m.arm - dt
		m.life = m.life - dt
		local boom = m.life <= 0
		if m.arm <= 0 then
			for _, t in ipairs(Core.foesOf(m.f)) do
				if dist(t.pos, m.pos) < m.ab.radius + t.radius then
					boom = true
				end
			end
		end
		if boom then
			Core.fx(m.f.island, { t = "ring", p = m.pos, r = m.ab.radius * 1.4, c = m.f.def.color })
			for _, t in ipairs(Core.foesOf(m.f)) do
				if dist(t.pos, m.pos) < m.ab.radius * 1.4 + t.radius then
					Core.damage(m.f, t, m.ab.power, m.ab.stat, m.ab)
				end
			end
			table.remove(mines, i)
		end
	end
end

-- separación para que no se monten unas sobre otras
local function separate(list)
	for i = 1, #list do
		for j = i + 1, #list do
			local a, b = list[i], list[j]
			if a.island == b.island then
				local d = flat(b.pos - a.pos)
				local m = d.Magnitude
				local min = (a.radius + b.radius) * 0.7
				if m < min and m > 0.01 then
					local push = (min - m) / 2
					local wa = a.boss and 0.1 or 1
					local wb = b.boss and 0.1 or 1
					a.pos = a.pos - d.Unit * push * wa
					b.pos = b.pos + d.Unit * push * wb
				end
			end
		end
	end
end

function Core.step(dt)
	Core.time = Core.time + dt
	if #timers > 0 then
		local due = {}
		local keep = {}
		for _, t in ipairs(timers) do
			if t.t <= Core.time then
				table.insert(due, t)
			else
				table.insert(keep, t)
			end
		end
		timers = keep
		for _, t in ipairs(due) do
			local ok, err = pcall(t.fn)
			if not ok then
				warn("[Sellos Arcanos] temporizador:", err)
			end
		end
	end
	local list = {}
	for _, e in pairs(Core.entities) do
		if e.alive and e.kind ~= "anchor" then
			stepEntity(e, dt)
			table.insert(list, e)
		end
	end
	separate(list)
	stepProjectiles(dt)
	stepZones(dt)
	stepMines(dt)
	for _, e in ipairs(list) do
		applyMotion(e)
	end
	flushFx()
end

function Core.applyMotion(e)
	applyMotion(e)
end

Core.flat = flat
Core.CollectionService = CollectionService
return Core
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX8D1550F15CAB44059B84DB2DD522288A">
				<Properties>
					<string name="Name">Companions</string>
					<ProtectedString name="Source"><![CDATA[-- Equipo de cada jugador: la criatura activa le acompaña, combate cuando hay
-- un objetivo y responde a Q · E · R · F, esquiva y cambio 1 · 2 · 3.
-- La vida del resto del equipo se guarda aquí mientras están en el grimorio.
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameData = require(Shared.GameData)
local Formulas = require(Shared.Formulas)
local Net = require(Shared.Net)

local Core = require(script.Parent.CombatCore)
local DataService = require(script.Parent.DataService)
local Progression = require(script.Parent.ProgressionService)
local World = require(script.Parent.WorldService)

local Companions = {}
local teams = {} -- player -> {slots = {{id, hp, maxHp, fainted, energy, seal}}, active = idx, ent, target, lastCast, switchCd}

local function pstate(player)
	return teams[player]
end
Companions.state = pstate

local function hrp(player)
	local ch = player.Character
	return ch and ch:FindFirstChild("HumanoidRootPart")
end

local function glowFor(p, id)
	local own = p.creatures[id]
	return Formulas.tintColor(own and own.tint, GameData.CreatureById[id].color)
end

local function sealFor(p, id)
	local s = p.cosmetics.seal
	if s and s ~= "propio" and s ~= "" then
		if s == "corona" or s == "constelacion" or s == "eclipse" then
			return "heptagrama"
		end
		return s
	end
	return GameData.CreatureById[id].circle
end

-- estado del equipo para la interfaz (atributo en el jugador)
function Companions.publish(player)
	local st = teams[player]
	if not st then
		return
	end
	local out = { active = st.active, slots = {} }
	for i, s in ipairs(st.slots) do
		local hp, maxHp, energy, seal = s.hp, s.maxHp, s.energy, s.seal
		local cds = { q = 0, e = 0, r = 0 }
		local shield = 0
		if i == st.active and st.ent and st.ent.alive then
			hp, maxHp, energy, seal = st.ent.hp, st.ent.maxHp, st.ent.energy, st.ent.seal
			cds = st.ent.cds
			shield = st.ent.shield
		end
		table.insert(out.slots, {
			id = s.id, hp = math.floor(hp), maxHp = maxHp, fainted = s.fainted, energy = math.floor(energy),
			seal = math.floor(seal), level = s.level, form = s.form, shield = math.floor(shield),
			cq = math.ceil(cds.q * 10) / 10, ce = math.ceil(cds.e * 10) / 10, cr = math.ceil(cds.r * 10) / 10,
		})
	end
	out.target = st.target and st.target.alive and st.target.id or ""
	local json = HttpService:JSONEncode(out)
	if player:GetAttribute("TeamState") ~= json then
		player:SetAttribute("TeamState", json)
	end
end

local function saveActive(st)
	local s = st.slots[st.active]
	if s and st.ent then
		s.hp = st.ent.hp
		s.energy = st.ent.energy
		s.seal = st.ent.seal
	end
end

-- reconstruye el equipo desde el perfil (al entrar o al cambiar el equipo)
function Companions.rebuild(player, keepHp)
	local p = DataService.get(player)
	if not p then
		return
	end
	local old = teams[player]
	local oldHp = {}
	if old and keepHp then
		saveActive(old)
		for _, s in ipairs(old.slots) do
			oldHp[s.id] = s
		end
	end
	local st = { slots = {}, active = 1, switchCd = 0, lastCast = 0 }
	for _, id in ipairs(p.team) do
		local own = p.creatures[id]
		if own then
			local stats = Formulas.stats(id, own.level, own.form, false)
			local prev = oldHp[id]
			table.insert(st.slots, {
				id = id, level = own.level, form = own.form, maxHp = stats.hp,
				hp = prev and math.min(prev.hp, stats.hp) or stats.hp, fainted = prev and prev.fainted or false,
				energy = prev and prev.energy or 100, seal = prev and prev.seal or 0,
			})
		end
	end
	if old and old.ent then
		Core.despawn(old.ent, false)
	end
	if old then
		st.target = nil
	end
	teams[player] = st
	for i, s in ipairs(st.slots) do
		if not s.fainted then
			st.active = i
			break
		end
	end
	Companions.summon(player)
end

function Companions.summon(player)
	local st = teams[player]
	local p = DataService.get(player)
	local root = hrp(player)
	if not st or not p or not root or #st.slots == 0 then
		return
	end
	local s = st.slots[st.active]
	if not s or s.fainted then
		return
	end
	if st.ent then
		Core.despawn(st.ent, false)
	end
	local island = World.islandAt(root.Position) or 0
	local look = root.CFrame.LookVector
	local pos = World.clampToIsland(island, root.Position - look * 6 + root.CFrame.RightVector * 5, 4)
	local ent = Core.spawn({
		creature = s.id, kind = "companion", level = s.level, form = s.form, owner = player,
		island = island, pos = pos, facing = math.atan2(-look.X, -look.Z), hp = s.hp,
		glow = glowFor(p, s.id), seal = sealFor(p, s.id), effect = p.cosmetics.effect,
	})
	ent.energy = s.energy
	ent.seal = s.seal
	ent.slot = st.active
	st.ent = ent
	Progression.markSeen(player, s.id)
	Companions.publish(player)
end

function Companions.switch(player, slot)
	local st = teams[player]
	if not st or type(slot) ~= "number" then
		return
	end
	slot = math.floor(slot)
	local s = st.slots[slot]
	if not s or s.fainted or slot == st.active or st.switchCd > 0 then
		return
	end
	saveActive(st)
	local oldPos = st.ent and st.ent.pos
	st.active = slot
	st.switchCd = 1.5
	Companions.summon(player)
	if oldPos and st.ent then
		st.ent.pos = oldPos
	end
end

-- toda la vida y la energía de vuelta (Fuente del Sello, al volver a la Ciudadela)
function Companions.restore(player)
	local st = teams[player]
	if not st then
		return
	end
	for _, s in ipairs(st.slots) do
		s.hp = s.maxHp
		s.fainted = false
		s.energy = 100
	end
	if st.ent and st.ent.alive then
		st.ent.hp = st.ent.maxHp
		st.ent.statuses = {}
		st.ent.model:SetAttribute("HP", st.ent.hp)
	else
		for i, s in ipairs(st.slots) do
			if not s.fainted then
				st.active = i
				break
			end
		end
		Companions.summon(player)
	end
	Companions.publish(player)
end

function Companions.onFaint(ent)
	local player = ent.owner
	local st = teams[player]
	if not st then
		return
	end
	local s = st.slots[ent.slot]
	if s then
		s.hp = 0
		s.fainted = true
	end
	Core.fx(ent.island, { t = "burst", p = ent.pos + Vector3.new(0, ent.height * 0.5, 0), c = ent.def.color, n = 30 })
	Core.despawn(ent, false)
	st.ent = nil
	local nextIdx = nil
	for i, sl in ipairs(st.slots) do
		if not sl.fainted then
			nextIdx = i
			break
		end
	end
	if nextIdx then
		st.active = nextIdx
		task.delay(0.8, function()
			if teams[player] == st and not st.ent then
				Companions.summon(player)
			end
		end)
	else
		-- equipo caído: vuelta a la Ciudadela, la Fuente los restaura
		Progression.toast(player, "teamFell", {}, "bad")
		task.delay(1.2, function()
			if Companions.toHub then
				Companions.toHub(player)
			end
			Companions.restore(player)
		end)
	end
	Companions.publish(player)
end

-- Renacer (Fénix): revive al equipo en el grimorio
function Companions.reviveTeam(ent, pct)
	local st = teams[ent.owner]
	if not st then
		return
	end
	for _, s in ipairs(st.slots) do
		if s.fainted then
			s.fainted = false
			s.hp = s.maxHp * pct
		end
	end
end

-- curas de equipo (Calor vital, Refugio, Amanecer): la activa recibe la cura real,
-- el resto del grimorio se cura directamente
function Companions.teamEntities(ent)
	local st = teams[ent.owner]
	if not st then
		return { ent }
	end
	local list = { ent }
	for i, s in ipairs(st.slots) do
		if i ~= st.active and not s.fainted then
			-- objeto ligero que recibe las curas de equipo (CombatCore.heal lo reconoce)
			local proxy = {
				alive = true, kind = "bench", benchSlot = s, hp = s.hp, maxHp = s.maxHp, island = ent.island,
				pos = ent.pos, height = ent.height, statuses = {}, buffs = {}, shield = 0, shieldT = 0, reflect = 0,
				radius = ent.radius, def = GameData.CreatureById[s.id],
			}
			table.insert(list, proxy)
		end
	end
	return list
end

-- objetivo: el que pidió el cliente si es válido; si no, el más cercano
local function pickTarget(st, wantedId)
	local ent = st.ent
	if not ent then
		return nil
	end
	local foes = Core.foesOf(ent)
	if wantedId and wantedId ~= "" then
		for _, f in ipairs(foes) do
			if f.id == wantedId and Core.dist(f.pos, ent.pos) < 120 then
				return f
			end
		end
	end
	if st.target and st.target.alive and st.target.island == ent.island then
		return st.target
	end
	local best, bd = nil, 70
	for _, f in ipairs(foes) do
		local d = Core.dist(f.pos, ent.pos)
		if d < bd then
			best, bd = f, d
		end
	end
	return best
end

function Companions.cast(player, key, targetId)
	local st = teams[player]
	if not st or not st.ent or not st.ent.alive then
		return
	end
	local ent = st.ent
	if type(key) ~= "string" or Core.stunned(ent) or ent.castLock > 0 or ent.dash then
		return
	end
	local ab = ent.def.abilityByKey[key]
	if not ab then
		return
	end
	if key == "r" and ent.form < 2 then
		return
	end
	local target = pickTarget(st, targetId)
	st.target = target
	st.lastCast = Core.time
	if key == "f" then
		if ent.seal < 100 then
			return
		end
		ent.seal = 0
		local p = DataService.get(player)
		p.stats.ults = p.stats.ults + 1
		Progression.progress(player, "ult")
		Net.get("Banner"):FireClient(player, "ult", { id = ent.creature }, "ult")
	else
		if ent.cds[key] > 0 or ent.energy < (ab.cost or 0) then
			return
		end
		ent.energy = ent.energy - (ab.cost or 0)
		ent.cds[key] = ab.cd * Core.cdrMul(ent)
	end
	local dir
	if target then
		dir = Core.dirTo(ent.pos, target.pos)
	else
		local r = hrp(player)
		local lv = r and r.CFrame.LookVector or Vector3.new(0, 0, -1)
		dir = Vector3.new(lv.X, 0, lv.Z).Unit
	end
	Core.cast(ent, ab, { dir = dir, pos = target and target.pos or (ent.pos + dir * 15), target = target })
	Companions.publish(player)
end

function Companions.dodge(player, dir)
	local st = teams[player]
	if not st or not st.ent or not st.ent.alive then
		return
	end
	local ent = st.ent
	if ent.dodgeCd > 0 or Core.rooted(ent) then
		return
	end
	local d = (typeof(dir) == "Vector3" and dir.Magnitude > 0.1) and Vector3.new(dir.X, 0, dir.Z).Unit or Vector3.new(-math.sin(ent.facing), 0, -math.cos(ent.facing))
	ent.dash = { dir = d, left = 13, speed = 62, hit = {} }
	ent.iframes = 0.4
	ent.dodgeCd = 1
	Core.fx(ent.island, { t = "trail", id = ent.id, c = ent.def.color, time = 0.25 })
end

-- movimiento y ataque automático de la criatura activa
function Companions.step(dt)
	for player, st in pairs(teams) do
		st.switchCd = math.max(0, (st.switchCd or 0) - dt)
		local ent = st.ent
		local root = hrp(player)
		if ent and ent.alive and root then
			local island = World.islandAt(root.Position)
			if island ~= nil and island ~= ent.island then
				-- el jugador cambió de isla: la criatura le sigue
				ent.island = island
				ent.pos = World.clampToIsland(island, root.Position, 4)
				ent.root.CFrame = CFrame.new(ent.pos + Vector3.new(0, 2, 0))
				ent.model:SetAttribute("Island", island)
				st.target = nil
			end
			if st.target and (not st.target.alive or st.target.island ~= ent.island or Core.dist(st.target.pos, root.Position) > 110) then
				st.target = nil
			end
			-- regeneración fuera de combate
			if not ent.lastHit or Core.time - ent.lastHit > 6 then
				if ent.hp < ent.maxHp then
					ent.hp = math.min(ent.maxHp, ent.hp + ent.maxHp * 0.05 * dt)
					ent.model:SetAttribute("HP", ent.hp)
				end
			end
			if not ent.dash and not Core.rooted(ent) and ent.castLock <= 0 then
				local goal
				local t = st.target
				if t and Core.time - st.lastCast < 12 then
					local q = ent.def.abilityByKey.q
					local want = ((q.type == "melee" or q.type == "dash") and (q.range * 0.8) or 18) + t.radius
					local d = Core.dist(ent.pos, t.pos)
					local dirT = Core.dirTo(ent.pos, t.pos)
					if d > want then
						goal = t.pos - dirT * want
					else
						goal = ent.pos
					end
					ent.facing = math.atan2(-dirT.X, -dirT.Z)
					-- ataque básico automático (Q) mientras dura el combate
					if ent.cds.q <= 0 and d <= (q.range or 18) + t.radius + 4 then
						ent.cds.q = q.cd * Core.cdrMul(ent)
						Core.cast(ent, q, { dir = dirT, pos = t.pos, target = t })
					end
				else
					local cf = root.CFrame
					goal = cf.Position - cf.LookVector * 7 + cf.RightVector * 5
					local dd = Core.flat(goal - ent.pos)
					if dd.Magnitude > 1 then
						ent.facing = math.atan2(-dd.Unit.X, -dd.Unit.Z)
					end
				end
				local delta = Core.flat(goal - ent.pos)
				local m = delta.Magnitude
				if m > 0.5 then
					local speed = math.max(ent.stats.speed * Core.speedMul(ent), 22)
					if m > 40 then
						speed = speed * 2.5
					end
					ent.pos = ent.pos + delta.Unit * math.min(m, speed * dt)
					ent.moving = true
				else
					ent.moving = false
				end
				ent.pos = World.clampToIsland(ent.island, ent.pos, 3)
			end
		end
	end
end

-- actualiza nivel y estadísticas sin volver a invocar (al subir de nivel o entrenar)
function Companions.refreshLevels(player)
	local st = teams[player]
	local p = DataService.get(player)
	if not st or not p then
		return
	end
	for i, s in ipairs(st.slots) do
		local own = p.creatures[s.id]
		if own and own.level ~= s.level then
			local stats = Formulas.stats(s.id, own.level, own.form, false)
			local ratio = (s.maxHp > 0) and (s.hp / s.maxHp) or 1
			s.level = own.level
			s.maxHp = stats.hp
			s.hp = stats.hp * ratio
			if i == st.active and st.ent and st.ent.alive then
				local e = st.ent
				local r = e.hp / e.maxHp
				e.level = own.level
				e.stats = stats
				e.maxHp = stats.hp
				e.hp = stats.hp * r
				e.model:SetAttribute("Level", e.level)
				e.model:SetAttribute("MaxHP", e.maxHp)
				e.model:SetAttribute("HP", e.hp)
			end
		end
	end
	Companions.publish(player)
end

-- publicación del estado del equipo a ~6 Hz
local acc = 0
function Companions.publishAll(dt)
	acc = acc + dt
	if acc < 0.16 then
		return
	end
	acc = 0
	for player in pairs(teams) do
		Companions.publish(player)
	end
end

function Companions.remove(player)
	local st = teams[player]
	if st and st.ent then
		Core.despawn(st.ent, false)
	end
	teams[player] = nil
end

function Companions.init()
	Core.hooks.teamOf = Companions.teamEntities
	Core.hooks.reviveTeam = Companions.reviveTeam
	Net.get("Cast").OnServerEvent:Connect(Companions.cast)
	Net.get("Switch").OnServerEvent:Connect(Companions.switch)
	Net.get("Dodge").OnServerEvent:Connect(Companions.dodge)
end

Companions.Players = Players
return Companions
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX8FDAFF1BADF3474BBC41B7171EEC31B1">
				<Properties>
					<string name="Name">CreatureFactory</string>
					<ProtectedString name="Source"><![CDATA[-- Construye el modelo de una criatura listo para moverse por física.
--
-- Usa los modelos importados desde los .obj del paquete de arte (ServerStorage >
-- CreatureModels > Hidra, Fenix, ...). Las piezas se reconocen por su nombre
-- (Cuerpo, Cuerpo2, Hueso, Brillo, Ojos, Plumas, Plumaje, Membrana, Cristal,
-- CristalTenue, Estrellas, Oscuro) y reciben automáticamente material Neon y el
-- color del elemento, como indica el LEEME. Si un modelo aún no se ha importado,
-- se crea una figura provisional para que el juego funcione igualmente.
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameData = require(Shared.GameData)
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local World = require(script.Parent.WorldService)

local Factory = {}

local FLYERS = { fenix = true, grifo = true, wyvern = true, leviatan = true }
Factory.FLYERS = FLYERS

-- giro para que el frente de los .obj (+Z) mire hacia el frente de Roblox (−Z)
Config.ModelYawOffset = Config.ModelYawOffset or 180

local modelsFolder = ServerStorage:FindFirstChild("CreatureModels")
if not modelsFolder then
	modelsFolder = Instance.new("Folder")
	modelsFolder.Name = "CreatureModels"
	modelsFolder.Parent = ServerStorage
end

local function findTemplate(fileName)
	local lower = string.lower(fileName)
	for _, child in ipairs(modelsFolder:GetChildren()) do
		if string.lower(child.Name) == lower or string.find(string.lower(child.Name), lower, 1, true) == 1 then
			return child
		end
	end
	return nil
end

function Factory.hasImported(id)
	local c = GameData.CreatureById[id]
	return findTemplate(c.file) ~= nil
end

-- tipo de pieza a partir de su nombre
local function classify(name)
	local n = string.lower(name)
	if string.find(n, "cristaltenue", 1, true) then
		return "tenue"
	end
	for _, k in ipairs({ "brillo", "estrellas" }) do
		if string.find(n, k, 1, true) then
			return "glow"
		end
	end
	if string.find(n, "ojos", 1, true) then
		return "eyes"
	end
	if string.find(n, "plumaje", 1, true) then
		return "plumaje"
	end
	if string.find(n, "plumas", 1, true) or string.find(n, "cristal", 1, true) then
		return "glow"
	end
	if string.find(n, "hueso", 1, true) then
		return "bone"
	end
	if string.find(n, "cuerpo2", 1, true) then
		return "body2"
	end
	if string.find(n, "membrana", 1, true) then
		return "membrane"
	end
	if string.find(n, "oscuro", 1, true) then
		return "dark"
	end
	return "body"
end

local function scaleColor(c, k)
	return Color3.new(math.min(1, c.R * k), math.min(1, c.G * k), math.min(1, c.B * k))
end

-- Pinta las piezas. glowStr es "#rrggbb", "prisma" o "aurora".
function Factory.paint(model, def, glowStr, t)
	local glow = Formulas.resolveColor(glowStr, t or 0)
	local body = Color3.fromHex(def.body)
	local bone = Color3.fromHex(def.bone)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "Root" and not p:GetAttribute("CircleRing") then
			local kind = p:GetAttribute("PartKind") or classify(p.Name)
			p:SetAttribute("PartKind", kind)
			if kind == "glow" then
				p.Material = Enum.Material.Neon
				p.Color = glow
			elseif kind == "eyes" then
				p.Material = Enum.Material.Neon
				p.Color = glow:Lerp(Color3.new(1, 1, 1), 0.55)
			elseif kind == "tenue" then
				p.Material = Enum.Material.Neon
				p.Color = glow
				p.Transparency = 0.45
			elseif kind == "bone" then
				p.Material = Enum.Material.SmoothPlastic
				p.Color = bone
			elseif kind == "body2" then
				p.Material = Enum.Material.Slate
				p.Color = scaleColor(body, 1.18)
			elseif kind == "plumaje" then
				p.Material = Enum.Material.SmoothPlastic
				p.Color = scaleColor(body, 1.22)
			elseif kind == "membrane" then
				p.Material = Enum.Material.SmoothPlastic
				p.Color = scaleColor(body, 1.1)
			elseif kind == "dark" then
				p.Material = Enum.Material.Slate
				p.Color = scaleColor(body, 0.6)
			else
				p.Material = Enum.Material.Slate
				p.Color = body
			end
		end
	end
end

-- figura provisional (si el modelo no se ha importado todavía)
local function placeholder(def)
	local m = Instance.new("Model")
	m.Name = def.file
	local function add(name, shape, size, cf)
		local p = Instance.new("Part")
		p.Name = name
		p.Shape = shape
		p.Size = size
		p.CFrame = cf
		p.Anchored = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = m
		return p
	end
	local role = def.role
	local w = (role == "tanque") and 3.2 or 2.4
	add("Cuerpo", Enum.PartType.Ball, Vector3.new(w, w * 0.9, w * 1.3), CFrame.new(0, 1.9, 0))
	add("Cuerpo2", Enum.PartType.Ball, Vector3.new(1.7, 1.5, 1.8), CFrame.new(0, 3.2, -1.3))
	add("Ojos", Enum.PartType.Ball, Vector3.new(0.35, 0.35, 0.35), CFrame.new(0.42, 3.4, -2.15))
	add("Ojos", Enum.PartType.Ball, Vector3.new(0.35, 0.35, 0.35), CFrame.new(-0.42, 3.4, -2.15))
	add("Brillo", Enum.PartType.Block, Vector3.new(0.15, 0.15, w * 1.2), CFrame.new(0, 1.9 + w * 0.46, 0))
	add("Brillo", Enum.PartType.Block, Vector3.new(w * 0.95, 0.15, 0.15), CFrame.new(0, 1.9, 0) * CFrame.Angles(0, 0, math.rad(20)))
	for _, sx in ipairs({ -1, 1 }) do
		add("Hueso", Enum.PartType.Block, Vector3.new(0.5, 1.4, 0.5), CFrame.new(sx * w * 0.32, 0.7, -0.6))
		add("Hueso", Enum.PartType.Block, Vector3.new(0.5, 1.4, 0.5), CFrame.new(sx * w * 0.32, 0.7, 0.7))
		if FLYERS[def.id] then
			add("Plumas", Enum.PartType.Wedge, Vector3.new(0.2, 1.4, 3.2), CFrame.new(sx * (w * 0.5 + 1.4), 2.6, 0.2) * CFrame.Angles(0, 0, math.rad(-sx * 70)))
		end
	end
	add("Hueso", Enum.PartType.Block, Vector3.new(0.35, 0.9, 0.35), CFrame.new(0.35, 4.2, -1.2) * CFrame.Angles(math.rad(-20), 0, math.rad(-15)))
	add("Hueso", Enum.PartType.Block, Vector3.new(0.35, 0.9, 0.35), CFrame.new(-0.35, 4.2, -1.2) * CFrame.Angles(math.rad(-20), 0, math.rad(15)))
	m:SetAttribute("Placeholder", true)
	return m
end

-- Construye el modelo. opts: form (1..3), boss, glow ("#hex"/"prisma"/"aurora"), seal (diseño), circle (bool)
function Factory.build(id, opts)
	opts = opts or {}
	local def = GameData.CreatureById[id]
	local template = findTemplate(def.file)
	local model
	if template then
		model = template:Clone()
		if not model:IsA("Model") then
			local wrap = Instance.new("Model")
			model.Parent = wrap
			model = wrap
		end
	else
		model = placeholder(def)
	end
	model.Name = def.file
	pcall(function()
		model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Humanoid") then
			d:Destroy()
		end
	end
	Factory.paint(model, def, opts.glow or def.color, 0)

	-- girar para que mire hacia −Z y escalar a la altura de su forma
	local pivot = model:GetPivot()
	model:PivotTo(CFrame.new(pivot.Position) * CFrame.Angles(0, math.rad(Config.ModelYawOffset), 0))
	local size = model:GetExtentsSize()
	local target = opts.boss and Config.BossHeight or Config.FormHeights[opts.form or 1]
	if size.Y > 0.01 then
		model:ScaleTo(model:GetScale() * (target / size.Y))
	end
	local cf, ext = model:GetBoundingBox()
	local bottom = cf.Position - Vector3.new(0, ext.Y / 2, 0)

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1)
	root.Transparency = 1
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.CFrame = CFrame.new(bottom)
	root.Parent = model
	model.PrimaryPart = root

	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p ~= root then
			p.Anchored = false
			p.CanCollide = false
			p.CanTouch = false
			p.Massless = true
			p.CastShadow = true
			local wc = Instance.new("WeldConstraint")
			wc.Part0 = root
			wc.Part1 = p
			wc.Parent = p
		end
	end

	-- círculo mágico bajo sus patas
	local radius = math.max(ext.X, ext.Z) * 0.62
	if opts.circle ~= false then
		local glow = Formulas.resolveColor(opts.glow or def.color, 0)
		local circle = World.magicCircle(model, bottom, radius, glow, opts.seal or def.circle, opts.circleIntensity or 0.85)
		circle.Name = "Circulo"
		for _, p in ipairs(circle:GetDescendants()) do
			if p:IsA("BasePart") then
				p.Anchored = false
				p.Massless = true
				p.CastShadow = false
				p:SetAttribute("CircleRing", true)
				local wc = Instance.new("WeldConstraint")
				wc.Part0 = root
				wc.Part1 = p
				wc.Parent = p
			end
		end
	end

	-- halo de la Hidra y el Fénix
	if def.halo then
		local glow = Formulas.resolveColor(opts.glow or def.color, 0)
		local halo = Instance.new("Part")
		halo.Name = "Halo"
		halo.Shape = Enum.PartType.Cylinder
		halo.Size = Vector3.new(0.12, ext.Y * 0.55, ext.Y * 0.55)
		halo.CFrame = CFrame.new(bottom + Vector3.new(0, ext.Y * 0.8, 0)) * CFrame.new(0, 0, ext.Z * 0.25) * CFrame.Angles(0, math.rad(90), 0)
		halo.Material = Enum.Material.Neon
		halo.Color = glow
		halo.Transparency = 0.55
		halo.Anchored = false
		halo.CanCollide = false
		halo.CanQuery = false
		halo.Massless = true
		halo:SetAttribute("PartKind", "glow")
		halo.Parent = model
		local wc = Instance.new("WeldConstraint")
		wc.Part0 = root
		wc.Part1 = halo
		wc.Parent = halo
	end

	-- luz del elemento
	local light = Instance.new("PointLight")
	light.Color = Formulas.resolveColor(opts.glow or def.color, 0)
	light.Range = math.clamp(ext.Y * 2.2, 10, 40)
	light.Brightness = opts.boss and 3 or 1.6
	light.Shadows = false
	light.Parent = root

	-- movimiento por física (suave en todos los clientes)
	local att = Instance.new("Attachment")
	att.Parent = root
	local ap = Instance.new("AlignPosition")
	ap.Mode = Enum.PositionAlignmentMode.OneAttachment
	ap.Attachment0 = att
	ap.MaxForce = 1e7
	ap.MaxVelocity = 60
	ap.Responsiveness = 45
	ap.Parent = root
	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.MaxTorque = 1e7
	ao.Responsiveness = 25
	ao.Parent = root

	model:SetAttribute("CreatureId", id)
	model:SetAttribute("Glow", opts.glow or def.color)
	model:SetAttribute("Height", ext.Y)
	model:SetAttribute("Radius", radius)
	CollectionService:AddTag(model, "SA_Creature")
	return model, root, ap, ao, { height = ext.Y, radius = radius, flyer = FLYERS[id] == true }
end

return Factory
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX8664CB0C1124468F8B4E54BD2A83D753">
				<Properties>
					<string name="Name">DataService</string>
					<ProtectedString name="Source"><![CDATA[-- Perfiles de jugador en DataStore: carga con bloqueo de sesión (evita
-- duplicar progreso al cambiar de servidor), autoguardado y guardado al salir.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local GameData = require(Shared.GameData)
local Net = require(Shared.Net)

local DataService = {}

local store = nil
local okStore = pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)
if not okStore then
	warn("[Sellos Arcanos] DataStore no disponible (activa «Studio Access to API Services» para probar el guardado en Studio).")
end

local profiles = {}
local dirty = {}
local LOCK_SECONDS = 1800
local jobId = game.JobId ~= "" and game.JobId or "studio"

local function today()
	return os.date("!%Y-%m-%d")
end
DataService.today = today

local function fresh()
	local bestiary = {}
	for _, c in ipairs(GameData.Creatures) do
		bestiary[c.id] = { seen = false, forms = { false, false, false } }
	end
	return {
		v = 1,
		created = os.time(),
		starterChosen = false,
		rankXp = 0,
		essence = 300,
		crystals = 0,
		ink = Config.InkMax,
		inkTs = os.time(),
		fragments = {},
		creatures = {}, -- id -> {form, level, xp, bond, bondXp, tint}
		team = {},
		bestiary = bestiary,
		islands = { unlocked = 1, cleared = {} },
		cosmetics = { tints = {}, seals = { "propio" }, effects = { "anillo" }, seal = "propio", effect = "anillo" },
		daily = { day = 0, last = "" },
		contracts = { date = "", list = {} },
		pass = { season = 1, xp = 0, premium = false, free = {}, prem = {} },
		purchases = { receipts = {}, founder = false },
		perks = { lastPremiumGift = "", lastVipGift = "", group = false },
		codes = {}, -- código -> fecha en que se canjeó
		stats = { seals = 0, perfect = 0, kills = 0, bosses = 0, ults = 0 },
		titles = {},
		milestones = {},
		settings = { music = 0.5, sfx = 0.8 },
	}
end
DataService.fresh = fresh

-- completa campos nuevos sin perder los existentes
local function reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			data[k] = v
		elseif type(v) == "table" and type(data[k]) == "table" and #v == 0 and next(v) ~= nil then
			reconcile(data[k], v)
		end
	end
	return data
end

local function key(player)
	return "u_" .. player.UserId
end

function DataService.tickInk(p)
	local now = os.time()
	if p.ink >= Config.InkMax then
		p.inkTs = now
		return
	end
	local gained = math.floor((now - p.inkTs) / Config.InkSeconds)
	if gained > 0 then
		p.ink = math.min(Config.InkMax, p.ink + gained)
		p.inkTs = p.inkTs + gained * Config.InkSeconds
		if p.ink >= Config.InkMax then
			p.inkTs = now
		end
	end
end

function DataService.load(player)
	local data = nil
	if store then
		for attempt = 1, 4 do
			local ok, err = pcall(function()
				store:UpdateAsync(key(player), function(old)
					old = old or { data = nil, lock = nil }
					if old.lock and old.lock.job ~= jobId and os.time() - old.lock.t < LOCK_SECONDS and attempt < 4 then
						-- otro servidor lo tiene abierto: reintentamos más tarde
						data = "locked"
						return nil
					end
					data = old.data
					old.lock = { job = jobId, t = os.time() }
					return old
				end)
			end)
			if ok and data ~= "locked" then
				break
			end
			if not ok then
				warn("[Sellos Arcanos] error al cargar", err)
			end
			data = nil
			task.wait(2 * attempt)
		end
	end
	if data == "locked" then
		data = nil
	end
	local profile = reconcile(type(data) == "table" and data or fresh(), fresh())
	DataService.tickInk(profile)
	profiles[player] = profile
	return profile
end

function DataService.save(player, release)
	local profile = profiles[player]
	if not profile or not store then
		return
	end
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function(old)
			old = old or {}
			old.data = profile
			if release then
				old.lock = nil
			else
				old.lock = { job = jobId, t = os.time() }
			end
			return old
		end)
	end)
	if not ok then
		warn("[Sellos Arcanos] error al guardar", err)
	end
	dirty[player] = nil
end

function DataService.get(player)
	return profiles[player]
end

-- Envía al cliente el perfil (o la parte que necesita la interfaz).
function DataService.sync(player)
	local p = profiles[player]
	if p then
		dirty[player] = true
		Net.get("ProfileSync"):FireClient(player, p)
	end
end

function DataService.release(player)
	DataService.save(player, true)
	profiles[player] = nil
end

function DataService.init()
	-- autoguardado cada 60 s y recarga de Tinta
	task.spawn(function()
		while true do
			task.wait(60)
			for player, p in pairs(profiles) do
				local before = p.ink
				DataService.tickInk(p)
				if p.ink ~= before then
					DataService.sync(player)
				end
				if dirty[player] then
					task.spawn(DataService.save, player, false)
				end
			end
		end
	end)
	game:BindToClose(function()
		local list = {}
		for player in pairs(profiles) do
			table.insert(list, player)
		end
		for _, player in ipairs(list) do
			task.spawn(DataService.save, player, true)
		end
		task.wait(3)
	end)
end

DataService.Players = Players
return DataService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX663C2525030D4CC4864816D5540E15E4">
				<Properties>
					<string name="Name">Encounters</string>
					<ProtectedString name="Source"><![CDATA[-- Encuentros: criaturas salvajes de cada isla (con IA y avisos en el suelo),
-- jefes Primordiales de tres fases con cuatro anclas rúnicas, sellado validado
-- en el servidor, recompensas y viajes entre la Ciudadela y las islas.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameData = require(Shared.GameData)
local Formulas = require(Shared.Formulas)
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Core = require(script.Parent.CombatCore)
local DataService = require(script.Parent.DataService)
local Progression = require(script.Parent.ProgressionService)
local Companions = require(script.Parent.Companions)
local World = require(script.Parent.WorldService)

local Encounters = {}
local wild = {} -- island -> {entities}
local respawnAt = {} -- island -> lista de tiempos
local bosses = {} -- island -> estado del jefe
local emptySince = {} -- island -> tiempo sin jugadores

local function playersOn(island)
	local list = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl:GetAttribute("Island") == island then
			table.insert(list, pl)
		end
	end
	return list
end

local function banner(island, key, vars, kind)
	for _, pl in ipairs(playersOn(island)) do
		Net.get("Banner"):FireClient(pl, key, vars or {}, kind or "")
	end
end

-- --- viajes ------------------------------------------------------------------
function Encounters.teleport(player, pos)
	local ch = player.Character
	if not ch then
		return
	end
	pcall(function()
		player:RequestStreamAroundAsync(pos, 5)
	end)
	ch:PivotTo(CFrame.new(pos))
	player:SetAttribute("Island", World.islandAt(pos))
end

function Encounters.toHub(player)
	Encounters.teleport(player, World.Hub.spawn)
end
Companions.toHub = Encounters.toHub

local function onPortal(player, prompt)
	local idx = prompt:GetAttribute("IslandIndex")
	local p = DataService.get(player)
	if not p or not idx then
		return
	end
	if not p.starterChosen then
		Progression.toast(player, "chooseFirstToast", {}, "")
		return
	end
	if idx > p.islands.unlocked then
		local prev = GameData.Islands[idx - 1]
		Progression.toast(player, "portalLocked", { isle = prev and prev.index or 1 }, "bad")
		return
	end
	Encounters.teleport(player, World.Islands[idx].spawn)
	Net.get("Banner"):FireClient(player, "islandEnter", { i = idx }, "island")
end

-- --- criaturas salvajes ---------------------------------------------------------
local function spawnWild(island)
	local isl = GameData.Islands[island]
	local w = World.Islands[island]
	local id = isl.pool[math.random(1, #isl.pool)]
	local lvl = math.random(isl.levels[1], isl.levels[2])
	local a = math.random() * math.pi * 2
	local r = math.random() * w.wildRadius
	local pos = World.clampToIsland(island, w.wildCenter + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), 10)
	local ent = Core.spawn({ creature = id, kind = "wild", level = lvl, form = 1, island = island, pos = pos, facing = math.random() * 6.28 })
	ent.home = pos
	table.insert(wild[island], ent)
	return ent
end

local function nearestCompanion(e, range)
	local best, bd = nil, range
	for _, o in pairs(Core.entities) do
		if o.alive and o.kind == "companion" and o.island == e.island then
			local d = Core.dist(o.pos, e.pos)
			if d < bd then
				best, bd = o, d
			end
		end
	end
	return best, bd
end

local TELEGRAPHED = { cone = true, aoe = true, dash = true, zone = true, revive = true }

local function aiStep(e, dt)
	if not e.alive or Core.stunned(e) or e.sealingBy then
		e.moving = false
		return
	end
	-- objetivo
	if e.target and (not e.target.alive or e.target.island ~= e.island) then
		e.target = nil
	end
	if not e.target then
		e.target = nearestCompanion(e, e.boss and 200 or Config.AggroRange)
	end
	-- correa: si se aleja demasiado vuelve a casa y se recupera
	if not e.boss and Core.dist(e.pos, e.home) > Config.LeashRange then
		e.target = nil
		e.returning = true
	end
	local t = e.target
	if e.windup then
		e.windup.t = e.windup.t - dt
		e.moving = false
		e.facing = math.atan2(-e.windup.dir.X, -e.windup.dir.Z)
		if e.windup.t <= 0 then
			local w = e.windup
			e.windup = nil
			Core.cast(e, w.ab, { dir = w.dir, pos = w.pos, target = t })
		end
		return
	end
	local speed = e.stats.speed * Core.speedMul(e) * (e.boss and 0.7 or 0.62)
	if not t then
		-- deambular cerca de casa
		e.wanderT = (e.wanderT or 0) - dt
		if e.returning or e.wanderT <= 0 or not e.wanderGoal then
			if e.returning then
				e.wanderGoal = e.home
				if Core.dist(e.pos, e.home) < 4 then
					e.returning = false
					e.hp = e.maxHp
					e.sealable = false
					e.model:SetAttribute("HP", e.hp)
					e.model:SetAttribute("Sealable", false)
				end
			else
				local a = math.random() * math.pi * 2
				e.wanderGoal = World.clampToIsland(e.island, e.home + Vector3.new(math.cos(a) * 16, 0, math.sin(a) * 16), 8)
				e.wanderT = 3 + math.random() * 4
			end
		end
		local d = Core.flat(e.wanderGoal - e.pos)
		if d.Magnitude > 1.5 and not Core.rooted(e) then
			e.pos = e.pos + d.Unit * math.min(d.Magnitude, speed * (e.returning and 2 or 0.45) * dt)
			e.facing = math.atan2(-d.Unit.X, -d.Unit.Z)
			e.moving = true
		else
			e.moving = false
		end
		return
	end
	local toP = Core.dirTo(e.pos, t.pos)
	local distT = Core.dist(e.pos, t.pos)
	local first = e.def.abilities[1]
	local meleeish = first.type == "melee" or first.type == "dash"
	local want = (meleeish and 5 or 18) + e.radius + t.radius
	e.aiGcd = e.aiGcd - dt
	if e.aiGcd <= 0 and e.castLock <= 0 and not e.dash then
		local keys = e.boss and { "f", "r", "e", "q" } or (e.form >= 2 and { "r", "e", "q" } or { "e", "q" })
		for _, k in ipairs(keys) do
			local ab = e.def.abilityByKey[k]
			local ready = ab and ((k == "f" and e.seal >= 100) or (k ~= "f" and e.cds[k] <= 0))
			local inRange = ab and (ab.type == "heal" or ab.type == "shield" or ab.type == "buff" or distT <= (ab.range or 14) + t.radius + 2)
			if ab and ab.type == "heal" and e.hp / e.maxHp > 0.6 then
				inRange = false
			end
			if ready and inRange then
				if k == "f" then
					e.seal = 0
				else
					local phase = e.bossPhase or 1
					e.cds[k] = ab.cd * (e.boss and (phase >= 2 and 1.3 or 1.6) or 2.2)
				end
				local wind = e.boss and ((e.bossPhase or 1) >= 3 and 0.5 or 0.65) or 0.75
				local pos = t.pos
				if TELEGRAPHED[ab.type] or k == "f" then
					e.windup = { ab = ab, dir = toP, pos = pos, t = wind }
					if ab.type == "cone" then
						Core.fx(e.island, { t = "tele", p = e.pos, r = ab.range, cone = ab.arc, d = toP, time = wind, c = "#ff3355" })
					elseif ab.type == "dash" then
						Core.fx(e.island, { t = "tele", p = e.pos, len = ab.range, w = ab.width * 1.6, d = toP, time = wind, c = "#ff3355" })
					elseif ab.type == "aoe" then
						Core.fx(e.island, { t = "tele", p = (ab.range and ab.range > 0) and pos or e.pos, r = ab.radius, time = wind, c = "#ff3355" })
					elseif ab.type == "zone" then
						Core.fx(e.island, { t = "tele", p = pos, r = ab.radius, time = wind, c = "#ff3355" })
					else
						Core.fx(e.island, { t = "tele", p = e.pos, r = ab.radius or 12, time = wind, c = "#ff3355" })
					end
				elseif ab.type == "melee" or ab.type == "projectile" then
					e.windup = { ab = ab, dir = toP, pos = pos, t = 0.28 }
				else
					Core.cast(e, ab, { dir = toP, pos = pos, target = t })
				end
				e.aiGcd = e.boss and ((e.bossPhase or 1) >= 2 and 0.9 or 1.2) or (1.4 + math.random() * 1.2)
				if e.boss then
					e.seal = math.min(100, e.seal + 12)
				end
				return
			end
		end
	end
	if Core.rooted(e) or e.dash then
		e.moving = false
		return
	end
	local mv = Vector3.zero
	if distT > want + 1 then
		mv = toP
	elseif distT < want - 4 then
		mv = -toP
	end
	if not e.boss then
		mv = mv + Vector3.new(-toP.Z, 0, toP.X) * e.strafe * 0.5
		if math.random() < dt * 0.3 then
			e.strafe = -e.strafe
		end
	end
	if mv.Magnitude > 0.01 then
		e.pos = e.pos + mv.Unit * speed * dt
		e.moving = true
	else
		e.moving = false
	end
	e.facing = math.atan2(-toP.X, -toP.Z)
end

-- --- recompensas ------------------------------------------------------------------
local function giveTeamXp(player, xp)
	local p = DataService.get(player)
	local st = Companions.state(player)
	local ups = {}
	for i, id in ipairs(p.team) do
		local own = p.creatures[id]
		if own then
			local share = (st and st.active == i) and 1 or 0.5
			local n = Progression.giveXp(own, xp * share)
			Progression.addBond(own, share >= 1 and 2 or 1)
			if n > 0 then
				table.insert(ups, { id = id, level = own.level })
			end
		end
	end
	if #ups > 0 then
		Companions.refreshLevels(player)
		for _, u in ipairs(ups) do
			Progression.toast(player, "levelUp", { id = u.id, n = u.level }, "gold")
		end
	end
end

local function rewardKill(e)
	local total = 0
	for _, dmg in pairs(e.contributors) do
		total = total + dmg
	end
	for player, dmg in pairs(e.contributors) do
		if player.Parent and DataService.get(player) and dmg >= total * 0.1 then
			local p = DataService.get(player)
			local xp = 10 + e.level * 6
			local ess = 15 + e.level * 4
			p.essence = p.essence + ess
			p.stats.kills = p.stats.kills + 1
			giveTeamXp(player, xp)
			Progression.addRankXp(player, xp * 0.6)
			Progression.addPassXp(player, 4)
			Progression.progress(player, "kills")
			Net.get("Reward"):FireClient(player, { essence = ess, xp = xp })
			DataService.sync(player)
		end
	end
end

-- --- jefes Primordiales ----------------------------------------------------------
local function spawnAnchor(b, pos)
	local color = Color3.fromHex(b.ent.def.color)
	local p = World.part({
		Size = Vector3.new(3.5, 11, 3.5),
		CFrame = CFrame.new(pos + Vector3.new(0, 8, 0)) * CFrame.Angles(0, math.rad(45), 0),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.15,
		CanCollide = false,
	})
	p.Name = "AnclaRunica"
	local m = Instance.new("Model")
	m.Name = "AnclaRunica"
	p.Parent = m
	local beam = World.part({ Size = Vector3.new(0.4, 0.4, (pos - b.ent.pos).Magnitude), CFrame = CFrame.lookAt((pos + b.ent.pos) / 2 + Vector3.new(0, 6, 0), b.ent.pos + Vector3.new(0, 6, 0)), Color = color, Material = Enum.Material.Neon, Transparency = 0.4, CanCollide = false, CanQuery = false })
	beam.Parent = m
	local hp = math.floor(b.ent.maxHp * 0.045)
	m:SetAttribute("HP", hp)
	m:SetAttribute("MaxHP", hp)
	m:SetAttribute("Kind", "anchor")
	m:SetAttribute("Island", b.island)
	m:SetAttribute("CreatureId", b.ent.creature)
	m.Parent = workspace:FindFirstChild("Criaturas")
	local a = {
		id = "a" .. tostring(math.random(1, 1e9)), kind = "anchor", alive = true, island = b.island, pos = pos, radius = 3,
		height = 12, hp = hp, maxHp = hp, def = b.ent.def, statuses = {}, buffs = {}, shield = 0, shieldT = 0, reflect = 0,
		iframes = 0, knock = Vector3.zero, contributors = {}, model = m, stats = b.ent.stats, level = b.ent.level, form = 1,
	}
	m:SetAttribute("EntityId", a.id)
	Core.entities[a.id] = a
	table.insert(b.anchors, a)
end

function Encounters.startBoss(player, island)
	if bosses[island] then
		return
	end
	local p = DataService.get(player)
	if not p or not p.starterChosen then
		return
	end
	local isl = GameData.Islands[island]
	local w = World.Islands[island]
	local nPlayers = math.max(1, #playersOn(island))
	local ent = Core.spawn({ creature = isl.boss, kind = "boss", level = isl.levels[2], form = 3, boss = true, island = island, pos = w.bossArena, facing = math.atan2(w.toHub.X, w.toHub.Z) })
	local mult = 1 + 0.5 * (nPlayers - 1)
	ent.maxHp = math.floor(ent.maxHp * mult)
	ent.hp = ent.maxHp
	ent.home = w.bossArena
	ent.bossPhase = 1
	ent.aiGcd = 2.5
	ent.model:SetAttribute("HP", ent.hp)
	ent.model:SetAttribute("MaxHP", ent.maxHp)
	bosses[island] = { ent = ent, island = island, anchors = {}, lastNear = Core.time }
	Core.fx(island, { t = "pillar", p = ent.pos, c = ent.def.color, h = 60 })
	Core.fx(island, { t = "roar", p = ent.pos })
	banner(island, "bossAppears", { id = ent.creature }, "boss")
	w.bossPrompt.Enabled = false
end

local function endBoss(island)
	local b = bosses[island]
	if not b then
		return
	end
	for _, a in ipairs(b.anchors) do
		if a.model then
			a.model:Destroy()
		end
		Core.entities[a.id] = nil
	end
	if b.ent.alive then
		Core.despawn(b.ent, true)
	end
	for _, add in ipairs(b.adds or {}) do
		if add.alive then
			Core.despawn(add, true)
		end
	end
	bosses[island] = nil
	World.Islands[island].bossPrompt.Enabled = true
end

local function bossStep(island, b, dt)
	local e = b.ent
	if not e.alive then
		endBoss(island)
		return
	end
	local near = nearestCompanion(e, 220)
	if near then
		b.lastNear = Core.time
	elseif Core.time - b.lastNear > 40 then
		endBoss(island)
		return
	end
	local k = e.hp / e.maxHp
	if e.bossPhase == 1 and k < 0.66 then
		e.bossPhase = 2
		banner(island, "phase", { n = 2 }, "boss")
		Core.fx(island, { t = "roar", p = e.pos })
		b.adds = {}
		local pool = GameData.Islands[island].pool
		for i = 1, 2 do
			local id = pool[(i % #pool) + 1]
			local a = math.random() * math.pi * 2
			local add = Core.spawn({ creature = id, kind = "wild", level = math.max(1, e.level - 4), form = 1, island = island, pos = World.clampToIsland(island, e.pos + Vector3.new(math.cos(a) * 24, 0, math.sin(a) * 24), 8) })
			add.home = add.pos
			add.noRespawn = true
			table.insert(b.adds, add)
		end
	elseif e.bossPhase == 2 and k < 0.34 then
		e.bossPhase = 3
		e.invuln = true
		e.model:SetAttribute("Invuln", true)
		banner(island, "anchors", {}, "boss")
		Core.fx(island, { t = "roar", p = e.pos })
		for i = 0, 3 do
			local a = math.pi / 4 + i * math.pi / 2
			spawnAnchor(b, World.clampToIsland(island, e.pos + Vector3.new(math.cos(a) * 28, 0, math.sin(a) * 28), 6))
		end
	end
	if e.sealingBy and Core.time > (e.sealDeadline or 0) then
		Encounters.resolveSeal(e.sealingBy, e, { done = false })
	end
end

-- --- caídas ------------------------------------------------------------------------
function Encounters.onDown(e, src)
	if e.kind == "anchor" then
		e.alive = false
		Core.entities[e.id] = nil
		Core.fx(e.island, { t = "burst", p = e.pos + Vector3.new(0, 8, 0), c = e.def.color, n = 40 })
		if e.model then
			e.model:Destroy()
		end
		local b = bosses[e.island]
		if b then
			local left = 0
			for _, a in ipairs(b.anchors) do
				if a.alive then
					left = left + 1
				end
			end
			if left == 0 then
				b.ent.invuln = false
				b.ent.phaseReady3 = true
				b.ent.model:SetAttribute("Invuln", false)
				Core.addStatus(b.ent, { t = "stun", dur = 9 }, e)
				banner(e.island, "anchorsBroken", {}, "gold")
			end
		end
		return
	end
	if e.kind == "companion" then
		Companions.onFaint(e)
		return
	end
	if e.kind == "wild" then
		rewardKill(e)
		Core.despawn(e, true)
		if not e.noRespawn and wild[e.island] then
			table.insert(respawnAt[e.island], Core.time + Config.WildRespawn)
		end
	end
end

-- --- sellado --------------------------------------------------------------------------
local function sealRequest(player, entId)
	local e = Core.entities[entId]
	local p = DataService.get(player)
	if not e or not p or not e.alive or not e.sealable or e.sealingBy then
		return nil
	end
	if player:GetAttribute("Island") ~= e.island then
		return nil
	end
	local st = Companions.state(player)
	local anchor = (st and st.ent and st.ent.pos) or e.pos
	if Core.dist(anchor, e.pos) > 90 then
		return nil
	end
	if not e.boss then
		DataService.tickInk(p)
		if p.ink <= 0 then
			return { error = "noInk" }
		end
		if p.ink >= Config.InkMax then
			p.inkTs = os.time()
		end
		p.ink = p.ink - 1
		DataService.sync(player)
	end
	local nodes = e.boss and 9 or math.clamp(e.def.nodes - 2 + math.floor((e.island - 1) / 4), 4, 7)
	local time = e.boss and 7 or 5
	e.sealingBy = player
	e.invuln = true
	e.sealStart = Core.time
	e.sealDeadline = Core.time + time + 6
	e.sealNodes = nodes
	e.sealTime = time
	return { nodes = nodes, time = time, moving = e.boss or e.form >= 2, color = e.model:GetAttribute("Glow") or e.def.color, id = e.creature, boss = e.boss, seed = math.random(1, 100000) }
end

function Encounters.resolveSeal(player, e, result)
	if not e or e.sealingBy ~= player then
		return
	end
	e.sealingBy = nil
	e.invuln = false
	local elapsed = Core.time - (e.sealStart or Core.time)
	local done = type(result) == "table" and result.done == true and elapsed >= e.sealNodes * 0.12
	local errors = (type(result) == "table" and tonumber(result.errors)) or 3
	if not done then
		Core.heal(e, e.maxHp * 0.1, false)
		if e.hp / e.maxHp >= 0.25 then
			e.sealable = false
			e.model:SetAttribute("Sealable", false)
		end
		Core.fx(e.island, { t = "dmg", p = e.pos + Vector3.new(0, e.height + 1, 0), v = 0, k = "resist" })
		return
	end
	local perfect = errors == 0 and elapsed <= e.sealTime * (e.boss and 0.75 or 0.65) + 1
	e.sealed = true
	Core.fx(e.island, { t = "sealed", p = e.pos, c = e.model:GetAttribute("Glow") or e.def.color, h = e.height })
	-- recompensas: quien sella; en los jefes, todos los participantes
	local winners = {}
	if e.boss then
		for _, pl in ipairs(playersOn(e.island)) do
			local st = Companions.state(pl)
			if (st and st.ent and Core.dist(st.ent.pos, e.pos) < 160) or e.contributors[pl] then
				table.insert(winners, pl)
			end
		end
		if not table.find(winners, player) then
			table.insert(winners, player)
		end
	else
		winners = { player }
	end
	for _, pl in ipairs(winners) do
		local p = DataService.get(pl)
		if p then
			local summary = { sealed = e.creature, perfect = perfect and pl == player, boss = e.boss }
			local ess = math.floor((25 + e.level * 6) * ((perfect and pl == player) and 1.5 or 1))
			local xp = math.floor((10 + e.level * 6) * 1.2)
			if e.boss then
				ess = ess + 600 + e.level * 25
				xp = xp + 200 + e.level * 20
				local isl = e.island
				local el = e.def.el
				local first = not table.find(p.islands.cleared, isl)
				local frags = first and 12 or 6
				p.fragments[el] = (p.fragments[el] or 0) + frags
				summary.fragments = frags
				if first then
					table.insert(p.islands.cleared, isl)
					p.stats.bosses = p.stats.bosses + 1
					p.crystals = p.crystals + 25
					summary.crystals = 25
					if isl < #GameData.Islands and p.islands.unlocked < isl + 1 then
						p.islands.unlocked = isl + 1
						summary.unlocked = isl + 1
					end
				end
				Progression.progress(pl, "boss")
				-- el Primordial sellado se une como Cría si no la tenías
				local res = Progression.addCreature(pl, e.creature, GameData.Islands[isl].levels[1], perfect and pl == player)
				summary.isNew = res.isNew
				Progression.addPassXp(pl, 40)
			else
				local res = Progression.addCreature(pl, e.creature, e.level, perfect)
				summary.isNew = res.isNew
				summary.fragments = res.fragments
				Progression.addPassXp(pl, 10)
			end
			p.essence = p.essence + ess
			summary.essence = ess
			summary.xp = xp
			p.stats.seals = p.stats.seals + 1
			if perfect and pl == player then
				p.stats.perfect = p.stats.perfect + 1
				Progression.progress(pl, "perfect")
			end
			Progression.progress(pl, "seal")
			giveTeamXp(pl, xp)
			Progression.addRankXp(pl, xp * 0.6 + 25 + (e.boss and 150 or 0))
			Net.get("Reward"):FireClient(pl, summary)
			DataService.sync(pl)
			if summary.isNew then
				Companions.rebuild(pl, true)
			end
		end
	end
	if e.boss then
		task.delay(1.5, function()
			endBoss(e.island)
		end)
		Core.despawn(e, false)
	else
		Core.despawn(e, false)
		if not e.noRespawn and wild[e.island] then
			table.insert(respawnAt[e.island], Core.time + Config.WildRespawn)
		end
	end
end

-- --- bucle --------------------------------------------------------------------------
function Encounters.step(dt)
	for island = 1, #GameData.Islands do
		local list = wild[island]
		-- limpia muertos
		for i = #list, 1, -1 do
			if not list[i].alive then
				table.remove(list, i)
			end
		end
		local here = #playersOn(island) > 0
		if here then
			emptySince[island] = nil
			local pending = respawnAt[island]
			for i = #pending, 1, -1 do
				if pending[i] <= Core.time then
					table.remove(pending, i)
				end
			end
			if #list + #pending < Config.WildPerIsland then
				spawnWild(island)
			end
		else
			emptySince[island] = emptySince[island] or Core.time
			if Core.time - emptySince[island] > 30 and #list > 0 then
				for _, e in ipairs(list) do
					Core.despawn(e, false)
				end
				wild[island] = {}
				respawnAt[island] = {}
			end
		end
		for _, e in ipairs(wild[island]) do
			if e.alive then
				aiStep(e, dt)
				if e.sealingBy and Core.time > (e.sealDeadline or 0) then
					Encounters.resolveSeal(e.sealingBy, e, { done = false })
				end
			end
		end
		local b = bosses[island]
		if b then
			if b.ent.alive then
				aiStep(b.ent, dt)
			end
			for _, add in ipairs(b.adds or {}) do
				if add.alive then
					aiStep(add, dt)
				end
			end
			bossStep(island, b, dt)
		end
	end
end

function Encounters.init()
	for i = 1, #GameData.Islands do
		wild[i] = {}
		respawnAt[i] = {}
	end
	Core.hooks.onDown = Encounters.onDown
	Core.hooks.onSealable = function(e)
		Core.fx(e.island, { t = "sealable", id = e.id, p = e.pos, c = e.def.color })
	end
	Core.hooks.onAdvantage = function(player)
		Progression.progress(player, "advantage")
	end
	for _, prompt in ipairs(World.Hub.portals) do
		prompt.Triggered:Connect(function(player)
			onPortal(player, prompt)
		end)
	end
	World.Hub.fountain.Triggered:Connect(function(player)
		Companions.restore(player)
		Progression.toast(player, "restored", {}, "good")
	end)
	for i, w in ipairs(World.Islands) do
		w.returnPrompt.Triggered:Connect(function(player)
			Encounters.toHub(player)
			Companions.restore(player)
		end)
		w.bossPrompt.Triggered:Connect(function(player)
			Encounters.startBoss(player, i)
		end)
	end
	Net.get("SealRequest").OnServerInvoke = function(player, entId)
		if type(entId) ~= "string" then
			return nil
		end
		return sealRequest(player, entId)
	end
	Net.get("SealResult").OnServerEvent:Connect(function(player, entId, result)
		local e = type(entId) == "string" and Core.entities[entId] or nil
		if e then
			Encounters.resolveSeal(player, e, result)
		end
	end)
end

Encounters.Formulas = Formulas
return Encounters
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBXCE628E8C83DC48C9AB1A2B6602C33F0D">
				<Properties>
					<string name="Name">Main</string>
					<ProtectedString name="Source"><![CDATA[-- Sellos Arcanos · arranque del servidor
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameData = require(Shared.GameData)
local Net = require(Shared.Net)
Net.init()

local DataService = require(script.Parent.DataService)
local World = require(script.Parent.WorldService)
local Progression = require(script.Parent.ProgressionService)
local Core = require(script.Parent.CombatCore)
local Companions = require(script.Parent.Companions)
local Encounters = require(script.Parent.Encounters)
local Shop = require(script.Parent.ShopService)

World.init()
DataService.init()
Progression.init()
Companions.init()
Encounters.init()
Shop.init()

-- cambios en el perfil que afectan a la criatura en el mundo
local REBUILD = { evolve = true, team = true, leader = true, equip = true, buyCosmetic = true, untint = true }
Progression.onChange = function(player, action)
	if REBUILD[action] then
		Companions.rebuild(player, true)
	elseif action == "train" then
		Companions.refreshLevels(player)
	end
end
Shop.onGranted = function(player)
	Companions.rebuild(player, true)
end

-- elegir la primera criatura
Net.get("ChooseStarter").OnServerEvent:Connect(function(player, id)
	local p = DataService.get(player)
	if not p or p.starterChosen or type(id) ~= "string" or not table.find(GameData.Starters, id) then
		return
	end
	p.creatures[id] = { form = 1, level = 1, xp = 0, bond = 2, bondXp = 0, tint = "" }
	p.bestiary[id].seen = true
	p.bestiary[id].forms[1] = true
	p.team = { id }
	p.starterChosen = true
	DataService.sync(player)
	Companions.rebuild(player, false)
	Progression.toast(player, "goPortal", {}, "gold")
end)

local function onCharacter(player)
	task.wait(0.3)
	player:SetAttribute("Island", 0)
	if DataService.get(player) and DataService.get(player).starterChosen then
		Companions.rebuild(player, true)
		Companions.restore(player)
	end
end

local function onPlayer(player)
	local p = DataService.load(player)
	Progression.ensureContracts(p)
	player:SetAttribute("Island", 0)
	Shop.loadPasses(player)
	Progression.dailyPerks(player, Shop.ownsPass(player, "vip"))
	DataService.sync(player)
	player.CharacterAdded:Connect(function()
		onCharacter(player)
	end)
	if player.Character then
		task.spawn(onCharacter, player)
	end
end

Players.PlayerAdded:Connect(onPlayer)
for _, pl in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayer, pl)
end
Players.PlayerRemoving:Connect(function(player)
	Companions.remove(player)
	DataService.release(player)
end)

-- isla de cada jugador (para enviar efectos solo a quien los ve)
task.spawn(function()
	while true do
		for _, pl in ipairs(Players:GetPlayers()) do
			local ch = pl.Character
			local root = ch and ch:FindFirstChild("HumanoidRootPart")
			if root then
				local island = World.islandAt(root.Position)
				if island ~= nil and pl:GetAttribute("Island") ~= island then
					pl:SetAttribute("Island", island)
					if island == 0 then
						Companions.restore(pl)
					end
				end
			end
		end
		task.wait(0.5)
	end
end)

-- bucle de simulación a 20 Hz
local STEP = 1 / 20
local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc = acc + math.min(dt, 0.25)
	while acc >= STEP do
		acc = acc - STEP
		Companions.step(STEP)
		Encounters.step(STEP)
		Core.step(STEP)
		Companions.publishAll(STEP)
	end
end)

print("[Sellos Arcanos] servidor listo · " .. #GameData.Creatures .. " criaturas · " .. #GameData.Islands .. " islas")
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXF75C0FC9A8AB46F1853D4C02C7E4663B">
				<Properties>
					<string name="Name">ProgressionService</string>
					<ProtectedString name="Source"><![CDATA[-- Progresión: experiencia, niveles, entrenamiento, evolución, vínculo,
-- recompensa diaria, contratos, Pase Arcano, Bestiario y compras con cristales.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameData = require(Shared.GameData)
local Formulas = require(Shared.Formulas)
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)
local Codes = require(script.Parent.Codes)

local Progression = {}

local function toast(player, key, vars, kind)
	Net.get("Toast"):FireClient(player, key, vars or {}, kind or "")
end
Progression.toast = toast

function Progression.markSeen(player, id)
	local p = DataService.get(player)
	if p and p.bestiary[id] and not p.bestiary[id].seen then
		p.bestiary[id].seen = true
		DataService.sync(player)
	end
end

function Progression.addBond(own, amount)
	own.bondXp = own.bondXp + amount
	local up = false
	while own.bond < 5 and own.bondXp >= 60 * own.bond do
		own.bondXp = own.bondXp - 60 * own.bond
		own.bond = own.bond + 1
		up = true
	end
	return up
end

function Progression.giveXp(own, amount)
	if own.level >= Formulas.MaxLevel then
		return 0
	end
	own.xp = own.xp + math.floor(amount + 0.5)
	local ups = 0
	while own.level < Formulas.MaxLevel and own.xp >= Formulas.xpToNext(own.level) do
		own.xp = own.xp - Formulas.xpToNext(own.level)
		own.level = own.level + 1
		ups = ups + 1
	end
	if own.level >= Formulas.MaxLevel then
		own.xp = 0
	end
	return ups
end

-- Añade una criatura sellada o convierte el duplicado en vínculo y fragmentos.
function Progression.addCreature(player, id, level, perfect)
	local p = DataService.get(player)
	local c = GameData.CreatureById[id]
	local res = { isNew = false, fragments = perfect and 4 or 3 }
	p.bestiary[id].seen = true
	if not p.creatures[id] then
		p.creatures[id] = { form = 1, level = math.max(1, level), xp = 0, bond = perfect and 2 or 1, bondXp = 0, tint = "" }
		p.bestiary[id].forms[1] = true
		res.isNew = true
		if #p.team < Formulas.teamSize(p.rankXp) then
			table.insert(p.team, id)
		end
	else
		Progression.addBond(p.creatures[id], perfect and 40 or 20)
	end
	p.fragments[c.el] = (p.fragments[c.el] or 0) + res.fragments
	Progression.milestones(player)
	return res
end

function Progression.milestones(player)
	local p = DataService.get(player)
	local n = Formulas.formsSealed(p)
	for _, m in ipairs({ 3, 6, 12, 18, 24, 30, 36 }) do
		local k = "b" .. m
		if n >= m and not table.find(p.milestones, k) then
			table.insert(p.milestones, k)
			local crystals = (m == 36 and 200) or (m >= 18 and 40) or 20
			p.crystals = p.crystals + crystals
			toast(player, "milestone", { n = m, c = crystals }, "gold")
		end
	end
	for _, c in ipairs(GameData.Creatures) do
		local b = p.bestiary[c.id]
		local key = "title_" .. c.id
		if b.forms[1] and b.forms[2] and b.forms[3] and not table.find(p.titles, key) then
			table.insert(p.titles, key)
		end
	end
end

function Progression.grant(player, g)
	local p = DataService.get(player)
	if not g then
		return
	end
	if g.essence then
		p.essence = p.essence + g.essence
	end
	if g.crystals then
		p.crystals = p.crystals + g.crystals
	end
	if g.ink then
		p.ink = math.min(Config.InkMax + 20, p.ink + g.ink)
	end
	if g.fragments then
		local lead = p.team[1] and GameData.CreatureById[p.team[1]]
		local el = lead and lead.el or "luz"
		p.fragments[el] = (p.fragments[el] or 0) + g.fragments
	end
	if g.tint and not table.find(p.cosmetics.tints, g.tint) then
		table.insert(p.cosmetics.tints, g.tint)
	end
	if g.seal and not table.find(p.cosmetics.seals, g.seal) then
		table.insert(p.cosmetics.seals, g.seal)
	end
	if g.effect and not table.find(p.cosmetics.effects, g.effect) then
		table.insert(p.cosmetics.effects, g.effect)
	end
end

function Progression.addRankXp(player, amount)
	local p = DataService.get(player)
	local before = Formulas.rankInfo(p.rankXp).rank
	p.rankXp = p.rankXp + math.floor(amount)
	local after = Formulas.rankInfo(p.rankXp).rank
	if after > before then
		toast(player, "rankUp", { n = after }, "gold")
		if after >= 10 and before < 10 then
			toast(player, "thirdSlot", {}, "gold")
		end
	end
end

function Progression.addPassXp(player, amount)
	local p = DataService.get(player)
	p.pass.xp = math.min(#GameData.PassTiers * GameData.PassXpPerTier, p.pass.xp + amount)
end

-- --- contratos diarios -------------------------------------------------
local CONTRACTS = {
	{ type = "seal", goal = 2, essence = 400 },
	{ type = "perfect", goal = 1, essence = 450 },
	{ type = "kills", goal = 12, essence = 350 },
	{ type = "ult", goal = 3, essence = 350 },
	{ type = "boss", goal = 1, essence = 600 },
	{ type = "advantage", goal = 8, essence = 300 },
}

function Progression.ensureContracts(p)
	if p.contracts.date == DataService.today() and #p.contracts.list > 0 then
		return
	end
	local pool = table.clone(CONTRACTS)
	local list = {}
	for i = 1, 3 do
		local idx = math.random(1, #pool)
		local c = table.remove(pool, idx)
		table.insert(list, { type = c.type, goal = c.goal, progress = 0, essence = c.essence, passXp = 60, claimed = false })
	end
	p.contracts = { date = DataService.today(), list = list }
end

function Progression.progress(player, ctype, n)
	local p = DataService.get(player)
	if not p then
		return
	end
	Progression.ensureContracts(p)
	for _, c in ipairs(p.contracts.list) do
		if c.type == ctype and not c.claimed and c.progress < c.goal then
			c.progress = math.min(c.goal, c.progress + (n or 1))
			if c.progress >= c.goal then
				toast(player, "contractDone", { t = c.type }, "good")
			end
		end
	end
end

-- --- regalos diarios (Premium / VIP) -----------------------------------
function Progression.dailyPerks(player, isVip)
	local p = DataService.get(player)
	local day = DataService.today()
	if player.MembershipType == Enum.MembershipType.Premium and p.perks.lastPremiumGift ~= day then
		p.perks.lastPremiumGift = day
		p.crystals = p.crystals + Config.PremiumDailyCrystals
		toast(player, "premiumGift", { n = Config.PremiumDailyCrystals }, "gold")
	end
	if isVip and p.perks.lastVipGift ~= day then
		p.perks.lastVipGift = day
		p.crystals = p.crystals + Config.VipDailyCrystals
		toast(player, "vipGift", { n = Config.VipDailyCrystals }, "gold")
	end
end

-- --- acciones de menú (RemoteFunction «Action») --------------------------
local Actions = {}

function Actions.train(player, p, id)
	local own = p.creatures[id]
	if not own or own.level >= Formulas.MaxLevel then
		return false
	end
	local cost = Formulas.trainCost(own.level)
	if p.essence < cost then
		return false, "notEnoughEssence"
	end
	p.essence = p.essence - cost
	own.level = own.level + 1
	own.xp = 0
	return true
end

function Actions.evolve(player, p, id)
	local info = Formulas.evolveInfo(p, id)
	if not info or not info.ok then
		return false
	end
	local c = GameData.CreatureById[id]
	if info.frags then
		p.fragments[c.el] = p.fragments[c.el] - info.frags
	end
	p.creatures[id].form = info.to
	p.bestiary[id].forms[info.to] = true
	Progression.milestones(player)
	return true
end

function Actions.team(player, p, id)
	if not p.creatures[id] then
		return false
	end
	local idx = table.find(p.team, id)
	if idx then
		if #p.team <= 1 then
			return false, "teamMin"
		end
		table.remove(p.team, idx)
	else
		if #p.team >= Formulas.teamSize(p.rankXp) then
			return false, "teamFull"
		end
		table.insert(p.team, id)
	end
	return true
end

function Actions.leader(player, p, id)
	local idx = table.find(p.team, id)
	if not idx then
		return false
	end
	table.remove(p.team, idx)
	table.insert(p.team, 1, id)
	return true
end

function Actions.claimDaily(player, p)
	if p.daily.last == DataService.today() then
		return false
	end
	local reward = GameData.Daily[(p.daily.day % 7) + 1]
	Progression.grant(player, reward)
	p.daily.day = (p.daily.day + 1) % 7
	p.daily.last = DataService.today()
	return true
end

function Actions.claimContract(player, p, i)
	Progression.ensureContracts(p)
	local c = p.contracts.list[i]
	if not c or c.claimed or c.progress < c.goal then
		return false
	end
	c.claimed = true
	p.essence = p.essence + c.essence
	Progression.addPassXp(player, c.passXp)
	return true
end

function Actions.claimPass(player, p, n, track)
	local tier = GameData.PassTiers[n]
	if not tier or Formulas.passTier(p.pass.xp) < n then
		return false
	end
	local list = track == "prem" and p.pass.prem or p.pass.free
	if table.find(list, n) then
		return false
	end
	if track == "prem" and not p.pass.premium then
		return false
	end
	table.insert(list, n)
	Progression.grant(player, track == "prem" and tier.prem or tier.free)
	return true
end

function Actions.passPremiumCrystals(player, p)
	if p.pass.premium or p.crystals < Config.PassPremiumCrystals then
		return false, "notEnoughCrystals"
	end
	p.crystals = p.crystals - Config.PassPremiumCrystals
	p.pass.premium = true
	return true
end

-- compras con Cristales Arcanos (solo cosméticos)
function Actions.buyCosmetic(player, p, kind, id)
	local item, list
	if kind == "tint" then
		item, list = GameData.TintById[id], p.cosmetics.tints
	elseif kind == "seal" then
		item, list = GameData.SealById[id], p.cosmetics.seals
	elseif kind == "effect" then
		item, list = GameData.EffectById[id], p.cosmetics.effects
	end
	if not item or table.find(list, id) then
		return false
	end
	if p.crystals < item.price then
		return false, "notEnoughCrystals"
	end
	p.crystals = p.crystals - item.price
	table.insert(list, id)
	if kind == "tint" and p.creatures[item.creature] then
		p.creatures[item.creature].tint = id
	elseif kind == "seal" then
		p.cosmetics.seal = id
	elseif kind == "effect" then
		p.cosmetics.effect = id
	end
	return true
end

function Actions.equip(player, p, kind, id)
	if kind == "seal" and table.find(p.cosmetics.seals, id) then
		p.cosmetics.seal = id
		return true
	elseif kind == "effect" and table.find(p.cosmetics.effects, id) then
		p.cosmetics.effect = id
		return true
	elseif kind == "tint" then
		local t = GameData.TintById[id]
		if id == "" then
			return false
		end
		if t and table.find(p.cosmetics.tints, id) and p.creatures[t.creature] then
			p.creatures[t.creature].tint = id
			return true
		end
	end
	return false
end

function Actions.untint(player, p, creatureId)
	if p.creatures[creatureId] then
		p.creatures[creatureId].tint = ""
		return true
	end
	return false
end

function Actions.settings(player, p, music, sfx)
	if type(music) == "number" and type(sfx) == "number" then
		p.settings.music = math.clamp(music, 0, 1)
		p.settings.sfx = math.clamp(sfx, 0, 1)
		return true
	end
	return false
end

-- --- códigos y grupo ---------------------------------------------------------------
local function grantReward(p, r)
	p.crystals = p.crystals + (r.crystals or 0)
	p.essence = p.essence + (r.essence or 0)
	if r.ink then
		p.ink = math.min(Config.InkMax * 2, p.ink + r.ink)
	end
	return { crystals = r.crystals, essence = r.essence, ink = r.ink }
end

-- límite de intentos para que no se puedan adivinar códigos a la fuerza
local attempts = {}
function Actions.redeem(player, p, code)
	local now = os.clock()
	local a = attempts[player]
	if not a or now - a.t > 60 then
		a = { t = now, n = 0 }
		attempts[player] = a
	end
	a.n = a.n + 1
	if a.n > 6 then
		return false, "codeWait"
	end
	if type(code) ~= "string" or #code > 40 then
		return false, "codeInvalid"
	end
	code = string.upper((string.gsub(code, "%s", "")))
	local def = Codes[code]
	if not def then
		return false, "codeInvalid"
	end
	if def.expires and os.date("!%Y-%m-%d") > def.expires then
		return false, "codeExpired"
	end
	p.codes = p.codes or {}
	if p.codes[code] then
		return false, "codeUsed"
	end
	p.codes[code] = os.time()
	return true, grantReward(p, def)
end

function Actions.groupReward(player, p)
	if not Config.GroupId or Config.GroupId == 0 then
		return false, "codeInvalid"
	end
	if p.perks.group then
		return false, "codeUsed"
	end
	local ok, inGroup = pcall(function()
		return player:IsInGroupAsync(Config.GroupId)
	end)
	if not ok or not inGroup then
		return false, "groupJoin"
	end
	p.perks.group = true
	return true, grantReward(p, Config.GroupReward)
end

game:GetService("Players").PlayerRemoving:Connect(function(player)
	attempts[player] = nil
end)

-- el cliente pide el perfil al arrancar (por si el primer envío llegó antes
-- de que estuviera escuchando)
function Actions.sync()
	return true
end

Progression.Actions = Actions
Progression.onChange = nil -- lo asigna Main para refrescar criaturas en el mundo

function Progression.init()
	-- como mucho 40 acciones cada 2 s por jugador (nadie pulsa tan rápido)
	local rate = {}
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		rate[player] = nil
	end)
	Net.get("Action").OnServerInvoke = function(player, name, a, b, c)
		local now = os.clock()
		local r = rate[player]
		if not r or now - r.t > 2 then
			r = { t = now, n = 0 }
			rate[player] = r
		end
		r.n = r.n + 1
		if r.n > 40 then
			return false
		end
		local p = DataService.get(player)
		local fn = Actions[name]
		if not p or not fn or type(name) ~= "string" then
			return false
		end
		local ok, err = fn(player, p, a, b, c)
		if ok then
			DataService.sync(player)
			if Progression.onChange then
				Progression.onChange(player, name)
			end
		end
		return ok, err
	end
end

return Progression
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXF5F51009DAB847BCABB74E47C022ADAA">
				<Properties>
					<string name="Name">ShopService</string>
					<ProtectedString name="Source"><![CDATA[-- Compras con Robux: productos para desarrolladores (Cristales Arcanos y
-- Pack del Fundador) y pases del juego (Pase Arcano Premium, Sellador VIP).
-- ProcessReceipt es idempotente: cada recibo se concede una sola vez y solo se
-- confirma a Roblox cuando el perfil ya está guardado.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local DataService = require(script.Parent.DataService)
local Progression = require(script.Parent.ProgressionService)

local Shop = {}
local passCache = {} -- player -> {passKey = bool}

local productById = {}
for _, prod in ipairs(Config.Products) do
	if prod.id and prod.id ~= 0 then
		productById[prod.id] = prod
	end
end

function Shop.ownsPass(player, key)
	local c = passCache[player]
	return c and c[key] == true
end

local function applyPass(player, key)
	local p = DataService.get(player)
	if not p then
		return
	end
	if key == "pase_premium" then
		p.pass.premium = true
	elseif key == "vip" then
		if not table.find(p.cosmetics.seals, "eclipse") then
			table.insert(p.cosmetics.seals, "eclipse")
		end
		player:SetAttribute("VIP", true)
	end
	DataService.sync(player)
end

function Shop.loadPasses(player)
	passCache[player] = {}
	for key, pass in pairs(Config.GamePasses) do
		if pass.id and pass.id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.id)
			end)
			if ok and owns then
				passCache[player][key] = true
				applyPass(player, key)
			end
		end
	end
end

local function grantProduct(player, prod, p)
	if prod.once and prod.founder and p.purchases.founder then
		-- ya lo tenía: se convierte en cristales para no perder la compra
		p.crystals = p.crystals + prod.crystals
		return
	end
	p.crystals = p.crystals + (prod.crystals or 0)
	if prod.founder then
		p.purchases.founder = true
		-- tinte Prisma para la primera criatura, Corona Solar y Lluvia de estrellas
		local first = p.team[1]
		if first then
			local tid = first .. "_prisma"
			if not table.find(p.cosmetics.tints, tid) then
				table.insert(p.cosmetics.tints, tid)
			end
			if p.creatures[first] then
				p.creatures[first].tint = tid
			end
		end
		if not table.find(p.cosmetics.seals, "corona") then
			table.insert(p.cosmetics.seals, "corona")
		end
		if not table.find(p.cosmetics.effects, "estrellas") then
			table.insert(p.cosmetics.effects, "estrellas")
		end
	end
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local p = DataService.get(player)
	if not p then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local receipts = p.purchases.receipts
	if table.find(receipts, info.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local prod = productById[info.ProductId]
	if not prod then
		warn("[Sellos Arcanos] producto desconocido", info.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	grantProduct(player, prod, p)
	table.insert(receipts, info.PurchaseId)
	-- guardamos solo los últimos 200 recibos
	while #receipts > 200 do
		table.remove(receipts, 1)
	end
	DataService.save(player, false)
	DataService.sync(player)
	Progression.toast(player, "purchaseDone", { key = prod.key }, "gold")
	if Shop.onGranted then
		Shop.onGranted(player)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function Shop.init()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for key, pass in pairs(Config.GamePasses) do
			if pass.id == passId then
				passCache[player] = passCache[player] or {}
				passCache[player][key] = true
				applyPass(player, key)
				Progression.toast(player, "purchaseDone", { key = key }, "gold")
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		passCache[player] = nil
	end)
end

return Shop
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXEB8D1DFBC61D4C2FBA82640783634F02">
				<Properties>
					<string name="Name">WorldService</string>
					<ProtectedString name="Source"><![CDATA[-- Construye el mundo al arrancar el servidor: iluminación nocturna con Bloom,
-- la Ciudadela del Sello (centro con 12 portales y la Fuente del Sello) y las
-- 12 islas flotantes del Velo, cada una con su sello en el suelo, decorado,
-- zona de criaturas salvajes, portal de vuelta y altar del Primordial.
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameData = require(Shared.GameData)
local Config = require(Shared.Config)

local World = {}

World.GroundY = 100
World.HubRadius = 82
World.IslandRadius = 120
World.IslandDistance = 1100
World.Islands = {} -- index -> {center, spawn, altar, model, color, wildArea}
World.Hub = nil

local NIGHT = Color3.fromHex("#090817")
local STONE = Color3.fromRGB(29, 25, 54)
local STONE_DARK = Color3.fromRGB(20, 17, 39)

local root = Instance.new("Folder")
root.Name = "Mundo"

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.Slate
	p.Color = STONE
	for k, v in pairs(props) do
		p[k] = v
	end
	return p
end
World.part = part

-- disco plano (cilindro con el eje en Y)
local function disc(parent, center, radius, height, color, material, transparency)
	local p = part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material or Enum.Material.Slate,
		Transparency = transparency or 0,
		CanCollide = false,
		CastShadow = false,
	})
	p.Parent = parent
	return p
end
World.disc = disc

-- Círculo mágico procedural: anillos de neón concéntricos y una estrella.
-- Si hay una imagen subida en Config.Assets.circles se usa como Decal.
function World.magicCircle(parent, center, radius, color, design, intensity)
	local m = Instance.new("Model")
	m.Name = "Sello"
	pcall(function()
		m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end)
	local transp = 1 - math.clamp(intensity or 1, 0, 1) * 0.85
	local assetId = Config.Assets.circles[design or "hexagrama"]
	if assetId and assetId ~= 0 then
		local plate = part({
			Size = Vector3.new(radius * 2, 0.05, radius * 2),
			CFrame = CFrame.new(center + Vector3.new(0, 0.06, 0)),
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
		})
		local d = Instance.new("Decal")
		d.Face = Enum.NormalId.Top
		d.Texture = "rbxassetid://" .. assetId
		d.Color3 = color
		d.Transparency = transp * 0.6
		d.Parent = plate
		plate.Parent = m
	else
		local rings = { 1, 0.93, 0.62, 0.55, 0.16 }
		for i, k in ipairs(rings) do
			local neon = (i % 2 == 1)
			local ring = disc(m, center + Vector3.new(0, 0.05 + i * 0.012, 0), radius * k, 0.04,
				neon and color or NIGHT, neon and Enum.Material.Neon or Enum.Material.SmoothPlastic,
				neon and transp or 0.15)
			ring.CanQuery = false
		end
		-- estrella: n puntas unidas saltando k vértices
		local n = (design == "pentagrama" and 5) or (design == "heptagrama" and 7) or 6
		local step = (n == 6) and 2 or ((n == 7) and 3 or 2)
		local r = radius * 0.6
		for i = 0, n - 1 do
			local a1 = math.rad(-90) + (i / n) * math.pi * 2
			local a2 = math.rad(-90) + (((i + step) % n) / n) * math.pi * 2
			local p1 = center + Vector3.new(math.cos(a1) * r, 0.14, math.sin(a1) * r)
			local p2 = center + Vector3.new(math.cos(a2) * r, 0.14, math.sin(a2) * r)
			local bar = part({
				Size = Vector3.new(math.max(0.12, radius * 0.025), 0.03, (p2 - p1).Magnitude),
				CFrame = CFrame.lookAt((p1 + p2) / 2, p2),
				Color = color,
				Material = Enum.Material.Neon,
				Transparency = transp,
				CanCollide = false,
				CanQuery = false,
				CastShadow = false,
			})
			bar.Parent = m
		end
	end
	m.Parent = parent
	return m
end

local function setupLighting()
	Lighting.ClockTime = 0
	Lighting.Brightness = 1.2
	Lighting.Ambient = Color3.fromRGB(46, 40, 80)
	Lighting.OutdoorAmbient = Color3.fromRGB(58, 50, 100)
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.GlobalShadows = true
	Lighting.FogColor = NIGHT
	Lighting.FogStart = 200
	Lighting.FogEnd = 900
	for _, c in ipairs(Lighting:GetChildren()) do
		if c:IsA("PostEffect") or c:IsA("Atmosphere") or c:IsA("Sky") then
			c:Destroy()
		end
	end
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 1
	bloom.Size = 24
	bloom.Threshold = 0.9
	bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.08
	cc.Contrast = 0.08
	cc.TintColor = Color3.fromRGB(235, 228, 255)
	cc.Parent = Lighting
	local atm = Instance.new("Atmosphere")
	atm.Density = 0.32
	atm.Offset = 0.1
	atm.Color = Color3.fromRGB(40, 32, 80)
	atm.Decay = Color3.fromRGB(12, 10, 30)
	atm.Glare = 0
	atm.Haze = 1.2
	atm.Parent = Lighting
	local sky = Instance.new("Sky")
	sky.StarCount = 5000
	sky.CelestialBodiesShown = false
	sky.Parent = Lighting
end

-- raíz de roca colgando bajo una isla (cilindros cada vez más estrechos)
local function rockRoot(parent, center, radius)
	local y = center.Y - 4
	local r = radius
	for i = 1, 6 do
		local h = 10 + i * 2
		local p = disc(parent, Vector3.new(center.X + math.random(-4, 4), y - h / 2, center.Z + math.random(-4, 4)), r, h,
			i % 2 == 0 and STONE_DARK or STONE, Enum.Material.Slate)
		p.CanCollide = false
		y = y - h + 2
		r = r * 0.72
	end
end

local PROP_BUILDERS = {}

function PROP_BUILDERS.crystal(parent, pos, color)
	for k = 1, 3 do
		local h = math.random(5, 14)
		local p = part({
			Size = Vector3.new(2, h, 2),
			CFrame = CFrame.new(pos + Vector3.new(math.random(-3, 3), h / 2, math.random(-3, 3)))
				* CFrame.Angles(math.rad(math.random(-15, 15)), math.rad(math.random(0, 90)), math.rad(math.random(-15, 15))),
			Color = color,
			Material = Enum.Material.Neon,
			Transparency = 0.25,
		})
		p.Parent = parent
	end
end

function PROP_BUILDERS.pillar(parent, pos, color)
	local h = math.random(10, 22)
	local p = part({ Size = Vector3.new(4, h, 4), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, math.rad(math.random(0, 90)), math.rad(math.random(-6, 6))), Color = Color3.fromRGB(43, 38, 72) })
	p.Parent = parent
	local strip = part({ Size = Vector3.new(4.2, 0.4, 4.2), CFrame = p.CFrame * CFrame.new(0, h * 0.15, 0), Color = color, Material = Enum.Material.Neon })
	strip.Parent = parent
end

function PROP_BUILDERS.statue(parent, pos)
	local h = math.random(7, 11)
	local body = part({ Size = Vector3.new(3, h, 2), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, math.rad(math.random(0, 180)), 0), Color = Color3.fromRGB(74, 85, 82) })
	body.Parent = parent
	local head = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), CFrame = body.CFrame * CFrame.new(0, h / 2 + 1.2, 0), Color = Color3.fromRGB(74, 85, 82) })
	head.Parent = parent
end

function PROP_BUILDERS.rock(parent, pos)
	local s = math.random(4, 10)
	local p = part({ Size = Vector3.new(s, s * 0.8, s), CFrame = CFrame.new(pos + Vector3.new(0, s * 0.3, 0)) * CFrame.Angles(math.rad(math.random(0, 40)), math.rad(math.random(0, 90)), math.rad(math.random(0, 40))), Color = Color3.fromRGB(35, 31, 61) })
	p.Parent = parent
end

function PROP_BUILDERS.flower(parent, pos, color)
	for k = 1, 4 do
		local stem = part({ Size = Vector3.new(0.3, 2.5, 0.3), CFrame = CFrame.new(pos + Vector3.new(math.random(-3, 3), 1.25, math.random(-3, 3))), Color = Color3.fromRGB(46, 58, 53), CanCollide = false })
		stem.Parent = parent
		local bloom = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9), CFrame = stem.CFrame * CFrame.new(0, 1.4, 0), Color = color, Material = Enum.Material.Neon, CanCollide = false })
		bloom.Parent = parent
	end
end

local PROPS_BY_TYPE = {
	flores = { "flower", "flower", "rock" },
	pilares = { "pillar", "rock" },
	estatuas = { "statue", "statue", "rock" },
	hielo = { "crystal", "rock" },
	rocas = { "rock", "rock", "pillar" },
	cristales = { "crystal", "crystal", "rock" },
	lava = { "rock", "crystal" },
	corales = { "crystal", "rock" },
	telas = { "pillar", "statue" },
	estrellas = { "crystal", "rock" },
	vacio = { "crystal", "pillar", "rock" },
}

-- Portal: arco de piedra con un disco de neón vertical y un ProximityPrompt
local function portal(parent, cf, color, name)
	local m = Instance.new("Model")
	m.Name = name
	for _, sx in ipairs({ -1, 1 }) do
		local pil = part({ Size = Vector3.new(2.4, 15, 2.4), CFrame = cf * CFrame.new(sx * 6, 7.5, 0), Color = Color3.fromRGB(43, 38, 72) })
		pil.Parent = m
	end
	local top = part({ Size = Vector3.new(15, 2.4, 2.6), CFrame = cf * CFrame.new(0, 15.6, 0), Color = Color3.fromRGB(43, 38, 72) })
	top.Parent = m
	local gate = part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 12, 12),
		CFrame = cf * CFrame.new(0, 7.6, 0) * CFrame.Angles(0, math.rad(90), 0),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.35,
		CanCollide = false,
	})
	gate.Name = "Gate"
	gate.Parent = m
	local prompt = Instance.new("ProximityPrompt")
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = gate
	m.PrimaryPart = gate
	m.Parent = parent
	return m, prompt
end
World.portal = portal

local function buildHub()
	local hub = Instance.new("Model")
	hub.Name = "Ciudadela"
	local c = Vector3.new(0, World.GroundY, 0)
	local floor = disc(hub, c - Vector3.new(0, 3, 0), World.HubRadius, 6, STONE, Enum.Material.Slate)
	floor.CanCollide = true
	floor.Name = "Suelo"
	rockRoot(hub, c - Vector3.new(0, 6, 0), World.HubRadius * 0.95)
	disc(hub, c - Vector3.new(0, 0.0, 0), World.HubRadius + 0.6, 0.1, Color3.fromHex("#cbb8ff"), Enum.Material.Neon, 0.4)
	disc(hub, c + Vector3.new(0, 0.02, 0), World.HubRadius - 0.3, 0.1, STONE, Enum.Material.Slate, 0)
	World.magicCircle(hub, c, 36, Color3.fromHex("#cbb8ff"), "heptagrama", 0.55)
	CollectionService:AddTag(hub:FindFirstChild("Sello"), "SA_Spin")

	-- Fuente del Sello: cura y revive al equipo
	local fountain = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 12, 12), CFrame = CFrame.new(c + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(43, 38, 72) })
	fountain.Parent = hub
	local core = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(5, 5, 5), CFrame = CFrame.new(c + Vector3.new(0, 7, 0)), Color = Color3.fromHex("#cbb8ff"), Material = Enum.Material.Neon, CanCollide = false })
	core.Name = "FuenteNucleo"
	core.Parent = hub
	CollectionService:AddTag(core, "SA_Bob")
	local light = Instance.new("PointLight")
	light.Color = Color3.fromHex("#cbb8ff")
	light.Range = 40
	light.Brightness = 2
	light.Parent = core
	local fprompt = Instance.new("ProximityPrompt")
	fprompt.Name = "FuentePrompt"
	fprompt.ActionText = "Restaurar equipo"
	fprompt.ObjectText = "Fuente del Sello"
	fprompt.MaxActivationDistance = 16
	fprompt.RequiresLineOfSight = false
	fprompt.Parent = core

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(c + Vector3.new(0, 0.4, 22))
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = hub

	-- 12 portales en círculo, uno por isla
	local portals = {}
	for i, isl in ipairs(GameData.Islands) do
		local a = (i - 1) / #GameData.Islands * math.pi * 2
		local pos = c + Vector3.new(math.cos(a) * (World.HubRadius - 10), 0, math.sin(a) * (World.HubRadius - 10))
		local cf = CFrame.lookAt(pos, Vector3.new(c.X, pos.Y, c.Z))
		local boss = GameData.CreatureById[isl.boss]
		local m, prompt = portal(hub, cf, Color3.fromHex(boss.color), "Portal_" .. i)
		m:SetAttribute("IslandIndex", i)
		prompt:SetAttribute("IslandIndex", i)
		prompt.Name = "TravelPrompt"
		prompt.ActionText = "Viajar"
		prompt.ObjectText = isl.name.es
		CollectionService:AddTag(m, "SA_Portal")
		portals[i] = prompt
	end
	hub.Parent = root
	World.Hub = { center = c, spawn = c + Vector3.new(0, 3, 22), model = hub, portals = portals, fountain = fprompt }
end

local function buildIsland(i, isl)
	local a = (i - 1) / #GameData.Islands * math.pi * 2
	local c = Vector3.new(math.cos(a) * World.IslandDistance, World.GroundY, math.sin(a) * World.IslandDistance)
	local boss = GameData.CreatureById[isl.boss]
	local color = Color3.fromHex(boss.color)
	local m = Instance.new("Model")
	m.Name = "Isla_" .. i
	local floor = disc(m, c - Vector3.new(0, 3, 0), World.IslandRadius, 6, STONE, Enum.Material.Slate)
	floor.CanCollide = true
	floor.Name = "Suelo"
	rockRoot(m, c - Vector3.new(0, 6, 0), World.IslandRadius * 0.95)
	disc(m, c, World.IslandRadius + 0.6, 0.1, color, Enum.Material.Neon, 0.55)
	disc(m, c + Vector3.new(0, 0.02, 0), World.IslandRadius - 0.3, 0.1, STONE, Enum.Material.Slate, 0)
	local floorSeal = World.magicCircle(m, c, World.IslandRadius * 0.8, color, boss.circle, 0.18)
	CollectionService:AddTag(floorSeal, "SA_Spin")

	-- decorado en el borde
	local kinds = PROPS_BY_TYPE[isl.props] or PROPS_BY_TYPE.rocas
	for k = 1, 22 do
		local pa = math.random() * math.pi * 2
		local pr = World.IslandRadius * (0.82 + math.random() * 0.14)
		local pos = c + Vector3.new(math.cos(pa) * pr, 0, math.sin(pa) * pr)
		local kind = kinds[math.random(1, #kinds)]
		PROP_BUILDERS[kind](m, pos, color)
	end

	-- portal de vuelta (cerca del borde, mirando al centro)
	local toHub = (Vector3.new(0, c.Y, 0) - c).Unit
	local ppos = c + toHub * (World.IslandRadius - 16)
	local _, back = portal(m, CFrame.lookAt(ppos, c), Color3.fromHex("#cbb8ff"), "PortalVuelta")
	back.Name = "ReturnPrompt"
	back.ActionText = "Volver a la Ciudadela"
	back.ObjectText = isl.name.es
	back:SetAttribute("IslandIndex", i)
	local spawn = c + toHub * (World.IslandRadius - 30) + Vector3.new(0, 3, 0)

	-- altar del Primordial en el lado opuesto
	local altarPos = c - toHub * (World.IslandRadius - 40)
	local altarSeal = World.magicCircle(m, altarPos, 22, color, boss.circle, 0.6)
	CollectionService:AddTag(altarSeal, "SA_Spin")
	local stone = part({ Size = Vector3.new(6, 6, 6), CFrame = CFrame.new(altarPos + Vector3.new(0, 3, 0)) * CFrame.Angles(0, math.rad(45), 0), Color = Color3.fromRGB(43, 38, 72) })
	stone.Name = "Altar"
	stone.Parent = m
	local rune = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(3, 3, 3), CFrame = CFrame.new(altarPos + Vector3.new(0, 8, 0)), Color = color, Material = Enum.Material.Neon, CanCollide = false })
	rune.Parent = m
	CollectionService:AddTag(rune, "SA_Bob")
	local bprompt = Instance.new("ProximityPrompt")
	bprompt.Name = "BossPrompt"
	bprompt.ActionText = "Desafiar al Primordial"
	bprompt.ObjectText = boss.name.es
	bprompt.HoldDuration = 1
	bprompt.MaxActivationDistance = 16
	bprompt.RequiresLineOfSight = false
	bprompt:SetAttribute("IslandIndex", i)
	bprompt.Parent = stone

	m:SetAttribute("IslandIndex", i)
	m.Parent = root
	World.Islands[i] = {
		index = i, center = c, spawn = spawn, model = m, color = color, toHub = toHub,
		altar = altarPos, bossArena = altarPos + toHub * 34, returnPrompt = back, bossPrompt = bprompt,
		wildCenter = c + toHub * 10, wildRadius = World.IslandRadius * 0.55,
	}
end

-- ¿en qué isla está esta posición? (0 = Ciudadela, nil = cayendo al Abismo)
function World.islandAt(pos)
	if (Vector3.new(pos.X, 0, pos.Z)).Magnitude < World.HubRadius + 20 then
		return 0
	end
	for i, isl in ipairs(World.Islands) do
		local d = Vector3.new(pos.X - isl.center.X, 0, pos.Z - isl.center.Z).Magnitude
		if d < World.IslandRadius + 20 then
			return i
		end
	end
	return nil
end

-- recorta una posición para que quede sobre la isla
function World.clampToIsland(islandIdx, pos, margin)
	local c, r
	if islandIdx == 0 then
		c, r = Vector3.new(0, World.GroundY, 0), World.HubRadius
	else
		local isl = World.Islands[islandIdx]
		if not isl then
			return pos
		end
		c, r = isl.center, World.IslandRadius
	end
	local d = Vector3.new(pos.X - c.X, 0, pos.Z - c.Z)
	local max = r - (margin or 4)
	if d.Magnitude > max then
		d = d.Unit * max
	end
	return Vector3.new(c.X + d.X, World.GroundY, c.Z + d.Z)
end

function World.init()
	math.randomseed(1234)
	setupLighting()
	buildHub()
	for i, isl in ipairs(GameData.Islands) do
		buildIsland(i, isl)
	end
	root.Parent = workspace
	math.randomseed(os.time())
	-- red de seguridad: quien cae al Abismo vuelve a la Ciudadela
	pcall(function()
		workspace.FallenPartsDestroyHeight = World.GroundY - 160
	end)
end

return World
