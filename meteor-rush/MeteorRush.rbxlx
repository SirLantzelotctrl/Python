		ball(ctx, "BatWing", Vector3.new(S * 0.6, S * 0.35, S * 0.04), base * CFrame.new(side * S * 0.22, 0, 0), color)
		for i = 0, 2 do
			ball(ctx, "WingTip", Vector3.new(S * 0.12, S * 0.2, S * 0.04), base * CFrame.new(side * S * (0.12 + i * 0.16), -S * 0.17, 0), color)
		end
	end)
end

