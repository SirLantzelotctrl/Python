          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">Critters</string>
              <string name="Source"><![CDATA[-- Inventario de criaturas: equipar, quitar, borrar, equipar las mejores y auto-borrado.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Critters = require(Shared:WaitForChild("Critters"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Format = require(Shared:WaitForChild("Format"))
local Models = require(Shared:WaitForChild("Models"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local State = require(Modules.State)

local Notifications = require(script.Parent.Parent.Controllers.Notifications)

local CrittersWindow = {
	Title = "🐾 CRITTERS",
	Color = UI.Colors.Orange,
	Size = UDim2.fromOffset(780, 520),
}

local summary: TextLabel
local autoButton: TextButton
local autoLabel: TextLabel
local grid: ScrollingFrame
local cards: { [string]: Frame } = {}
local selected: string? = nil
local detailViewport: ViewportFrame
local detailName: TextLabel
local detailInfo: TextLabel
local equipButton: TextButton
local equipLabel: TextLabel
local deleteButton: TextButton
local previewKey = ""

local function act(name: string, payload: { [string]: any }?)
	local ok, message = State.Action(name, payload)
	if message then
		Notifications.Show(message, if ok then "Success" else "Error")
	end
	return ok
end

local function setPreview(critterId: string?, shiny: boolean)
	local key = tostring(critterId) .. tostring(shiny)
	if key == previewKey then
		return
	end
	previewKey = key
	for _, child in detailViewport:GetChildren() do
		if child:IsA("Model") then
			child:Destroy()
		end
	end
	if not critterId then
		return
	end
	local model = Models.BuildCritter(critterId, { Shiny = shiny, NoEffects = true })
	local height = (model:GetAttribute("Height") :: number?) or 2
	local camera = detailViewport.CurrentCamera
	if camera then
		camera.CFrame = CFrame.lookAt(Vector3.new(height * 0.4, height * 0.8, -height * 2.6 - 1.5), Vector3.new(0, height * 0.5, 0))
	end
	model.Parent = detailViewport
end

local function updateDetail(data: { [string]: any })
	local entry = selected and data.Critters and data.Critters[selected]
	if not entry then
		selected = nil
		detailName.Text = "Select a critter"
		detailName.TextColor3 = UI.Colors.Text
		detailInfo.Text = ""
		equipButton.Visible = false
		deleteButton.Visible = false
		setPreview(nil, false)
		return
	end
	local def = Critters.Get(entry.Id)
	if not def then
		return
	end
	local rarity = Rarities.Get(def.Rarity)
	detailName.Text = (if entry.Shiny then "✨ " else "") .. def.Name
	detailName.TextColor3 = rarity.Color
	detailInfo.Text = ("%s  •  +%s damage"):format(def.Rarity, Format.Percent(Critters.GetPower(def.Id, entry.Shiny)))
	local equipped = table.find(data.Equipped or {}, selected) ~= nil
	equipButton.Visible = true
	deleteButton.Visible = true
	equipLabel.Text = if equipped then "UNEQUIP" else "EQUIP"
	UI.SetButtonColor(equipButton, if equipped then UI.Colors.Gray else UI.Colors.Green)
	setPreview(entry.Id, entry.Shiny == true)
end

function CrittersWindow.Build(window)
	local content = window.Content
	summary = UI.Text({ Name = "Summary", Text = "", Size = UDim2.new(0.55, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Yellow, Parent = content })
	UI.Button({
		Name = "EquipBest",
		Text = "⭐ Equip Best",
		Color = UI.Colors.Green,
		Size = UDim2.fromOffset(160, 40),
		Position = UDim2.new(1, -170, 0, -4),
		AnchorPoint = Vector2.new(1, 0),
		OnClick = function()
			act("EquipBest")
		end,
		Parent = content,
	})
	autoButton, autoLabel = UI.Button({
		Name = "AutoDelete",
		Text = "",
		Color = UI.Colors.Gray,
		Size = UDim2.fromOffset(160, 40),
		Position = UDim2.new(1, 0, 0, -4),
		AnchorPoint = Vector2.new(1, 0),
		TextSizeScale = 0.55,
		OnClick = function()
			act("ToggleAutoDelete")
		end,
		Parent = content,
	})

	grid = UI.New("ScrollingFrame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 44),
		Size = UDim2.new(1, -250, 1, -44),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	})
	UI.Grid(UDim2.fromOffset(110, 110), 8).Parent = grid
	UI.Padding(4, 10, 8, 4).Parent = grid

	local detail = UI.Panel({ Name = "Detail", Color = UI.Colors.PanelDark, Size = UDim2.new(0, 238, 1, -44), Position = UDim2.new(1, 0, 0, 44), AnchorPoint = Vector2.new(1, 0), Parent = content })
	detailViewport = UI.New("ViewportFrame", {
		Name = "Preview",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -20, 0, 170),
		Position = UDim2.new(0.5, 0, 0, 8),
		AnchorPoint = Vector2.new(0.5, 0),
		Ambient = Color3.fromRGB(200, 200, 200),
		LightDirection = Vector3.new(-1, -1, 1),
		Parent = detail,
	})
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.Parent = detailViewport
	detailViewport.CurrentCamera = camera
	detailName = UI.Text({ Name = "Name", Text = "Select a critter", Size = UDim2.new(1, -16, 0, 32), Position = UDim2.new(0.5, 0, 0, 182), AnchorPoint = Vector2.new(0.5, 0), Parent = detail })
	detailInfo = UI.Text({ Name = "Info", Text = "", Size = UDim2.new(1, -16, 0, 24), Position = UDim2.new(0.5, 0, 0, 216), AnchorPoint = Vector2.new(0.5, 0), TextColor3 = UI.Colors.SubText, Parent = detail })
	equipButton, equipLabel = UI.Button({
		Name = "Equip",
		Text = "EQUIP",
		Color = UI.Colors.Green,
		Size = UDim2.new(1, -24, 0, 46),
		Position = UDim2.new(0.5, 0, 1, -64),
		AnchorPoint = Vector2.new(0.5, 1),
		OnClick = function()
			local data = State.Data
			if not data or not selected then
				return
			end
			if table.find(data.Equipped or {}, selected) then
				act("UnequipCritter", { Uid = selected })
			else
				act("EquipCritter", { Uid = selected })
			end
		end,
		Parent = detail,
	})
	deleteButton = UI.Button({
		Name = "Delete",
		Text = "🗑️ DELETE",
		Color = UI.Colors.Red,
		Size = UDim2.new(1, -24, 0, 42),
		Position = UDim2.new(0.5, 0, 1, -12),
		AnchorPoint = Vector2.new(0.5, 1),
		OnClick = function()
			if selected and act("DeleteCritter", { Uid = selected }) then
				selected = nil
			end
		end,
		Parent = detail,
	})
	equipButton.Visible = false
	deleteButton.Visible = false
end

function CrittersWindow.Refresh(data)
	local critters = data.Critters or {}
	local equipped = data.Equipped or {}
	local count = data.CritterCount or 0
	local bonus = 0
	for _, uid in equipped do
		local entry = critters[uid]
		if entry then
			bonus += Critters.GetPower(entry.Id, entry.Shiny)
		end
	end
	summary.Text = ("Equipped %d/%d  •  +%s dmg  •  %d/%d owned"):format(#equipped, data.SlotCount or 3, Format.Percent(bonus), count, data.InventoryLimit or 80)
	local auto = data.Settings and data.Settings.AutoDeleteCommon
	autoLabel.Text = if auto then "🗑️ Auto-delete Common: ON" else "Auto-delete Common: OFF"
	UI.SetButtonColor(autoButton, if auto then UI.Colors.Red else UI.Colors.Gray)

	-- Ordenadas: equipadas primero, después por poder
	local list = {}
	for uid, entry in critters do
		local def = Critters.Get(entry.Id)
		if def then
			table.insert(list, { Uid = uid, Entry = entry, Def = def, Power = Critters.GetPower(def.Id, entry.Shiny), Equipped = table.find(equipped, uid) ~= nil })
		end
	end
	table.sort(list, function(a, b)
		if a.Equipped ~= b.Equipped then
			return a.Equipped
		end
		if a.Power ~= b.Power then
			return a.Power > b.Power
		end
		return a.Uid < b.Uid
	end)

	local alive = {}
	for order, item in list do
		alive[item.Uid] = true
		local card = cards[item.Uid]
		local rarity = Rarities.Get(item.Def.Rarity)
		if not card then
			card = UI.Panel({ Name = item.Uid, Color = UI.Darken(rarity.Color, 0.55), Parent = grid })
			local button = UI.New("TextButton", { Name = "Select", Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = card })
			local uid = item.Uid
			button.Activated:Connect(function()
				selected = uid
				if State.Data then
					updateDetail(State.Data)
				end
			end)
			UI.Text({ Name = "Icon", Text = "", Size = UDim2.new(1, 0, 0, 44), Position = UDim2.new(0, 0, 0, 6), StrokeThickness = 0, Parent = card })
			UI.Text({ Name = "CardName", Text = item.Def.Name, Size = UDim2.new(1, -8, 0, 22), Position = UDim2.new(0.5, 0, 0, 52), AnchorPoint = Vector2.new(0.5, 0), Parent = card })
			UI.Text({ Name = "Power", Text = "", Size = UDim2.new(1, -8, 0, 20), Position = UDim2.new(0.5, 0, 0, 78), AnchorPoint = Vector2.new(0.5, 0), TextColor3 = rarity.Color, Parent = card })
			cards[item.Uid] = card
		end
		card.LayoutOrder = order
		local icon = card:FindFirstChild("Icon") :: TextLabel
		icon.Text = (if item.Equipped then "✅" else "") .. (if item.Entry.Shiny then "✨" else "") .. "🐾"
		local power = card:FindFirstChild("Power") :: TextLabel
		power.Text = "+" .. Format.Percent(item.Power)
		local stroke = card:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = if item.Uid == selected then UI.Colors.Yellow elseif item.Equipped then UI.Colors.Green else UI.Colors.Stroke
		end
	end
	for uid, card in cards do
		if not alive[uid] then
			card:Destroy()
			cards[uid] = nil
		end
	end
	updateDetail(data)
end

return CrittersWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">Daily</string>
              <string name="Source"><![CDATA[-- Recompensa diaria con racha de 7 días.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local RewardInfo = require(Shared:WaitForChild("RewardInfo"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local State = require(Modules.State)

local Notifications = require(script.Parent.Parent.Controllers.Notifications)

local Daily = {
	Title = "📅 DAILY REWARDS",
	Color = UI.Colors.Blue,
	Size = UDim2.fromOffset(720, 400),
}

type Cell = { Frame: Frame, Icon: TextLabel, Reward: TextLabel, Status: TextLabel }

local cells: { Cell } = {}
local streakLabel: TextLabel
local claimButton: TextButton
local claimLabel: TextLabel

function Daily.Build(window)
	local content = window.Content
	streakLabel = UI.Text({ Name = "Streak", Text = "", Size = UDim2.new(1, 0, 0, 32), TextColor3 = UI.Colors.Orange, StrokeThickness = 3, Parent = content })
	local row = UI.New("Frame", { Name = "Days", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 170), Position = UDim2.new(0, 0, 0, 44), Parent = content })
	UI.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center).Parent = row
	for day, _ in Config.DailyRewards do
		local frame = UI.Panel({ Name = "Day" .. day, Color = UI.Colors.PanelLight, Size = UDim2.fromOffset(88, 160), LayoutOrder = day, Parent = row })
		UI.Text({ Name = "DayLabel", Text = "Day " .. day, Size = UDim2.new(1, -8, 0, 24), Position = UDim2.new(0.5, 0, 0, 6), AnchorPoint = Vector2.new(0.5, 0), Parent = frame })
		local icon = UI.Text({ Name = "Icon", Text = "🎁", Size = UDim2.new(1, 0, 0, 44), Position = UDim2.new(0, 0, 0, 34), StrokeThickness = 0, Parent = frame })
		local reward = UI.Text({ Name = "Reward", Text = "", Size = UDim2.new(1, -8, 0, 36), Position = UDim2.new(0.5, 0, 0, 82), AnchorPoint = Vector2.new(0.5, 0), TextWrapped = true, Parent = frame })
		local status = UI.Text({ Name = "Status", Text = "", Size = UDim2.new(1, -8, 0, 22), Position = UDim2.new(0.5, 0, 1, -6), AnchorPoint = Vector2.new(0.5, 1), Parent = frame })
		cells[day] = { Frame = frame, Icon = icon, Reward = reward, Status = status }
	end
	claimButton, claimLabel = UI.Button({
		Name = "Claim",
		Text = "",
		Color = UI.Colors.Gray,
		Size = UDim2.fromOffset(300, 62),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		OnClick = function()
			local ok, message = State.Action("ClaimDaily")
			if message then
				Notifications.Show(message, if ok then "Success" else "Error")
			end
		end,
		Parent = content,
	})
end

function Daily.Refresh(data)
	local income = data.RewardBase or 1
	local nextIndex = data.DailyNextIndex or 1
	local available = data.DailyAvailable == true
	-- Días ya reclamados dentro del ciclo actual de 7
	local claimedInCycle = if available then nextIndex - 1 else ((data.DailyStreak or 0) - 1) % #Config.DailyRewards + 1
	if (data.DailyStreak or 0) == 0 then
		claimedInCycle = 0
	end
	streakLabel.Text = ("🔥 Streak: %d day%s"):format(data.DailyStreak or 0, if (data.DailyStreak or 0) == 1 then "" else "s")
	for day, reward in Config.DailyRewards do
		local cell = cells[day]
		if cell then
			local icon, text, color = RewardInfo.Describe(reward, income)
			cell.Icon.Text = icon
			cell.Reward.Text = text
			cell.Reward.TextColor3 = color
			local stroke = cell.Frame:FindFirstChildOfClass("UIStroke")
			if day <= claimedInCycle then
				cell.Status.Text = "✅"
				cell.Frame.BackgroundColor3 = UI.Colors.PanelDark
			elseif available and day == nextIndex then
				cell.Status.Text = "TODAY!"
				cell.Frame.BackgroundColor3 = UI.Darken(UI.Colors.Green, 0.35)
			else
				cell.Status.Text = ""
				cell.Frame.BackgroundColor3 = UI.Colors.PanelLight
			end
			if stroke then
				stroke.Color = if available and day == nextIndex then UI.Colors.Yellow else UI.Colors.Stroke
			end
		end
	end
	Daily.Tick()
end

function Daily.Tick()
	local data = State.Data
	if not data or not claimButton then
		return
	end
	if data.DailyAvailable then
		claimLabel.Text = "🎁 CLAIM!"
		UI.SetButtonColor(claimButton, UI.Colors.Green)
	else
		local remaining = (data.DailyResetAt or 0) - Workspace:GetServerTimeNow()
		claimLabel.Text = "Next in " .. Format.Clock(math.max(0, remaining))
		UI.SetButtonColor(claimButton, UI.Colors.Gray)
		if remaining <= 0 then
			State.Action("RequestSync")
		end
	end
end

return Daily
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">Gifts</string>
              <string name="Source"><![CDATA[-- Regalos por tiempo jugado en la sesión.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local RewardInfo = require(Shared:WaitForChild("RewardInfo"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local State = require(Modules.State)

local Notifications = require(script.Parent.Parent.Controllers.Notifications)

local Gifts = {
	Title = "🎁 FREE GIFTS",
	Color = UI.Colors.Orange,
	Size = UDim2.fromOffset(700, 500),
}

type Cell = { Frame: Frame, Icon: TextLabel, Reward: TextLabel, Button: TextButton, Label: TextLabel }

local cells: { Cell } = {}

function Gifts.Build(window)
	UI.Text({ Name = "Hint", Text = "Stay in the game to unlock more gifts!", Size = UDim2.new(1, 0, 0, 26), TextColor3 = UI.Colors.SubText, Parent = window.Content })
	local holder = UI.New("Frame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 34),
		Size = UDim2.new(1, 0, 1, -34),
		Parent = window.Content,
	})
	UI.Grid(UDim2.fromOffset(150, 120), 10).Parent = holder
	for index, gift in Config.PlaytimeGifts do
		local frame = UI.Panel({ Name = "Gift" .. index, Color = UI.Colors.PanelLight, LayoutOrder = index, Parent = holder })
		local icon = UI.Text({ Name = "Icon", Text = "🎁", Size = UDim2.new(1, 0, 0, 36), Position = UDim2.new(0, 0, 0, 4), StrokeThickness = 0, Parent = frame })
		local reward = UI.Text({ Name = "Reward", Text = "", Size = UDim2.new(1, -10, 0, 24), Position = UDim2.new(0.5, 0, 0, 42), AnchorPoint = Vector2.new(0.5, 0), Parent = frame })
		local button, label = UI.Button({
			Name = "Claim",
			Text = "",
			Color = UI.Colors.Gray,
			Size = UDim2.new(1, -16, 0, 38),
			Position = UDim2.new(0.5, 0, 1, -8),
			AnchorPoint = Vector2.new(0.5, 1),
			OnClick = function()
				local ok, message = State.Action("ClaimGift", { Index = index })
				if message then
					Notifications.Show(message, if ok then "Success" else "Error")
				end
			end,
			Parent = frame,
		})
		cells[index] = { Frame = frame, Icon = icon, Reward = reward, Button = button, Label = label }
		local _ = gift
	end
end

function Gifts.Refresh(data)
	local income = data.RewardBase or 1
	for index, gift in Config.PlaytimeGifts do
		local cell = cells[index]
		if cell then
			local icon, text, color = RewardInfo.Describe(gift, income)
			cell.Icon.Text = icon
			cell.Reward.Text = text
			cell.Reward.TextColor3 = color
		end
	end
	Gifts.Tick()
end

function Gifts.Tick()
	local data = State.Data
	if not data then
		return
	end
	local elapsed = Workspace:GetServerTimeNow() - (data.SessionStart or Workspace:GetServerTimeNow())
	for index, gift in Config.PlaytimeGifts do
		local cell = cells[index]
		if cell then
			local claimed = data.GiftsClaimed and data.GiftsClaimed[tostring(index)]
			local remaining = gift.Minutes * 60 - elapsed
			if claimed then
				cell.Label.Text = "✅ CLAIMED"
				UI.SetButtonColor(cell.Button, UI.Colors.Gray)
			elseif remaining <= 0 then
				cell.Label.Text = "CLAIM!"
				UI.SetButtonColor(cell.Button, UI.Colors.Green)
			else
				cell.Label.Text = Format.Clock(remaining)
				UI.SetButtonColor(cell.Button, UI.Colors.PanelDark)
			end
		end
	end
end

return Gifts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">Index</string>
              <string name="Source"><![CDATA[-- Index: todas las criaturas por huevo (normal y shiny). Las no descubiertas, en silueta.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Critters = require(Shared:WaitForChild("Critters"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Models = require(Shared:WaitForChild("Models"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local State = require(Modules.State)

local Index = {
	Title = "📖 CRITTER INDEX",
	Color = UI.Colors.Purple,
	Size = UDim2.fromOffset(780, 520),
}

type Cell = { Frame: Frame, Viewport: ViewportFrame, Name: TextLabel, Key: string? }

local summary: TextLabel
local cells: { Cell } = {}
local eggButtons: { TextButton } = {}
local currentEgg = 1

local function setModel(cell: Cell, critterId: string, shiny: boolean, discovered: boolean)
	local key = critterId .. tostring(shiny) .. tostring(discovered)
	if cell.Key == key then
		return
	end
	cell.Key = key
	for _, child in cell.Viewport:GetChildren() do
		if child:IsA("Model") then
			child:Destroy()
		end
	end
	local model = Models.BuildCritter(critterId, { Shiny = shiny, NoEffects = true, Silhouette = not discovered })
	local height = (model:GetAttribute("Height") :: number?) or 2
	local camera = cell.Viewport.CurrentCamera
	if camera then
		camera.CFrame = CFrame.lookAt(Vector3.new(height * 0.4, height * 0.8, -height * 2.6 - 1.5), Vector3.new(0, height * 0.5, 0))
	end
	model.Parent = cell.Viewport
end

local function setEgg(index: number)
	currentEgg = index
	for i, button in eggButtons do
		UI.SetButtonColor(button, if i == index then UI.Colors.Purple else UI.Colors.Gray)
	end
	if State.Data then
		Index.Refresh(State.Data)
	end
end

function Index.Build(window)
	local content = window.Content
	summary = UI.Text({ Name = "Summary", Text = "", Size = UDim2.new(1, 0, 0, 28), TextColor3 = UI.Colors.Yellow, Parent = content })
	local tabs = UI.New("Frame", { Name = "Eggs", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 0, 32), Parent = content })
	UI.List(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center).Parent = tabs
	for i, egg in Critters.Eggs do
		eggButtons[i] = UI.Button({
			Name = "Egg" .. i,
			Text = string.gsub(egg.Name, " Egg", ""),
			Color = UI.Colors.Gray,
			Size = UDim2.fromOffset(112, 38),
			LayoutOrder = i,
			OnClick = function()
				setEgg(i)
			end,
			Parent = tabs,
		})
	end
	local grid = UI.New("Frame", { Name = "Grid", BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 80), Size = UDim2.new(1, 0, 1, -80), Parent = content })
	UI.Grid(UDim2.fromOffset(118, 168), 8).Parent = grid
	for slot = 1, 12 do
		local frame = UI.Panel({ Name = "Cell" .. slot, Color = UI.Colors.PanelLight, LayoutOrder = slot, Parent = grid })
		local viewport = UI.New("ViewportFrame", {
			Name = "Viewport",
			BackgroundColor3 = UI.Colors.PanelDark,
			Size = UDim2.new(1, -10, 0, 112),
			Position = UDim2.new(0.5, 0, 0, 5),
			AnchorPoint = Vector2.new(0.5, 0),
			Ambient = Color3.fromRGB(200, 200, 200),
			LightDirection = Vector3.new(-1, -1, 1),
			Parent = frame,
		}, { UI.Corner(10) })
		local camera = Instance.new("Camera")
		camera.FieldOfView = 40
		camera.Parent = viewport
		viewport.CurrentCamera = camera
		local name = UI.Text({ Name = "CritterName", Text = "", Size = UDim2.new(1, -8, 0, 22), Position = UDim2.new(0.5, 0, 0, 120), AnchorPoint = Vector2.new(0.5, 0), Parent = frame })
		cells[slot] = { Frame = frame, Viewport = viewport, Name = name, Key = nil }
	end
	setEgg(1)
end

function Index.Refresh(data)
	local index = data.Index or {}
	summary.Text = ("Discovered %d/%d (normal + ✨shiny)"):format(data.IndexCount or 0, data.IndexTotal or Critters.Count() * 2)
	local list = Critters.ByEgg[currentEgg] or {}
	for slot, cell in cells do
		local def = list[((slot - 1) % #list) + 1]
		local shiny = slot > #list
		if def then
			local variant = if shiny then "Shiny" else "Normal"
			local discovered = index[def.Id] ~= nil and index[def.Id][variant] == true
			setModel(cell, def.Id, shiny, discovered)
			cell.Name.Text = if discovered then (if shiny then "✨" else "") .. def.Name else "???"
			cell.Name.TextColor3 = if discovered then Rarities.Get(def.Rarity).Color else UI.Colors.SubText
		end
	end
end

return Index
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Quests</string>
              <string name="Source"><![CDATA[-- Misiones diarias.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Quests = require(Shared:WaitForChild("Quests"))
local Format = require(Shared:WaitForChild("Format"))
local RewardInfo = require(Shared:WaitForChild("RewardInfo"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local State = require(Modules.State)

local Notifications = require(script.Parent.Parent.Controllers.Notifications)

local QuestsWindow = {
	Title = "📜 DAILY QUESTS",
	Color = UI.Colors.Yellow,
	Size = UDim2.fromOffset(640, 470),
}

type Row = { Title: TextLabel, Fill: Frame, Progress: TextLabel, Button: TextButton, Label: TextLabel, Reward: TextLabel }

local rows: { Row } = {}
local resetLabel: TextLabel
local bonusButton: TextButton
local bonusLabel: TextLabel

local function act(name: string, payload: { [string]: any }?)
	local ok, message = State.Action(name, payload)
	if message then
		Notifications.Show(message, if ok then "Success" else "Error")
	end
end

function QuestsWindow.Build(window)
	local content = window.Content
	resetLabel = UI.Text({ Name = "Reset", Text = "", Size = UDim2.new(1, 0, 0, 26), TextColor3 = UI.Colors.SubText, Parent = content })
	for i = 1, Quests.PerDay do
		local frame = UI.Panel({ Name = "Quest" .. i, Color = UI.Colors.PanelLight, Size = UDim2.new(1, 0, 0, 92), Position = UDim2.new(0, 0, 0, 32 + (i - 1) * 100), Parent = content })
		local title = UI.Text({ Name = "QuestTitle", Text = "", Size = UDim2.new(1, -210, 0, 30), Position = UDim2.new(0, 14, 0, 8), TextXAlignment = Enum.TextXAlignment.Left, Parent = frame })
		local bar = UI.Panel({ Name = "Bar", Color = UI.Colors.PanelDark, Size = UDim2.new(1, -210, 0, 26), Position = UDim2.new(0, 14, 0, 46), CornerRadius = 10, Parent = frame })
		local fill = UI.New("Frame", { Name = "Fill", BackgroundColor3 = UI.Colors.Green, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), Parent = bar }, { UI.Corner(10) })
		local progress = UI.Text({ Name = "ProgressText", Text = "", Size = UDim2.new(1, -10, 0.8, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3, Parent = bar })
		local reward = UI.Text({ Name = "Reward", Text = "", Size = UDim2.fromOffset(170, 22), Position = UDim2.new(1, -14, 0, 8), AnchorPoint = Vector2.new(1, 0), TextColor3 = Color3.fromRGB(255, 225, 100), Parent = frame })
		local button, label = UI.Button({
			Name = "Claim",
			Text = "",
			Color = UI.Colors.Gray,
			Size = UDim2.fromOffset(170, 44),
			Position = UDim2.new(1, -14, 1, -10),
			AnchorPoint = Vector2.new(1, 1),
			OnClick = function()
				act("ClaimQuest", { Index = i })
			end,
			Parent = frame,
		})
		rows[i] = { Title = title, Fill = fill, Progress = progress, Button = button, Label = label, Reward = reward }
	end
	bonusButton, bonusLabel = UI.Button({
		Name = "Bonus",
		Text = "",
		Color = UI.Colors.Gray,
		Size = UDim2.fromOffset(380, 56),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		OnClick = function()
			act("ClaimQuestBonus")
		end,
		Parent = content,
	})
end

function QuestsWindow.Refresh(data)
	local quests = data.Quests
	if not quests or not quests.List then
		return
	end
	local allClaimed = true
	for i, row in rows do
		local quest = quests.List[i]
		if quest then
			row.Title.Text = Quests.Describe(quest.Kind, quest.Target)
			row.Fill.Size = UDim2.fromScale(math.clamp(quest.Progress / quest.Target, 0, 1), 1)
			row.Progress.Text = ("%s / %s"):format(Format.Abbreviate(quest.Progress), Format.Abbreviate(quest.Target))
			row.Reward.Text = "+" .. Format.Abbreviate(math.floor((data.RewardBase or 1) * quest.RewardMeteors)) .. " ⭐"
			if quest.Claimed then
				row.Label.Text = "✅ DONE"
				UI.SetButtonColor(row.Button, UI.Colors.Gray)
			elseif quest.Progress >= quest.Target then
				row.Label.Text = "CLAIM!"
				UI.SetButtonColor(row.Button, UI.Colors.Green)
			else
				row.Label.Text = "In progress"
				UI.SetButtonColor(row.Button, UI.Colors.PanelDark)
			end
			allClaimed = allClaimed and quest.Claimed
		end
	end
	local _, bonusText = RewardInfo.Describe(Quests.Bonus, data.RewardBase or 1)
	if quests.BonusClaimed then
		bonusLabel.Text = "🏆 Bonus claimed! Come back tomorrow"
		UI.SetButtonColor(bonusButton, UI.Colors.Gray)
	elseif allClaimed then
		bonusLabel.Text = "🏆 CLAIM BONUS: " .. bonusText
		UI.SetButtonColor(bonusButton, UI.Colors.Green)
	else
		bonusLabel.Text = "🏆 Finish all 3: " .. bonusText
		UI.SetButtonColor(bonusButton, UI.Colors.PanelDark)
	end
	QuestsWindow.Tick()
end

function QuestsWindow.Tick()
	local data = State.Data
	if data and resetLabel then
		resetLabel.Text = "New quests in " .. Format.Clock((data.QuestsResetAt or 0) - Workspace:GetServerTimeNow())
	end
end

return QuestsWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">Rebirth</string>
              <string name="Source"><![CDATA[-- 🌟 Supernova (rebirth): ventajas, coste y progreso.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local State = require(Modules.State)

local Notifications = require(script.Parent.Parent.Controllers.Notifications)

local Rebirth = {
	Title = "🌟 SUPERNOVA",
	Color = UI.Colors.Pink,
	Size = UDim2.fromOffset(600, 480),
}

local headline: TextLabel
local perkLabels: { TextLabel } = {}
local progressFill: Frame
local progressText: TextLabel
local button: TextButton
local buttonLabel: TextLabel

function Rebirth.Build(window)
	local content = window.Content
	headline = UI.Text({ Name = "Headline", Text = "", Size = UDim2.new(1, 0, 0, 44), StrokeThickness = 3, Parent = content })
	local perks = UI.Panel({ Name = "Perks", Color = UI.Colors.PanelDark, Size = UDim2.new(1, 0, 0, 170), Position = UDim2.new(0, 0, 0, 52), Parent = content })
	UI.List(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center).Parent = perks
	UI.Padding(8, 16, 8, 16).Parent = perks
	for i = 1, 5 do
		perkLabels[i] = UI.Text({ Name = "Perk" .. i, Text = "", Size = UDim2.new(1, 0, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = i, Parent = perks })
	end
	UI.Text({ Name = "Warning", Text = "⚠️ Resets stardust, pickaxes & zones. You KEEP your critters!", TextColor3 = Color3.fromRGB(255, 160, 140), Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 0, 230), Parent = content })
	local bar = UI.Panel({ Name = "Progress", Color = UI.Colors.PanelDark, Size = UDim2.new(1, -20, 0, 38), Position = UDim2.new(0.5, 0, 0, 266), AnchorPoint = Vector2.new(0.5, 0), Parent = content })
	progressFill = UI.New("Frame", { Name = "Fill", BackgroundColor3 = UI.Colors.Pink, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), Parent = bar }, { UI.Corner(12) })
	progressText = UI.Text({ Name = "Text", Text = "", Size = UDim2.new(1, -16, 0.75, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3, Parent = bar })
	button, buttonLabel = UI.Button({
		Name = "Supernova",
		Text = "SUPERNOVA",
		Color = UI.Colors.Gray,
		Size = UDim2.fromOffset(280, 62),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		OnClick = function()
			local ok, message = State.Action("Rebirth")
			if message then
				Notifications.Show(message, if ok then "Success" else "Error")
			end
		end,
		Parent = content,
	})
end

function Rebirth.Refresh(data)
	local rebirths = data.Rebirths or 0
	local passes = data.Passes or {}
	headline.Text = ("Supernova %d  ➜  %d"):format(rebirths, rebirths + 1)
	perkLabels[1].Text = ("⭐ Stardust bonus: +%d%%  ➜  +%d%%"):format(math.floor(rebirths * Config.Rebirth.StardustBonus * 100 + 0.5), math.floor((rebirths + 1) * Config.Rebirth.StardustBonus * 100 + 0.5))
	perkLabels[2].Text = ("⚔️ Damage bonus: +%d%%  ➜  +%d%%"):format(math.floor(rebirths * Config.Rebirth.DamageBonus * 100 + 0.5), math.floor((rebirths + 1) * Config.Rebirth.DamageBonus * 100 + 0.5))
	perkLabels[3].Text = ("🐾 Critter slots: %d  ➜  %d"):format(Economy.GetSlotCount(rebirths, passes.ExtraSlots == true), Economy.GetSlotCount(rebirths + 1, passes.ExtraSlots == true))
	perkLabels[4].Text = "🌟 Supernova tag above your head"
	perkLabels[5].Text = "🐾 Your critters, upgrades & index stay!"
	Rebirth.Tick()
end

function Rebirth.Tick()
	local data = State.Data
	if not data or not progressFill then
		return
	end
	local cost = data.RebirthCost or math.huge
	local stardust = State.Stardust()
	progressFill.Size = UDim2.fromScale(math.clamp(stardust / cost, 0, 1), 1)
	progressText.Text = ("%s / %s ⭐"):format(Format.Abbreviate(stardust), Format.Abbreviate(cost))
	local ready = stardust >= cost
	UI.SetButtonColor(button, if ready then UI.Colors.Pink else UI.Colors.Gray)
	buttonLabel.Text = if ready then "🌟 GO SUPERNOVA!" else "Need " .. Format.Abbreviate(math.max(0, cost - stardust)) .. " ⭐"
end

return Rebirth
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- Tienda (Stardust): picos y mejoras permanentes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Gear = require(Shared:WaitForChild("Gear"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Products = require(Shared:WaitForChild("Products"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local State = require(Modules.State)
local Purchase = require(Modules.Purchase)

local Notifications = require(script.Parent.Parent.Controllers.Notifications)

local Shop = {
	Title = "⛏️ SHOP",
	Color = UI.Colors.Green,
	Size = UDim2.fromOffset(720, 490),
}

type Row = { Button: TextButton, Label: TextLabel, Info: TextLabel }

local tabs: { [string]: ScrollingFrame } = {}
local tabButtons: { [string]: TextButton } = {}
local pickRows: { [string]: Row } = {}
local upgradeRows: { [string]: Row } = {}
local currentTab = "Pickaxes"

local function scrolling(parent: Instance, name: string): ScrollingFrame
	local frame = UI.New("ScrollingFrame", {
		Name = name,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 58),
		Size = UDim2.new(1, 0, 1, -58),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	})
	UI.List(Enum.FillDirection.Vertical, 10).Parent = frame
	UI.Padding(4, 12, 8, 4).Parent = frame
	return frame
end

local function setTab(name: string)
	currentTab = name
	for tabName, frame in tabs do
		frame.Visible = tabName == name
		UI.SetButtonColor(tabButtons[tabName], if tabName == name then UI.Colors.Blue else UI.Colors.Gray)
	end
end

local function row(parent: Instance, order: number, icon: string, title: string, onClick: () -> ()): Row
	local frame = UI.Panel({ Name = "Row", Color = UI.Colors.PanelLight, Size = UDim2.new(1, 0, 0, 86), LayoutOrder = order, Parent = parent })
	local iconBox = UI.Panel({ Name = "Icon", Color = UI.Colors.PanelDark, Size = UDim2.fromOffset(66, 66), Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = frame })
	UI.Text({ Text = icon, Size = UDim2.fromScale(0.75, 0.75), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), StrokeThickness = 0, Parent = iconBox })
	UI.Text({ Name = "Title", Text = title, Size = UDim2.new(1, -280, 0, 32), Position = UDim2.new(0, 88, 0, 10), TextXAlignment = Enum.TextXAlignment.Left, Parent = frame })
	local info = UI.Text({ Name = "Info", Text = "", Size = UDim2.new(1, -280, 0, 24), Position = UDim2.new(0, 88, 0, 48), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.SubText, Parent = frame })
	local button, label = UI.Button({ Name = "Action", Text = "", Size = UDim2.fromOffset(170, 54), Position = UDim2.new(1, -12, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), OnClick = onClick, Parent = frame })
	return { Button = button, Label = label, Info = info }
end

local function act(name: string, payload: { [string]: any })
	local ok, message = State.Action(name, payload)
	if message then
		Notifications.Show(message, if ok then "Success" else "Error")
	end
end

function Shop.Build(window)
	local content = window.Content
	local tabBar = UI.New("Frame", { Name = "Tabs", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), Parent = content })
	UI.List(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left).Parent = tabBar
	for index, def in { { "Pickaxes", "⛏️ Pickaxes" }, { "Upgrades", "⬆️ Upgrades" } } do
		tabButtons[def[1]] = UI.Button({
			Name = def[1],
			Text = def[2],
			Color = UI.Colors.Gray,
			Size = UDim2.fromOffset(180, 46),
			LayoutOrder = index,
			OnClick = function()
				setTab(def[1])
			end,
			Parent = tabBar,
		})
	end

	tabs.Pickaxes = scrolling(content, "Pickaxes")
	for index, pick in Gear.Pickaxes do
		pickRows[pick.Id] = row(tabs.Pickaxes, index, pick.Icon, pick.Name, function()
			local data = State.Data
			if not data then
				return
			end
			if pick.GamePass then
				if data.Passes and data.Passes[pick.GamePass] then
					act("EquipPickaxe", { Id = pick.Id })
				else
					Purchase.PromptPass(pick.GamePass)
				end
			elseif data.OwnedPickaxes and data.OwnedPickaxes[pick.Id] then
				act("EquipPickaxe", { Id = pick.Id })
			else
				act("BuyPickaxe", { Id = pick.Id })
			end
		end)
		pickRows[pick.Id].Info.Text = ("⚔️ %s damage  •  ⏱ %.2fs"):format(Format.Abbreviate(pick.Damage), pick.Cooldown)
	end

	tabs.Upgrades = scrolling(content, "Upgrades")
	for index, key in Gear.UpgradeOrder do
		local def = Gear.Upgrades[key]
		upgradeRows[key] = row(tabs.Upgrades, index, def.Icon, def.Name, function()
			act("BuyUpgrade", { Key = key })
		end)
	end
	setTab(currentTab)
end

function Shop.Refresh(data)
	local stardust = State.Stardust()
	local bestTier = 1
	for id in data.OwnedPickaxes or {} do
		local pick = Gear.GetPickaxe(id)
		if pick and not pick.GamePass then
			bestTier = math.max(bestTier, Gear.GetTier(id))
		end
	end
	for index, pick in Gear.Pickaxes do
		local refs = pickRows[pick.Id]
		if refs then
			local owned = if pick.GamePass then (data.Passes and data.Passes[pick.GamePass]) == true else (data.OwnedPickaxes and data.OwnedPickaxes[pick.Id]) == true
			if owned and data.ActivePickaxe == pick.Id then
				refs.Label.Text = "EQUIPPED"
				UI.SetButtonColor(refs.Button, UI.Colors.Gray)
			elseif owned then
				refs.Label.Text = "EQUIP"
				UI.SetButtonColor(refs.Button, UI.Colors.Blue)
			elseif pick.GamePass then
				local passDef = Products.GamePasses[pick.GamePass]
				refs.Label.Text = "R$ " .. (if passDef then passDef.PriceHint else "?")
				UI.SetButtonColor(refs.Button, UI.Colors.Pink)
				Purchase.GetPrice("Pass", pick.GamePass, function(price)
					refs.Label.Text = "R$ " .. price
				end)
			elseif index > bestTier + 1 then
				refs.Label.Text = "🔒 " .. Format.Abbreviate(pick.Price)
				UI.SetButtonColor(refs.Button, UI.Colors.Gray)
			else
				refs.Label.Text = Format.Abbreviate(pick.Price) .. " ⭐"
				UI.SetButtonColor(refs.Button, if stardust >= pick.Price then UI.Colors.Green else UI.Colors.Red)
			end
		end
	end
	for key, refs in upgradeRows do
		local def = Gear.Upgrades[key]
		local level = (data.Upgrades and data.Upgrades[key]) or 0
		refs.Info.Text = ("%s  •  Lv %d/%d"):format(def.Description, level, def.MaxLevel)
		if level >= def.MaxLevel then
			refs.Label.Text = "MAX"
			UI.SetButtonColor(refs.Button, UI.Colors.Gray)
		else
			local cost = Economy.GetUpgradeCost(key, level)
			refs.Label.Text = Format.Abbreviate(cost) .. " ⭐"
			UI.SetButtonColor(refs.Button, if stardust >= cost then UI.Colors.Green else UI.Colors.Red)
		end
	end
end

function Shop.Tick()
	if State.Data then
		Shop.Refresh(State.Data)
	end
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">Store</string>
              <string name="Source"><![CDATA[-- Tienda de Robux: Game Passes y Developer Products.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared:WaitForChild("Products"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local Purchase = require(Modules.Purchase)

local Store = {
	Title = "💎 STORE",
	Color = UI.Colors.Pink,
	Size = UDim2.fromOffset(720, 500),
}

local passButtons: { [string]: { Button: TextButton, Label: TextLabel } } = {}

local function sectionTitle(parent: Instance, text: string, order: number)
	UI.Text({ Name = "Section", Text = text, Size = UDim2.new(1, -20, 0, 36), LayoutOrder = order, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Yellow, StrokeThickness = 3, Parent = parent })
end

local function card(parent: Instance, order: number, icon: string, name: string, description: string, color: Color3, onClick: () -> ()): (TextButton, TextLabel)
	local frame = UI.Panel({ Name = name, Color = UI.Colors.PanelLight, LayoutOrder = order, Parent = parent })
	UI.Gradient(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 200, 215)).Parent = frame
	UI.Text({ Name = "Icon", Text = icon, Size = UDim2.new(1, 0, 0, 52), Position = UDim2.new(0, 0, 0, 6), StrokeThickness = 0, Parent = frame })
	UI.Text({ Name = "Name", Text = name, Size = UDim2.new(1, -12, 0, 28), Position = UDim2.new(0.5, 0, 0, 60), AnchorPoint = Vector2.new(0.5, 0), Parent = frame })
	UI.Text({ Name = "Description", Text = description, Size = UDim2.new(1, -14, 0, 40), Position = UDim2.new(0.5, 0, 0, 90), AnchorPoint = Vector2.new(0.5, 0), TextWrapped = true, TextColor3 = UI.Colors.SubText, StrokeThickness = 1, Parent = frame })
	local button, label = UI.Button({
		Name = "Buy",
		Text = "R$ ...",
		Color = color,
		Size = UDim2.new(1, -20, 0, 42),
		Position = UDim2.new(0.5, 0, 1, -10),
		AnchorPoint = Vector2.new(0.5, 1),
		OnClick = onClick,
		Parent = frame,
	})
	return button, label
end

local function grid(parent: Instance, order: number): Frame
	local frame = UI.New("Frame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -10, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
		Parent = parent,
	})
	UI.Grid(UDim2.fromOffset(200, 196), 12).Parent = frame
	return frame
end

function Store.Build(window)
	local scroll = UI.New("ScrollingFrame", {
		Name = "Scroll",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = window.Content,
	})
	UI.List(Enum.FillDirection.Vertical, 10).Parent = scroll
	UI.Padding(4, 12, 10, 4).Parent = scroll

	sectionTitle(scroll, "🍀 BOOSTS & ITEMS", 1)
	local productGrid = grid(scroll, 2)
	for index, key in Products.ProductOrder do
		local def = Products.DevProducts[key]
		local _, label = card(productGrid, index, def.Icon, def.Name, def.Description, UI.Colors.Green, function()
			Purchase.PromptProduct(key)
		end)
		Purchase.GetPrice("Product", key, function(price)
			label.Text = "R$ " .. price
		end)
	end

	sectionTitle(scroll, "⭐ GAME PASSES (FOREVER)", 3)
	local passGrid = grid(scroll, 4)
	for index, key in Products.PassOrder do
		local def = Products.GamePasses[key]
		local button, label = card(passGrid, index, def.Icon, def.Name, def.Description, UI.Colors.Pink, function()
			Purchase.PromptPass(key)
		end)
		passButtons[key] = { Button = button, Label = label }
	end
end

function Store.Refresh(data)
	for key, refs in passButtons do
		if data.Passes and data.Passes[key] then
			refs.Label.Text = "✅ OWNED"
			UI.SetButtonColor(refs.Button, UI.Colors.Gray)
			refs.Button.Active = false
		else
			UI.SetButtonColor(refs.Button, UI.Colors.Pink)
			Purchase.GetPrice("Pass", key, function(price)
				if not (data.Passes and data.Passes[key]) then
					refs.Label.Text = "R$ " .. price
				end
			end)
		end
	end
end

return Store
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Zones</string>
              <string name="Source"><![CDATA[-- Zonas: desbloquear la siguiente y teletransportarte a las que ya tienes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Zones = require(Shared:WaitForChild("Zones"))
local Format = require(Shared:WaitForChild("Format"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local State = require(Modules.State)

local Windows = require(script.Parent.Parent.Controllers.Windows)
local Notifications = require(script.Parent.Parent.Controllers.Notifications)

local ZonesWindow = {
	Title = "🗺️ ZONES",
	Color = UI.Colors.Blue,
	Size = UDim2.fromOffset(640, 500),
}

local rows: { [number]: { Button: TextButton, Label: TextLabel, Info: TextLabel } } = {}

function ZonesWindow.Build(window)
	local scroll = UI.New("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		Parent = window.Content,
	})
	UI.List(Enum.FillDirection.Vertical, 8).Parent = scroll
	UI.Padding(4, 12, 8, 4).Parent = scroll
	for _, zone in Zones.List do
		local frame = UI.Panel({ Name = zone.Id, Color = UI.Darken(zone.GroundColor, 0.45), Size = UDim2.new(1, 0, 0, 70), LayoutOrder = zone.Index, Parent = scroll })
		UI.Text({ Name = "Icon", Text = zone.Icon, Size = UDim2.fromOffset(54, 54), Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), StrokeThickness = 0, Parent = frame })
		UI.Text({ Name = "ZoneName", Text = zone.Name, Size = UDim2.new(1, -260, 0, 30), Position = UDim2.new(0, 72, 0, 8), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = zone.AccentColor, Parent = frame })
		local info = UI.Text({ Name = "Info", Text = "", Size = UDim2.new(1, -260, 0, 22), Position = UDim2.new(0, 72, 0, 40), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.SubText, Parent = frame })
		local button, label = UI.Button({
			Name = "Action",
			Text = "",
			Size = UDim2.fromOffset(170, 50),
			Position = UDim2.new(1, -10, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			OnClick = function()
				local data = State.Data
				if not data then
					return
				end
				if zone.Index <= (data.Zone or 1) then
					local ok, message = State.Action("TeleportZone", { Zone = zone.Index })
					if ok then
						Windows.Close()
					elseif message then
						Notifications.Show(message, "Error")
					end
				else
					local ok, message = State.Action("UnlockZone", { Zone = zone.Index })
					if message then
						Notifications.Show(message, if ok then "Success" else "Error")
					end
				end
			end,
			Parent = frame,
		})
		rows[zone.Index] = { Button = button, Label = label, Info = info }
	end
end

function ZonesWindow.Refresh(data)
	local unlocked = data.Zone or 1
	local stardust = State.Stardust()
	for index, refs in rows do
		local zone = Zones.Get(index)
		refs.Info.Text = ("Meteor HP from %s  •  loot from %s ⭐"):format(Format.Abbreviate(zone.BaseHP), Format.Abbreviate(zone.BaseLoot))
		if index <= unlocked then
			refs.Label.Text = "🚀 TELEPORT"
			UI.SetButtonColor(refs.Button, UI.Colors.Blue)
		elseif index == unlocked + 1 then
			refs.Label.Text = "🔓 " .. Format.Abbreviate(zone.Cost) .. " ⭐"
			UI.SetButtonColor(refs.Button, if stardust >= zone.Cost then UI.Colors.Green else UI.Colors.Red)
		else
			refs.Label.Text = "🔒 " .. Format.Abbreviate(zone.Cost)
			UI.SetButtonColor(refs.Button, UI.Colors.Gray)
		end
	end
end

function ZonesWindow.Tick()
	if State.Data then
		ZonesWindow.Refresh(State.Data)
	end
end

return ZonesWindow
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="72">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>