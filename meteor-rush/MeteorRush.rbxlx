      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Critters</string>
          <string name="Source"><![CDATA[-- Criaturas cósmicas (mascotas) y huevos. Cada zona tiene su huevo con 6 criaturas.
-- Power = bonus de daño que da al equiparla (0.5 = +50%). Shiny = x2.

local Rarities = require(script.Parent.Rarities)

export type CritterDef = {
	Id: string,
	Name: string,
	Rarity: string,
	Egg: number,
	Power: number,
	Color: Color3,
	Body: string?, -- "Round" | "Bean" | "Wide" | "Drop"
	Features: { string },
	Material: Enum.Material?,
}

export type EggDef = {
	Index: number,
	Name: string,
	Cost: number,
	Color: Color3,
	SpotColor: Color3,
}

local Critters = {}

-- Probabilidad base de cada rareza dentro de un huevo
Critters.RarityChances = {
	Common = 0.55,
	Uncommon = 0.28,
	Rare = 0.12,
	Epic = 0.04,
	Legendary = 0.009,
	Mythic = 0.001,
}

Critters.Eggs = {
	{ Index = 1, Name = "Meadow Egg", Cost = 150, Color = Color3.fromRGB(140, 220, 120), SpotColor = Color3.fromRGB(255, 255, 255) },
	{ Index = 2, Name = "Desert Egg", Cost = 2_000, Color = Color3.fromRGB(240, 200, 120), SpotColor = Color3.fromRGB(200, 120, 60) },
	{ Index = 3, Name = "Frost Egg", Cost = 25_000, Color = Color3.fromRGB(190, 230, 255), SpotColor = Color3.fromRGB(100, 160, 255) },
	{ Index = 4, Name = "Magma Egg", Cost = 350_000, Color = Color3.fromRGB(60, 40, 40), SpotColor = Color3.fromRGB(255, 120, 30) },
	{ Index = 5, Name = "Moon Egg", Cost = 5_000_000, Color = Color3.fromRGB(215, 220, 235), SpotColor = Color3.fromRGB(150, 150, 175) },
	{ Index = 6, Name = "Nebula Egg", Cost = 80_000_000, Color = Color3.fromRGB(70, 40, 120), SpotColor = Color3.fromRGB(255, 160, 255) },
} :: { EggDef }

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

Critters.List = {
	-- 🌿 MEADOW ---------------------------------------------------------
	{ Id = "pebblit", Name = "Pebblit", Rarity = "Common", Egg = 1, Power = 0.1, Color = rgb(150, 140, 125), Features = { "TinyLeaf" }, Material = Enum.Material.Slate },
	{ Id = "sproutling", Name = "Sproutling", Rarity = "Uncommon", Egg = 1, Power = 0.18, Color = rgb(120, 210, 90), Body = "Bean", Features = { "Sprout" } },
	{ Id = "dewdrop", Name = "Dewdrop", Rarity = "Rare", Egg = 1, Power = 0.32, Color = rgb(120, 200, 255), Body = "Drop", Features = {}, Material = Enum.Material.Glass },
	{ Id = "buzzby", Name = "Buzzby", Rarity = "Epic", Egg = 1, Power = 0.6, Color = rgb(255, 215, 60), Features = { "Stripes", "BugWings", "Antennae" } },
	{ Id = "glimmerfox", Name = "Glimmerfox", Rarity = "Legendary", Egg = 1, Power = 1.2, Color = rgb(255, 140, 60), Body = "Bean", Features = { "PointyEars", "FluffyTail", "Sparkle" } },
	{ Id = "starfawn", Name = "Starfawn", Rarity = "Mythic", Egg = 1, Power = 2.5, Color = rgb(255, 232, 200), Body = "Bean", Features = { "Antlers", "StarSpots", "Halo" } },

	-- 🏜️ DESERT ---------------------------------------------------------
	{ Id = "sandmite", Name = "Sandmite", Rarity = "Common", Egg = 2, Power = 0.35, Color = rgb(220, 190, 130), Body = "Wide", Features = { "Mandibles" } },
	{ Id = "cactopup", Name = "Cactopup", Rarity = "Uncommon", Egg = 2, Power = 0.6, Color = rgb(90, 170, 90), Body = "Bean", Features = { "CactusArms", "Flower" } },
	{ Id = "dunebug", Name = "Dune Beetle", Rarity = "Rare", Egg = 2, Power = 1, Color = rgb(140, 90, 50), Body = "Wide", Features = { "Shell", "Horn" } },
	{ Id = "mirage_gecko", Name = "Mirage Gecko", Rarity = "Epic", Egg = 2, Power = 1.9, Color = rgb(80, 220, 200), Features = { "Frill", "LongTail" } },
	{ Id = "sun_scarab", Name = "Sun Scarab", Rarity = "Legendary", Egg = 2, Power = 3.8, Color = rgb(255, 190, 40), Body = "Wide", Features = { "Shell", "SunDisc", "Sparkle" }, Material = Enum.Material.Metal },
	{ Id = "sphinxlet", Name = "Sphinxlet", Rarity = "Mythic", Egg = 2, Power = 8, Color = rgb(230, 190, 120), Features = { "PointyEars", "Headdress", "Halo" } },

	-- ❄️ FROST ----------------------------------------------------------
	{ Id = "snowpuff", Name = "Snowpuff", Rarity = "Common", Egg = 3, Power = 1.1, Color = rgb(245, 250, 255), Features = { "Fluff" } },
	{ Id = "frostfin", Name = "Frostfin", Rarity = "Uncommon", Egg = 3, Power = 1.9, Color = rgb(120, 190, 255), Body = "Wide", Features = { "Fins" } },
	{ Id = "icicub", Name = "Icicub", Rarity = "Rare", Egg = 3, Power = 3.2, Color = rgb(200, 235, 255), Features = { "RoundEars", "IceSpikes" } },
	{ Id = "aurora_owl", Name = "Aurora Owl", Rarity = "Epic", Egg = 3, Power = 6, Color = rgb(150, 120, 255), Body = "Bean", Features = { "OwlTufts", "BirdWings" } },
	{ Id = "glacier_golem", Name = "Glacier Golem", Rarity = "Legendary", Egg = 3, Power = 12, Color = rgb(150, 210, 240), Body = "Wide", Features = { "IceSpikes", "Crystals" }, Material = Enum.Material.Glass },
	{ Id = "frostwyrm", Name = "Frostwyrm", Rarity = "Mythic", Egg = 3, Power = 25, Color = rgb(190, 240, 255), Features = { "Horns", "BatWings", "LongTail" } },

	-- 🌋 MAGMA ----------------------------------------------------------
	{ Id = "emberling", Name = "Emberling", Rarity = "Common", Egg = 4, Power = 3.5, Color = rgb(255, 120, 40), Body = "Drop", Features = { "Flame" } },
	{ Id = "lava_slug", Name = "Lava Slug", Rarity = "Uncommon", Egg = 4, Power = 6, Color = rgb(230, 80, 40), Body = "Wide", Features = { "Antennae", "LavaCracks" } },
	{ Id = "cinderbat", Name = "Cinderbat", Rarity = "Rare", Egg = 4, Power = 10, Color = rgb(60, 40, 45), Features = { "BatWings", "PointyEars" } },
	{ Id = "magmole", Name = "Magmole", Rarity = "Epic", Egg = 4, Power = 19, Color = rgb(140, 70, 50), Body = "Bean", Features = { "Goggles", "Claws" } },
	{ Id = "phoenix_chick", Name = "Phoenix Chick", Rarity = "Legendary", Egg = 4, Power = 38, Color = rgb(255, 150, 40), Features = { "Crest", "BirdWings", "Flame" } },
	{ Id = "obsidian_drake", Name = "Obsidian Drake", Rarity = "Mythic", Egg = 4, Power = 80, Color = rgb(40, 30, 45), Features = { "Horns", "BatWings", "LavaCracks" } },

	-- 🌙 MOON -----------------------------------------------------------
	{ Id = "moonbun", Name = "Moonbun", Rarity = "Common", Egg = 5, Power = 11, Color = rgb(235, 235, 250), Features = { "BunnyEars" } },
	{ Id = "craterpup", Name = "Craterpup", Rarity = "Uncommon", Egg = 5, Power = 19, Color = rgb(160, 160, 175), Features = { "FloppyEars", "Craters" } },
	{ Id = "orbit_owl", Name = "Orbit Owl", Rarity = "Rare", Egg = 5, Power = 32, Color = rgb(90, 110, 180), Body = "Bean", Features = { "OwlTufts", "OrbitRing" } },
	{ Id = "lunar_jelly", Name = "Lunar Jelly", Rarity = "Epic", Egg = 5, Power = 60, Color = rgb(200, 180, 255), Body = "Drop", Features = { "Tentacles", "Glow" }, Material = Enum.Material.Glass },
	{ Id = "astro_axolotl", Name = "Astro Axolotl", Rarity = "Legendary", Egg = 5, Power = 120, Color = rgb(255, 160, 200), Body = "Wide", Features = { "Gills", "Helmet" } },
	{ Id = "moon_dragon", Name = "Moon Dragon", Rarity = "Mythic", Egg = 5, Power = 250, Color = rgb(220, 225, 255), Features = { "Horns", "BatWings", "Crescent" } },

	-- 🌌 NEBULA ---------------------------------------------------------
	{ Id = "stardrop", Name = "Stardrop", Rarity = "Common", Egg = 6, Power = 35, Color = rgb(255, 240, 150), Body = "Drop", Features = { "Sparkle" }, Material = Enum.Material.Neon },
	{ Id = "nebulisk", Name = "Nebulisk", Rarity = "Uncommon", Egg = 6, Power = 60, Color = rgb(150, 90, 220), Features = { "Antennae", "StarSpots" } },
	{ Id = "void_kitten", Name = "Void Kitten", Rarity = "Rare", Egg = 6, Power = 100, Color = rgb(30, 20, 45), Features = { "PointyEars", "LongTail", "Glow" } },
	{ Id = "comet_ray", Name = "Comet Ray", Rarity = "Epic", Egg = 6, Power = 190, Color = rgb(90, 200, 255), Body = "Wide", Features = { "Fins", "CometTail" } },
	{ Id = "galaxy_whale", Name = "Galaxy Whale", Rarity = "Legendary", Egg = 6, Power = 380, Color = rgb(60, 50, 140), Body = "Wide", Features = { "Fins", "StarSpots", "OrbitRing" } },
	{ Id = "celestial_phoenix", Name = "Celestial Phoenix", Rarity = "Mythic", Egg = 6, Power = 800, Color = rgb(255, 230, 255), Features = { "Crest", "BirdWings", "Halo", "Glow" } },
} :: { CritterDef }

local byId: { [string]: CritterDef } = {}
Critters.ByEgg = {} :: { [number]: { CritterDef } }
for index, def in Critters.List do
	assert(byId[def.Id] == nil, "Criatura duplicada: " .. def.Id)
	assert(Critters.RarityChances[def.Rarity], "Rareza sin probabilidad: " .. def.Rarity)
	byId[def.Id] = def
	Critters.ByEgg[def.Egg] = Critters.ByEgg[def.Egg] or {}
	table.insert(Critters.ByEgg[def.Egg], def)
	;(def :: any).CatalogIndex = index
end

function Critters.Get(id: string): CritterDef?
	return byId[id]
end

function Critters.Exists(id: string): boolean
	return byId[id] ~= nil
end

function Critters.GetEgg(index: number): EggDef?
	return Critters.Eggs[index]
end

function Critters.GetPower(id: string, shiny: boolean?): number
	local def = byId[id]
	if not def then
		return 0
	end
	return def.Power * (if shiny then 2 else 1)
end

-- Probabilidades del huevo con suerte aplicada (las rarezas altas suben)
function Critters.GetEggChances(eggIndex: number, luck: number): { { Id: string, Chance: number } }
	local list = Critters.ByEgg[eggIndex] or {}
	local weights = {}
	local total = 0
	for _, def in list do
		local order = Rarities.Order(def.Rarity)
		local boost = if order >= 3 then luck ^ ((order - 2) / 2) else 1
		local weight = Critters.RarityChances[def.Rarity] * boost
		table.insert(weights, { Id = def.Id, Chance = weight })
		total += weight
	end
	for _, entry in weights do
		entry.Chance /= total
	end
	return weights
end

function Critters.Roll(rng: Random, eggIndex: number, luck: number): string
	local chances = Critters.GetEggChances(eggIndex, luck)
	local roll = rng:NextNumber()
	for _, entry in chances do
		roll -= entry.Chance
		if roll <= 0 then
			return entry.Id
		end
	end
	return chances[1].Id
end

function Critters.OfRarity(eggIndex: number, rarity: string): string?
	for _, def in Critters.ByEgg[eggIndex] or {} do
		if def.Rarity == rarity then
			return def.Id
		end
	end
	return nil
end

function Critters.Count(): number
	return #Critters.List
end

return Critters
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[-- Fórmulas de economía (puras). Las usan servidor y cliente.

local Config = require(script.Parent.Config)
local Rarities = require(script.Parent.Rarities)
local Zones = require(script.Parent.Zones)
local Gear = require(script.Parent.Gear)
local Critters = require(script.Parent.Critters)

local Economy = {}

export type StardustContext = {
	Rebirths: number,
	Friends: number,
	VIP: boolean,
	Premium: boolean,
	InGroup: boolean,
	DoubleStardust: boolean,
	Boost: boolean,
	EventMultiplier: number,
}

export type DamageContext = {
	CritterBonus: number,
	Rebirths: number,
	VIP: boolean,
	DamageBoost: boolean,
}

type Breakdown = { { Label: string, Value: string } }

local function pct(value: number): string
	return "+" .. tostring(math.floor(value * 100 + 0.5)) .. "%"
end

-- ---------------------------------------------------------------------
-- Meteoritos
-- ---------------------------------------------------------------------
function Economy.GetMeteorHP(zoneIndex: number, rarity: string): number
	return math.floor(Zones.Get(zoneIndex).BaseHP * Rarities.Get(rarity).HpMult)
end

function Economy.GetMeteorLoot(zoneIndex: number, rarity: string): number
	return Zones.Get(zoneIndex).BaseLoot * Rarities.Get(rarity).LootMult
end

function Economy.GetRarityWeights(luck: number): { { Name: string, Weight: number } }
	local list = {}
	for _, rarity in Rarities.List do
		table.insert(list, { Name = rarity.Name, Weight = rarity.Weight * (luck ^ ((rarity.Order - 1) / 3)) })
	end
	return list
end

function Economy.GetRarityChances(luck: number): { [string]: number }
	local weights = Economy.GetRarityWeights(luck)
	local total = 0
	for _, entry in weights do
		total += entry.Weight
	end
	local chances = {}
	for _, entry in weights do
		chances[entry.Name] = entry.Weight / total
	end
	return chances
end

function Economy.RollMeteorRarity(rng: Random, luck: number): string
	local weights = Economy.GetRarityWeights(luck)
	local total = 0
	for _, entry in weights do
		total += entry.Weight
	end
	local roll = rng:NextNumber() * total
	for _, entry in weights do
		roll -= entry.Weight
		if roll <= 0 then
			return entry.Name
		end
	end
	return weights[1].Name
end

-- ---------------------------------------------------------------------
-- Progresión
-- ---------------------------------------------------------------------
function Economy.GetRebirthCost(rebirths: number): number
	return Config.Rebirth.BaseCost * (Config.Rebirth.CostGrowth ^ rebirths)
end

function Economy.GetSlotCount(rebirths: number, hasExtraSlots: boolean): number
	local slots = Config.Critters.BaseSlots + math.min(rebirths * Config.Critters.SlotsPerRebirth, Config.Critters.MaxSlotsFromRebirth)
	if hasExtraSlots then
		slots += Config.Critters.PassSlots
	end
	return slots
end

function Economy.GetWalkSpeed(speedLevel: number, hasBoots: boolean): number
	local speed = Config.Player.BaseWalkSpeed + speedLevel * Config.Player.SpeedPerLevel
	if hasBoots then
		speed += Config.Player.BootsSpeed
	end
	return speed
end

function Economy.GetUpgradeCost(key: string, level: number): number
	local def = Gear.Upgrades[key]
	if not def then
		return math.huge
	end
	return math.floor(def.BaseCost * (def.CostGrowth ^ level))
end

function Economy.GetCritChance(level: number): number
	return Config.Mining.BaseCritChance + level * Config.Mining.CritPerLevel
end

function Economy.GetHatchLuck(level: number, hasLuckyPass: boolean): number
	local luck = 1 + level * Config.Critters.LuckPerLevel
	if hasLuckyPass then
		luck *= Config.Critters.LuckyPassMultiplier
	end
	return luck
end

-- ---------------------------------------------------------------------
-- Multiplicadores
-- ---------------------------------------------------------------------
function Economy.GetStardustMultiplier(ctx: StardustContext): (number, Breakdown)
	local breakdown = {}
	local additive = 1
	if ctx.Rebirths > 0 then
		local bonus = ctx.Rebirths * Config.Rebirth.StardustBonus
		additive += bonus
		table.insert(breakdown, { Label = "Supernovas", Value = pct(bonus) })
	end
	if ctx.Friends > 0 then
		local bonus = math.min(ctx.Friends * Config.Income.FriendBonus, Config.Income.MaxFriendBonus)
		additive += bonus
		table.insert(breakdown, { Label = "Friends", Value = pct(bonus) })
	end
	if ctx.VIP then
		additive += Config.Income.VipStardust
		table.insert(breakdown, { Label = "VIP", Value = pct(Config.Income.VipStardust) })
	end
	if ctx.Premium then
		additive += Config.Income.PremiumBonus
		table.insert(breakdown, { Label = "Premium", Value = pct(Config.Income.PremiumBonus) })
	end
	if ctx.InGroup then
		additive += Config.Income.GroupBonus
		table.insert(breakdown, { Label = "Group", Value = pct(Config.Income.GroupBonus) })
	end
	local total = additive
	if ctx.DoubleStardust then
		total *= Config.Income.DoubleStardust
		table.insert(breakdown, { Label = "2x Stardust", Value = "x" .. Config.Income.DoubleStardust })
	end
	if ctx.Boost then
		total *= Config.Income.BoostMultiplier
		table.insert(breakdown, { Label = "Stardust Boost", Value = "x" .. Config.Income.BoostMultiplier })
	end
	if ctx.EventMultiplier ~= 1 then
		total *= ctx.EventMultiplier
		table.insert(breakdown, { Label = "Event", Value = "x" .. ctx.EventMultiplier })
	end
	return total, breakdown
end

function Economy.GetDamageMultiplier(ctx: DamageContext): (number, Breakdown)
	local breakdown = {}
	local total = 1 + ctx.CritterBonus
	if ctx.CritterBonus > 0 then
		table.insert(breakdown, { Label = "Critters", Value = pct(ctx.CritterBonus) })
	end
	if ctx.Rebirths > 0 then
		local bonus = ctx.Rebirths * Config.Rebirth.DamageBonus
		total *= 1 + bonus
		table.insert(breakdown, { Label = "Supernovas", Value = pct(bonus) })
	end
	if ctx.VIP then
		total *= 1 + Config.Income.VipDamage
		table.insert(breakdown, { Label = "VIP", Value = pct(Config.Income.VipDamage) })
	end
	if ctx.DamageBoost then
		total *= Config.Income.BoostMultiplier
		table.insert(breakdown, { Label = "Damage Boost", Value = "x" .. Config.Income.BoostMultiplier })
	end
	return total, breakdown
end

function Economy.GetHitDamage(pickaxeId: string, damageMultiplier: number): number
	local pick = Gear.GetPickaxe(pickaxeId) or Gear.Pickaxes[1]
	return pick.Damage * damageMultiplier
end

-- Suma de poder de las criaturas equipadas
function Economy.GetCritterBonus(equipped: { { Id: string, Shiny: boolean? } }): number
	local total = 0
	for _, entry in equipped do
		total += Critters.GetPower(entry.Id, entry.Shiny)
	end
	return total
end

-- ---------------------------------------------------------------------
-- Recompensas que escalan con el progreso (valor de N meteoritos medios)
-- ---------------------------------------------------------------------
local AVERAGE_LOOT = Rarities.AverageLootMult()

function Economy.GetRewardBase(bestZone: number, stardustMultiplier: number): number
	return Zones.Get(bestZone).BaseLoot * AVERAGE_LOOT * stardustMultiplier
end

function Economy.ScaleReward(minimum: number?, rewardBase: number, meteors: number?): number
	local scaled = if meteors then rewardBase * meteors else 0
	return math.floor(math.max(minimum or 0, scaled))
end

-- ---------------------------------------------------------------------
-- Index / clasificaciones
-- ---------------------------------------------------------------------
function Economy.CountIndex(index: { [string]: { [string]: boolean } }?): number
	local count = 0
	if not index then
		return 0
	end
	for critterId, variants in index do
		if Critters.Exists(critterId) then
			if variants.Normal then
				count += 1
			end
			if variants.Shiny then
				count += 1
			end
		end
	end
	return count
end

function Economy.GetIndexTotal(): number
	return Critters.Count() * 2
end

function Economy.EncodeScore(value: number): number
	if value <= 0 then
		return 0
	end
	return math.floor(math.log10(value + 1) * 1e10)
end

function Economy.DecodeScore(encoded: number): number
	if encoded <= 0 then
		return 0
	end
	return math.max(0, 10 ^ (encoded / 1e10) - 1)
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[-- Utilidades de formato: números abreviados ($1.25M), tiempos, etc.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "Ud", "Dd", "Td" }

local function stripZeros(text: string): string
	if string.find(text, ".", 1, true) then
		text = (string.gsub(text, "0+$", ""))
		text = (string.gsub(text, "%.$", ""))
	end
	return text
end

function Format.Abbreviate(n: number): string
	if n ~= n or n == math.huge or n == -math.huge then
		return "0"
	end
	local negative = n < 0
	local value = math.abs(n)
	local text: string
	if value < 1000 then
		if value < 10 and value % 1 ~= 0 then
			text = stripZeros(string.format("%.1f", math.floor(value * 10) / 10))
		else
			text = tostring(math.floor(value))
		end
	else
		local tier = math.floor(math.log10(value) / 3)
		if tier >= #SUFFIXES then
			text = string.format("%.2e", value)
		else
			local scaled = value / (10 ^ (tier * 3))
			if scaled >= 100 then
				text = tostring(math.floor(scaled))
			elseif scaled >= 10 then
				text = stripZeros(string.format("%.1f", math.floor(scaled * 10) / 10))
			else
				text = stripZeros(string.format("%.2f", math.floor(scaled * 100) / 100))
			end
			text ..= SUFFIXES[tier + 1]
		end
	end
	return (if negative then "-" else "") .. text
end

function Format.Money(n: number): string
	return "$" .. Format.Abbreviate(n)
end

function Format.PerSecond(n: number): string
	return "$" .. Format.Abbreviate(n) .. "/s"
end

function Format.Commas(n: number): string
	local text = tostring(math.floor(math.abs(n)))
	local result = string.reverse((string.gsub(string.reverse(text), "(%d%d%d)", "%1,")))
	if string.sub(result, 1, 1) == "," then
		result = string.sub(result, 2)
	end
	return (if n < 0 then "-" else "") .. result
end

-- 75 -> "1:15", 3725 -> "1:02:05"
function Format.Clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

-- 90 -> "1m 30s", 7200 -> "2h 0m"
function Format.Duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return if m > 0 then string.format("%dh %dm", h, m) else string.format("%dh", h)
	elseif m > 0 then
		return if s > 0 then string.format("%dm %ds", m, s) else string.format("%dm", m)
	end
	return string.format("%ds", s)
end

function Format.Percent(fraction: number): string
	return stripZeros(string.format("%.1f", fraction * 100)) .. "%"
end

function Format.Multiplier(mult: number): string
	return "x" .. stripZeros(string.format("%.2f", mult))
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Gear</string>
          <string name="Source"><![CDATA[-- Picos (más daño) y mejoras permanentes compradas con Stardust.

export type PickaxeDef = {
	Id: string,
	Name: string,
	Damage: number,
	Cooldown: number,
	Price: number,
	GamePass: string?,
	Color: Color3,
	HeadColor: Color3,
	Material: Enum.Material,
	Icon: string,
}

export type UpgradeDef = {
	Key: string,
	Name: string,
	Icon: string,
	Description: string,
	MaxLevel: number,
	BaseCost: number,
	CostGrowth: number,
}

local Gear = {}

Gear.Pickaxes = {
	{ Id = "Rusty", Name = "Rusty Pick", Damage = 1, Cooldown = 0.4, Price = 0, Color = Color3.fromRGB(120, 85, 55), HeadColor = Color3.fromRGB(150, 95, 70), Material = Enum.Material.Wood, Icon = "⛏️" },
	{ Id = "Stone", Name = "Stone Pick", Damage = 3, Cooldown = 0.4, Price = 60, Color = Color3.fromRGB(120, 85, 55), HeadColor = Color3.fromRGB(140, 140, 145), Material = Enum.Material.Slate, Icon = "🪨" },
	{ Id = "Iron", Name = "Iron Pick", Damage = 8, Cooldown = 0.38, Price = 600, Color = Color3.fromRGB(90, 70, 50), HeadColor = Color3.fromRGB(190, 195, 205), Material = Enum.Material.Metal, Icon = "⚙️" },
	{ Id = "Gold", Name = "Golden Pick", Damage = 20, Cooldown = 0.36, Price = 4_000, Color = Color3.fromRGB(90, 70, 50), HeadColor = Color3.fromRGB(255, 205, 50), Material = Enum.Material.Metal, Icon = "🏆" },
	{ Id = "Crystal", Name = "Crystal Pick", Damage = 55, Cooldown = 0.34, Price = 30_000, Color = Color3.fromRGB(60, 70, 90), HeadColor = Color3.fromRGB(130, 230, 255), Material = Enum.Material.Glass, Icon = "💎" },
	{ Id = "Magma", Name = "Magma Pick", Damage = 150, Cooldown = 0.32, Price = 250_000, Color = Color3.fromRGB(40, 30, 30), HeadColor = Color3.fromRGB(255, 100, 30), Material = Enum.Material.Neon, Icon = "🔥" },
	{ Id = "Lunar", Name = "Lunar Pick", Damage = 420, Cooldown = 0.3, Price = 2_500_000, Color = Color3.fromRGB(70, 75, 95), HeadColor = Color3.fromRGB(220, 230, 255), Material = Enum.Material.Neon, Icon = "🌙" },
	{ Id = "Plasma", Name = "Plasma Pick", Damage = 1_200, Cooldown = 0.28, Price = 25_000_000, Color = Color3.fromRGB(30, 30, 40), HeadColor = Color3.fromRGB(80, 255, 200), Material = Enum.Material.Neon, Icon = "⚡" },
	{ Id = "Nebula", Name = "Nebula Pick", Damage = 3_500, Cooldown = 0.26, Price = 300_000_000, Color = Color3.fromRGB(30, 20, 50), HeadColor = Color3.fromRGB(220, 110, 255), Material = Enum.Material.Neon, Icon = "🌌" },
	{ Id = "Galaxy", Name = "Galaxy Hammer", Damage = 6_000, Cooldown = 0.25, Price = 0, GamePass = "GalaxyHammer", Color = Color3.fromRGB(20, 20, 30), HeadColor = Color3.fromRGB(150, 80, 255), Material = Enum.Material.Neon, Icon = "🔨" },
} :: { PickaxeDef }

Gear.Upgrades = {
	Speed = { Key = "Speed", Name = "Rocket Legs", Icon = "👟", Description = "+1.5 walk speed per level", MaxLevel = 10, BaseCost = 300, CostGrowth = 3 },
	Crit = { Key = "Crit", Name = "Critical Hits", Icon = "💥", Description = "+2% critical hit chance per level", MaxLevel = 10, BaseCost = 500, CostGrowth = 3.2 },
	Luck = { Key = "Luck", Name = "Hatch Luck", Icon = "🍀", Description = "+10% rare critter chance per level", MaxLevel = 8, BaseCost = 1_000, CostGrowth = 3.4 },
} :: { [string]: UpgradeDef }

Gear.UpgradeOrder = { "Speed", "Crit", "Luck" }

local byId: { [string]: PickaxeDef } = {}
local tierById: { [string]: number } = {}
for index, pick in Gear.Pickaxes do
	byId[pick.Id] = pick
	tierById[pick.Id] = index
end

function Gear.GetPickaxe(id: string): PickaxeDef?
	return byId[id]
end

function Gear.GetTier(id: string): number
	return tierById[id] or 1
end

return Gear
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Models</string>
          <string name="Source"><![CDATA[-- Modelos 3D hechos con piezas: criaturas, huevos y meteoritos.
-- Convención: el modelo se construye en el origen, Root en la base, el frente mira a -Z.

local CollectionService = game:GetService("CollectionService")

local Critters = require(script.Parent.Critters)
local Rarities = require(script.Parent.Rarities)
local Zones = require(script.Parent.Zones)

local Models = {}

local WHITE = Color3.fromRGB(255, 255, 255)
local BLACK = Color3.fromRGB(20, 20, 26)
local PINK = Color3.fromRGB(255, 130, 160)
local GOLD = Color3.fromRGB(255, 205, 60)
local SILHOUETTE = Color3.fromRGB(18, 18, 28)

type Ctx = {
	Model: Model,
	Root: BasePart,
	S: number,
	W: number,
	H: number,
	D: number,
	CY: number,
	Color: Color3,
	Accent: Color3,
	Silhouette: boolean,
	Effects: boolean,
	Body: BasePart?,
	Eyes: { Vector3 },
	EyeSize: number,
}

-- ---------------------------------------------------------------------
-- Geometría
-- ---------------------------------------------------------------------
local function prepare(ctx: Ctx, part: BasePart, name: string, color: Color3, material: Enum.Material?)
	part.Name = name
	part.Color = if ctx.Silhouette then SILHOUETTE else color
	part.Material = if ctx.Silhouette then Enum.Material.SmoothPlastic else (material or Enum.Material.SmoothPlastic)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.Anchored = false
	part.CastShadow = false
	part.Parent = ctx.Model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = ctx.Root
	weld.Part1 = part
	weld.Parent = part
end

local function ball(ctx: Ctx, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Size = size
	part.CFrame = cf
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	prepare(ctx, part, name, color, material)
	return part
end

local function block(ctx: Ctx, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Size = size
	part.CFrame = cf
	prepare(ctx, part, name, color, material)
	return part
end

local function alongDir(center: Vector3, dir: Vector3): CFrame
	local unit = dir.Unit
	if math.abs(unit.Y) > 0.999 then
		return if unit.Y > 0 then CFrame.new(center) else CFrame.new(center) * CFrame.Angles(math.pi, 0, 0)
	end
	return CFrame.lookAt(center, center + dir) * CFrame.Angles(-math.pi / 2, 0, 0)
end

local function cylinder(ctx: Ctx, name: string, height: number, diameter: number, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(height, diameter, diameter)
	part.CFrame = cf * CFrame.Angles(0, 0, math.pi / 2)
	prepare(ctx, part, name, color, material)
	return part
end

local function cylBetween(ctx: Ctx, name: string, a: Vector3, b: Vector3, diameter: number, color: Color3, material: Enum.Material?): Part
	return cylinder(ctx, name, (b - a).Magnitude, diameter, alongDir((a + b) / 2, b - a), color, material)
end

local function blockBetween(ctx: Ctx, name: string, a: Vector3, b: Vector3, w: number, d: number, color: Color3, material: Enum.Material?): Part
	return block(ctx, name, Vector3.new(w, (b - a).Magnitude, d), alongDir((a + b) / 2, b - a), color, material)
end

-- Punto en la superficie del cuerpo (elipsoide centrado en (0, CY, 0)) en la dirección dada
local function surface(ctx: Ctx, dir: Vector3, inset: number?): Vector3
	local d = dir.Unit
	local a, b, c = ctx.W / 2, ctx.H / 2, ctx.D / 2
	local t = 1 / math.sqrt((d.X / a) ^ 2 + (d.Y / b) ^ 2 + (d.Z / c) ^ 2)
	return Vector3.new(0, ctx.CY, 0) + d * (t - (inset or 0))
end

local function tag(instance: Instance, name: string)
	CollectionService:AddTag(instance, name)
end

local function effect(ctx: Ctx, instance: Instance, parent: Instance?)
	if not ctx.Effects then
		instance:Destroy()
		return
	end
	instance.Parent = parent or ctx.Body or ctx.Root
end

local function particles(ctx: Ctx, a: Color3, b: Color3, rate: number, size: number, parent: Instance?)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(a, b)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	emitter.Lifetime = NumberRange.new(0.8, 1.5)
	emitter.Rate = rate
	emitter.Speed = NumberRange.new(1, 2.5)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.LightEmission = 0.8
	emitter.Drag = 1
	effect(ctx, emitter, parent)
end

local function light(ctx: Ctx, color: Color3, range: number, brightness: number, parent: Instance?)
	local pointLight = Instance.new("PointLight")
	pointLight.Color = color
	pointLight.Range = range
	pointLight.Brightness = brightness
	effect(ctx, pointLight, parent)
end

local function darker(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

local function lighter(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(1, 1, 1), amount)
end

local function newModel(name: string, rootSize: Vector3): (Model, Part)
	local model = Instance.new("Model")
	model.Name = name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = rootSize
	root.CFrame = CFrame.new()
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Parent = model
	model.PrimaryPart = root
	return model, root
end

-- ---------------------------------------------------------------------
-- Rasgos de las criaturas
-- ---------------------------------------------------------------------
local Features: { [string]: (Ctx) -> () } = {}

local function topY(ctx: Ctx): number
	return ctx.CY + ctx.H / 2
end

local function pair(fn: (side: number) -> ())
	fn(-1)
	fn(1)
end

Features.TinyLeaf = function(ctx)
	local S = ctx.S
	local base = Vector3.new(0, topY(ctx) - S * 0.03, 0)
	cylBetween(ctx, "Stem", base, base + Vector3.new(0, S * 0.12, 0), S * 0.04, Color3.fromRGB(70, 150, 60))
	ball(ctx, "Leaf", Vector3.new(S * 0.26, S * 0.05, S * 0.14), CFrame.new(base + Vector3.new(S * 0.08, S * 0.14, 0)) * CFrame.Angles(0, 0, math.rad(25)), Color3.fromRGB(90, 200, 80))
end

Features.Sprout = function(ctx)
	local S = ctx.S
	local base = Vector3.new(0, topY(ctx) - S * 0.03, 0)
	local tip = base + Vector3.new(0, S * 0.24, 0)
	cylBetween(ctx, "Stem", base, tip, S * 0.05, Color3.fromRGB(70, 160, 60))
	pair(function(side)
		ball(ctx, "Leaf", Vector3.new(S * 0.3, S * 0.06, S * 0.16), CFrame.new(tip + Vector3.new(side * S * 0.13, S * 0.02, 0)) * CFrame.Angles(0, 0, side * math.rad(25)), Color3.fromRGB(110, 220, 90))
	end)
end

Features.Stripes = function(ctx)
	for _, yf in { -0.15, 0.25 } do
		local y = ctx.CY + yf * ctx.H / 2
		local r = (ctx.W / 2) * math.sqrt(1 - yf * yf)
		cylinder(ctx, "Stripe", ctx.S * 0.09, r * 2.04, CFrame.new(0, y, ctx.S * 0.02), BLACK)
	end
end

Features.BugWings = function(ctx)
	local S = ctx.S
	pair(function(side)
		local wing = ball(ctx, "Wing", Vector3.new(S * 0.55, S * 0.32, S * 0.04), CFrame.new(side * S * 0.36, ctx.CY + S * 0.28, S * 0.3) * CFrame.Angles(0, side * math.rad(-25), side * math.rad(35)), Color3.fromRGB(220, 245, 255), Enum.Material.Glass)
		wing.Transparency = 0.35
	end)
end

Features.Antennae = function(ctx)
	local S = ctx.S
	local tipColor = Rarities.Get(ctx.Model:GetAttribute("Rarity") or "Common").Color
	pair(function(side)
		local base = surface(ctx, Vector3.new(side * 0.35, 1, -0.1), S * 0.02)
		local tip = base + Vector3.new(side * 0.35, 1, -0.15).Unit * S * 0.4
		cylBetween(ctx, "Antenna", base, tip, S * 0.04, darker(ctx.Color, 0.5))
		ball(ctx, "AntennaTip", Vector3.one * S * 0.12, CFrame.new(tip), tipColor, Enum.Material.Neon)
	end)
end

local function ear(ctx: Ctx, side: number, size: Vector3, tilt: number, inner: boolean, yLift: number?)
	local S = ctx.S
	local base = surface(ctx, Vector3.new(side * 0.55, 1, 0), S * 0.05)
	local cf = CFrame.new(base + Vector3.new(0, size.Y * 0.4 + (yLift or 0), 0)) * CFrame.Angles(0, 0, -side * math.rad(tilt))
	ball(ctx, "Ear", size, cf, ctx.Color)
	if inner then
		ball(ctx, "EarInner", size * Vector3.new(0.55, 0.7, 0.6), cf * CFrame.new(0, -size.Y * 0.05, -size.Z * 0.3), PINK)
	end
end

Features.PointyEars = function(ctx)
	pair(function(side)
		ear(ctx, side, Vector3.new(ctx.S * 0.22, ctx.S * 0.42, ctx.S * 0.1), 18, true)
	end)
end

Features.RoundEars = function(ctx)
	pair(function(side)
		ear(ctx, side, Vector3.new(ctx.S * 0.28, ctx.S * 0.28, ctx.S * 0.12), 10, true, -ctx.S * 0.05)
	end)
end

Features.BunnyEars = function(ctx)
	pair(function(side)
		ear(ctx, side * 0.6, Vector3.new(ctx.S * 0.18, ctx.S * 0.65, ctx.S * 0.09), 10, true)
	end)
end

Features.FloppyEars = function(ctx)
	local S = ctx.S
	pair(function(side)
		local pos = surface(ctx, Vector3.new(side, 0.4, 0), -S * 0.02)
		ball(ctx, "FloppyEar", Vector3.new(S * 0.16, S * 0.45, S * 0.24), CFrame.new(pos + Vector3.new(side * S * 0.04, -S * 0.12, 0)) * CFrame.Angles(0, 0, side * math.rad(15)), darker(ctx.Color, 0.25))
	end)
end

Features.OwlTufts = function(ctx)
	local S = ctx.S
	pair(function(side)
		local base = surface(ctx, Vector3.new(side * 0.7, 1, 0), S * 0.06)
		ball(ctx, "Tuft", Vector3.new(S * 0.14, S * 0.32, S * 0.1), CFrame.new(base + Vector3.new(side * S * 0.05, S * 0.12, 0)) * CFrame.Angles(0, 0, -side * math.rad(35)), darker(ctx.Color, 0.3))
	end)
end

Features.FluffyTail = function(ctx)
	local S = ctx.S
	local pos = surface(ctx, Vector3.new(0, -0.2, 1), -S * 0.15)
	local cf = CFrame.new(pos + Vector3.new(S * 0.15, S * 0.15, 0)) * CFrame.Angles(math.rad(-35), 0, math.rad(-20))
	ball(ctx, "Tail", Vector3.new(S * 0.38, S * 0.75, S * 0.38), cf, ctx.Color)
	ball(ctx, "TailTip", Vector3.new(S * 0.3, S * 0.3, S * 0.3), cf * CFrame.new(0, S * 0.32, 0), WHITE)
end

Features.LongTail = function(ctx)
	local S = ctx.S
	local start = surface(ctx, Vector3.new(0, -0.4, 1), S * 0.05)
	local points = { start, start + Vector3.new(S * 0.1, S * 0.05, S * 0.35), start + Vector3.new(S * 0.25, S * 0.2, S * 0.6), start + Vector3.new(S * 0.3, S * 0.45, S * 0.75) }
	for i = 1, #points - 1 do
		cylBetween(ctx, "Tail", points[i], points[i + 1], S * (0.18 - i * 0.04), ctx.Color)
	end
	ball(ctx, "TailTip", Vector3.one * S * 0.12, CFrame.new(points[#points]), darker(ctx.Color, 0.2))
end

Features.CometTail = function(ctx)
