  </Item>
  <Item class="ServerScriptService" referent="17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="18">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Actions</string>
          <string name="Source"><![CDATA[-- Router de acciones del cliente (un único RemoteFunction "Action").
-- Cada servicio registra sus acciones con Actions.Register(nombre, handler).
-- Incluye límite de peticiones por jugador (anti-spam / anti-exploit).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Actions = {}

type Handler = (player: Player, payload: any) -> (boolean?, string?)

local handlers: { [string]: Handler } = {}
local buckets: { [Player]: { Tokens: number, Last: number } } = {}

local MAX_TOKENS = 12
local REFILL_PER_SECOND = 8

function Actions.Register(name: string, handler: Handler)
	assert(handlers[name] == nil, "Acción duplicada: " .. name)
	handlers[name] = handler
end

local function allow(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if not bucket then
		bucket = { Tokens = MAX_TOKENS, Last = now }
		buckets[player] = bucket
	end
	bucket.Tokens = math.min(MAX_TOKENS, bucket.Tokens + (now - bucket.Last) * REFILL_PER_SECOND)
	bucket.Last = now
	if bucket.Tokens < 1 then
		return false
	end
	bucket.Tokens -= 1
	return true
end

function Actions.Start()
	local remote = Remotes.Function("Action")
	remote.OnServerInvoke = function(player: Player, actionName: any, payload: any)
		if typeof(actionName) ~= "string" then
			return false, "Invalid action"
		end
		local handler = handlers[actionName]
		if not handler then
			return false, "Unknown action"
		end
		if not allow(player) then
			return false, "Slow down!"
		end
		if payload ~= nil and typeof(payload) ~= "table" then
			payload = nil
		end
		local ok, success, message = pcall(handler, player, payload or {})
		if not ok then
			warn(("[Actions] Error en '%s': %s"):format(actionName, tostring(success)))
			return false, "Something went wrong"
		end
		return success == true, message
	end

	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

return Actions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Layout</string>
          <string name="Source"><![CDATA[-- Posiciones del mapa. Las zonas van en fila a lo largo del eje X:
--
--   [HUB + 🌿 Pradera] | [🏜️ Desierto] | [❄️ Tundra] | [🌋 Magma] | [🌙 Luna] | [🌌 Nebulosa]
--    spawn, huevos,      puerta          puerta         ...
--    tienda, cometa

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Zones = require(ReplicatedStorage.Shared.Zones)

local Layout = {}

Layout.ZoneWidth = 210 -- eje X
Layout.ZoneDepth = 200 -- eje Z
Layout.GateHalfWidth = 14

Layout.SpawnPosition = Vector3.new(-82, 0, 0)
Layout.PlazaCenter = Vector3.new(-42, 0, 0)
Layout.PlazaRadius = 30
Layout.ShopPosition = Vector3.new(-84, 0, 34)
Layout.AltarPosition = Vector3.new(-60, 0, 40)
Layout.LeaderboardX = -100

function Layout.ZoneCenter(index: number): Vector3
	return Vector3.new((index - 1) * Layout.ZoneWidth, 0, 0)
end

-- Rango de X (min, max) de una zona
function Layout.ZoneXRange(index: number): (number, number)
	local center = Layout.ZoneCenter(index).X
	return center - Layout.ZoneWidth / 2, center + Layout.ZoneWidth / 2
end

-- Índice de zona según la posición (0 si está fuera del mapa)
function Layout.ZoneAt(position: Vector3): number
	if math.abs(position.Z) > Layout.ZoneDepth / 2 + 5 then
		return 0
	end
	local index = math.floor((position.X + Layout.ZoneWidth / 2) / Layout.ZoneWidth) + 1
	if index < 1 or index > Zones.Count() then
		return 0
	end
	return index
end

-- Punto de aparición/teletransporte de cada zona (en su borde oeste)
function Layout.ZoneSpawn(index: number): CFrame
	if index <= 1 then
		return CFrame.lookAt(Layout.SpawnPosition + Vector3.new(0, 3, 0), Layout.SpawnPosition + Vector3.new(10, 3, 0))
	end
	local minX = Layout.ZoneXRange(index)
	local position = Vector3.new(minX + 14, 3, 0)
	return CFrame.lookAt(position, position + Vector3.new(1, 0, 0))
end

-- Posición de la puerta que da acceso a la zona `index` (frontera con la anterior)
function Layout.GatePosition(index: number): Vector3
	local minX = Layout.ZoneXRange(index)
	return Vector3.new(minX, 0, 0)
end

-- Soporte del huevo de cada zona
function Layout.EggPosition(index: number): Vector3
	if index <= 1 then
		return Vector3.new(-84, 0, -34)
	end
	local minX = Layout.ZoneXRange(index)
	return Vector3.new(minX + 22, 0, -34)
end

-- Zona donde pueden caer meteoritos (min X, max X, max |Z|)
function Layout.MeteorArea(index: number): (number, number, number)
	local minX, maxX = Layout.ZoneXRange(index)
	if index == 1 then
		return -8, maxX - 14, 82
	end
	return minX + 40, maxX - 14, 82
end

return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="21">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Punto de entrada del servidor: carga servicios, construye el mapa y gestiona
-- la entrada y salida de jugadores en el orden correcto.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

require(ReplicatedStorage.Shared.Remotes) -- crea los Remotes

local Registry = require(script.Parent.Registry)
local Actions = require(script.Parent.Actions)
local Net = require(script.Parent.Net)
local Services = script.Parent.Services

local SERVICE_ORDER = {
	"DataService",
	"MapService",
	"MonetizationService",
	"EventService",
	"StatsService",
	"ZoneService",
	"MeteorService",
	"CometService",
	"MiningService",
	"CritterService",
	"QuestService",
	"ShopService",
	"RebirthService",
	"RewardService",
	"PlayerService",
	"LeaderboardService",
	"AdminService",
}

for _, name in SERVICE_ORDER do
	Registry[name] = require(Services:FindFirstChild(name) :: ModuleScript)
end
for _, name in SERVICE_ORDER do
	local service = Registry[name]
	if service.Init then
		service.Init()
	end
end

Registry.MapService.Build()

Actions.Start()
for _, name in SERVICE_ORDER do
	local service = Registry[name]
	if service.Start then
		service.Start()
	end
end

local joined: { [Player]: boolean } = {}

local function onPlayerAdded(player: Player)
	if joined[player] then
		return
	end
	joined[player] = true
	local passesThread = task.spawn(Registry.MonetizationService.LoadPlayer, player)
	local data = Registry.DataService.Load(player)
	if not data or player.Parent ~= Players then
		return
	end
	while coroutine.status(passesThread) ~= "dead" do
		task.wait(0.1)
	end
	Registry.StatsService.Invalidate(player)
	Registry.CritterService.UpdateFollowers(player)
	Registry.QuestService.EnsureToday(player)
	Registry.RewardService.OnJoin(player)
	Registry.PlayerService.SetupPlayer(player)
	Registry.AdminService.SetupPlayer(player)
	Registry.DataService.MarkDirty(player)
	if not Registry.DataService.IsPersistent() then
		task.delay(3, function()
			Net.Notify(player, "⚠️ Data saving is OFF (Studio without API access). Progress won't save.", "Warning")
		end)
	end
end

local function onPlayerRemoving(player: Player)
	if not joined[player] then
		return
	end
	joined[player] = nil
	for _, step in {
		function()
			Registry.RewardService.OnPlayerRemoving(player)
		end,
		function()
			Registry.PlayerService.OnPlayerRemoving(player)
		end,
		function()
			Registry.LeaderboardService.OnPlayerRemoving(player)
		end,
	} do
		local ok, err = pcall(step)
		if not ok then
			warn("[Main] Error al salir " .. player.Name .. ": " .. tostring(err))
		end
	end
	Registry.DataService.Release(player)
	Registry.MonetizationService.OnPlayerRemoving(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

print(("[%s] Servidor listo ✅"):format(require(ReplicatedStorage.Shared.Config).GameName))
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Atajos para enviar mensajes a los clientes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local NotifyEvent = Remotes.Event("Notify")
local AnnounceEvent = Remotes.Event("Announce")
local EffectEvent = Remotes.Event("Effect")

local Net = {}

-- Kind: "Info" | "Success" | "Error" | "Warning" | "Cash"
function Net.Notify(player: Player, text: string, kind: string?)
	if player.Parent ~= Players then
		return
	end
	NotifyEvent:FireClient(player, { Text = text, Kind = kind or "Info" })
end

function Net.NotifyAll(text: string, kind: string?)
	NotifyEvent:FireAllClients({ Text = text, Kind = kind or "Info" })
end

function Net.Announce(text: string, color: Color3?, duration: number?)
	AnnounceEvent:FireAllClients({ Text = text, Color = color or Color3.fromRGB(255, 255, 255), Duration = duration or 4 })
end

function Net.AnnounceTo(player: Player, text: string, color: Color3?, duration: number?)
	if player.Parent ~= Players then
		return
	end
	AnnounceEvent:FireClient(player, { Text = text, Color = color or Color3.fromRGB(255, 255, 255), Duration = duration or 4 })
end

function Net.Effect(player: Player, name: string, payload: { [string]: any }?)
	if player.Parent ~= Players then
		return
	end
	EffectEvent:FireClient(player, name, payload or {})
end

function Net.EffectAll(name: string, payload: { [string]: any }?)
	EffectEvent:FireAllClients(name, payload or {})
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Registry</string>
          <string name="Source"><![CDATA[-- Registro de servicios del servidor. Main.server.luau lo rellena al arrancar.
-- Los servicios acceden a otros con Registry.NombreServicio DENTRO de funciones
-- (nunca al cargar el módulo) para evitar dependencias circulares.

local Registry = {} :: { [string]: any }

return Registry
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="24">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[-- Comandos de administrador por chat (prefijo "!"). En Studio todos son admin.
--   !help                      lista de comandos
--   !stardust 1m               darte stardust (acepta k, m, b, t)
--   !meteor cosmic [zona]      hacer caer un meteorito (rareza) cerca de ti
--   !comet                     lanzar el cometa gigante ahora
--   !event BloodMoon [seg]     evento (MeteorShower, BloodMoon, GoldenHour)
--   !luck 5 10                 suerte x5 durante 10 min ("admin abuse")
--   !critter mythic [shiny]    darte una criatura de esa rareza (o id)
--   !zones                     desbloquear todas las zonas
--   !rebirth                   +1 supernova gratis
--   !reset                     BORRA tus datos

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Rarities = require(Shared.Rarities)
local Critters = require(Shared.Critters)
local Zones = require(Shared.Zones)

local Registry = require(script.Parent.Parent.Registry)
local Net = require(script.Parent.Parent.Net)

local AdminService = {}

local SUFFIXES = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18 }

local function parseAmount(text: string?): number?
	if not text then
		return nil
	end
	local number, suffix = string.match(string.lower(text), "^([%d%.e%+]+)(%a*)$")
	local value = tonumber(number)
	if not value then
		return nil
	end
	if suffix and suffix ~= "" then
		local mult = SUFFIXES[suffix]
		if not mult then
			return nil
		end
		value *= mult
	end
	return value
end

local function capitalize(text: string): string
	return string.upper(string.sub(text, 1, 1)) .. string.lower(string.sub(text, 2))
end

function AdminService.IsAdmin(player: Player): boolean
	if RunService:IsStudio() or table.find(Config.Admins, player.UserId) then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank >= 254
end

local commands: { [string]: (Player, { string }) -> string? } = {}

commands.help = function()
	return "!stardust <n>, !meteor <rarity> [zone], !comet, !event <name> [sec], !luck <x> <min>, !critter <rarity|id> [shiny], !zones, !rebirth, !reset"
end

commands.stardust = function(player, args)
	local amount = parseAmount(args[1])
	if not amount or amount <= 0 then
		return "Usage: !stardust 1m"
	end
	Registry.DataService.AddStardust(player, amount, false)
	return "Gave " .. Format.Abbreviate(amount) .. " ⭐"
end

commands.meteor = function(player, args)
	local rarity = capitalize(args[1] or "legendary")
	if not Rarities.Exists(rarity) then
		return "Rarities: Common, Uncommon, Rare, Epic, Legendary, Mythic, Cosmic"
	end
	local data = Registry.DataService.Get(player)
	local zone = math.clamp(tonumber(args[2]) or math.max(1, Registry.ZoneService.GetCurrentZone(player)), 1, Zones.Count())
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local near = if root and root:IsA("BasePart") and Registry.ZoneService.GetCurrentZone(player) == zone then root.Position else nil
	local meteor = Registry.MeteorService.Spawn(zone, rarity, { Near = near })
	local _ = data
	return if meteor then ("%s meteor falling in zone %d"):format(rarity, zone) else "No space for a meteor"
end

commands.comet = function()
	return if Registry.CometService.Launch(nil) then "Comet launched!" else "A comet is already active (queued)"
end

commands.event = function(_player, args)
	local wanted = string.lower(args[1] or "")
	for _, name in Registry.EventService.GetEventNames() do
		if string.lower(name) == wanted then
			Registry.EventService.StartEvent(name, tonumber(args[2]))
			return "Started " .. name
		end
	end
	return "Events: " .. table.concat(Registry.EventService.GetEventNames(), ", ")
end

commands.luck = function(_player, args)
	local multiplier = tonumber(args[1]) or 5
	local minutes = tonumber(args[2]) or 10
	Registry.EventService.SetAdminLuck(multiplier, minutes * 60)
	return ("Luck x%s for %d min"):format(tostring(multiplier), minutes)
end

commands.critter = function(player, args)
	local arg = string.lower(args[1] or "legendary")
	local shiny = args[2] ~= nil and string.lower(args[2]) == "shiny"
	if Critters.Exists(arg) then
		Registry.CritterService.AddCritter(player, arg, shiny)
		return "Gave " .. arg
	end
	local rarity = capitalize(arg)
	if Rarities.Exists(rarity) then
		Registry.CritterService.GiveCritterOfRarity(player, rarity, nil, shiny, "admin")
		return "Gave a " .. rarity .. " critter"
	end
	return "Usage: !critter <rarity|id> [shiny]"
end

commands.zones = function(player)
	local data = Registry.DataService.Get(player)
	if data then
		data.Zone = Zones.Count()
		Registry.StatsService.Invalidate(player)
	end
	return "All zones unlocked"
end

commands.rebirth = function(player)
	local data = Registry.DataService.Get(player)
	if not data then
		return nil
	end
	data.Rebirths = math.min(data.Rebirths + 1, Config.Rebirth.MaxRebirths)
	Registry.StatsService.Invalidate(player)
	Registry.DataService.UpdateDisplay(player)
	Registry.PlayerService.UpdateOverhead(player)
	return "Supernovas: " .. data.Rebirths
end

commands.reset = function(player)
	Registry.DataService.ResetData(player)
	Registry.StatsService.Invalidate(player)
	Registry.CritterService.UpdateFollowers(player)
	Registry.MiningService.GivePickaxe(player)
	Registry.PlayerService.UpdateMovement(player)
	Registry.PlayerService.UpdateOverhead(player)
	Registry.ZoneService.Teleport(player, 1)
	return "Your data was reset"
end

function AdminService.Handle(player: Player, message: string)
	if string.sub(message, 1, 1) ~= "!" or not AdminService.IsAdmin(player) then
		return
	end
	local args = string.split(string.sub(message, 2), " ")
	local name = string.lower(table.remove(args, 1) or "")
	local command = commands[name]
	if not command then
		return
	end
	local ok, result = pcall(command, player, args)
	if ok then
		if result then
			Net.Notify(player, "[Admin] " .. result, "Info")
		end
	else
		Net.Notify(player, "[Admin] Error: " .. tostring(result), "Error")
	end
end

function AdminService.SetupPlayer(player: Player)
	player.Chatted:Connect(function(message)
		AdminService.Handle(player, message)
	end)
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">CometService</string>
            <string name="Source"><![CDATA[-- ☄️ Cometa jefe: cada 20 min (o al comprarlo) cae un cometa gigante en la plaza.
-- Su vida se ajusta al daño del servidor y todos los que participan ganan premio.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)
local Layout = require(script.Parent.Parent.Layout)
local Net = require(script.Parent.Parent.Net)

local CometService = {}

local active = false
local queued = 0
local nextCometAt = 0
local rng = Random.new()

local function now(): number
	return workspace:GetServerTimeNow()
end

local function setNext(at: number)
	nextCometAt = at
	workspace:SetAttribute("CometAt", at)
end

function CometService.IsActive(): boolean
	return active
end

function CometService.Launch(caller: Player?): boolean
	if active then
		queued += 1
		return false
	end
	active = true
	workspace:SetAttribute("CometActive", true)
	local totalDps = 0
	for _, player in Players:GetPlayers() do
		totalDps += Registry.StatsService.EstimateDps(player)
	end
	local hp = math.max(Config.Comet.MinHP, math.floor(totalDps * Config.Comet.TargetSeconds))
	local meteor = Registry.MeteorService.Spawn(1, "Mythic", {
		Position = Layout.PlazaCenter,
		Comet = true,
		HP = hp,
		WarningTime = Config.Comet.WarningTime,
	})
	if not meteor then
		active = false
		workspace:SetAttribute("CometActive", false)
		return false
	end
	local text = if caller then ("☄️ %s CALLED THE GIANT COMET! Go to the plaza!"):format(caller.DisplayName) else "☄️ A GIANT COMET is crashing into the plaza! Everyone go!"
	Net.Announce(text, Color3.fromRGB(140, 230, 255), 6)
	Net.EffectAll("Sound", { Name = "Announce" })
	Net.EffectAll("CometIncoming", { ImpactAt = meteor.ImpactAt })

	-- Si nadie lo rompe a tiempo, se va
	task.delay(Config.Comet.WarningTime + Config.Comet.Lifetime, function()
		if not meteor.Dead then
			Registry.MeteorService.Expire(meteor)
			Net.Announce("☄️ The comet flew away... be faster next time!", Color3.fromRGB(180, 180, 200), 4)
			CometService.Finish()
		end
	end)
	return true
end

function CometService.Finish()
	active = false
	workspace:SetAttribute("CometActive", false)
	if queued > 0 then
		queued -= 1
		setNext(now() + 30)
	elseif nextCometAt < now() + 60 then
		setNext(now() + Config.Comet.Interval)
	end
end

-- Recompensas al romperlo
function CometService.OnBroken(meteor: any, list: { { Player: Player, Damage: number } }, total: number)
	local count = #list
	for rank, entry in list do
		local player = entry.Player
		local data = Registry.DataService.Get(player)
		if player.Parent == Players and data then
			local share = entry.Damage / math.max(total, 1)
			local relative = math.clamp(share * count, Config.Comet.MinRewardShare, 3)
			local loot = math.floor(Registry.StatsService.GetRewardBase(player) * Config.Comet.RewardMeteors * relative)
			Registry.DataService.AddStardust(player, loot)
			data.Stats.Comets += 1
			Registry.DataService.MarkDirty(player)
			Net.Effect(player, "Loot", { Amount = loot, Position = meteor.Position, MVP = rank == 1, Share = share })
			Net.Notify(player, ("☄️ Comet reward: +%s ⭐ (#%d)"):format(Format.Abbreviate(loot), rank), "Success")
			if rank == 1 then
				Registry.CritterService.GiveCritterOfRarity(player, "Legendary", data.Zone, rng:NextNumber() < 0.2, "comet")
			elseif rank <= 3 then
				Registry.CritterService.GiveCritterOfRarity(player, "Epic", data.Zone, false, "comet")
			end
		end
	end
	local mvp = list[1] and list[1].Player
	if mvp then
		Net.Announce(("☄️ COMET DESTROYED! MVP: %s"):format(mvp.DisplayName), Color3.fromRGB(140, 230, 255), 5)
	end
	Net.EffectAll("Confetti", {})
	CometService.Finish()
end

function CometService.Start()
	setNext(now() + Config.Comet.FirstDelay)
	task.spawn(function()
		local warned = false
		while true do
			task.wait(1)
			local remaining = nextCometAt - now()
			if not active and remaining <= 60 and remaining > 50 and not warned then
				warned = true
				Net.Announce("☄️ The GIANT COMET arrives in 1 minute! Get ready at the plaza!", Color3.fromRGB(140, 230, 255), 5)
			end
			if not active and remaining <= 0 and #Players:GetPlayers() > 0 then
				warned = false
				setNext(now() + Config.Comet.Interval)
				CometService.Launch(nil)
			end
		end
	end)
end

return CometService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">CritterService</string>
            <string name="Source"><![CDATA[-- Criaturas: huevos (eclosión con suerte y shiny), inventario, equipar y borrar.
-- Las equipadas dan bonus de daño, ayudan a picar y siguen al jugador (las dibuja el cliente).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Critters = require(Shared.Critters)
local Rarities = require(Shared.Rarities)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)
local Actions = require(script.Parent.Parent.Actions)
local Net = require(script.Parent.Parent.Net)

local CritterService = {}

local rng = Random.new()
local hatchCooldown: { [Player]: number } = {}

local function count(tbl: { [any]: any }): number
	local n = 0
	for _ in tbl do
		n += 1
	end
	return n
end

local function critterName(id: string, shiny: boolean?): string
	local def = Critters.Get(id)
	return (if shiny then "✨Shiny " else "") .. (if def then def.Name else id)
end

-- Atributo que usan los clientes para dibujar las criaturas que te siguen
function CritterService.UpdateFollowers(player: Player)
	local data = Registry.DataService.Get(player)
	if not data then
		return
	end
	local parts = {}
	for _, uid in data.Equipped do
		local entry = data.Critters[uid]
		if entry then
			table.insert(parts, entry.Id .. ":" .. (if entry.Shiny then "1" else "0"))
		end
	end
	player:SetAttribute("Critters", table.concat(parts, ","))
end

function CritterService.GetEquippedBonus(player: Player): number
	local data = Registry.DataService.Get(player)
	if not data then
		return 0
	end
	local list = {}
	for _, uid in data.Equipped do
		local entry = data.Critters[uid]
		if entry then
			table.insert(list, entry)
		end
	end
	return Economy.GetCritterBonus(list)
end

local function changed(player: Player)
	CritterService.UpdateFollowers(player)
	Registry.StatsService.Invalidate(player)
	Registry.DataService.MarkDirty(player)
end

function CritterService.AddCritter(player: Player, critterId: string, shiny: boolean): string?
	local data = Registry.DataService.Get(player)
	if not data or not Critters.Exists(critterId) then
		return nil
	end
	local uid = "c" .. data.NextCritter
	data.NextCritter += 1
	data.Critters[uid] = { Id = critterId, Shiny = shiny }
	data.Index[critterId] = data.Index[critterId] or {}
	local variant = if shiny then "Shiny" else "Normal"
	if not data.Index[critterId][variant] then
		data.Index[critterId][variant] = true
		Net.Notify(player, "📖 New Index entry: " .. critterName(critterId, shiny) .. "!", "Success")
	end
	-- Equipa automáticamente si hay hueco libre
	if #data.Equipped < Registry.StatsService.GetSlotCount(player) then
		table.insert(data.Equipped, uid)
	end
	changed(player)
	return uid
end

-- Da una criatura de una rareza concreta (huevos de meteorito, cometa, códigos, productos)
function CritterService.GiveCritterOfRarity(player: Player, rarity: string, eggIndex: number?, shiny: boolean?, source: string?): string?
	local data = Registry.DataService.Get(player)
	if not data then
		return nil
	end
	local egg = math.clamp(eggIndex or data.Zone, 1, #Critters.Eggs)
	local critterId = Critters.OfRarity(egg, rarity) or Critters.OfRarity(egg, "Common")
	if not critterId then
		return nil
	end
	local isShiny = shiny == true or rng:NextNumber() < Config.Critters.ShinyChance
	if count(data.Critters) >= Config.Critters.InventoryLimit then
		local compensation = math.floor(Registry.StatsService.GetRewardBase(player) * 20)
		Registry.DataService.AddStardust(player, compensation)
		Net.Notify(player, ("🐾 Inventory full! Got %s ⭐ instead"):format(Format.Abbreviate(compensation)), "Warning")
		return nil
	end
	local uid = CritterService.AddCritter(player, critterId, isShiny)
	local rarityDef = Rarities.Get(rarity)
	local from = if source == "meteor" then " from a meteor egg" elseif source == "comet" then " from the comet" else ""
	Net.Notify(player, ("🥚 You got %s (%s)%s!"):format(critterName(critterId, isShiny), rarity, from), "Success")
	Net.Effect(player, "Hatch", { Egg = egg, Results = { { Id = critterId, Shiny = isShiny } } })
	if rarityDef.Order >= Config.Critters.AnnounceMinRarityOrder then
		Net.Announce(("🥚 %s got a %s %s!"):format(player.DisplayName, string.upper(rarity), critterName(critterId, isShiny)), rarityDef.Color, 4)
	end
	return uid
end

function CritterService.Hatch(player: Player, eggIndex: number, amount: number): (boolean, string?)
	local data = Registry.DataService.Get(player)
	local egg = Critters.GetEgg(eggIndex)
	if not data or not egg then
		return false, "Invalid egg"
	end
	if eggIndex > data.Zone then
		return false, "Unlock this zone first!"
	end
	if amount ~= 1 and amount ~= 3 then
		return false, "Invalid amount"
	end
	if amount == 3 and not Registry.MonetizationService.OwnsPass(player, "TripleHatch") then
		Net.Effect(player, "PromptPass", { Key = "TripleHatch" })
		return false, "Get Triple Hatch to open 3 at once!"
	end
	local t = os.clock()
	if (hatchCooldown[player] or 0) > t then
		return false, nil
	end
	hatchCooldown[player] = t + 1.2
	local space = Config.Critters.InventoryLimit - count(data.Critters)
	if space < amount and not data.Settings.AutoDeleteCommon then
		return false, "Your critter inventory is full! Delete some first."
	end
	local cost = egg.Cost * amount
	if not Registry.DataService.SpendStardust(player, cost) then
		return false, ("You need %s ⭐"):format(Format.Abbreviate(cost))
	end

	local luck = Registry.StatsService.GetHatchLuck(player)
	local results = {}
	for _ = 1, amount do
		local critterId = Critters.Roll(rng, eggIndex, luck)
		local shiny = rng:NextNumber() < Config.Critters.ShinyChance
		local def = Critters.Get(critterId)
		local deleted = false
		if data.Settings.AutoDeleteCommon and def and def.Rarity == "Common" and not shiny then
			deleted = true
			-- Aun así cuenta para el Index
			data.Index[critterId] = data.Index[critterId] or {}
			data.Index[critterId].Normal = true
		elseif count(data.Critters) < Config.Critters.InventoryLimit then
			CritterService.AddCritter(player, critterId, shiny)
		else
			deleted = true
		end
		table.insert(results, { Id = critterId, Shiny = shiny, Deleted = deleted })
		if def and Rarities.Get(def.Rarity).Order >= Config.Critters.AnnounceMinRarityOrder then
			Net.Announce(("🥚 %s hatched a %s %s!"):format(player.DisplayName, string.upper(def.Rarity), critterName(critterId, shiny)), Rarities.Get(def.Rarity).Color, 4)
		end
	end
	data.Stats.Hatched += amount
	Registry.QuestService.Progress(player, "HatchEggs", amount)
	Registry.DataService.MarkDirty(player)
	Net.Effect(player, "Hatch", { Egg = eggIndex, Results = results })
	return true, nil
end

function CritterService.Equip(player: Player, uid: string): (boolean, string?)
	local data = Registry.DataService.Get(player)
	if not data or not data.Critters[uid] then
		return false, "Critter not found"
	end
	if table.find(data.Equipped, uid) then
		return false, "Already equipped"
	end
	if #data.Equipped >= Registry.StatsService.GetSlotCount(player) then
		return false, "No free slots! Unequip one first."
	end
	table.insert(data.Equipped, uid)
	changed(player)
	return true, "Equipped " .. critterName(data.Critters[uid].Id, data.Critters[uid].Shiny)
end

function CritterService.Unequip(player: Player, uid: string): (boolean, string?)
	local data = Registry.DataService.Get(player)
	local index = data and table.find(data.Equipped, uid)
	if not data or not index then
		return false, "Not equipped"
	end
	table.remove(data.Equipped, index)
	changed(player)
	return true, nil
end

function CritterService.EquipBest(player: Player): (boolean, string?)
	local data = Registry.DataService.Get(player)
	if not data then
		return false, nil
	end
	local list = {}
	for uid, entry in data.Critters do
		table.insert(list, { Uid = uid, Power = Critters.GetPower(entry.Id, entry.Shiny) })
	end
	table.sort(list, function(a, b)
		if a.Power == b.Power then
			return a.Uid < b.Uid
		end
		return a.Power > b.Power
	end)
	local slots = Registry.StatsService.GetSlotCount(player)
	local equipped = {}
	for i = 1, math.min(slots, #list) do
		table.insert(equipped, list[i].Uid)
	end
	data.Equipped = equipped
	changed(player)
	return true, "Equipped your best critters!"
end

function CritterService.Delete(player: Player, uid: string): (boolean, string?)
	local data = Registry.DataService.Get(player)
	if not data or not data.Critters[uid] then
		return false, "Critter not found"
	end
	local index = table.find(data.Equipped, uid)
	if index then
		table.remove(data.Equipped, index)
	end
	data.Critters[uid] = nil
	changed(player)
	return true, nil
end

-- Borra todas las NO equipadas de una rareza (y no shiny)
function CritterService.DeleteRarity(player: Player, rarity: string): (boolean, string?)
	local data = Registry.DataService.Get(player)
	if not data or not Rarities.Exists(rarity) then
		return false, "Invalid rarity"
	end
	local removed = 0
	for uid, entry in data.Critters do
		local def = Critters.Get(entry.Id)
		if def and def.Rarity == rarity and not entry.Shiny and not table.find(data.Equipped, uid) then
			data.Critters[uid] = nil
			removed += 1
		end
	end
	changed(player)
	return true, ("Deleted %d %s critters"):format(removed, rarity)
end

function CritterService.FillView(player: Player, view: { [string]: any })
	local data = Registry.DataService.Get(player)
	if not data then
		return
	end
	view.IndexCount = Economy.CountIndex(data.Index)
	view.IndexTotal = Economy.GetIndexTotal()
	view.CritterCount = count(data.Critters)
end

function CritterService.Init()
	Actions.Register("Hatch", function(player, payload)
		return CritterService.Hatch(player, tonumber(payload.Egg) or 0, tonumber(payload.Amount) or 1)
	end)
	Actions.Register("EquipCritter", function(player, payload)
		return CritterService.Equip(player, tostring(payload.Uid))
	end)
	Actions.Register("UnequipCritter", function(player, payload)
		return CritterService.Unequip(player, tostring(payload.Uid))
	end)
	Actions.Register("EquipBest", function(player)
		return CritterService.EquipBest(player)
	end)
	Actions.Register("DeleteCritter", function(player, payload)
		return CritterService.Delete(player, tostring(payload.Uid))
	end)
	Actions.Register("DeleteRarity", function(player, payload)
		return CritterService.DeleteRarity(player, tostring(payload.Rarity))
	end)
	Actions.Register("ToggleAutoDelete", function(player)
		local data = Registry.DataService.Get(player)
		if not data then
			return false, nil
		end
		data.Settings.AutoDeleteCommon = not data.Settings.AutoDeleteCommon
		Registry.DataService.MarkDirty(player)
		return true, if data.Settings.AutoDeleteCommon then "Auto-delete Commons: ON" else "Auto-delete Commons: OFF"
	end)
end

function CritterService.Start()
	-- Prompts en los soportes de huevos
	for eggIndex, stand in Registry.MapService.EggStands do
		local egg = Critters.GetEgg(eggIndex)
		if egg then
			for _, amount in { 1, 3 } do
				local prompt = Instance.new("ProximityPrompt")
				prompt.Name = "Hatch" .. amount
				prompt.ActionText = if amount == 1 then "Hatch (" .. Format.Abbreviate(egg.Cost) .. " ⭐)" else "Hatch x3 (" .. Format.Abbreviate(egg.Cost * 3) .. " ⭐)"
				prompt.ObjectText = egg.Name
				prompt.KeyboardKeyCode = if amount == 1 then Enum.KeyCode.E else Enum.KeyCode.R
				prompt.HoldDuration = 0.25
				prompt.MaxActivationDistance = 12
				prompt.RequiresLineOfSight = false
				prompt.UIOffset = Vector2.new(0, if amount == 1 then 0 else 80)
				prompt.Parent = stand
				prompt.Triggered:Connect(function(player)
					local ok, message = CritterService.Hatch(player, eggIndex, amount)
					if not ok and message then
						Net.Notify(player, message, "Error")
					end
				end)
			end
			-- Cartel con las probabilidades
			local gui = Instance.new("BillboardGui")
			gui.Name = "Chances"
			gui.Size = UDim2.new(10, 0, 8, 0)
			gui.StudsOffsetWorldSpace = Vector3.new(0, 11, 0)
			gui.LightInfluence = 0
			gui.MaxDistance = 60
			local layout = Instance.new("UIListLayout")
			layout.SortOrder = Enum.SortOrder.LayoutOrder
			layout.Parent = gui
			local lines = { { egg.Name .. " • " .. Format.Abbreviate(egg.Cost) .. " ⭐", Color3.fromRGB(255, 255, 255) } }
			for _, def in Critters.ByEgg[eggIndex] or {} do
				local chance = Critters.RarityChances[def.Rarity] * 100
				table.insert(lines, { ("%s  %s%%  (+%s)"):format(def.Name, if chance < 1 then string.format("%.1f", chance) else tostring(math.floor(chance)), Format.Percent(def.Power)), Rarities.Get(def.Rarity).Color })
			end
			for order, line in lines do
				local labelInstance = Instance.new("TextLabel")
				labelInstance.BackgroundTransparency = 1
				labelInstance.Size = UDim2.fromScale(1, 1 / #lines)
				labelInstance.Font = Enum.Font.FredokaOne
				labelInstance.TextScaled = true
				labelInstance.Text = line[1]
				labelInstance.TextColor3 = line[2]
				labelInstance.LayoutOrder = order
				local stroke = Instance.new("UIStroke")
				stroke.Thickness = 2
				stroke.Parent = labelInstance
				labelInstance.Parent = gui
			end
			gui.Parent = stand
		end
	end

	Players.PlayerRemoving:Connect(function(player)
		hatchCooldown[player] = nil
	end)
end

return CritterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Guardado con DataStore + bloqueo de sesión (evita duplicar criaturas entre servidores).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Gear = require(Shared.Gear)
local Zones = require(Shared.Zones)
local Critters = require(Shared.Critters)
local Remotes = require(Shared.Remotes)

local Registry = require(script.Parent.Parent.Registry)

local DataService = {}

local SESSION_TIMEOUT = 10 * 60
local LOAD_ATTEMPTS = 6
local AUTOSAVE_INTERVAL = 120
local MAX_RECEIPTS = 60

local DEFAULT_DATA = {
	Stardust = Config.StartingStardust,
	TotalStardust = 0,
	Rebirths = 0,
	Pickaxe = "Rusty",
	OwnedPickaxes = { Rusty = true },
	Zone = 1, -- zona más alta desbloqueada
	Critters = {}, -- ["c1"] = { Id = "pebblit", Shiny = false }
	NextCritter = 1,
	Equipped = {}, -- { "c1", "c4" }
	Index = {}, -- [critterId] = { Normal = true, Shiny = true }
	Upgrades = { Speed = 0, Crit = 0, Luck = 0 },
	Daily = { LastDay = 0, Streak = 0 },
	Codes = {},
	Boosts = { Stardust = 0, Damage = 0 },
	Quests = { Day = 0, List = {}, BonusClaimed = false },
	Stats = { Meteors = 0, RareMeteors = 0, MVPs = 0, Hatched = 0, Swings = 0, Crits = 0, Comets = 0, Playtime = 0 },
	Settings = { AutoDeleteCommon = false },
	ReceiptIds = {},
	LastOnline = 0,
	Version = 1,
}

local profiles: { [Player]: any } = {}
local saving: { [Player]: boolean } = {}
local dirty: { [Player]: boolean } = {}
local store: DataStore? = nil
local persistent = false

local function deepCopy<T>(value: T): T
	if typeof(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, child in value :: any do
		copy[key] = deepCopy(child)
	end
	return copy :: any
end

local function reconcile(target: { [any]: any }, template: { [any]: any })
	for key, value in template do
		if target[key] == nil then
			target[key] = deepCopy(value)
		elseif typeof(value) == "table" and typeof(target[key]) == "table" and next(value) ~= nil and #value == 0 then
			reconcile(target[key], value)
		end
	end
end

local function sanitize(data: any)
	if typeof(data.Stardust) ~= "number" or data.Stardust ~= data.Stardust then
		data.Stardust = Config.StartingStardust
	end
	data.Rebirths = math.clamp(math.floor(tonumber(data.Rebirths) or 0), 0, Config.Rebirth.MaxRebirths)
	data.Zone = math.clamp(math.floor(tonumber(data.Zone) or 1), 1, Zones.Count())
	data.OwnedPickaxes.Rusty = true
	if not Gear.GetPickaxe(data.Pickaxe) then
		data.Pickaxe = "Rusty"
	end
	for uid, entry in data.Critters do
		if typeof(entry) ~= "table" or not Critters.Exists(entry.Id) then
			data.Critters[uid] = nil
		end
	end
	local seen = {}
	local equipped = {}
	for _, uid in data.Equipped do
		if typeof(uid) == "string" and data.Critters[uid] and not seen[uid] then
			seen[uid] = true
			table.insert(equipped, uid)
		end
	end
	data.Equipped = equipped
	data.NextCritter = math.max(1, math.floor(tonumber(data.NextCritter) or 1))
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local function setupLeaderstats(player: Player, data: any)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local stardust = Instance.new("StringValue")
	stardust.Name = "Stardust"
	stardust.Value = Format.Abbreviate(data.Stardust)
	stardust.Parent = folder
	local meteors = Instance.new("IntValue")
	meteors.Name = "Meteors"
	meteors.Value = data.Stats.Meteors
	meteors.Parent = folder
	local supernovas = Instance.new("IntValue")
	supernovas.Name = "Supernovas"
	supernovas.Value = data.Rebirths
	supernovas.Parent = folder
	folder.Parent = player
end

-- ---------------------------------------------------------------------
-- Ciclo de vida
-- ---------------------------------------------------------------------
function DataService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok and result then
		local probeOk, probeError = pcall(function()
			return result:GetAsync("__probe")
		end)
		if probeOk then
			store = result
			persistent = true
		else
			warn("[DataService] DataStore no disponible (publica el juego y activa 'Enable Studio Access to API Services'). Los datos NO se guardarán. " .. tostring(probeError))
		end
	else
		warn("[DataService] No se pudo abrir el DataStore: " .. tostring(result))
	end
end

function DataService.Start()
	local syncEvent = Remotes.Event("Sync")
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.2 then
			return
		end
		elapsed = 0
		for player in dirty do
			dirty[player] = nil
			if profiles[player] and player.Parent == Players then
				local ok, view = pcall(DataService.BuildView, player)
				if ok then
					syncEvent:FireClient(player, view)
				else
					warn("[DataService] Error construyendo la vista: " .. tostring(view))
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.Save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		if not persistent then
			return
		end
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

function DataService.IsPersistent(): boolean
	return persistent
end

function DataService.Load(player: Player): any?
	local data: any = nil
	if store then
		local key = keyFor(player)
		for attempt = 1, LOAD_ATTEMPTS do
			if player.Parent ~= Players then
				return nil
			end
			local wasLocked = false
			local ok, result = pcall(function()
				return (store :: DataStore):UpdateAsync(key, function(old)
					local now = os.time()
					local session = if typeof(old) == "table" then old._Session else nil
					if typeof(session) == "table" and session.JobId ~= game.JobId and now - (session.Time or 0) < SESSION_TIMEOUT and attempt < LOAD_ATTEMPTS then
						wasLocked = true
						return nil
					end
					local value = if typeof(old) == "table" then old else {}
					value._Session = { JobId = game.JobId, Time = now }
					return value
				end)
			end)
			if ok and typeof(result) == "table" then
				data = result
				break
			end
			if not ok then
				warn(("[DataService] Error cargando %s (intento %d): %s"):format(player.Name, attempt, tostring(result)))
			end
			task.wait(if wasLocked then 5 else 2)
		end
		if not data then
			player:Kick("We couldn't load your data. Please rejoin in a moment!")
			return nil
		end
	else
		data = {}
	end

	if player.Parent ~= Players then
		if store then
			task.spawn(function()
				pcall(function()
					(store :: DataStore):UpdateAsync(keyFor(player), function(old)
						if typeof(old) == "table" and typeof(old._Session) == "table" and old._Session.JobId == game.JobId then
							old._Session = nil
							return old
						end
						return nil
					end)
				end)
			end)
		end
		return nil
	end

	data._Session = nil
	reconcile(data, DEFAULT_DATA)
	sanitize(data)
	profiles[player] = data

	setupLeaderstats(player, data)
	player:SetAttribute("Stardust", data.Stardust)
	return data
end

function DataService.Save(player: Player, release: boolean): boolean
	local data = profiles[player]
	if not data or not store then
		return true
	end
	while saving[player] do
		task.wait(0.1)
	end
	saving[player] = true
	data.LastOnline = os.time()
	local snapshot = deepCopy(data)
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(keyFor(player), function(old)
			local session = if typeof(old) == "table" then old._Session else nil
			if typeof(session) == "table" and session.JobId ~= game.JobId and os.time() - (session.Time or 0) < SESSION_TIMEOUT then
				warn("[DataService] Otro servidor tiene la sesión de " .. player.Name .. "; no se sobrescribe.")
				return nil
			end
			snapshot._Session = if release then nil else { JobId = game.JobId, Time = os.time() }
			return snapshot
		end)
	end)
	saving[player] = nil
	if not ok then
		warn("[DataService] Error guardando " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

function DataService.Release(player: Player)
	if not profiles[player] then
		return
	end
	DataService.Save(player, true)
	profiles[player] = nil
	dirty[player] = nil
end

-- ---------------------------------------------------------------------
-- Acceso
-- ---------------------------------------------------------------------
function DataService.Get(player: Player): any?
	return profiles[player]
end

function DataService.MarkDirty(player: Player)
	if profiles[player] then
		dirty[player] = true
	end
end

function DataService.UpdateDisplay(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	player:SetAttribute("Stardust", data.Stardust)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	local stardust = leaderstats:FindFirstChild("Stardust")
	if stardust and stardust:IsA("StringValue") then
		stardust.Value = Format.Abbreviate(data.Stardust)
	end
	local meteors = leaderstats:FindFirstChild("Meteors")
	if meteors and meteors:IsA("IntValue") then
		meteors.Value = data.Stats.Meteors
	end
	local supernovas = leaderstats:FindFirstChild("Supernovas")
	if supernovas and supernovas:IsA("IntValue") then
		supernovas.Value = data.Rebirths
	end
end

function DataService.AddStardust(player: Player, amount: number, countsAsEarned: boolean?)
	local data = profiles[player]
	if not data or amount ~= amount or amount <= 0 or amount == math.huge then
		return
	end
	data.Stardust += amount
	if countsAsEarned ~= false then
		data.TotalStardust += amount
	end
	DataService.UpdateDisplay(player)
end

function DataService.SpendStardust(player: Player, amount: number): boolean
	local data = profiles[player]
	if not data or amount ~= amount or amount < 0 or data.Stardust < amount then
		return false
	end
	data.Stardust -= amount
	DataService.UpdateDisplay(player)
	return true
end

function DataService.HasReceipt(player: Player, receiptId: string): boolean
	local data = profiles[player]
	return data ~= nil and table.find(data.ReceiptIds, receiptId) ~= nil
end

function DataService.AddReceipt(player: Player, receiptId: string)
	local data = profiles[player]
	if not data then
		return
	end
	table.insert(data.ReceiptIds, receiptId)
	while #data.ReceiptIds > MAX_RECEIPTS do
		table.remove(data.ReceiptIds, 1)
	end
end

function DataService.ResetData(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	local receipts = data.ReceiptIds
	for key in data do
		data[key] = nil
	end
	reconcile(data, DEFAULT_DATA)
	data.ReceiptIds = receipts
	DataService.UpdateDisplay(player)
	DataService.MarkDirty(player)
end

-- ---------------------------------------------------------------------
-- Vista para el cliente
-- ---------------------------------------------------------------------
function DataService.BuildView(player: Player): { [string]: any }
	local data = profiles[player]
	if not data then
		return {}
	end
	local view: { [string]: any } = {
		Stardust = data.Stardust,
		TotalStardust = data.TotalStardust,
		Rebirths = data.Rebirths,
		Pickaxe = data.Pickaxe,
		OwnedPickaxes = data.OwnedPickaxes,
		Zone = data.Zone,
		Critters = data.Critters,
		Equipped = data.Equipped,
		Index = data.Index,
		Upgrades = data.Upgrades,
		Stats = data.Stats,
		Boosts = data.Boosts,
		Codes = data.Codes,
		Settings = data.Settings,
		InventoryLimit = Config.Critters.InventoryLimit,
		IsStudio = RunService:IsStudio(),
		SimulatePurchases = RunService:IsStudio() and Config.SimulatePurchasesInStudio,
		Persistent = persistent,
	}
	for _, name in { "MonetizationService", "StatsService", "CritterService", "QuestService", "RewardService" } do
		local service = Registry[name]
		if service and service.FillView then
			service.FillView(player, view)
		end
	end
	return view
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[-- Eventos del servidor: Lluvia de meteoritos, Luna de sangre, Hora dorada,
-- suerte de servidor (producto) y suerte de admin.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)
local Net = require(script.Parent.Parent.Net)

local EventService = {}

export type EventDef = { Title: string, Description: string, Color: Color3 }

EventService.Events = {
	MeteorShower = { Title = "🌠 METEOR SHOWER", Description = "Meteors fall 3x faster!", Color = Color3.fromRGB(255, 180, 90) },
	BloodMoon = { Title = "🌕 BLOOD MOON", Description = "3x luck: rare meteors everywhere!", Color = Color3.fromRGB(255, 70, 70) },
	GoldenHour = { Title = "✨ GOLDEN HOUR", Description = "2x stardust for everyone!", Color = Color3.fromRGB(255, 215, 70) },
} :: { [string]: EventDef }

local EVENT_ORDER = { "MeteorShower", "BloodMoon", "GoldenHour" }

local serverLuckUntil = 0
local adminLuck = 1
local adminLuckUntil = 0
local current: { Name: string, EndsAt: number }? = nil

local function now(): number
	return workspace:GetServerTimeNow()
end

local function isActive(name: string): boolean
	return current ~= nil and current.Name == name and current.EndsAt > now()
end

function EventService.GetLuck(): number
	local luck = 1
	if serverLuckUntil > now() then
		luck *= Config.ServerLuck.Multiplier
	end
	if isActive("BloodMoon") then
		luck *= Config.Events.BloodMoonLuck
	end
	if adminLuckUntil > now() then
		luck *= adminLuck
	end
	return luck
end

function EventService.GetSpawnRateMultiplier(): number
	return if isActive("MeteorShower") then Config.Events.ShowerMultiplier else 1
end

function EventService.GetStardustMultiplier(): number
	return if isActive("GoldenHour") then Config.Events.GoldenMultiplier else 1
end

local function publishLuck()
	workspace:SetAttribute("Luck", EventService.GetLuck())
end

function EventService.AddServerLuck(seconds: number, buyer: Player?)
	local t = now()
	serverLuckUntil = math.min(math.max(serverLuckUntil, t) + seconds, t + Config.ServerLuck.MaxStackSeconds)
	workspace:SetAttribute("ServerLuckEndsAt", serverLuckUntil)
	publishLuck()
	if buyer then
		Net.Announce(("🍀 %s activated SERVER LUCK x%d for everyone!"):format(buyer.DisplayName, Config.ServerLuck.Multiplier), Color3.fromRGB(90, 255, 120), 5)
		Net.EffectAll("Confetti", {})
	end
end

function EventService.SetAdminLuck(multiplier: number, seconds: number)
	adminLuck = math.max(1, multiplier)
	adminLuckUntil = now() + seconds
	workspace:SetAttribute("AdminLuck", adminLuck)
	workspace:SetAttribute("AdminLuckEndsAt", adminLuckUntil)
	publishLuck()
	Net.Announce(("👑 ADMIN LUCK x%s for %s!"):format(tostring(adminLuck), Format.Duration(seconds)), Color3.fromRGB(255, 120, 220), 5)
end

function EventService.StartEvent(name: string, duration: number?): boolean
	local def = EventService.Events[name]
	if not def then
		return false
	end
	if current then
		EventService.EndEvent()
	end
	local length = duration or Config.Events.Duration
	local endsAt = now() + length
	current = { Name = name, EndsAt = endsAt }
	workspace:SetAttribute("EventName", name)
	workspace:SetAttribute("EventTitle", def.Title)
	workspace:SetAttribute("EventEndsAt", endsAt)
	publishLuck()
	Net.Announce(def.Title .. " — " .. def.Description, def.Color, 6)
	Net.EffectAll("Sound", { Name = "Announce" })
	if name == "GoldenHour" then
		Registry.StatsService.InvalidateAll()
	end
	task.delay(length, function()
		if current and current.Name == name and current.EndsAt == endsAt then
			EventService.EndEvent()
		end
	end)
	return true
end

function EventService.EndEvent()
	if not current then
		return
	end
	local name = current.Name
	current = nil
	workspace:SetAttribute("EventName", nil)
	workspace:SetAttribute("EventTitle", nil)
	workspace:SetAttribute("EventEndsAt", nil)
	publishLuck()
	if name == "GoldenHour" then
		Registry.StatsService.InvalidateAll()
	end
end

function EventService.GetEventNames(): { string }
	return EVENT_ORDER
end

function EventService.Start()
	publishLuck()
	task.spawn(function()
		task.wait(Config.Events.FirstDelay)
		local lastName = nil
		while true do
			local name
			repeat
				name = EVENT_ORDER[math.random(1, #EVENT_ORDER)]
			until name ~= lastName
			lastName = name
			if not current then
				EventService.StartEvent(name)
			end
			task.wait(Config.Events.Interval)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(5)
			publishLuck()
		end
	end)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- Clasificaciones globales (OrderedDataStore) en los tablones del hub.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)

local LeaderboardService = {}

local REFRESH_INTERVAL = 120

type Board = { Name: string, Store: OrderedDataStore?, GetScore: (any) -> number, FormatValue: (number) -> string }

local boards: { Board } = {
	{
		Name = "TopStardust",
		Store = nil,
		GetScore = function(data)
			return Economy.EncodeScore(data.TotalStardust)
		end,
		FormatValue = function(stored)
			return Format.Abbreviate(Economy.DecodeScore(stored)) .. " ⭐"
		end,
	},
	{
		Name = "TopMeteors",
		Store = nil,
		GetScore = function(data)
			return data.Stats.Meteors
		end,
		FormatValue = function(stored)
			return Format.Abbreviate(stored)
		end,
	},
	{
		Name = "TopSupernovas",
		Store = nil,
		GetScore = function(data)
			return data.Rebirths
		end,
		FormatValue = function(stored)
			return tostring(stored)
		end,
	},
}

local nameCache: { [number]: string } = {}

local function getName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and name then name else "Player"
	nameCache[userId] = result
	return result
end

local function setRow(boardName: string, rank: number, text: string)
	local gui = Registry.MapService.Boards[boardName]
	local row = gui and gui:FindFirstChild("Row" .. rank)
	if row and row:IsA("TextLabel") then
		row.Text = text
	end
end

function LeaderboardService.Submit(player: Player)
	local data = Registry.DataService.Get(player)
	if not data or player.UserId <= 0 then
		return
	end
	for _, board in boards do
		if board.Store then
			local score = math.floor(board.GetScore(data))
			if score > 0 then
				pcall(function()
					(board.Store :: OrderedDataStore):SetAsync(tostring(player.UserId), score)
				end)
			end
		end
	end
end

function LeaderboardService.Refresh()
	for _, board in boards do
		if board.Store then
			local ok, pages = pcall(function()
				return (board.Store :: OrderedDataStore):GetSortedAsync(false, 10)
			end)
			if ok and pages then
				local entries = pages:GetCurrentPage()
				for rank = 1, 10 do
					local entry = entries[rank]
					if entry then
						setRow(board.Name, rank, ("  #%d  %s  •  %s"):format(rank, getName(tonumber(entry.key) or 0), board.FormatValue(entry.value)))
					else
						setRow(board.Name, rank, ("  #%d  ---"):format(rank))
					end
				end
			end
		end
	end
end

function LeaderboardService.Start()
	if not Registry.DataService.IsPersistent() then
		for _, board in boards do
			setRow(board.Name, 1, "  Publish the game to")
			setRow(board.Name, 2, "  enable leaderboards")
		end
		return
	end
	for _, board in boards do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(Config.LeaderboardStorePrefix .. board.Name)
		end)
		if ok then
			board.Store = store
		end
	end
	task.spawn(function()
		task.wait(10)
		while true do
			for _, player in Players:GetPlayers() do
				LeaderboardService.Submit(player)
			end
			LeaderboardService.Refresh()
			task.wait(REFRESH_INTERVAL)
		end
	end)
end

function LeaderboardService.OnPlayerRemoving(player: Player)
	if Registry.DataService.IsPersistent() then
		LeaderboardService.Submit(player)
	end
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[-- Genera el mundo: 6 zonas en fila con su suelo y decoración, puertas, plaza central,
-- soportes de huevos, tienda, altar de Supernova, tablones e iluminación.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Zones = require(Shared.Zones)
local Critters = require(Shared.Critters)
local Models = require(Shared.Models)
local Format = require(Shared.Format)

local Layout = require(script.Parent.Parent.Layout)

local MapService = {}

MapService.Folder = nil :: Folder?
MapService.Boards = {} :: { [string]: SurfaceGui }
MapService.Gates = {} :: { [number]: Part }
MapService.EggStands = {} :: { [number]: Part }
MapService.Obstacles = {} :: { { Position: Vector3, Radius: number } }

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function textLabel(parent: Instance, props: { [string]: any }): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	for key, value in props do
		(label :: any)[key] = value
	end
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(15, 15, 25)
	stroke.Parent = label
	label.Parent = parent
	return label
end

local function addObstacle(position: Vector3, radius: number)
	table.insert(MapService.Obstacles, { Position = position, Radius = radius })
end

-- ---------------------------------------------------------------------
-- Decoración
-- ---------------------------------------------------------------------
local function tree(parent: Instance, position: Vector3, scale: number, leafColor: Color3, trunkColor: Color3, pine: boolean)
	part({ Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(8 * scale, 2 * scale, 2 * scale), CFrame = CFrame.new(position + Vector3.new(0, 4 * scale, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = trunkColor, Material = Enum.Material.Wood, Parent = parent })
	if pine then
		for i = 0, 2 do
			part({ Name = "Leaves", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.6 * scale, (7 - i * 2) * scale, (7 - i * 2) * scale), CFrame = CFrame.new(position + Vector3.new(0, (7 + i * 2.6) * scale, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = leafColor, Material = Enum.Material.Snow, CanCollide = false, Parent = parent })
		end
	else
		for i, offset in { Vector3.new(0, 9, 0), Vector3.new(2.2, 7.5, 1), Vector3.new(-2, 7.8, -1.2) } do
			part({ Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.one * (6.5 - i * 0.7) * scale, CFrame = CFrame.new(position + offset * scale), Color = leafColor, Material = Enum.Material.Grass, CanCollide = false, Parent = parent })
		end
	end
	addObstacle(position, 4 * scale)
end

local function cactus(parent: Instance, position: Vector3, scale: number)
	local green = Color3.fromRGB(80, 160, 80)
	part({ Name = "Cactus", Size = Vector3.new(2, 9, 2) * scale, CFrame = CFrame.new(position + Vector3.new(0, 4.5 * scale, 0)), Color = green, Material = Enum.Material.Grass, Parent = parent })
	for _, side in { -1, 1 } do
		part({ Name = "CactusArm", Size = Vector3.new(1.4, 4, 1.4) * scale, CFrame = CFrame.new(position + Vector3.new(side * 1.9, 5.5 + side * 0.8, 0) * scale), Color = green, Material = Enum.Material.Grass, Parent = parent })
		part({ Name = "CactusJoint", Size = Vector3.new(1.6, 1.4, 1.4) * scale, CFrame = CFrame.new(position + Vector3.new(side * 1.2, 3.9 + side * 0.8, 0) * scale), Color = green, Material = Enum.Material.Grass, Parent = parent })
	end
	addObstacle(position, 3.5 * scale)
end

local function boulder(parent: Instance, position: Vector3, scale: number, color: Color3, material: Enum.Material)
	part({ Name = "Boulder", Shape = Enum.PartType.Ball, Size = Vector3.one * 6 * scale, CFrame = CFrame.new(position + Vector3.new(0, 1.5 * scale, 0)), Color = color, Material = material, Parent = parent })
	addObstacle(position, 3.5 * scale)
end

local function crystalCluster(parent: Instance, position: Vector3, scale: number, color: Color3)
	for i = 0, 4 do
		local angle = math.rad(i * 72)
		local tilt = CFrame.Angles(math.rad(15) * math.cos(angle), 0, math.rad(15) * math.sin(angle))
		part({ Name = "Crystal", Size = Vector3.new(1.6, 7 - i * 0.8, 1.6) * scale, CFrame = CFrame.new(position + Vector3.new(math.cos(angle) * 1.4, 3, math.sin(angle) * 1.4) * scale) * tilt, Color = color, Material = Enum.Material.Neon, Transparency = 0.1, CanCollide = false, Parent = parent })
	end
	addObstacle(position, 3 * scale)
end

local function decorate(zone: Zones.Zone, parent: Instance)
	local rng = Random.new(zone.Index * 1337)
	local minX, maxX = Layout.ZoneXRange(zone.Index)
	local count = 22
	for _ = 1, count do
		local x = rng:NextNumber(minX + 8, maxX - 8)
		local zSide = if rng:NextNumber() < 0.5 then -1 else 1
		local z = zSide * rng:NextNumber(70, 94)
		local position = Vector3.new(x, 0, z)
		local scale = rng:NextNumber(0.9, 1.4)
		if zone.Decor == "Trees" then
			tree(parent, position, scale, Color3.fromRGB(80, 175, 75), Color3.fromRGB(120, 80, 50), false)
		elseif zone.Decor == "Cacti" then
			if rng:NextNumber() < 0.7 then
				cactus(parent, position, scale)
			else
				boulder(parent, position, scale, Color3.fromRGB(190, 140, 90), Enum.Material.Sandstone)
			end
		elseif zone.Decor == "Pines" then
			tree(parent, position, scale, Color3.fromRGB(235, 245, 255), Color3.fromRGB(90, 70, 55), true)
		elseif zone.Decor == "Lava" then
			if rng:NextNumber() < 0.5 then
				part({ Name = "LavaPool", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 12 * scale, 12 * scale), CFrame = CFrame.new(position + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(255, 110, 30), Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
				addObstacle(position, 6 * scale)
			else
				boulder(parent, position, scale, Color3.fromRGB(40, 32, 32), Enum.Material.Basalt)
			end
		elseif zone.Decor == "Craters" then
			part({ Name = "CraterRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 14 * scale, 14 * scale), CFrame = CFrame.new(position + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(150, 150, 160), Material = Enum.Material.Slate, Parent = parent })
			part({ Name = "CraterHole", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.3, 10 * scale, 10 * scale), CFrame = CFrame.new(position + Vector3.new(0, 0.32, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(110, 110, 120), Material = Enum.Material.Slate, Parent = parent })
			addObstacle(position, 7 * scale)
		elseif zone.Decor == "Crystals" then
			crystalCluster(parent, position, scale, if rng:NextNumber() < 0.5 then Color3.fromRGB(230, 110, 255) else Color3.fromRGB(110, 200, 255))
		end
	end
end

-- ---------------------------------------------------------------------
-- Piezas del mundo
-- ---------------------------------------------------------------------
local function buildZoneGround(zone: Zones.Zone, parent: Instance)
	local center = Layout.ZoneCenter(zone.Index)
	part({ Name = "Ground" .. zone.Index, Size = Vector3.new(Layout.ZoneWidth, 4, Layout.ZoneDepth), CFrame = CFrame.new(center + Vector3.new(0, -2, 0)), Color = zone.GroundColor, Material = zone.GroundMaterial, Parent = parent })
	-- Borde exterior (muros) a lo largo de Z
	for _, side in { -1, 1 } do
		part({ Name = "Fence", Size = Vector3.new(Layout.ZoneWidth, 6, 2), CFrame = CFrame.new(center + Vector3.new(0, 3, side * (Layout.ZoneDepth / 2 + 1))), Color = zone.GroundColor:Lerp(Color3.new(0, 0, 0), 0.35), Material = zone.GroundMaterial, Parent = parent })
		part({ Name = "Boundary", Size = Vector3.new(Layout.ZoneWidth, 120, 2), CFrame = CFrame.new(center + Vector3.new(0, 60, side * (Layout.ZoneDepth / 2 + 2))), Transparency = 1, Parent = parent })
	end
	-- Cartel con el nombre de la zona
	local sign = part({ Name = "ZoneSign", Size = Vector3.new(1, 6, 26), CFrame = CFrame.new(center + Vector3.new(-Layout.ZoneWidth / 2 + 6, 14, 30)) * CFrame.Angles(0, 0, 0), Transparency = 1, CanCollide = false, Parent = parent })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Right
	gui.LightInfluence = 0
	gui.PixelsPerStud = 30
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.Parent = sign
	textLabel(gui, { Size = UDim2.fromScale(1, 1), Text = zone.Icon .. " " .. string.upper(zone.Name), TextColor3 = zone.AccentColor })
end

local function buildGate(zone: Zones.Zone, parent: Instance)
	local x = Layout.GatePosition(zone.Index).X
	local half = Layout.GateHalfWidth
	local wallColor = Color3.fromRGB(70, 75, 100)
	local segment = Layout.ZoneDepth / 2 - half
	for _, side in { -1, 1 } do
		part({ Name = "ZoneWall", Size = Vector3.new(3, 24, segment), CFrame = CFrame.new(x, 12, side * (half + segment / 2)), Color = wallColor, Material = Enum.Material.Metal, Parent = parent })
		part({ Name = "WallTop", Size = Vector3.new(3.4, 1, segment), CFrame = CFrame.new(x, 24.5, side * (half + segment / 2)), Color = zone.AccentColor, Material = Enum.Material.Neon, Parent = parent })
		part({ Name = "GatePillar", Size = Vector3.new(5, 30, 4), CFrame = CFrame.new(x, 15, side * (half + 2)), Color = Color3.fromRGB(45, 48, 70), Material = Enum.Material.Metal, Parent = parent })
		part({ Name = "Boundary", Size = Vector3.new(3, 120, segment), CFrame = CFrame.new(x, 60, side * (half + segment / 2)), Transparency = 1, Parent = parent })
	end
	local gate = part({
		Name = "Gate" .. zone.Index,
		Size = Vector3.new(1.5, 30, half * 2),
		CFrame = CFrame.new(x, 15, 0),
		Color = zone.AccentColor,
		Material = Enum.Material.ForceField,
		Parent = parent,
	})
	gate:SetAttribute("Zone", zone.Index)
	-- Cartel encima de la puerta (visible desde ambos lados)
	local sign = part({ Name = "GateSign", Size = Vector3.new(2, 7, 30), CFrame = CFrame.new(x, 34, 0), Color = Color3.fromRGB(30, 32, 50), Parent = parent })
	for _, face in { Enum.NormalId.Left, Enum.NormalId.Right } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.LightInfluence = 0
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 25
		gui.Parent = sign
		textLabel(gui, { Size = UDim2.new(1, -20, 0.55, 0), Position = UDim2.new(0, 10, 0.05, 0), Text = zone.Icon .. " " .. string.upper(zone.Name), TextColor3 = zone.AccentColor })
		textLabel(gui, { Name = "Price", Size = UDim2.new(1, -20, 0.35, 0), Position = UDim2.new(0, 10, 0.6, 0), Text = "🔒 " .. Format.Abbreviate(zone.Cost) .. " ⭐", TextColor3 = Color3.fromRGB(255, 230, 110) })
	end
	MapService.Gates[zone.Index] = gate
end

local function buildEggStand(eggIndex: number, parent: Instance)
	local egg = Critters.GetEgg(eggIndex)
	if not egg then
		return
	end
	local position = Layout.EggPosition(eggIndex)
	local stand = part({ Name = "EggStand" .. eggIndex, Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 9, 9), CFrame = CFrame.new(position + Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(50, 54, 80), Material = Enum.Material.Metal, Parent = parent })
	part({ Name = "StandGlow", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 9.6, 9.6), CFrame = CFrame.new(position + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = egg.SpotColor, Material = Enum.Material.Neon, Parent = parent })
	stand:SetAttribute("Egg", eggIndex)
	local model = Models.BuildEgg(eggIndex, 1.6)
	model:PivotTo(CFrame.new(position + Vector3.new(0, 2, 0)) * CFrame.Angles(0, math.rad(-90), 0))
	model.Parent = parent
	if model.PrimaryPart then
		model.PrimaryPart:AddTag("Spin")
	end
	addObstacle(position, 7)
	MapService.EggStands[eggIndex] = stand
end

local function buildStand(name: string, position: Vector3, title: string, color: Color3, parent: Instance): Part
	local base = part({ Name = name, Size = Vector3.new(12, 1, 8), CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0)), Color = Color3.fromRGB(50, 54, 80), Parent = parent })
	part({ Name = name .. "Counter", Size = Vector3.new(12, 3.5, 2), CFrame = CFrame.new(position + Vector3.new(0, 2.75, -2)), Color = color, Parent = parent })
	for _, side in { -1, 1 } do
		part({ Name = "Post", Size = Vector3.new(0.8, 9, 0.8), CFrame = CFrame.new(position + Vector3.new(side * 5.6, 5.5, 3.4)), Color = Color3.fromRGB(240, 240, 250), Parent = parent })
	end
	local roof = part({ Name = name .. "Roof", Size = Vector3.new(13, 1, 9), CFrame = CFrame.new(position + Vector3.new(0, 10.5, 0)), Color = color, Parent = parent })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(14, 0, 3, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 120
	gui.Parent = roof
	textLabel(gui, { Size = UDim2.fromScale(1, 1), Text = title, TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.4) })
	addObstacle(position, 8)
	return base
end

local function buildBoard(parent: Instance, name: string, title: string, position: Vector3, lookAt: Vector3, color: Color3)
	local board = part({ Name = name, Size = Vector3.new(16, 22, 1), CFrame = CFrame.lookAt(position + Vector3.new(0, 12, 0), lookAt + Vector3.new(0, 12, 0)), Color = Color3.fromRGB(30, 32, 48), Parent = parent })
	part({ Name = "Frame", Size = Vector3.new(17, 23, 0.8), CFrame = board.CFrame * CFrame.new(0, 0, 0.3), Color = color, Material = Enum.Material.Neon, Parent = parent })
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.PixelsPerStud = 30
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.Parent = board
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = gui
	textLabel(gui, { Name = "Header", Size = UDim2.new(1, -20, 0, 70), Text = title, TextColor3 = color, LayoutOrder = 0 })
	for rank = 1, 10 do
		local row = textLabel(gui, {
			Name = "Row" .. rank,
			BackgroundTransparency = 0.1,
			BackgroundColor3 = if rank % 2 == 0 then Color3.fromRGB(40, 44, 64) else Color3.fromRGB(48, 52, 74),
			Size = UDim2.new(1, -24, 0, 50),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = if rank == 1 then Color3.fromRGB(255, 215, 60) elseif rank == 2 then Color3.fromRGB(220, 220, 230) elseif rank == 3 then Color3.fromRGB(230, 150, 90) else Color3.fromRGB(240, 240, 255),
			Text = ("  #%d  ---"):format(rank),
			LayoutOrder = rank,
		})
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = row
	end
	MapService.Boards[name] = gui
end

local function buildHub(parent: Instance)
	local plaza = Layout.PlazaCenter
	part({ Name = "Plaza", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, Layout.PlazaRadius * 2, Layout.PlazaRadius * 2), CFrame = CFrame.new(plaza + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(215, 210, 230), Material = Enum.Material.Concrete, Parent = parent })
	part({ Name = "PlazaRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, Layout.PlazaRadius * 2 + 3, Layout.PlazaRadius * 2 + 3), CFrame = CFrame.new(plaza + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(140, 230, 255), Material = Enum.Material.Neon, Parent = parent })
	part({ Name = "CometMark", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 10, 10), CFrame = CFrame.new(plaza + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(80, 90, 140), Material = Enum.Material.Neon, Parent = parent })

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SpawnLocation"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(Layout.SpawnPosition + Vector3.new(0, 0.5, 0))
	spawn.Color = Color3.fromRGB(140, 230, 255)
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.3
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = parent

	-- Título
	local title = part({ Name = "Title", Size = Vector3.new(1, 10, 44), CFrame = CFrame.new(Layout.ZoneXRange(1) + 1, 22, 0), Transparency = 1, CanCollide = false, Parent = parent })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Right
	gui.LightInfluence = 0
	gui.PixelsPerStud = 30
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.Parent = title
	textLabel(gui, { Size = UDim2.fromScale(1, 1), Text = "☄️ " .. string.upper(Config.GameName), TextColor3 = Color3.fromRGB(255, 200, 90) })

	local boards = Instance.new("Folder")
	boards.Name = "Leaderboards"
	boards.Parent = parent
	local x = Layout.LeaderboardX
	buildBoard(boards, "TopStardust", "⭐ TOP STARDUST", Vector3.new(x, 0, -60), Vector3.new(0, 0, -60), Color3.fromRGB(255, 220, 90))
	buildBoard(boards, "TopMeteors", "☄️ TOP METEORS", Vector3.new(x, 0, -80), Vector3.new(0, 0, -80), Color3.fromRGB(120, 220, 255))
	buildBoard(boards, "TopSupernovas", "🌟 TOP SUPERNOVAS", Vector3.new(x, 0, 64), Vector3.new(0, 0, 64), Color3.fromRGB(255, 120, 200))

	MapService.ShopStand = buildStand("ShopStand", Layout.ShopPosition, "🛒 PICKAXES", Color3.fromRGB(70, 200, 110), parent)
	MapService.Altar = buildStand("SupernovaAltar", Layout.AltarPosition, "🌟 SUPERNOVA", Color3.fromRGB(255, 120, 200), parent)
end

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(100, 100, 115)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 155)
	Lighting.GlobalShadows = true
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(200, 225, 255)
	atmosphere.Decay = Color3.fromRGB(110, 140, 200)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.7
	bloom.Size = 28
	bloom.Threshold = 1.5
	bloom.Parent = Lighting
	local color = Instance.new("ColorCorrectionEffect")
	color.Name = "ZoneColor"
	color.Saturation = 0.15
	color.Contrast = 0.06
	color.Parent = Lighting
end

function MapService.Build()
	local map = Instance.new("Folder")
	map.Name = "Map"
	MapService.Folder = map

	for _, zone in Zones.List do
		local folder = Instance.new("Folder")
		folder.Name = zone.Id
		folder.Parent = map
		buildZoneGround(zone, folder)
		decorate(zone, folder)
		if zone.Index > 1 then
			buildGate(zone, folder)
		end
		buildEggStand(zone.Index, folder)
	end
	buildHub(map)

	-- Muros de los extremos
	local firstMin = Layout.ZoneXRange(1)
	local _, lastMax = Layout.ZoneXRange(Zones.Count())
	for _, x in { firstMin - 1, lastMax + 1 } do
		part({ Name = "EndWall", Size = Vector3.new(2, 8, Layout.ZoneDepth), CFrame = CFrame.new(x, 4, 0), Color = Color3.fromRGB(60, 64, 90), Parent = map })
		part({ Name = "Boundary", Size = Vector3.new(2, 120, Layout.ZoneDepth), CFrame = CFrame.new(x, 60, 0), Transparency = 1, Parent = map })
	end

	for _, name in { "Meteors", "Effects" } do
		local folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = workspace
	end

	map.Parent = workspace
	setupLighting()
	return map
end

-- ¿Hay espacio libre para un meteorito de radio r en esta posición?
function MapService.IsClear(position: Vector3, radius: number): boolean
	for _, obstacle in MapService.Obstacles do
		local flat = Vector3.new(position.X - obstacle.Position.X, 0, position.Z - obstacle.Position.Z)
		if flat.Magnitude < obstacle.Radius + radius + 2 then
			return false
		end
	end
	return true
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">MeteorService</string>
            <string name="Source"><![CDATA[-- Meteoritos: aviso en el suelo -> impacto con onda expansiva -> roca con vida que
-- todos pueden picar -> al romperse, botín repartido según el daño de cada uno.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Rarities = require(Shared.Rarities)
local Zones = require(Shared.Zones)
local Models = require(Shared.Models)
local Remotes = require(Shared.Remotes)

local Registry = require(script.Parent.Parent.Registry)
local Layout = require(script.Parent.Parent.Layout)
local Net = require(script.Parent.Parent.Net)

local MeteorService = {}

export type Meteor = {
	Id: number,
	Zone: number,
	Rarity: string,
	HP: number,
	MaxHP: number,
	Position: Vector3,
	Radius: number,
	Damage: { [Player]: number },
	Landed: boolean,
	Dead: boolean,
	Comet: boolean,
	ImpactAt: number,
	LandedAt: number,
	ReservedFor: Player?,
	ReservedUntil: number,
	Model: Model?,
	Marker: BasePart?,
	HpFill: Frame?,
	HpText: TextLabel?,
	TopText: TextLabel?,
	BillboardDirty: boolean,
}

local meteors: { [number]: Meteor } = {}
local nextId = 0
local rng = Random.new()
local folder: Folder
local zoneTimers: { [number]: number } = {}
local reservedNotice: { [Player]: number } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function label(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = Color3.fromRGB(255, 255, 255)
	for key, value in props do
		(l :: any)[key] = value
	end
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(10, 10, 20)
	stroke.Parent = l
	l.Parent = parent
	return l
end

local function displayName(meteor: Meteor): string
	if meteor.Comet then
		return "☄️ GIANT COMET"
	end
	return string.upper(meteor.Rarity) .. " METEOR"
end

local function rarityColor(meteor: Meteor): Color3
	if meteor.Comet then
		return Color3.fromRGB(140, 230, 255)
	end
	return Rarities.Get(meteor.Rarity).Color
end

-- ---------------------------------------------------------------------
-- Consultas
-- ---------------------------------------------------------------------
function MeteorService.Get(id: number): Meteor?
	return meteors[id]
end

function MeteorService.GetAll(): { [number]: Meteor }
	return meteors
end

function MeteorService.CountActive(zoneIndex: number): number
	local count = 0
	for _, meteor in meteors do
		if meteor.Zone == zoneIndex and not meteor.Comet then
			count += 1
		end
	end
	return count
end

-- Meteorito aterrizado más cercano al alcance del jugador
function MeteorService.FindTarget(player: Player, reach: number?): Meteor?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return nil
	end
	local data = Registry.DataService.Get(player)
	local unlocked = if data then data.Zone else 1
	local best, bestDistance = nil, math.huge
	for _, meteor in meteors do
		if meteor.Landed and not meteor.Dead and (meteor.Comet or meteor.Zone <= unlocked) then
			local flat = Vector3.new(root.Position.X - meteor.Position.X, 0, root.Position.Z - meteor.Position.Z)
			local distance = flat.Magnitude - meteor.Radius
			if distance <= (reach or Config.Meteors.MiningReach) and distance < bestDistance then
				best, bestDistance = meteor, distance
			end
		end
	end
	return best
end

-- ---------------------------------------------------------------------
-- Aparición
-- ---------------------------------------------------------------------
local function findSpot(zoneIndex: number, radius: number, near: Vector3?): Vector3?
	local minX, maxX, maxZ = Layout.MeteorArea(zoneIndex)
	for _ = 1, 30 do
		local position
		if near then
			local angle = rng:NextNumber(0, math.pi * 2)
			local distance = rng:NextNumber(radius + 8, radius + 18)
			position = near + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
			position = Vector3.new(math.clamp(position.X, minX, maxX), 0, math.clamp(position.Z, -maxZ, maxZ))
		else
			position = Vector3.new(rng:NextNumber(minX, maxX), 0, rng:NextNumber(-maxZ, maxZ))
		end
		local ok = Registry.MapService.IsClear(position, radius)
		if ok then
			for _, other in meteors do
				local flat = Vector3.new(position.X - other.Position.X, 0, position.Z - other.Position.Z)
				if flat.Magnitude < radius + other.Radius + 8 then
					ok = false
					break
				end
			end
		end
		if ok then
			return position
		end
	end
	return nil
end

export type SpawnOptions = {
	Position: Vector3?,
	Near: Vector3?,
	ReservedFor: Player?,
	Comet: boolean?,
	HP: number?,
	WarningTime: number?,
}

function MeteorService.Spawn(zoneIndex: number, rarityName: string?, options: SpawnOptions?): Meteor?
	local opts: SpawnOptions = options or {}
	local rarity = rarityName or Economy.RollMeteorRarity(rng, Registry.EventService.GetLuck())
	local radius = if opts.Comet then 13 else Rarities.Get(rarity).Size
	local position = opts.Position or findSpot(zoneIndex, radius, opts.Near)
	if not position then
		return nil
	end
	nextId += 1
	local hp = opts.HP or Economy.GetMeteorHP(zoneIndex, rarity)
	local warning = opts.WarningTime or Config.Meteors.WarningTime
	local meteor: Meteor = {
		Id = nextId,
		Zone = zoneIndex,
		Rarity = rarity,
		HP = hp,
		MaxHP = hp,
		Position = position,
		Radius = radius,
		Damage = {},
		Landed = false,
		Dead = false,
		Comet = opts.Comet == true,
		ImpactAt = now() + warning,
		LandedAt = 0,
		ReservedFor = opts.ReservedFor,
		ReservedUntil = 0,
		Model = nil,
		Marker = nil,
		HpFill = nil,
		HpText = nil,
		TopText = nil,
		BillboardDirty = true,
	}
	meteors[meteor.Id] = meteor

	-- Círculo de aviso en el suelo (el cliente dibuja la bola de fuego que cae)
	local color = rarityColor(meteor)
	local marker = Instance.new("Part")
	marker.Name = "Incoming"
	marker.Shape = Enum.PartType.Cylinder
	marker.Size = Vector3.new(0.3, radius * 2.8, radius * 2.8)
	marker.CFrame = CFrame.new(position + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	marker.Color = color
	marker.Material = Enum.Material.Neon
	marker.Transparency = 0.35
	marker.Anchored = true
	marker.CanCollide = false
	marker.CanQuery = false
	marker.CanTouch = false
	marker:SetAttribute("MeteorId", meteor.Id)
	marker:SetAttribute("Rarity", rarity)
	marker:SetAttribute("ImpactAt", meteor.ImpactAt)
	marker:SetAttribute("Comet", meteor.Comet)
	marker:SetAttribute("Radius", radius)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Warning"
	gui.Size = UDim2.new(12, 0, 3, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 400
	gui.AlwaysOnTop = true
	label(gui, { Name = "Title", Size = UDim2.fromScale(1, 0.55), Text = "⚠️ " .. displayName(meteor), TextColor3 = color })
	label(gui, { Name = "Countdown", Size = UDim2.fromScale(1, 0.45), Position = UDim2.fromScale(0, 0.55), Text = tostring(math.ceil(warning)), TextColor3 = Color3.fromRGB(255, 255, 255) })
	gui.Parent = marker
	CollectionService:AddTag(marker, "MeteorMarker")
	marker.Parent = folder
	meteor.Marker = marker

	local rarityDef = Rarities.Get(rarity)
	if not meteor.Comet and rarityDef.Announce then
		Net.Announce(("☄️ A %s meteor is falling in %s!"):format(string.upper(rarity), Zones.Get(zoneIndex).Name), rarityDef.Color, 4)
		Net.EffectAll("Sound", { Name = "Announce" })
	end

	task.delay(warning, function()
		MeteorService.Land(meteor)
	end)
	return meteor
end

function MeteorService.Land(meteor: Meteor)
	if meteor.Dead or meteor.Landed then
		return
	end
	if meteor.Marker then
		meteor.Marker:Destroy()
		meteor.Marker = nil
	end
	local model = Models.BuildMeteor(meteor.Rarity, meteor.Zone, { Comet = meteor.Comet })
	model:PivotTo(CFrame.new(meteor.Position) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
	model:SetAttribute("MeteorId", meteor.Id)
	model:SetAttribute("Zone", meteor.Zone)
	model:SetAttribute("Comet", meteor.Comet)
	CollectionService:AddTag(model, "Meteor")

	-- Cartel con la vida
	local root = model.PrimaryPart :: BasePart
	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.new(if meteor.Comet then 20 else 11, 0, if meteor.Comet then 5 else 3.4, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, meteor.Radius * 1.9 + 3, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = if meteor.Comet then 500 else 160
	label(gui, { Name = "Title", Size = UDim2.fromScale(1, 0.32), Text = displayName(meteor), TextColor3 = rarityColor(meteor) })
	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
	bar.BorderSizePixel = 0
	bar.Size = UDim2.fromScale(1, 0.3)
	bar.Position = UDim2.fromScale(0, 0.34)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = bar
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = bar
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = rarityColor(meteor)
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(1, 1)
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.5, 0)
	fillCorner.Parent = fill
	fill.Parent = bar
	local hpText = label(bar, { Name = "HP", Size = UDim2.fromScale(1, 0.9), Position = UDim2.fromScale(0, 0.05), Text = "", ZIndex = 2 })
	bar.Parent = gui
	local topText = label(gui, { Name = "Top", Size = UDim2.fromScale(1, 0.3), Position = UDim2.fromScale(0, 0.68), Text = "", TextColor3 = Color3.fromRGB(255, 230, 140) })
	gui.Parent = root

	model.Parent = folder
	meteor.Model = model
	meteor.HpFill = fill
	meteor.HpText = hpText
	meteor.TopText = topText
	meteor.Landed = true
	meteor.LandedAt = now()
	meteor.BillboardDirty = true
	if meteor.ReservedFor then
		meteor.ReservedUntil = now() + Config.Meteors.ReservedSeconds
	end

	-- Onda expansiva: los jugadores cercanos salen volando
	local knockback = Remotes.Event("Knockback")
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") then
			local offset = hrp.Position - meteor.Position
			local flat = Vector3.new(offset.X, 0, offset.Z)
			if flat.Magnitude < Config.Meteors.ImpactRadius + meteor.Radius then
				local dir = if flat.Magnitude > 0.1 then flat.Unit else Vector3.new(1, 0, 0)
				knockback:FireClient(player, dir * Config.Meteors.ImpactKnockback + Vector3.new(0, Config.Meteors.ImpactKnockback * 0.7, 0))
			end
		end
	end
	Net.EffectAll("Impact", { Position = meteor.Position, Rarity = meteor.Rarity, Comet = meteor.Comet, Radius = meteor.Radius })
end

-- ---------------------------------------------------------------------
-- Daño y rotura
-- ---------------------------------------------------------------------
function MeteorService.Damage(player: Player, meteor: Meteor, amount: number): number
	if meteor.Dead or not meteor.Landed or amount <= 0 or amount ~= amount then
		return 0
	end
	if meteor.ReservedFor and meteor.ReservedFor ~= player and now() < meteor.ReservedUntil then
		if (reservedNotice[player] or 0) < os.clock() then
			reservedNotice[player] = os.clock() + 3
			Net.Notify(player, ("🔒 Reserved for %s for %ds"):format(meteor.ReservedFor.DisplayName, math.ceil(meteor.ReservedUntil - now())), "Error")
		end
		return 0
	end
	local dealt = math.min(amount, meteor.HP)
	meteor.HP -= dealt
	meteor.Damage[player] = (meteor.Damage[player] or 0) + dealt
	meteor.BillboardDirty = true
	if meteor.HP <= 0 then
		MeteorService.Break(meteor)
	end
	return dealt
end

local function contributors(meteor: Meteor): ({ { Player: Player, Damage: number } }, number)
	local list = {}
	local total = 0
	for player, damage in meteor.Damage do
		if damage > 0 then
			table.insert(list, { Player = player, Damage = damage })
			total += damage
		end
	end
	table.sort(list, function(a, b)
		return a.Damage > b.Damage
	end)
	return list, total
end

function MeteorService.Break(meteor: Meteor)
	if meteor.Dead then
		return
	end
	meteor.Dead = true
	meteors[meteor.Id] = nil
	local list, total = contributors(meteor)
	local count = #list
	local rarity = Rarities.Get(meteor.Rarity)
	local mvp = list[1] and list[1].Player

	if meteor.Comet then
		Registry.CometService.OnBroken(meteor, list, total)
	else
		local baseLoot = Economy.GetMeteorLoot(meteor.Zone, meteor.Rarity) * (1 + Config.Meteors.TeamworkBonus * math.max(0, count - 1))
		for _, entry in list do
			local player = entry.Player
			local data = Registry.DataService.Get(player)
			if player.Parent == Players and data then
				local share = entry.Damage / math.max(total, 1)
				local loot = baseLoot * share * Registry.StatsService.GetStardustMultiplier(player)
				local isMvp = player == mvp
				if isMvp then
					loot *= 1 + Config.Meteors.MvpBonus
				end
				loot = math.max(1, math.floor(loot))
				Registry.DataService.AddStardust(player, loot)
				data.Stats.Meteors += 1
				Registry.QuestService.Progress(player, "BreakMeteors", 1)
				if rarity.Order >= 3 then
					data.Stats.RareMeteors += 1
					Registry.QuestService.Progress(player, "BreakRare", 1)
				end
				if isMvp and count > 0 then
					data.Stats.MVPs += 1
					Registry.QuestService.Progress(player, "BeMVP", 1)
				end
				Registry.DataService.UpdateDisplay(player)
				Registry.DataService.MarkDirty(player)
				Net.Effect(player, "Loot", { Amount = loot, Position = meteor.Position, MVP = isMvp and count > 1, Share = share })
			end
		end
		-- Huevo de meteorito para el MVP
		if mvp and mvp.Parent == Players and rng:NextNumber() < rarity.EggChance then
			local critterRarity = if rarity.Name == "Cosmic" then "Mythic" else rarity.Name
			Registry.CritterService.GiveCritterOfRarity(mvp, critterRarity, meteor.Zone, rarity.Name == "Cosmic", "meteor")
		end
		if rarity.Announce and mvp then
			Net.Announce(("💥 %s broke a %s meteor!"):format(mvp.DisplayName, string.upper(rarity.Name)), rarity.Color, 3)
		end
	end

	Net.EffectAll("Break", { Position = meteor.Position, Rarity = meteor.Rarity, Comet = meteor.Comet, Radius = meteor.Radius })
	if meteor.Model then
		meteor.Model:Destroy()
		meteor.Model = nil
	end
end

function MeteorService.Expire(meteor: Meteor)
	if meteor.Dead then
		return
	end
	meteor.Dead = true
	meteors[meteor.Id] = nil
	if meteor.Model then
		meteor.Model:Destroy()
	end
	if meteor.Marker then
		meteor.Marker:Destroy()
	end
end

local function updateBillboard(meteor: Meteor)
	meteor.BillboardDirty = false
	if not meteor.HpFill or not meteor.HpText or not meteor.TopText then
		return
	end
	local fraction = math.clamp(meteor.HP / meteor.MaxHP, 0, 1)
	meteor.HpFill.Size = UDim2.fromScale(fraction, 1)
	meteor.HpText.Text = Format.Abbreviate(math.ceil(meteor.HP)) .. " / " .. Format.Abbreviate(meteor.MaxHP)
	local list, total = contributors(meteor)
	local parts = {}
	for i = 1, math.min(3, #list) do
		table.insert(parts, ("%s %d%%"):format(list[i].Player.DisplayName, math.floor(list[i].Damage / math.max(total, 1) * 100 + 0.5)))
	end
	local reserved = ""
	if meteor.ReservedFor and now() < meteor.ReservedUntil then
		reserved = ("🔒 %s %ds  "):format(meteor.ReservedFor.DisplayName, math.ceil(meteor.ReservedUntil - now()))
	elseif meteor.ReservedFor and meteor.Landed then
		meteor.ReservedFor = nil
	end
	meteor.TopText.Text = reserved .. table.concat(parts, "  •  ")
end

-- Meteorito invocado por un producto: cae junto al jugador
function MeteorService.SummonFor(player: Player): Meteor?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local data = Registry.DataService.Get(player)
	if not data then
		return nil
	end
	local roll = rng:NextNumber()
	local rarity = if roll < 0.05 then "Cosmic" elseif roll < 0.25 then "Mythic" else "Legendary"
	local zoneIndex = math.clamp(Registry.ZoneService.GetCurrentZone(player), 1, data.Zone)
	local near = if root and root:IsA("BasePart") then root.Position else nil
	local meteor = MeteorService.Spawn(zoneIndex, rarity, { Near = near, ReservedFor = player })
	if not meteor then
		meteor = MeteorService.Spawn(zoneIndex, rarity, { ReservedFor = player })
	end
	if meteor then
		Net.Announce(("🌠 %s summoned a %s meteor!"):format(player.DisplayName, string.upper(rarity)), Rarities.Get(rarity).Color, 4)
	end
	return meteor
end

function MeteorService.Start()
	folder = workspace:WaitForChild("Meteors") :: Folder

	-- Aparición por zona (solo donde hay jugadores)
	task.spawn(function()
		while true do
			task.wait(1)
			local playersPerZone: { [number]: number } = {}
			for _, player in Players:GetPlayers() do
				local zone = Registry.ZoneService.GetCurrentZone(player)
				if zone > 0 then
					playersPerZone[zone] = (playersPerZone[zone] or 0) + 1
				end
			end
			local interval = Config.Meteors.SpawnInterval / Registry.EventService.GetSpawnRateMultiplier()
			for zoneIndex = 1, Zones.Count() do
				local playerCount = playersPerZone[zoneIndex] or 0
				if playerCount > 0 then
					zoneTimers[zoneIndex] = (zoneTimers[zoneIndex] or 0) + 1
					local cap = math.min(Config.Meteors.MaxActivePerZone + (playerCount - 1) * Config.Meteors.ExtraPerPlayer, Config.Meteors.MaxActiveCap)
					if zoneTimers[zoneIndex] >= interval and MeteorService.CountActive(zoneIndex) < cap then
						zoneTimers[zoneIndex] = 0
						local ok, err = pcall(MeteorService.Spawn, zoneIndex)
						if not ok then
							warn("[MeteorService] " .. tostring(err))
						end
					end
				else
					zoneTimers[zoneIndex] = 0
				end
			end
			-- Caducidad
			local t = now()
			for _, meteor in meteors do
				if meteor.Landed and not meteor.Comet and t - meteor.LandedAt > Config.Meteors.Lifetime then
					MeteorService.Expire(meteor)
				end
			end
		end
	end)

	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.2 then
			return
		end
		elapsed = 0
		for _, meteor in meteors do
			if meteor.BillboardDirty or (meteor.ReservedFor and meteor.Landed) then
				updateBillboard(meteor)
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		reservedNotice[player] = nil
	end)
end

return MeteorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">MiningService</string>
            <string name="Source"><![CDATA[-- Picar: cada jugador lleva un pico (Tool). Los golpes se validan en el servidor.
-- Las criaturas equipadas ayudan (daño por segundo) y Auto Mine golpea solo.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Gear = require(Shared.Gear)

local Registry = require(script.Parent.Parent.Registry)
local Net = require(script.Parent.Parent.Net)

local MiningService = {}

local lastSwing: { [Player]: number } = {}
local lastTarget: { [Player]: number } = {}
local rng = Random.new()

local function buildPickaxe(def: Gear.PickaxeDef): Tool
	local tool = Instance.new("Tool")
	tool.Name = def.Name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = "Click near a meteor to mine it!"
	tool.Grip = CFrame.fromMatrix(Vector3.new(0, 0, -1.5), Vector3.new(0, 1, 0), Vector3.new(0, 0, 1))
	tool:SetAttribute("PickaxeId", def.Id)
	CollectionService:AddTag(tool, "PickaxeTool")

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.35, 0.35, 4.2)
	handle.Color = def.Color
	handle.Material = Enum.Material.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local function attach(part: BasePart)
		part.CanCollide = false
		part.Massless = true
		part.Color = def.HeadColor
		part.Material = def.Material
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = part
		weld.Parent = part
		part.Parent = tool
	end

	if def.Id == "Galaxy" then
		local head = Instance.new("Part")
		head.Name = "Head"
		head.Shape = Enum.PartType.Cylinder
		head.Size = Vector3.new(2.6, 1.6, 1.6)
		head.CFrame = handle.CFrame * CFrame.new(0, 0, 2)
		attach(head)
	else
		local head = Instance.new("Part")
		head.Name = "Head"
		head.Size = Vector3.new(3.2, 0.5, 0.6)
		head.CFrame = handle.CFrame * CFrame.new(0, 0, 1.85)
		attach(head)
		for _, side in { -1, 1 } do
			local tip = Instance.new("Part")
			tip.Name = "Tip"
			tip.Size = Vector3.new(0.9, 0.35, 0.45)
			tip.CFrame = head.CFrame * CFrame.new(side * 1.85, 0, -0.15) * CFrame.Angles(0, side * math.rad(25), 0)
			attach(tip)
		end
	end
	if def.Material == Enum.Material.Neon then
		local glow = Instance.new("PointLight")
		glow.Color = def.HeadColor
		glow.Range = 8
		glow.Brightness = 1.2
		glow.Parent = handle
	end
	return tool
end

function MiningService.GivePickaxe(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local character = player.Character
	if not backpack then
		return
	end
	for _, container in { backpack, character } do
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and CollectionService:HasTag(child, "PickaxeTool") then
					child:Destroy()
				end
			end
		end
	end
	local stats = Registry.StatsService.Get(player)
	local def = Gear.GetPickaxe(if stats then stats.Pickaxe else "Rusty") or Gear.Pickaxes[1]
	local tool = buildPickaxe(def)
	tool.Activated:Connect(function()
		if tool.Parent == player.Character then
			MiningService.Swing(player, true)
		end
	end)
	tool.Parent = backpack
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid:EquipTool(tool)
	end
end

local function setTarget(player: Player, meteorId: number?)
	if meteorId then
		lastTarget[player] = os.clock()
		if player:GetAttribute("Target") ~= meteorId then
			player:SetAttribute("Target", meteorId)
		end
	elseif player:GetAttribute("Target") ~= nil and os.clock() - (lastTarget[player] or 0) > 2 then
		player:SetAttribute("Target", nil)
	end
end

-- Un golpe del jugador. animate = mostrar animación de la herramienta.
function MiningService.Swing(player: Player, animate: boolean): boolean
	local data = Registry.DataService.Get(player)
	if not data then
		return false
	end
	local cooldown = Registry.StatsService.GetCooldown(player)
	local t = os.clock()
	if (lastSwing[player] or 0) + cooldown * 0.9 > t then
		return false
	end
	lastSwing[player] = t

	if animate then
		local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
		if tool then
			local anim = Instance.new("StringValue")
			anim.Name = "toolanim"
			anim.Value = "Slash"
			anim.Parent = tool
			Debris:AddItem(anim, 1)
		end
	end

	local meteor = Registry.MeteorService.FindTarget(player)
	if not meteor then
		return false
	end
	local damage = Registry.StatsService.GetHitDamage(player)
	local crit = rng:NextNumber() < Registry.StatsService.GetCritChance(player)
	if crit then
		damage *= Config.Mining.CritMultiplier
	end
	local dealt = Registry.MeteorService.Damage(player, meteor, damage)
	if dealt <= 0 then
		return false
	end
	data.Stats.Swings += 1
	Registry.QuestService.Progress(player, "Swings", 1)
	if crit then
		data.Stats.Crits += 1
		Registry.QuestService.Progress(player, "Crits", 1)
	end
	setTarget(player, meteor.Id)
	Net.Effect(player, "Hit", { Position = meteor.Position + Vector3.new(0, meteor.Radius * 1.3, 0), Amount = damage, Crit = crit })
	return true
end

function MiningService.Start()
	-- Auto Mine (gamepass)
	task.spawn(function()
		while true do
			task.wait(Config.Mining.AutoMineInterval)
			for _, player in Players:GetPlayers() do
				if Registry.MonetizationService.OwnsPass(player, "AutoMine") then
					MiningService.Swing(player, true)
				end
			end
		end
	end)

	-- Criaturas que ayudan a picar
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				local data = Registry.DataService.Get(player)
				if data then
					local helpers = #data.Equipped
					local meteor = if helpers > 0 then Registry.MeteorService.FindTarget(player, Config.Mining.HelperRange) else nil
					if meteor then
						local damage = Registry.StatsService.GetHitDamage(player) * Config.Mining.HelperDpsFactor * helpers
						if Registry.MeteorService.Damage(player, meteor, damage) > 0 then
							setTarget(player, meteor.Id)
						end
					else
						setTarget(player, nil)
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastSwing[player] = nil
		lastTarget[player] = nil
	end)
end

return MiningService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[-- Game Passes y Developer Products. ProcessReceipt es idempotente (cada compra se
-- registra en los datos del jugador). En Studio se pueden simular las compras.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Products = require(Shared.Products)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)
local Actions = require(script.Parent.Parent.Actions)
local Net = require(script.Parent.Parent.Net)

local MonetizationService = {}

local owned: { [Player]: { [string]: boolean } } = {}
local EMPTY = table.freeze({})
local rng = Random.new()

local function applyPassEffects(player: Player, key: string)
	if key == "VIP" then
		Registry.PlayerService.UpdateOverhead(player)
	end
	if key == "RocketBoots" then
		Registry.PlayerService.UpdateMovement(player)
	end
	if key == "GalaxyHammer" then
		local data = Registry.DataService.Get(player)
		if data then
			data.Pickaxe = "Galaxy"
		end
	end
	Registry.StatsService.Invalidate(player)
	if key == "GalaxyHammer" then
		Registry.MiningService.GivePickaxe(player)
	end
	if key == "ExtraSlots" then
		Registry.CritterService.EquipBest(player)
	end
end

function MonetizationService.GrantPass(player: Player, key: string, announce: boolean)
	local def = Products.GamePasses[key]
	if not def then
		return
	end
	owned[player] = owned[player] or {}
	if owned[player][key] then
		return
	end
	owned[player][key] = true
	applyPassEffects(player, key)
	if announce then
		Net.Announce(("👑 %s bought %s %s!"):format(player.DisplayName, def.Icon, def.Name), Color3.fromRGB(255, 215, 70), 4)
		Net.Effect(player, "Confetti", {})
	end
end

function MonetizationService.ApplyProduct(player: Player, key: string): (boolean, string?)
	local def = Products.DevProducts[key]
	local data = Registry.DataService.Get(player)
	if not def or not data then
		return false, "Invalid product"
	end
	if def.Kind == "Stardust" then
		local amount = Economy.ScaleReward(def.Minimum, Registry.StatsService.GetRewardBase(player), def.Meteors)
		Registry.DataService.AddStardust(player, amount)
		Net.Effect(player, "Confetti", {})
		Net.Effect(player, "Sound", { Name = "Stardust" })
		return true, "+" .. Format.Abbreviate(amount) .. " ⭐"
	elseif def.Kind == "ServerLuck" then
		Registry.EventService.AddServerLuck(def.Seconds, player)
		return true, "Server Luck activated!"
	elseif def.Kind == "PowerBoost" then
		Registry.StatsService.AddBoost(player, "Damage", def.Seconds)
		Registry.StatsService.AddBoost(player, "Stardust", def.Seconds)
		return true, "x2 damage & stardust!"
	elseif def.Kind == "Summon" then
		local meteor = Registry.MeteorService.SummonFor(player)
		if not meteor then
			-- No había hueco: se compensa
			local amount = math.floor(Registry.StatsService.GetRewardBase(player) * 40)
			Registry.DataService.AddStardust(player, amount)
			return true, "No space for a meteor, got +" .. Format.Abbreviate(amount) .. " ⭐"
		end
		return true, "A meteor is falling next to you!"
	elseif def.Kind == "Comet" then
		local launched = Registry.CometService.Launch(player)
		return true, if launched then "The comet is coming!" else "Comet queued after the current one!"
	elseif def.Kind == "SuperEgg" then
		local rarity = if rng:NextNumber() < 0.15 then "Mythic" else "Legendary"
		Registry.CritterService.GiveCritterOfRarity(player, rarity, data.Zone, false, "product")
		return true, "Super Egg opened!"
	end
	return false, "Unknown product"
end

local function processReceipt(receiptInfo): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = Registry.DataService.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local receiptKey = tostring(receiptInfo.PurchaseId)
	if Registry.DataService.HasReceipt(player, receiptKey) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local def = Products.FindProductById(receiptInfo.ProductId)
	if not def then
		warn("[Monetization] Producto desconocido: " .. tostring(receiptInfo.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, success, message = pcall(MonetizationService.ApplyProduct, player, def.Key)
	if not ok or not success then
		warn("[Monetization] Error aplicando " .. def.Key .. ": " .. tostring(if ok then message else success))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Registry.DataService.AddReceipt(player, receiptKey)
	Registry.DataService.MarkDirty(player)
	task.spawn(Registry.DataService.Save, player, false)
	Net.Notify(player, ("💎 Thanks! %s: %s"):format(def.Name, message or ""), "Success")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.Init()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased then
			local def = Products.FindPassById(passId)
			if def then
				MonetizationService.GrantPass(player, def.Key, true)
			end
		end
	end)
	Actions.Register("SimulatePurchase", function(player, payload)
		if not (RunService:IsStudio() and Config.SimulatePurchasesInStudio) then
			return false, "Purchases are not configured yet"
		end
		local key = tostring(payload.Key)
		if payload.Kind == "Pass" then
			local def = Products.GamePasses[key]
			if not def then
				return false, "Invalid pass"
			end
			MonetizationService.GrantPass(player, key, true)
			return true, "[Studio] Simulated pass: " .. def.Name
		elseif payload.Kind == "Product" then
			local ok, message = MonetizationService.ApplyProduct(player, key)
			return ok, "[Studio] " .. tostring(message)
		end
		return false, "Invalid purchase"
	end)
end

function MonetizationService.LoadPlayer(player: Player)
	owned[player] = owned[player] or {}
	local pending = 0
	for key, def in Products.GamePasses do
		if def.Id ~= 0 then
			pending += 1
			task.spawn(function()
				local ok, has = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.Id)
				end)
				if ok and has and owned[player] then
					owned[player][key] = true
				end
				pending -= 1
			end)
		end
	end
	local started = os.clock()
	while pending > 0 and os.clock() - started < 10 do
		task.wait(0.1)
	end
end

function MonetizationService.OnPlayerRemoving(player: Player)
	owned[player] = nil
end

function MonetizationService.GetOwnedPasses(player: Player): { [string]: boolean }
	return owned[player] or EMPTY :: any
end

function MonetizationService.OwnsPass(player: Player, key: string): boolean
	local passes = owned[player]
	return passes ~= nil and passes[key] == true
end

function MonetizationService.FillView(player: Player, view: { [string]: any })
	view.Passes = MonetizationService.GetOwnedPasses(player)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source"><![CDATA[-- Personajes: aparecer en tu mejor zona, velocidad/salto, etiqueta sobre la cabeza
-- y bonus de amigos/grupo.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)

local Registry = require(script.Parent.Parent.Registry)
local Actions = require(script.Parent.Parent.Actions)
local Net = require(script.Parent.Parent.Net)

local PlayerService = {}

local friendCounts: { [Player]: number } = {}
local friendPairs: { [Player]: { [Player]: boolean } } = {}
local groupMembers: { [Player]: boolean } = {}

function PlayerService.UpdateMovement(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local data = Registry.DataService.Get(player)
	if not humanoid or not data then
		return
	end
	local boots = Registry.MonetizationService.OwnsPass(player, "RocketBoots")
	humanoid.WalkSpeed = Economy.GetWalkSpeed(data.Upgrades.Speed or 0, boots)
	humanoid.UseJumpPower = false
	humanoid.JumpHeight = 7.2 + (if boots then Config.Player.BootsJump else 0)
end

function PlayerService.UpdateOverhead(player: Player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local data = Registry.DataService.Get(player)
	if not head or not data then
		return
	end
	local existing = head:FindFirstChild("Overhead")
	if existing then
		existing:Destroy()
	end
	local isVip = Registry.MonetizationService.OwnsPass(player, "VIP")
	if not isVip and data.Rebirths <= 0 then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Overhead"
	gui.Size = UDim2.new(6, 0, 0.9, 0)
	gui.StudsOffset = Vector3.new(0, 3.2, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 70
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	local parts = {}
	if isVip then
		table.insert(parts, "👑 VIP")
	end
	if data.Rebirths > 0 then
		table.insert(parts, "🌟 " .. data.Rebirths)
	end
	label.Text = table.concat(parts, "  ")
	label.TextColor3 = if isVip then Color3.fromRGB(255, 215, 60) else Color3.fromRGB(255, 160, 230)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = head
end

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root then
		return
	end
	task.wait(0.1)
	if player.Character ~= character then
		return
	end
	Registry.ZoneService.Teleport(player, Registry.ZoneService.GetUnlocked(player))
	Registry.MiningService.GivePickaxe(player)
	PlayerService.UpdateMovement(player)
	PlayerService.UpdateOverhead(player)
end

function PlayerService.GetFriendCount(player: Player): number
	return friendCounts[player] or 0
end

function PlayerService.IsInGroup(player: Player): boolean
	return groupMembers[player] == true
end

local function checkFriends(player: Player)
	friendPairs[player] = friendPairs[player] or {}
	for _, other in Players:GetPlayers() do
		if other ~= player and friendPairs[other] and not friendPairs[player][other] then
			local ok, isFriend = pcall(function()
				return player:IsFriendsWith(other.UserId)
			end)
			if ok and isFriend and player.Parent and other.Parent then
				friendPairs[player][other] = true
				friendPairs[other][player] = true
				friendCounts[player] = (friendCounts[player] or 0) + 1
				friendCounts[other] = (friendCounts[other] or 0) + 1
				Registry.StatsService.Invalidate(other)
				Net.Notify(other, ("👋 Your friend %s joined! +%d%% stardust"):format(player.DisplayName, math.floor(Config.Income.FriendBonus * 100)), "Success")
			end
		end
	end
	Registry.StatsService.Invalidate(player)
end

function PlayerService.Init()
	Actions.Register("RequestSync", function(player)
		Registry.DataService.MarkDirty(player)
		return true
	end)
end

function PlayerService.SetupPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	task.spawn(checkFriends, player)
	if Config.GroupId > 0 then
		task.spawn(function()
			local ok, inGroup = pcall(function()
				return player:IsInGroup(Config.GroupId)
			end)
			if ok and inGroup then
				groupMembers[player] = true
				Registry.StatsService.Invalidate(player)
			end
		end)
	end
end

function PlayerService.OnPlayerRemoving(player: Player)
	local friends = friendPairs[player]
	if friends then
		for other in friends do
			if friendPairs[other] then
				friendPairs[other][player] = nil
				friendCounts[other] = math.max(0, (friendCounts[other] or 1) - 1)
				Registry.StatsService.Invalidate(other)
			end
		end
	end
	friendPairs[player] = nil
	friendCounts[player] = nil
	groupMembers[player] = nil
end

return PlayerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[-- Misiones diarias (3 por día) con premio extra al completar todas.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Quests = require(Shared.Quests)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)
local Actions = require(script.Parent.Parent.Actions)
local Net = require(script.Parent.Parent.Net)

local QuestService = {}

local function today(): number
	return math.floor(os.time() / 86400)
end

function QuestService.EnsureToday(player: Player): any?
	local data = Registry.DataService.Get(player)
	if not data then
		return nil
	end
	local day = today()
	if data.Quests.Day ~= day or #data.Quests.List == 0 then
		data.Quests = { Day = day, List = Quests.Generate(day, player.UserId), BonusClaimed = false }
		Registry.DataService.MarkDirty(player)
	end
	return data.Quests
end

function QuestService.Progress(player: Player, kind: string, amount: number)
	local quests = QuestService.EnsureToday(player)
	if not quests then
		return
	end
	for _, quest in quests.List do
		if quest.Kind == kind and quest.Progress < quest.Target then
			quest.Progress = math.min(quest.Target, quest.Progress + amount)
			if quest.Progress >= quest.Target then
				Net.Notify(player, "✅ Quest complete: " .. Quests.Describe(quest.Kind, quest.Target) .. "! Claim it in Quests.", "Success")
				Net.Effect(player, "Sound", { Name = "Buy" })
			end
			Registry.DataService.MarkDirty(player)
		end
	end
end

function QuestService.FillView(player: Player, view: { [string]: any })
	local quests = QuestService.EnsureToday(player)
	if quests then
		view.Quests = quests
		view.QuestsResetAt = (today() + 1) * 86400
	end
end

function QuestService.Init()
	Actions.Register("ClaimQuest", function(player, payload)
		local quests = QuestService.EnsureToday(player)
		local index = tonumber(payload.Index)
		local quest = quests and index and quests.List[index]
		if not quest then
			return false, "Invalid quest"
		end
		if quest.Claimed then
			return false, "Already claimed"
		end
		if quest.Progress < quest.Target then
			return false, "Not finished yet"
		end
		quest.Claimed = true
		local reward = math.floor(Registry.StatsService.GetRewardBase(player) * quest.RewardMeteors)
		Registry.DataService.AddStardust(player, reward)
		Registry.DataService.MarkDirty(player)
		Net.Effect(player, "Sound", { Name = "Stardust" })
		return true, ("+%s ⭐"):format(Format.Abbreviate(reward))
	end)

	Actions.Register("ClaimQuestBonus", function(player)
		local quests = QuestService.EnsureToday(player)
		if not quests then
			return false, nil
		end
		if quests.BonusClaimed then
			return false, "Already claimed"
		end
		for _, quest in quests.List do
			if not quest.Claimed then
				return false, "Claim all 3 quests first"
			end
		end
		quests.BonusClaimed = true
		local description = Registry.RewardService.Grant(player, Quests.Bonus)
		return true, "🏆 " .. description
	end)
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[-- 🌟 Supernova (rebirth): reinicia Stardust, picos y zonas a cambio de
-- +50% stardust, +25% daño y +1 hueco de criatura permanentes. Las criaturas se conservan.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)
local Actions = require(script.Parent.Parent.Actions)
local Net = require(script.Parent.Parent.Net)

local RebirthService = {}

function RebirthService.DoRebirth(player: Player): (boolean, string?)
	local data = Registry.DataService.Get(player)
	if not data then
		return false, "Data not loaded"
	end
	if data.Rebirths >= Config.Rebirth.MaxRebirths then
		return false, "Max supernovas reached!"
	end
	local cost = Economy.GetRebirthCost(data.Rebirths)
	if data.Stardust < cost then
		return false, ("You need %s ⭐"):format(Format.Abbreviate(cost))
	end
	data.Rebirths += 1
	data.Stardust = Config.StartingStardust
	data.OwnedPickaxes = { Rusty = true }
	if not (data.Pickaxe == "Galaxy" and Registry.MonetizationService.OwnsPass(player, "GalaxyHammer")) then
		data.Pickaxe = "Rusty"
	end
	data.Zone = 1

	Registry.StatsService.Invalidate(player)
	Registry.DataService.UpdateDisplay(player)
	Registry.MiningService.GivePickaxe(player)
	Registry.ZoneService.Teleport(player, 1)
	Registry.PlayerService.UpdateOverhead(player)
	Registry.DataService.MarkDirty(player)

	Net.Effect(player, "Supernova", { Rebirths = data.Rebirths })
	Net.Announce(("🌟 %s went SUPERNOVA %d!"):format(player.DisplayName, data.Rebirths), Color3.fromRGB(255, 140, 220), 4)
	task.spawn(Registry.DataService.Save, player, false)
	return true, ("Supernova %d! Permanent bonuses unlocked"):format(data.Rebirths)
end

function RebirthService.Init()
	Actions.Register("Rebirth", function(player)
		return RebirthService.DoRebirth(player)
	end)
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[-- Recompensas de retención: diaria con racha, regalos por tiempo jugado y códigos.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)
local Actions = require(script.Parent.Parent.Actions)
local Net = require(script.Parent.Parent.Net)

local RewardService = {}

type Session = { Start: number, Claimed: { [string]: boolean } }

local sessions: { [Player]: Session } = {}

local function today(): number
	return math.floor(os.time() / 86400)
end

-- Entrega una recompensa (Stardust / Meteors / Boost / DamageBoost / CritterRarity)
function RewardService.Grant(player: Player, reward: { [string]: any }): string
	local data = Registry.DataService.Get(player)
	if not data then
		return ""
	end
	local parts = {}
	if reward.Stardust or reward.Meteors then
		local amount = Economy.ScaleReward(reward.Stardust, Registry.StatsService.GetRewardBase(player), reward.Meteors)
		if amount > 0 then
			Registry.DataService.AddStardust(player, amount)
			table.insert(parts, Format.Abbreviate(amount) .. " ⭐")
			Net.Effect(player, "Sound", { Name = "Stardust" })
		end
	end
	if reward.Boost then
		Registry.StatsService.AddBoost(player, "Stardust", reward.Boost)
		table.insert(parts, "2x Stardust " .. Format.Duration(reward.Boost))
	end
	if reward.DamageBoost then
		Registry.StatsService.AddBoost(player, "Damage", reward.DamageBoost)
		table.insert(parts, "2x Damage " .. Format.Duration(reward.DamageBoost))
	end
	if reward.CritterRarity then
		local uid = Registry.CritterService.GiveCritterOfRarity(player, reward.CritterRarity, nil, false, "reward")
		table.insert(parts, (if uid then "a " else "stardust for a ") .. reward.CritterRarity .. " critter")
	end
	Net.Effect(player, "Confetti", {})
	Registry.DataService.MarkDirty(player)
	return table.concat(parts, " + ")
end

function RewardService.OnJoin(player: Player)
	sessions[player] = { Start = workspace:GetServerTimeNow(), Claimed = {} }
	local data = Registry.DataService.Get(player)
	if not data then
		return
	end
	player:SetAttribute("BoostStardust", data.Boosts.Stardust or 0)
	player:SetAttribute("BoostDamage", data.Boosts.Damage or 0)
	data.LastOnline = os.time()
	if data.Daily.LastDay < today() then
		task.delay(5, function()
			if player.Parent then
				Net.Effect(player, "DailyAvailable", {})
			end
		end)
	end
end

function RewardService.OnPlayerRemoving(player: Player)
	sessions[player] = nil
end

function RewardService.FillView(player: Player, view: { [string]: any })
	local data = Registry.DataService.Get(player)
	local session = sessions[player]
	view.SessionStart = if session then session.Start else workspace:GetServerTimeNow()
	view.GiftsClaimed = if session then session.Claimed else {}
	if not data then
		return
	end
	local t = today()
	local lastDay = data.Daily.LastDay
	local streak = data.Daily.Streak
	local nextStreak = if lastDay >= t - 1 then streak + 1 else 1
	view.DailyAvailable = lastDay < t
	view.DailyStreak = if lastDay >= t - 1 then streak else 0
	view.DailyNextIndex = ((nextStreak - 1) % #Config.DailyRewards) + 1
	view.DailyResetAt = (t + 1) * 86400
end

function RewardService.Init()
	Actions.Register("ClaimDaily", function(player)
		local data = Registry.DataService.Get(player)
		if not data then
			return false, "Data not loaded"
		end
		local t = today()
		if data.Daily.LastDay >= t then
			return false, "Come back tomorrow!"
		end
		local streak = if data.Daily.LastDay == t - 1 then data.Daily.Streak + 1 else 1
		data.Daily.LastDay = t
		data.Daily.Streak = streak
		local reward = Config.DailyRewards[((streak - 1) % #Config.DailyRewards) + 1]
		return true, ("📅 Day %d: %s"):format(streak, RewardService.Grant(player, reward))
	end)

	Actions.Register("ClaimGift", function(player, payload)
		local session = sessions[player]
		local index = tonumber(payload.Index)
		local gift = index and Config.PlaytimeGifts[index]
		if not session or not gift or not index then
			return false, "Invalid gift"
		end
		local key = tostring(index)
		if session.Claimed[key] then
			return false, "Already claimed"
		end
		if workspace:GetServerTimeNow() - session.Start < gift.Minutes * 60 - 2 then
			return false, "Not ready yet"
		end
		session.Claimed[key] = true
		return true, "🎁 " .. RewardService.Grant(player, gift)
	end)

	Actions.Register("RedeemCode", function(player, payload)
		local data = Registry.DataService.Get(player)
		if not data then
			return false, "Data not loaded"
		end
		local code = string.upper((string.gsub(tostring(payload.Code or ""), "%s", "")))
		if #code == 0 or #code > 30 then
			return false, "Enter a code"
		end
		local reward = Config.Codes[code]
		if not reward then
			return false, "Invalid code"
		end
		if data.Codes[code] then
			return false, "Code already redeemed"
		end
		data.Codes[code] = true
		return true, "✅ " .. RewardService.Grant(player, reward)
	end)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[-- Tienda con Stardust: picos (en orden) y mejoras permanentes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Gear = require(Shared.Gear)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)
local Actions = require(script.Parent.Parent.Actions)
local Net = require(script.Parent.Parent.Net)

local ShopService = {}

local function bestOwnedTier(data: any): number
	local best = 1
	for id in data.OwnedPickaxes do
		local pick = Gear.GetPickaxe(id)
		if pick and not pick.GamePass then
			best = math.max(best, Gear.GetTier(id))
		end
	end
	return best
end

function ShopService.Init()
	Actions.Register("BuyPickaxe", function(player, payload)
		local data = Registry.DataService.Get(player)
		local pick = Gear.GetPickaxe(tostring(payload.Id))
		if not data or not pick then
			return false, "Invalid pickaxe"
		end
		if pick.GamePass then
			return false, "This one is a Game Pass"
		end
		if data.OwnedPickaxes[pick.Id] then
			return false, "Already owned"
		end
		if Gear.GetTier(pick.Id) > bestOwnedTier(data) + 1 then
			return false, "Buy the previous pickaxe first"
		end
		if not Registry.DataService.SpendStardust(player, pick.Price) then
			return false, ("You need %s ⭐"):format(Format.Abbreviate(pick.Price))
		end
		data.OwnedPickaxes[pick.Id] = true
		data.Pickaxe = pick.Id
		Registry.StatsService.Invalidate(player)
		Registry.MiningService.GivePickaxe(player)
		Net.Effect(player, "Sound", { Name = "Buy" })
		return true, "Bought " .. pick.Name .. "!"
	end)

	Actions.Register("EquipPickaxe", function(player, payload)
		local data = Registry.DataService.Get(player)
		local pick = Gear.GetPickaxe(tostring(payload.Id))
		if not data or not pick then
			return false, "Invalid pickaxe"
		end
		local owned = if pick.GamePass then Registry.MonetizationService.OwnsPass(player, pick.GamePass) else data.OwnedPickaxes[pick.Id] == true
		if not owned then
			return false, "You don't own this pickaxe"
		end
		data.Pickaxe = pick.Id
		Registry.StatsService.Invalidate(player)
		Registry.MiningService.GivePickaxe(player)
		return true, "Equipped " .. pick.Name
	end)

	Actions.Register("BuyUpgrade", function(player, payload)
		local data = Registry.DataService.Get(player)
		local key = tostring(payload.Key)
		local def = Gear.Upgrades[key]
		if not data or not def then
			return false, "Invalid upgrade"
		end
		local level = data.Upgrades[key] or 0
		if level >= def.MaxLevel then
			return false, "Max level!"
		end
		local cost = Economy.GetUpgradeCost(key, level)
		if not Registry.DataService.SpendStardust(player, cost) then
			return false, ("You need %s ⭐"):format(Format.Abbreviate(cost))
		end
		data.Upgrades[key] = level + 1
		Registry.StatsService.Invalidate(player)
		if key == "Speed" then
			Registry.PlayerService.UpdateMovement(player)
		end
		Net.Effect(player, "Sound", { Name = "Buy" })
		return true, ("%s → level %d!"):format(def.Name, level + 1)
	end)
end

function ShopService.Start()
	-- Puestos físicos: abren las ventanas de la interfaz
	local shop = Registry.MapService.ShopStand
	local altar = Registry.MapService.Altar
	for _, entry in { { shop, "Shop", "Open Shop" }, { altar, "Rebirth", "Supernova" } } do
		local stand = entry[1]
		if stand then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "OpenPrompt"
			prompt.ActionText = entry[3]
			prompt.ObjectText = ""
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 12
			prompt.RequiresLineOfSight = false
			prompt.Parent = stand
			prompt.Triggered:Connect(function(player)
				Net.Effect(player, "OpenWindow", { Name = entry[2] })
			end)
		end
	end
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">StatsService</string>
            <string name="Source"><![CDATA[-- Estadísticas derivadas de cada jugador (daño por golpe, multiplicadores, suerte...)
-- con caché. Cualquier cambio relevante llama a StatsService.Invalidate(player).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Gear = require(Shared.Gear)

local Registry = require(script.Parent.Parent.Registry)
local Net = require(script.Parent.Parent.Net)

local StatsService = {}

type Stats = {
	CritterBonus: number,
	DamageMultiplier: number,
	DamageBreakdown: { any },
	StardustMultiplier: number,
	StardustBreakdown: { any },
	Pickaxe: string,
	HitDamage: number,
	Cooldown: number,
	CritChance: number,
	HatchLuck: number,
	RewardBase: number,
	SlotCount: number,
}

local cache: { [Player]: Stats } = {}

local function compute(player: Player): Stats?
	local data = Registry.DataService.Get(player)
	if not data then
		return nil
	end
	local passes = Registry.MonetizationService.GetOwnedPasses(player)
	local critterBonus = if Registry.CritterService then Registry.CritterService.GetEquippedBonus(player) else 0
	local damageMultiplier, damageBreakdown = Economy.GetDamageMultiplier({
		CritterBonus = critterBonus,
		Rebirths = data.Rebirths,
		VIP = passes.VIP == true,
		DamageBoost = (data.Boosts.Damage or 0) > 0,
	})
	local playerService = Registry.PlayerService
	local stardustMultiplier, stardustBreakdown = Economy.GetStardustMultiplier({
		Rebirths = data.Rebirths,
		Friends = if playerService then playerService.GetFriendCount(player) else 0,
		VIP = passes.VIP == true,
		Premium = player.MembershipType == Enum.MembershipType.Premium,
		InGroup = if playerService then playerService.IsInGroup(player) else false,
		DoubleStardust = passes.DoubleStardust == true,
		Boost = (data.Boosts.Stardust or 0) > 0,
		EventMultiplier = Registry.EventService.GetStardustMultiplier(),
	})
	local pickaxeId = data.Pickaxe
	local pick = Gear.GetPickaxe(pickaxeId)
	if not pick or (pick.GamePass and passes[pick.GamePass] ~= true) then
		pickaxeId = "Rusty"
		pick = Gear.GetPickaxe("Rusty")
	end
	return {
		CritterBonus = critterBonus,
		DamageMultiplier = damageMultiplier,
		DamageBreakdown = damageBreakdown,
		StardustMultiplier = stardustMultiplier,
		StardustBreakdown = stardustBreakdown,
		Pickaxe = pickaxeId,
		HitDamage = Economy.GetHitDamage(pickaxeId, damageMultiplier),
		Cooldown = (pick :: Gear.PickaxeDef).Cooldown,
		CritChance = Economy.GetCritChance(data.Upgrades.Crit or 0),
		HatchLuck = Economy.GetHatchLuck(data.Upgrades.Luck or 0, passes.LuckyHatch == true),
		RewardBase = Economy.GetRewardBase(data.Zone, stardustMultiplier),
		SlotCount = Economy.GetSlotCount(data.Rebirths, passes.ExtraSlots == true),
	}
end

function StatsService.Get(player: Player): Stats?
	local stats = cache[player]
	if not stats then
		stats = compute(player)
		cache[player] = stats
		if stats then
			player:SetAttribute("HitDamage", stats.HitDamage)
		end
	end
	return stats
end

function StatsService.Invalidate(player: Player)
	cache[player] = nil
	StatsService.Get(player)
	Registry.DataService.MarkDirty(player)
end

function StatsService.InvalidateAll()
	for _, player in Players:GetPlayers() do
		StatsService.Invalidate(player)
	end
end

function StatsService.GetHitDamage(player: Player): number
	local stats = StatsService.Get(player)
	return if stats then stats.HitDamage else 1
end

function StatsService.GetCooldown(player: Player): number
	local stats = StatsService.Get(player)
	return if stats then stats.Cooldown else 0.4
end

function StatsService.GetCritChance(player: Player): number
	local stats = StatsService.Get(player)
	return if stats then stats.CritChance else 0
end

function StatsService.GetStardustMultiplier(player: Player): number
	local stats = StatsService.Get(player)
	return if stats then stats.StardustMultiplier else 1
end

function StatsService.GetRewardBase(player: Player): number
	local stats = StatsService.Get(player)
	return if stats then stats.RewardBase else 1
end

function StatsService.GetHatchLuck(player: Player): number
	local stats = StatsService.Get(player)
	return if stats then stats.HatchLuck else 1
end

function StatsService.GetSlotCount(player: Player): number
	local stats = StatsService.Get(player)
	return if stats then stats.SlotCount else Config.Critters.BaseSlots
end

-- Daño por segundo estimado (para dimensionar el cometa)
function StatsService.EstimateDps(player: Player): number
	local stats = StatsService.Get(player)
	if not stats then
		return 0
	end
	local data = Registry.DataService.Get(player)
	local helpers = if data then #data.Equipped else 0
	local crit = 1 + stats.CritChance * (Config.Mining.CritMultiplier - 1)
	return stats.HitDamage / stats.Cooldown * crit * 0.7 + stats.HitDamage * Config.Mining.HelperDpsFactor * helpers
end

function StatsService.FillView(player: Player, view: { [string]: any })
	local stats = StatsService.Get(player)
	if not stats then
		return
	end
	local data = Registry.DataService.Get(player)
	view.DamageMultiplier = stats.DamageMultiplier
	view.DamageBreakdown = stats.DamageBreakdown
	view.StardustMultiplier = stats.StardustMultiplier
	view.StardustBreakdown = stats.StardustBreakdown
	view.HitDamage = stats.HitDamage
	view.ActivePickaxe = stats.Pickaxe
	view.CritChance = stats.CritChance
	view.HatchLuck = stats.HatchLuck
	view.RewardBase = stats.RewardBase
	view.SlotCount = stats.SlotCount
	view.RebirthCost = Economy.GetRebirthCost(if data then data.Rebirths else 0)
end

function StatsService.Start()
	-- Contadores de boosts y tiempo jugado
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				local data = Registry.DataService.Get(player)
				if data then
					data.Stats.Playtime += 1
					for _, key in { "Stardust", "Damage" } do
						if (data.Boosts[key] or 0) > 0 then
							data.Boosts[key] = math.max(0, data.Boosts[key] - 1)
							player:SetAttribute("Boost" .. key, data.Boosts[key])
							if data.Boosts[key] == 0 then
								StatsService.Invalidate(player)
								Net.Notify(player, (if key == "Damage" then "⚔️ Damage" else "⏫ Stardust") .. " boost ended", "Info")
							end
						end
					end
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		cache[player] = nil
	end)
end

function StatsService.AddBoost(player: Player, key: string, seconds: number)
	local data = Registry.DataService.Get(player)
	if not data then
		return
	end
	data.Boosts[key] = (data.Boosts[key] or 0) + seconds
	player:SetAttribute("Boost" .. key, data.Boosts[key])
	StatsService.Invalidate(player)
end

return StatsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">ZoneService</string>
            <string name="Source"><![CDATA[-- Zonas: desbloquear con Stardust, teletransporte, y control anti-trampas
-- (si alguien entra en una zona que no tiene, vuelve a la suya).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Zones = require(Shared.Zones)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)
local Actions = require(script.Parent.Parent.Actions)
local Layout = require(script.Parent.Parent.Layout)
local Net = require(script.Parent.Parent.Net)

local ZoneService = {}

local teleportCooldown: { [Player]: number } = {}

function ZoneService.GetUnlocked(player: Player): number
	local data = Registry.DataService.Get(player)
	return if data then data.Zone else 1
end

function ZoneService.GetCurrentZone(player: Player): number
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return 0
	end
	return Layout.ZoneAt(root.Position)
end

function ZoneService.Teleport(player: Player, zoneIndex: number): boolean
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return false
	end
	character:PivotTo(Layout.ZoneSpawn(zoneIndex) + Vector3.new(math.random(-4, 4), 0, math.random(-6, 6)))
	return true
end

function ZoneService.Unlock(player: Player, zoneIndex: number): (boolean, string?)
	local data = Registry.DataService.Get(player)
	local zone = Zones.List[zoneIndex]
	if not data or not zone then
		return false, "Invalid zone"
	end
	if data.Zone >= zoneIndex then
		return false, "Already unlocked"
	end
	if zoneIndex ~= data.Zone + 1 then
		return false, "Unlock " .. Zones.Get(data.Zone + 1).Name .. " first"
	end
	if not Registry.DataService.SpendStardust(player, zone.Cost) then
		return false, ("You need %s ⭐"):format(Format.Abbreviate(zone.Cost))
	end
	data.Zone = zoneIndex
	Registry.StatsService.Invalidate(player)
	Registry.DataService.MarkDirty(player)
	Net.Effect(player, "Sound", { Name = "Buy" })
	Net.Effect(player, "Confetti", {})
	Net.Announce(("%s %s unlocked %s!"):format(zone.Icon, player.DisplayName, zone.Name), zone.AccentColor, 3)
	return true, zone.Icon .. " " .. zone.Name .. " unlocked!"
end

function ZoneService.Init()
	Actions.Register("UnlockZone", function(player, payload)
		return ZoneService.Unlock(player, tonumber(payload.Zone) or 0)
	end)
	Actions.Register("TeleportZone", function(player, payload)
		local index = tonumber(payload.Zone) or 0
		if index < 1 or index > ZoneService.GetUnlocked(player) then
			return false, "Zone locked"
		end
		local now = os.clock()
		if (teleportCooldown[player] or 0) > now then
			return false, "Wait a moment..."
		end
		teleportCooldown[player] = now + 2
		return ZoneService.Teleport(player, index), nil
	end)
end

function ZoneService.Start()
	-- Prompts de las puertas
	for zoneIndex, gate in Registry.MapService.Gates do
		local zone = Zones.Get(zoneIndex)
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "UnlockPrompt"
		prompt.ActionText = "Unlock " .. Format.Abbreviate(zone.Cost) .. " ⭐"
		prompt.ObjectText = zone.Name
		prompt.HoldDuration = 0.3
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("Zone", zoneIndex)
		prompt.Parent = gate
		prompt.Triggered:Connect(function(player)
			local ok, message = ZoneService.Unlock(player, zoneIndex)
			if message then
				Net.Notify(player, message, if ok then "Success" else "Error")
			end
		end)
	end

	-- Actualiza la zona actual de cada jugador y expulsa de zonas no desbloqueadas
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, player in Players:GetPlayers() do
				local current = ZoneService.GetCurrentZone(player)
				if current > 0 then
					if player:GetAttribute("Zone") ~= current then
						player:SetAttribute("Zone", current)
					end
					local unlocked = ZoneService.GetUnlocked(player)
					if current > unlocked and Registry.DataService.Get(player) then
						ZoneService.Teleport(player, unlocked)
						Net.Notify(player, "🔒 Unlock " .. Zones.Get(current).Name .. " first!", "Error")
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		teleportCooldown[player] = nil
	end)
end

return ZoneService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="42">
