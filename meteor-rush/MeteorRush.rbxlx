			ball(ctx, "Gill", Vector3.new(S * 0.24, S * 0.07, S * 0.07), CFrame.new(base + Vector3.new(side * S * 0.1, i * S * 0.05, 0)) * CFrame.Angles(0, 0, side * math.rad(20 + i * 25)), Color3.fromRGB(255, 100, 150))
		end
