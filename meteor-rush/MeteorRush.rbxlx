		block(ctx, "Crack", Vector3.new(S * 0.04, S * 0.22, S * 0.03), CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, 0, math.rad(30)), Color3.fromRGB(255, 120, 30), Enum.Material.Neon)
	end
