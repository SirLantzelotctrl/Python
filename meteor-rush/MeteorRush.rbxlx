          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">Combat</string>
              <string name="Source"><![CDATA[-- Empujón (knockback) por la onda expansiva de los meteoritos al impactar.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

local Modules = script.Parent.Parent.Modules
local Sound = require(Modules.Sound)

local Combat = {}

local player = Players.LocalPlayer
local stunnedUntil = 0

function Combat.Init()
	Remotes.Event("Knockback").OnClientEvent:Connect(function(velocity)
		if typeof(velocity) ~= "Vector3" then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not humanoid then
			return
		end
		Sound.Play("Hit", 0.6)
		stunnedUntil = os.clock() + 1.1
		humanoid.PlatformStand = true
		root.AssemblyLinearVelocity = velocity
		root.AssemblyAngularVelocity = Vector3.new(math.random(-8, 8), math.random(-4, 4), math.random(-8, 8))
		task.delay(1.15, function()
			if os.clock() >= stunnedUntil and humanoid.Parent then
				humanoid.PlatformStand = false
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)
	end)
end

return Combat
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- Efectos que pide el servidor: botín, números de daño, impactos, roturas,
-- sonidos, confeti, supernova, abrir ventanas y pedir compras.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Format"))
local Rarities = require(Shared:WaitForChild("Rarities"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local Sound = require(Modules.Sound)
local Purchase = require(Modules.Purchase)

local Windows = require(script.Parent.Windows)
local Notifications = require(script.Parent.Notifications)
local Hatch = require(script.Parent.Hatch)

local Effects = {}

local player = Players.LocalPlayer
local effectsRoot: Frame
local CONFETTI = {
	Color3.fromRGB(255, 90, 90),
	Color3.fromRGB(255, 220, 80),
	Color3.fromRGB(90, 255, 140),
	Color3.fromRGB(90, 180, 255),
	Color3.fromRGB(220, 110, 255),
}

function Effects.FloatingText(position: Vector3, text: string, color: Color3?, size: number?)
	local attachment = Instance.new("Attachment")
	attachment.WorldPosition = position + Vector3.new(math.random(-15, 15) / 10, 0, math.random(-15, 15) / 10)
	attachment.Parent = Workspace.Terrain
	local scale = size or 1
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(5 * scale, 0, 1.4 * scale, 0)
	gui.StudsOffset = Vector3.new(0, 1, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = attachment
	local label = UI.Text({ Text = text, TextColor3 = color or Color3.fromRGB(255, 230, 110), StrokeThickness = 3, Parent = gui })
	UI.Tween(gui, 0.9, { StudsOffset = Vector3.new(0, 5, 0) })
	task.delay(0.45, function()
		UI.Tween(label, 0.45, { TextTransparency = 1 })
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			UI.Tween(stroke, 0.45, { Transparency = 1 })
		end
	end)
	Debris:AddItem(attachment, 1)
end

function Effects.Confetti(amount: number?)
	for _ = 1, amount or 45 do
		local size = math.random(10, 18)
		local piece = UI.New("Frame", {
			BackgroundColor3 = CONFETTI[math.random(1, #CONFETTI)],
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(size, size * 0.6),
			Position = UDim2.new(math.random(), 0, 0, -20),
			Rotation = math.random(0, 360),
			Parent = effectsRoot,
		})
		local duration = 1.6 + math.random() * 1.2
		UI.Tween(piece, duration, { Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1, 40), Rotation = piece.Rotation + math.random(-360, 360) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(duration, function()
			piece:Destroy()
		end)
	end
end

function Effects.Flash(color: Color3, strength: number?)
	local flash = UI.New("Frame", { BackgroundColor3 = color, BackgroundTransparency = 1 - (strength or 0.8), Size = UDim2.fromScale(1, 1), Parent = effectsRoot })
	UI.Tween(flash, 0.7, { BackgroundTransparency = 1 })
	task.delay(0.75, function()
		flash:Destroy()
	end)
end

-- Temblor de cámara (desplaza la cámara del humanoide)
function Effects.Shake(intensity: number, duration: number)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	task.spawn(function()
		local elapsed = 0
		while elapsed < duration do
			local falloff = 1 - elapsed / duration
			humanoid.CameraOffset = Vector3.new((math.random() - 0.5) * intensity * falloff, (math.random() - 0.5) * intensity * falloff, 0)
			elapsed += task.wait()
		end
		humanoid.CameraOffset = Vector3.zero
	end)
end

-- Trozos de roca que salen volando (solo local)
function Effects.Debris(position: Vector3, color: Color3, count: number, size: number)
	for _ = 1, count do
		local piece = Instance.new("Part")
		piece.Size = Vector3.one * size * (0.5 + math.random())
		piece.Color = if math.random() < 0.5 then color else Color3.fromRGB(80, 75, 85)
		piece.Material = if math.random() < 0.5 then Enum.Material.Neon else Enum.Material.Slate
		piece.CanCollide = false
		piece.CanQuery = false
		piece.CanTouch = false
		piece.Anchored = true
		piece.CFrame = CFrame.new(position + Vector3.new(0, size * 2, 0))
		piece.Parent = Workspace.Terrain
		local target = position + Vector3.new((math.random() - 0.5) * 30, math.random() * 14 + 2, (math.random() - 0.5) * 30)
		UI.Tween(piece, 0.8, { CFrame = CFrame.new(target) * CFrame.Angles(math.random() * 6, math.random() * 6, 0), Transparency = 1, Size = piece.Size * 0.3 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		Debris:AddItem(piece, 0.9)
	end
end

local function distanceTo(position: Vector3): number
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return (root.Position - position).Magnitude
	end
	return math.huge
end

local handlers: { [string]: (payload: { [string]: any }) -> () } = {}

handlers.Sound = function(payload)
	if typeof(payload.Name) == "string" then
		Sound.Play(payload.Name, 0.5)
	end
end

handlers.Hit = function(payload)
	if typeof(payload.Position) ~= "Vector3" then
		return
	end
	Sound.Play(if payload.Crit then "Crit" else "Hit", 0.35)
	local amount = Format.Abbreviate(payload.Amount or 0)
	if payload.Crit then
		Effects.FloatingText(payload.Position, "💥" .. amount, Color3.fromRGB(255, 150, 60), 1.4)
	else
		Effects.FloatingText(payload.Position, amount, Color3.fromRGB(255, 255, 255), 1)
	end
end

handlers.Loot = function(payload)
	Sound.Play("Stardust", 0.6)
	if typeof(payload.Position) == "Vector3" then
		Effects.FloatingText(payload.Position + Vector3.new(0, 6, 0), "+" .. Format.Abbreviate(payload.Amount or 0) .. " ⭐", Color3.fromRGB(255, 225, 90), 1.8)
	end
	if payload.MVP then
		Notifications.Announce("🏅 MVP! +25% stardust", Color3.fromRGB(255, 215, 70), 2)
	end
end

handlers.Impact = function(payload)
	if typeof(payload.Position) ~= "Vector3" then
		return
	end
	local distance = distanceTo(payload.Position)
	local rarity = Rarities.Get(payload.Rarity or "Common")
	local color = if payload.Comet then Color3.fromRGB(140, 230, 255) else rarity.Color
	if distance < 160 then
		Sound.Play("Impact", math.clamp(1 - distance / 160, 0.15, 0.8))
		Effects.Shake(if payload.Comet then 3 else 1.2, if payload.Comet then 1 else 0.45)
		Effects.Debris(payload.Position, color, if payload.Comet then 30 else 12, (payload.Radius or 3) * 0.25)
	end
	if distance < 40 or payload.Comet then
		Effects.Flash(color, if payload.Comet then 0.5 else 0.25)
	end
end

handlers.Break = function(payload)
	if typeof(payload.Position) ~= "Vector3" then
		return
	end
	if distanceTo(payload.Position) < 200 then
		local rarity = Rarities.Get(payload.Rarity or "Common")
		Sound.Play("Break", 0.5)
		Effects.Debris(payload.Position, if payload.Comet then Color3.fromRGB(140, 230, 255) else rarity.Color, if payload.Comet then 40 else 18, (payload.Radius or 3) * 0.3)
	end
end

handlers.Confetti = function()
	Effects.Confetti()
end

handlers.Supernova = function(payload)
	Sound.Play("Supernova", 0.8)
	Effects.Flash(Color3.fromRGB(255, 220, 255), 0.9)
	Effects.Confetti(80)
	Notifications.Announce(("🌟 SUPERNOVA %d!"):format(payload.Rebirths or 1), Color3.fromRGB(255, 150, 230), 4)
end

handlers.OpenWindow = function(payload)
	if typeof(payload.Name) == "string" then
		Windows.Open(payload.Name)
	end
end

handlers.PromptPass = function(payload)
	if typeof(payload.Key) == "string" then
		Purchase.PromptPass(payload.Key)
	end
end

handlers.Hatch = function(payload)
	if typeof(payload.Results) == "table" then
		Hatch.Play(tonumber(payload.Egg) or 1, payload.Results)
	end
end

handlers.DailyAvailable = function()
	Notifications.Show("📅 Your daily reward is ready! Open Daily.", "Success")
end

handlers.CometIncoming = function()
	Sound.Play("Announce", 0.7)
end

function Effects.Init()
	local _, root = UI.Screen("MeteorRushEffects", 25)
	effectsRoot = root
	Remotes.Event("Effect").OnClientEvent:Connect(function(name, payload)
		local handler = handlers[name]
		if handler then
			local ok, err = pcall(handler, if typeof(payload) == "table" then payload else {})
			if not ok then
				warn("[Effects] " .. tostring(err))
			end
		end
	end)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Followers</string>
              <string name="Source"><![CDATA[-- Dibuja (solo en local) las criaturas equipadas de cada jugador: le siguen flotando
-- y, cuando su dueño pica un meteorito, saltan a su alrededor "atacándolo".

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Models = require(Shared:WaitForChild("Models"))
local Critters = require(Shared:WaitForChild("Critters"))

local Followers = {}

type Entry = { Key: string, Models: { Model }, Player: Player }

local entries: { [Player]: Entry } = {}
local folder: Folder
local meteorCache: { [number]: Model } = {}
local lastCache = 0

local function parse(value: any): { { Id: string, Shiny: boolean } }
	local list = {}
	if typeof(value) ~= "string" or value == "" then
		return list
	end
	for _, item in string.split(value, ",") do
		local id, shiny = string.match(item, "^([%w_]+):([01])$")
		if id and Critters.Exists(id) then
			table.insert(list, { Id = id, Shiny = shiny == "1" })
		end
	end
	return list
end

local function rebuild(player: Player)
	local value = player:GetAttribute("Critters")
	local key = if typeof(value) == "string" then value else ""
	local entry = entries[player]
	if entry and entry.Key == key then
		return
	end
	if entry then
		for _, model in entry.Models do
			model:Destroy()
		end
	end
	entry = { Key = key, Models = {}, Player = player }
	for _, item in parse(value) do
		local model = Models.BuildCritter(item.Id, { Shiny = item.Shiny, Scale = 1.1 })
		model.Parent = folder
		table.insert(entry.Models, model)
	end
	entries[player] = entry
end

local function watch(player: Player)
	rebuild(player)
	player:GetAttributeChangedSignal("Critters"):Connect(function()
		rebuild(player)
	end)
end

local function refreshMeteorCache()
	table.clear(meteorCache)
	local meteors = Workspace:FindFirstChild("Meteors")
	if not meteors then
		return
	end
	for _, child in meteors:GetChildren() do
		local id = child:GetAttribute("MeteorId")
		if child:IsA("Model") and typeof(id) == "number" then
			meteorCache[id] = child
		end
	end
end

function Followers.Init()
	folder = Instance.new("Folder")
	folder.Name = "LocalCritters"
	folder.Parent = Workspace

	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(player)
		local entry = entries[player]
		if entry then
			for _, model in entry.Models do
				model:Destroy()
			end
			entries[player] = nil
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		if t - lastCache > 0.5 then
			lastCache = t
			refreshMeteorCache()
		end
		local camera = Workspace.CurrentCamera
		local cameraPos = if camera then camera.CFrame.Position else Vector3.zero
		local alpha = 1 - math.exp(-dt * 7)
		for player, entry in entries do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and (root.Position - cameraPos).Magnitude < 220 then
				local targetId = player:GetAttribute("Target")
				local meteor = if typeof(targetId) == "number" then meteorCache[targetId] else nil
				local meteorPos = meteor and meteor:GetPivot().Position
				if meteorPos and (meteorPos - root.Position).Magnitude > 60 then
					meteorPos = nil
				end
				local count = #entry.Models
				for index, model in entry.Models do
					local primary = model.PrimaryPart
					if primary then
						local goal: CFrame
						if meteorPos and meteor then
							local radius = (meteor:GetAttribute("Radius") :: number?) or 4
							local angle = (index / math.max(count, 1)) * math.pi * 2 + t * 0.8
							local pos = meteorPos + Vector3.new(math.cos(angle) * (radius + 2.5), math.abs(math.sin(t * 9 + index)) * 1.6, math.sin(angle) * (radius + 2.5))
							goal = CFrame.lookAt(pos, Vector3.new(meteorPos.X, pos.Y, meteorPos.Z))
						else
							local spread = (index - (count + 1) / 2) * 3
							local offset = root.CFrame * CFrame.new(spread, -2.6 + math.sin(t * 3 + index) * 0.35 + 0.8, 4 + math.abs(spread) * 0.3)
							goal = CFrame.new(offset.Position) * root.CFrame.Rotation
						end
						primary.CFrame = primary.CFrame:Lerp(goal, alpha)
					end
				end
			end
		end
	end)
end

return Followers
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[-- HUD: Stardust, daño por golpe, zona actual, menú, radar de meteoritos,
-- cuenta atrás del cometa, eventos, boosts y pistas para jugadores nuevos.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Config = require(Shared:WaitForChild("Config"))
local Zones = require(Shared:WaitForChild("Zones"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Critters = require(Shared:WaitForChild("Critters"))
local Economy = require(Shared:WaitForChild("Economy"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local State = require(Modules.State)

local Windows = require(script.Parent.Windows)

local HUD = {}

local player = Players.LocalPlayer

local stardustLabel: TextLabel
local damageLabel: TextLabel
local zoneLabel: TextLabel
local infoLabels: { TextLabel } = {}
local radarRows: { { Frame: Frame, Arrow: TextLabel, Text: TextLabel } } = {}
local hintPanel: Frame
local hintLabel: TextLabel
local badges: { [string]: Frame } = {}
local displayed = 0

local MENU = {
	{ Name = "Shop", Icon = "⛏️", Label = "Shop", Color = UI.Colors.Green },
	{ Name = "Critters", Icon = "🐾", Label = "Critters", Color = UI.Colors.Orange },
	{ Name = "Zones", Icon = "🗺️", Label = "Zones", Color = UI.Colors.Blue },
	{ Name = "Quests", Icon = "📜", Label = "Quests", Color = UI.Colors.Yellow },
	{ Name = "Rebirth", Icon = "🌟", Label = "Supernova", Color = UI.Colors.Pink },
	{ Name = "Index", Icon = "📖", Label = "Index", Color = UI.Colors.Purple },
	{ Name = "Store", Icon = "💎", Label = "Store", Color = Color3.fromRGB(255, 80, 150) },
	{ Name = "Gifts", Icon = "🎁", Label = "Gifts", Color = Color3.fromRGB(255, 120, 60) },
	{ Name = "Daily", Icon = "📅", Label = "Daily", Color = UI.Colors.Cyan },
	{ Name = "Codes", Icon = "🎟️", Label = "Codes", Color = Color3.fromRGB(120, 130, 255) },
}

function HUD.SetBadge(name: string, text: string?)
	local badge = badges[name]
	if not badge then
		return
	end
	badge.Visible = text ~= nil
	local count = badge:FindFirstChild("Count")
	if count and count:IsA("TextLabel") and text then
		count.Text = text
	end
end

local function buildTop(root: Frame)
	local panel = UI.Panel({
		Name = "StardustPanel",
		Color = UI.Colors.PanelDark,
		Size = UDim2.fromOffset(340, 96),
		Position = UDim2.new(0.5, 0, 0, 10),
		AnchorPoint = Vector2.new(0.5, 0),
		CornerRadius = 18,
		BackgroundTransparency = 0.15,
		Parent = root,
	})
	stardustLabel = UI.Text({ Name = "Stardust", Text = "⭐ 0", Size = UDim2.new(1, -20, 0, 48), Position = UDim2.new(0.5, 0, 0, 6), AnchorPoint = Vector2.new(0.5, 0), TextColor3 = Color3.fromRGB(255, 225, 100), StrokeThickness = 3, Parent = panel })
	damageLabel = UI.Text({ Name = "Damage", Text = "⚔️ 1 / hit", Size = UDim2.new(0.48, 0, 0, 26), Position = UDim2.new(0.02, 0, 0, 60), TextColor3 = Color3.fromRGB(255, 160, 140), Parent = panel })
	zoneLabel = UI.Text({ Name = "Zone", Text = "", Size = UDim2.new(0.48, 0, 0, 26), Position = UDim2.new(0.5, 0, 0, 60), TextColor3 = Color3.fromRGB(170, 230, 255), Parent = panel })

	local info = UI.New("Frame", { Name = "Info", BackgroundTransparency = 1, Size = UDim2.fromOffset(520, 120), Position = UDim2.new(0.5, 0, 0, 112), AnchorPoint = Vector2.new(0.5, 0), Parent = root })
	UI.List(Enum.FillDirection.Vertical, 2).Parent = info
	for i = 1, 5 do
		infoLabels[i] = UI.Text({ Name = "Line" .. i, Text = "", Size = UDim2.new(1, 0, 0, 22), LayoutOrder = i, Visible = false, Parent = info })
	end
end

local function buildMenu(root: Frame)
	local menu = UI.New("Frame", { Name = "Menu", BackgroundTransparency = 1, Size = UDim2.fromOffset(184, 470), Position = UDim2.new(0, 14, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = root })
	local grid = UI.Grid(UDim2.fromOffset(84, 84), 10)
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Left
	grid.Parent = menu
	for order, def in MENU do
		local button = UI.Button({
			Name = def.Name,
			Text = "",
			Color = def.Color,
			Size = UDim2.fromOffset(84, 84),
			LayoutOrder = order,
			OnClick = function()
				Windows.Toggle(def.Name)
			end,
			Parent = menu,
		})
		UI.Text({ Name = "Icon", Text = def.Icon, Size = UDim2.new(1, 0, 0.55, 0), Position = UDim2.fromScale(0, 0.06), StrokeThickness = 0, Parent = button })
		UI.Text({ Name = "Caption", Text = def.Label, Size = UDim2.new(1, -6, 0.28, 0), Position = UDim2.new(0, 3, 0.66, 0), Parent = button })
		local badge = UI.Panel({ Name = "Badge", Color = UI.Colors.Red, Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, 6, 0, -6), AnchorPoint = Vector2.new(1, 0), CornerRadius = 14, Visible = false, ZIndex = 3, Parent = button })
		UI.Text({ Name = "Count", Text = "!", Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 4, Parent = badge })
		badges[def.Name] = badge
	end
end

local function buildRadar(root: Frame)
	local panel = UI.Panel({ Name = "Radar", Color = UI.Colors.PanelDark, Size = UDim2.fromOffset(230, 168), Position = UDim2.new(1, -14, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 0.2, Parent = root })
	UI.Text({ Name = "Title", Text = "📡 METEOR RADAR", Size = UDim2.new(1, -16, 0, 26), Position = UDim2.new(0.5, 0, 0, 6), AnchorPoint = Vector2.new(0.5, 0), TextColor3 = UI.Colors.Cyan, Parent = panel })
	for i = 1, 4 do
		local row = UI.New("Frame", { Name = "Row" .. i, BackgroundTransparency = 1, Size = UDim2.new(1, -16, 0, 30), Position = UDim2.new(0, 8, 0, 34 + (i - 1) * 32), Parent = panel })
		local arrow = UI.Text({ Name = "Arrow", Text = "➤", Size = UDim2.fromOffset(28, 28), Position = UDim2.new(0, 0, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = row })
		local text = UI.Text({ Name = "Text", Text = "", Size = UDim2.new(1, -36, 0.85, 0), Position = UDim2.new(0, 34, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		radarRows[i] = { Frame = row, Arrow = arrow, Text = text }
	end
end

local function buildHint(root: Frame)
	hintPanel = UI.Panel({ Name = "Hint", Color = UI.Colors.PanelDark, Size = UDim2.fromOffset(640, 54), Position = UDim2.new(0.5, 0, 1, -36), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 0.1, Visible = false, Parent = root })
	hintLabel = UI.Text({ Text = "", Size = UDim2.new(1, -24, 0.7, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), TextColor3 = UI.Colors.Yellow, Parent = hintPanel })
end

-- ---------------------------------------------------------------------
-- Actualizaciones
-- ---------------------------------------------------------------------
local function updateRadar()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = Workspace.CurrentCamera
	local folder = Workspace:FindFirstChild("Meteors")
	local zone = player:GetAttribute("Zone") or 1
	local list = {}
	if root and root:IsA("BasePart") and camera and folder then
		for _, child in folder:GetChildren() do
			local isMeteor = child:IsA("Model") and child:GetAttribute("MeteorId") ~= nil
			local isMarker = child:IsA("BasePart") and child:GetAttribute("ImpactAt") ~= nil
			if isMeteor or isMarker then
				local position = if child:IsA("Model") then child:GetPivot().Position else (child :: BasePart).Position
				local comet = child:GetAttribute("Comet") == true
				local childZone = if child:IsA("Model") then child:GetAttribute("Zone") else nil
				if comet or childZone == nil or childZone == zone or (math.abs(position.X - root.Position.X) < 120) then
					local rarity = child:GetAttribute("Rarity") or "Common"
					table.insert(list, {
						Position = position,
						Rarity = rarity,
						Order = if comet then 99 else Rarities.Order(rarity),
						Distance = (position - root.Position).Magnitude,
						Incoming = isMarker,
						Comet = comet,
					})
				end
			end
		end
	end
	table.sort(list, function(a, b)
		if a.Order ~= b.Order then
			return a.Order > b.Order
		end
		return a.Distance < b.Distance
	end)
	for i, row in radarRows do
		local entry = list[i]
		row.Frame.Visible = entry ~= nil
		if entry and camera and root then
			local look = camera.CFrame.LookVector
			local toTarget = entry.Position - (root :: BasePart).Position
			local angle = math.atan2(toTarget.X, toTarget.Z) - math.atan2(look.X, look.Z)
			row.Arrow.Rotation = -math.deg(angle) - 90
			local color = if entry.Comet then Color3.fromRGB(140, 230, 255) else Rarities.Get(entry.Rarity).Color
			row.Arrow.TextColor3 = color
			row.Text.TextColor3 = color
			row.Text.Text = ("%s%s  %dm"):format(if entry.Incoming then "⚠️ " else "", if entry.Comet then "COMET" else string.upper(entry.Rarity), math.floor(entry.Distance))
		end
	end
end

local function updateHint(data: { [string]: any })
	local stats = data.Stats or {}
	local stardust = State.Stardust()
	local text: string? = nil
	if (data.Rebirths or 0) == 0 then
		if (stats.Meteors or 0) == 0 then
			text = "☄️ Run to a meteor and CLICK to mine it! (follow the radar ➤)"
		elseif data.Pickaxe == "Rusty" and stardust >= 60 then
			text = "⛏️ Buy a better pickaxe in the Shop!"
		elseif (stats.Hatched or 0) == 0 and stardust >= Critters.Eggs[1].Cost then
			text = "🥚 Hatch an egg at the egg stand — critters mine WITH you!"
		elseif (data.Zone or 1) == 1 and stardust >= Zones.Get(2).Cost then
			text = "🏜️ You can unlock the Dune Desert! Go to the gate."
		end
	end
	hintPanel.Visible = text ~= nil
	if text then
		hintLabel.Text = text
	end
end

local function updateInfo(now: number)
	local lines = {}
	local cometAt = Workspace:GetAttribute("CometAt") or 0
	if Workspace:GetAttribute("CometActive") == true then
		table.insert(lines, { "☄️ GIANT COMET AT THE PLAZA! GO GO GO!", Color3.fromRGB(140, 230, 255) })
	elseif cometAt > now then
		table.insert(lines, { "☄️ Giant Comet in " .. Format.Clock(cometAt - now), Color3.fromRGB(170, 220, 255) })
	end
	local luckEnds = Workspace:GetAttribute("ServerLuckEndsAt") or 0
	if luckEnds > now then
		table.insert(lines, { ("🍀 SERVER LUCK x%d  •  %s"):format(Config.ServerLuck.Multiplier, Format.Clock(luckEnds - now)), Color3.fromRGB(110, 255, 140) })
	end
	local adminEnds = Workspace:GetAttribute("AdminLuckEndsAt") or 0
	if adminEnds > now then
		table.insert(lines, { ("👑 ADMIN LUCK x%s  •  %s"):format(tostring(Workspace:GetAttribute("AdminLuck") or 1), Format.Clock(adminEnds - now)), Color3.fromRGB(255, 130, 230) })
	end
	local eventTitle = Workspace:GetAttribute("EventTitle")
	local eventEnds = Workspace:GetAttribute("EventEndsAt") or 0
	if typeof(eventTitle) == "string" and eventEnds > now then
		table.insert(lines, { ("%s  •  %s"):format(eventTitle, Format.Clock(eventEnds - now)), Color3.fromRGB(255, 220, 100) })
	end
	local boostStardust = player:GetAttribute("BoostStardust") or 0
	if boostStardust > 0 then
		table.insert(lines, { "⏫ 2x Stardust " .. Format.Clock(boostStardust), Color3.fromRGB(120, 230, 255) })
	end
	local boostDamage = player:GetAttribute("BoostDamage") or 0
	if boostDamage > 0 then
		table.insert(lines, { "⚔️ 2x Damage " .. Format.Clock(boostDamage), Color3.fromRGB(255, 150, 130) })
	end
	for i, label in infoLabels do
		local line = lines[i]
		label.Visible = line ~= nil
		if line then
			label.Text = line[1]
			label.TextColor3 = line[2]
		end
	end
end

local function updateBadges(data: { [string]: any }, now: number)
	local ready = 0
	local elapsed = now - (data.SessionStart or now)
	for index, gift in Config.PlaytimeGifts do
		if not (data.GiftsClaimed and data.GiftsClaimed[tostring(index)]) and elapsed >= gift.Minutes * 60 then
			ready += 1
		end
	end
	HUD.SetBadge("Gifts", if ready > 0 then tostring(ready) else nil)
	HUD.SetBadge("Daily", if data.DailyAvailable then "!" else nil)
	local questsReady = 0
	if data.Quests and data.Quests.List then
		for _, quest in data.Quests.List do
			if quest.Progress >= quest.Target and not quest.Claimed then
				questsReady += 1
			end
		end
	end
	HUD.SetBadge("Quests", if questsReady > 0 then tostring(questsReady) else nil)
	local stardust = State.Stardust()
	HUD.SetBadge("Rebirth", if stardust >= (data.RebirthCost or math.huge) then "!" else nil)
	local nextZone = Zones.List[(data.Zone or 1) + 1]
	HUD.SetBadge("Zones", if nextZone and stardust >= nextZone.Cost then "!" else nil)
	local _ = Economy
end

function HUD.Init()
	local _, root = UI.Screen("MeteorRushHUD", 5)
	buildTop(root)
	buildMenu(root)
	buildRadar(root)
	buildHint(root)

	displayed = State.Stardust()
	RunService.RenderStepped:Connect(function(dt)
		local target = State.Stardust()
		if math.abs(target - displayed) < 1 then
			displayed = target
		else
			displayed += (target - displayed) * math.clamp(dt * 10, 0, 1)
		end
		stardustLabel.Text = "⭐ " .. Format.Abbreviate(displayed)
	end)

	local function refreshStatic()
		local hit = player:GetAttribute("HitDamage")
		damageLabel.Text = "⚔️ " .. Format.Abbreviate(if typeof(hit) == "number" then hit else 1) .. " / hit"
		local zone = Zones.Get(player:GetAttribute("Zone") or 1)
		zoneLabel.Text = zone.Icon .. " " .. zone.Name
		zoneLabel.TextColor3 = zone.AccentColor
	end
	player:GetAttributeChangedSignal("HitDamage"):Connect(refreshStatic)
	player:GetAttributeChangedSignal("Zone"):Connect(refreshStatic)
	refreshStatic()

	task.spawn(function()
		while true do
			local now = Workspace:GetServerTimeNow()
			local ok, err = pcall(function()
				updateInfo(now)
				updateRadar()
				if State.Data then
					updateHint(State.Data)
					updateBadges(State.Data, now)
				end
			end)
			if not ok then
				warn("[HUD] " .. tostring(err))
			end
			task.wait(0.2)
		end
	end)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Hatch</string>
              <string name="Source"><![CDATA[-- Animación de eclosión: el huevo tiembla, destello y aparece la criatura.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Models = require(Shared:WaitForChild("Models"))
local Critters = require(Shared:WaitForChild("Critters"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Format = require(Shared:WaitForChild("Format"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local Sound = require(Modules.Sound)

local Hatch = {}

local overlay: Frame
local queue: { { Egg: number, Results: { any } } } = {}
local playing = false
local skip = false

local function frameModel(viewport: ViewportFrame, model: Model, height: number)
	local camera = viewport.CurrentCamera
	if camera then
		local distance = height * 2.4 + 2
		camera.CFrame = CFrame.lookAt(Vector3.new(height * 0.35, height * 0.75, -distance), Vector3.new(0, height * 0.5, 0))
	end
	model.Parent = viewport
end

local function showOne(egg: number, results: { any })
	overlay.Visible = true
	skip = false
	for _, child in overlay:GetChildren() do
		if child:IsA("Frame") and child.Name == "Cell" then
			child:Destroy()
		end
	end
	local count = #results
	local cells = {}
	for index, result in results do
		local cell = UI.New("Frame", {
			Name = "Cell",
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(240, 330),
			Position = UDim2.new(0.5, (index - (count + 1) / 2) * 260, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Parent = overlay,
		})
		local viewport = UI.New("ViewportFrame", {
			Name = "Viewport",
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(240, 240),
			Ambient = Color3.fromRGB(200, 200, 200),
			LightColor = Color3.fromRGB(255, 255, 255),
			LightDirection = Vector3.new(-1, -1, 1),
			Parent = cell,
		})
		local camera = Instance.new("Camera")
		camera.FieldOfView = 40
		camera.Parent = viewport
		viewport.CurrentCamera = camera
		local eggModel = Models.BuildEgg(egg, 1)
		frameModel(viewport, eggModel, 3)
		local nameLabel = UI.Text({ Name = "Name", Text = "", Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 0, 240), StrokeThickness = 3, Parent = cell })
		local infoLabel = UI.Text({ Name = "Info", Text = "", Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 0, 276), Parent = cell })
		table.insert(cells, { Viewport = viewport, Egg = eggModel, Name = nameLabel, Info = infoLabel, Result = result })
	end

	-- Temblor del huevo
	local started = os.clock()
	while os.clock() - started < 1.3 and not skip do
		local t = os.clock() - started
		for _, cell in cells do
			local amplitude = math.rad(6 + t * 18)
			cell.Egg:PivotTo(CFrame.Angles(0, 0, math.sin(t * 28) * amplitude))
		end
		RunService.RenderStepped:Wait()
	end

	-- Revelación
	Sound.Play("Hatch", 0.7)
	local bestOrder = 0
	for _, cell in cells do
		cell.Egg:Destroy()
		local result = cell.Result
		local def = Critters.Get(result.Id)
		if def then
			local critter = Models.BuildCritter(def.Id, { Shiny = result.Shiny, NoEffects = true })
			frameModel(cell.Viewport, critter, (critter:GetAttribute("Height") :: number?) or 2)
			local rarity = Rarities.Get(def.Rarity)
			bestOrder = math.max(bestOrder, rarity.Order)
			cell.Name.Text = (if result.Shiny then "✨ " else "") .. def.Name
			cell.Name.TextColor3 = rarity.Color
			if result.Deleted then
				cell.Info.Text = "🗑️ auto-deleted"
				cell.Info.TextColor3 = Color3.fromRGB(200, 200, 210)
			else
				cell.Info.Text = ("%s  •  +%s dmg"):format(def.Rarity, Format.Percent(Critters.GetPower(def.Id, result.Shiny)))
				cell.Info.TextColor3 = rarity.Color
			end
			local scale = UI.New("UIScale", { Scale = 0.4, Parent = cell.Viewport })
			UI.Tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end
	local flash = UI.New("Frame", { BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = if bestOrder >= 5 then 0.1 else 0.5, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = overlay })
	UI.Tween(flash, 0.5, { BackgroundTransparency = 1 })
	local waited = 0
	while waited < 2.4 and not skip do
		waited += RunService.RenderStepped:Wait()
	end
	flash:Destroy()
	overlay.Visible = false
end

function Hatch.Play(egg: number, results: { any })
	table.insert(queue, { Egg = egg, Results = results })
	if playing then
		return
	end
	playing = true
	task.spawn(function()
		while #queue > 0 do
			local item = table.remove(queue, 1)
			local ok, err = pcall(showOne, item.Egg, item.Results)
			if not ok then
				warn("[Hatch] " .. tostring(err))
				overlay.Visible = false
			end
		end
		playing = false
	end)
end

function Hatch.Init()
	local _, root = UI.Screen("MeteorRushHatch", 20)
	overlay = UI.New("TextButton", {
		Name = "Overlay",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(10, 10, 25),
		BackgroundTransparency = 0.35,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = root,
	})
	;(overlay :: any).Activated:Connect(function()
		skip = true
	end)
end

return Hatch
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[-- Notificaciones (toasts abajo) y anuncios grandes (arriba, para rarezas/eventos).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local Sound = require(Modules.Sound)

local Notifications = {}

local KIND_COLORS = {
	Info = UI.Colors.Blue,
	Success = UI.Colors.Green,
	Error = UI.Colors.Red,
	Warning = UI.Colors.Orange,
	Cash = Color3.fromRGB(70, 200, 110),
}

local toastContainer: Frame
local announceContainer: Frame
local MAX_TOASTS = 5
local toastOrder = 0

function Notifications.Show(text: string, kind: string?)
	local color = KIND_COLORS[kind or "Info"] or UI.Colors.Blue
	toastOrder += 1
	local toast = UI.Panel({
		Name = "Toast",
		Color = UI.Darken(color, 0.15),
		Size = UDim2.new(1, 0, 0, 44),
		LayoutOrder = toastOrder,
		BackgroundTransparency = 0.05,
		CornerRadius = 12,
		Parent = toastContainer,
	})
	UI.Gradient(Color3.fromRGB(255, 255, 255), Color3.fromRGB(205, 205, 205)).Parent = toast
	local label = UI.Text({
		Text = text,
		Size = UDim2.new(1, -20, 0.72, 0),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = toast,
	})
	local scale = UI.New("UIScale", { Scale = 0.6, Parent = toast })
	UI.Tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)

	if kind == "Error" then
		Sound.Play("Error", 0.4)
	end

	local toasts = {}
	for _, child in toastContainer:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > MAX_TOASTS then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for i = 1, #toasts - MAX_TOASTS do
			toasts[i]:Destroy()
		end
	end

	task.delay(3.6, function()
		if toast.Parent then
			UI.Tween(toast, 0.35, { BackgroundTransparency = 1 })
			UI.Tween(label, 0.35, { TextTransparency = 1 })
			local stroke = label:FindFirstChildOfClass("UIStroke")
			if stroke then
				UI.Tween(stroke, 0.35, { Transparency = 1 })
			end
			local border = toast:FindFirstChildOfClass("UIStroke")
			if border then
				UI.Tween(border, 0.35, { Transparency = 1 })
			end
			task.wait(0.4)
			toast:Destroy()
		end
	end)
end

function Notifications.Announce(text: string, color: Color3?, duration: number?)
	announceContainer:ClearAllChildren()
	local label = UI.Text({
		Name = "Announcement",
		Text = text,
		TextColor3 = color or UI.Colors.Text,
		Size = UDim2.fromScale(1, 1),
		StrokeThickness = 3,
		Parent = announceContainer,
	})
	local scale = UI.New("UIScale", { Scale = 0.3, Parent = label })
	UI.Tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(duration or 4, function()
		if label.Parent then
			UI.Tween(label, 0.4, { TextTransparency = 1 })
			local stroke = label:FindFirstChildOfClass("UIStroke")
			if stroke then
				UI.Tween(stroke, 0.4, { Transparency = 1 })
			end
			task.wait(0.45)
			label:Destroy()
		end
	end)
end

function Notifications.Init()
	local _, root = UI.Screen("MeteorRushNotifications", 30)

	toastContainer = UI.New("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -100),
		Size = UDim2.fromOffset(560, 260),
		Parent = root,
	})
	UI.List(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom).Parent = toastContainer

	announceContainer = UI.New("Frame", {
		Name = "Announcements",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 175),
		Size = UDim2.new(0.8, 0, 0, 48),
		Parent = root,
	})

	Remotes.Event("Notify").OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" and typeof(payload.Text) == "string" then
			Notifications.Show(payload.Text, payload.Kind)
		end
	end)
	Remotes.Event("Announce").OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" and typeof(payload.Text) == "string" then
			Notifications.Announce(payload.Text, payload.Color, payload.Duration)
		end
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Windows</string>
              <string name="Source"><![CDATA[-- Gestor de ventanas (una abierta a la vez) con el marco común: cabecera, título y botón de cerrar.

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local State = require(Modules.State)

local Windows = {}

export type Window = {
	Name: string,
	Frame: Frame,
	Content: Frame,
	Header: Frame,
	Title: TextLabel,
	Scale: UIScale,
}

export type WindowModule = {
	Title: string,
	Color: Color3,
	Size: UDim2?,
	Build: (window: Window) -> (),
	Refresh: ((data: { [string]: any }) -> ())?,
	Tick: (() -> ())?,
	OnOpen: (() -> ())?,
}

type Entry = { Module: WindowModule, Window: Window? }

local entries: { [string]: Entry } = {}
local current: string? = nil
local root: Frame
local dim: TextButton

Windows.Opened = nil :: ((name: string?) -> ())?

local function createWindow(name: string, module: WindowModule): Window
	local frame = UI.Panel({
		Name = name,
		Size = module.Size or UDim2.fromOffset(660, 450),
		Position = UDim2.fromScale(0.5, 0.52),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = UI.Colors.Panel,
		CornerRadius = 20,
		Visible = false,
		ZIndex = 2,
		Parent = root,
	})
	UI.Gradient(Color3.fromRGB(255, 255, 255), Color3.fromRGB(215, 215, 228)).Parent = frame

	local header = UI.New("Frame", {
		Name = "Header",
		BackgroundColor3 = module.Color,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 60),
		ZIndex = 2,
		Parent = frame,
	})
	UI.Corner(20).Parent = header
	UI.Gradient(Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 190, 190)).Parent = header
	-- Relleno para que las esquinas de abajo de la cabecera queden rectas
	UI.New("Frame", {
		Name = "Filler",
		BackgroundColor3 = module.Color,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 1, -20),
		ZIndex = 2,
		Parent = header,
	}, { UI.Gradient(Color3.fromRGB(205, 205, 205), Color3.fromRGB(190, 190, 190)) })

	local title = UI.Text({
		Name = "Title",
		Text = module.Title,
		Size = UDim2.new(1, -90, 0, 40),
		Position = UDim2.new(0, 20, 0, 10),
		TextXAlignment = Enum.TextXAlignment.Left,
		StrokeThickness = 3,
		ZIndex = 3,
		Parent = header,
	})

	local close = UI.Button({
		Name = "Close",
		Text = "X",
		Color = UI.Colors.Red,
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.new(1, -10, 0, 7),
		AnchorPoint = Vector2.new(1, 0),
		OnClick = function()
			Windows.Close()
		end,
		Parent = header,
	})
	close.ZIndex = 3

	local content = UI.New("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 72),
		Size = UDim2.new(1, -32, 1, -86),
		ZIndex = 2,
		Parent = frame,
	})

	local scale = UI.New("UIScale", { Scale = 1, Parent = frame })
	return { Name = name, Frame = frame, Content = content, Header = header, Title = title, Scale = scale }
end

function Windows.Register(name: string, module: WindowModule)
	entries[name] = { Module = module, Window = nil }
end

function Windows.GetWindow(name: string): Window?
	local entry = entries[name]
	return entry and entry.Window
end

function Windows.IsOpen(name: string): boolean
	return current == name
end

function Windows.Open(name: string)
	local entry = entries[name]
	if not entry or current == name then
		return
	end
	if current then
		Windows.Close(true)
	end
	if not entry.Window then
		entry.Window = createWindow(name, entry.Module)
		entry.Module.Build(entry.Window :: Window)
	end
	local window = entry.Window :: Window
	current = name
	dim.Visible = true
	UI.Tween(dim, 0.2, { BackgroundTransparency = 0.55 })
	window.Frame.Visible = true
	window.Scale.Scale = 0.6
	UI.Tween(window.Scale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
	if entry.Module.OnOpen then
		entry.Module.OnOpen()
	end
	if entry.Module.Refresh and State.Data then
		entry.Module.Refresh(State.Data)
	end
	if Windows.Opened then
		Windows.Opened(name)
	end
end

function Windows.Close(instant: boolean?)
	if not current then
		return
	end
	local entry = entries[current]
	current = nil
	local window = entry and entry.Window
	if window then
		if instant then
			window.Frame.Visible = false
		else
			local tween = UI.Tween(window.Scale, 0.15, { Scale = 0.7 })
			tween.Completed:Once(function()
				if current ~= window.Name then
					window.Frame.Visible = false
				end
			end)
		end
	end
	if not instant then
		UI.Tween(dim, 0.15, { BackgroundTransparency = 1 })
		task.delay(0.16, function()
			if not current then
				dim.Visible = false
			end
		end)
	end
	if Windows.Opened then
		Windows.Opened(nil)
	end
end

function Windows.Toggle(name: string)
	if current == name then
		Windows.Close()
	else
		Windows.Open(name)
	end
end

-- Ventana de mensaje genérica (ganancias offline, avisos...)
local messageModule: WindowModule
local messageBody: TextLabel
local messageButton: TextButton
local messageButtonLabel: TextLabel
local messageCallback: (() -> ())? = nil

messageModule = {
	Title = "MESSAGE",
	Color = UI.Colors.Blue,
	Size = UDim2.fromOffset(500, 300),
	Build = function(window)
		messageBody = UI.Text({
			Name = "Body",
			Text = "",
			Size = UDim2.new(1, -20, 0, 120),
			Position = UDim2.new(0.5, 0, 0, 10),
			AnchorPoint = Vector2.new(0.5, 0),
			TextWrapped = true,
			Parent = window.Content,
		})
		messageButton, messageButtonLabel = UI.Button({
			Text = "OK",
			Color = UI.Colors.Green,
			Size = UDim2.fromOffset(200, 56),
			Position = UDim2.new(0.5, 0, 1, -8),
			AnchorPoint = Vector2.new(0.5, 1),
			OnClick = function()
				Windows.Close()
				if messageCallback then
					messageCallback()
				end
			end,
			Parent = window.Content,
		})
	end,
}

function Windows.ShowMessage(title: string, body: string, buttonText: string?, color: Color3?, callback: (() -> ())?)
	if current == "Message" then
		Windows.Close(true)
	end
	Windows.Open("Message")
	local window = Windows.GetWindow("Message")
	if not window then
		return
	end
	window.Title.Text = title
	window.Header.BackgroundColor3 = color or UI.Colors.Blue
	local filler = window.Header:FindFirstChild("Filler")
	if filler and filler:IsA("Frame") then
		filler.BackgroundColor3 = color or UI.Colors.Blue
	end
	messageBody.Text = body
	messageButtonLabel.Text = buttonText or "OK"
	messageCallback = callback
	local _ = messageButton
end

function Windows.Init()
	local _, screenRoot = UI.Screen("MeteorRushWindows", 10)
	root = screenRoot
	dim = UI.New("TextButton", {
		Name = "Dim",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Visible = false,
		ZIndex = 1,
		Parent = root,
	})
	dim.Activated:Connect(function()
		Windows.Close()
	end)

	Windows.Register("Message", messageModule)

	State.Changed:Connect(function(data)
		if current then
			local entry = entries[current]
			if entry and entry.Window and entry.Module.Refresh then
				entry.Module.Refresh(data)
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			if current then
				local entry = entries[current]
				if entry and entry.Window and entry.Module.Tick then
					local ok, err = pcall(entry.Module.Tick)
					if not ok then
						warn("[Windows] Tick error: " .. tostring(err))
					end
				end
			end
		end
	end)
end

return Windows
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">World</string>
              <string name="Source"><![CDATA[-- Mundo local: bolas de fuego que caen, cuenta atrás de impacto, puertas abiertas
-- para tus zonas, ambiente por zona, gravedad lunar y animaciones de etiquetas.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Models = require(Shared:WaitForChild("Models"))
local Zones = require(Shared:WaitForChild("Zones"))
local Config = require(Shared:WaitForChild("Config"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local State = require(Modules.State)

local World = {}

local player = Players.LocalPlayer

type Fall = { Marker: BasePart, Fireball: Model, Start: Vector3, Target: Vector3, StartTime: number, ImpactAt: number, Countdown: TextLabel? }

local falls: { [BasePart]: Fall } = {}
local rainbowParts: { [BasePart]: number } = {}
local gradients: { [UIGradient]: boolean } = {}
local spinners: { [BasePart]: CFrame } = {}
local fxFolder: Folder
local gravityForce: VectorForce? = nil

-- ---------------------------------------------------------------------
-- Meteoritos que caen
-- ---------------------------------------------------------------------
local function onMarker(instance: Instance)
	if not instance:IsA("BasePart") then
		return
	end
	local impactAt = instance:GetAttribute("ImpactAt")
	if typeof(impactAt) ~= "number" then
		return
	end
	local comet = instance:GetAttribute("Comet") == true
	local fireball = Models.BuildFireball((instance:GetAttribute("Rarity") :: string?) or "Common", comet)
	local target = instance.Position
	local start = target + Vector3.new(-90, 280, 70) * (if comet then 1.6 else 1)
	fireball:PivotTo(CFrame.new(start))
	fireball.Parent = fxFolder
	local gui = instance:FindFirstChild("Warning")
	local countdown = gui and gui:FindFirstChild("Countdown")
	falls[instance] = {
		Marker = instance,
		Fireball = fireball,
		Start = start,
		Target = target,
		StartTime = Workspace:GetServerTimeNow(),
		ImpactAt = impactAt,
		Countdown = if countdown and countdown:IsA("TextLabel") then countdown else nil,
	}
end

local function onMarkerRemoved(instance: Instance)
	local fall = falls[instance :: BasePart]
	if fall then
		fall.Fireball:Destroy()
		falls[instance :: BasePart] = nil
	end
end

-- ---------------------------------------------------------------------
-- Puertas
-- ---------------------------------------------------------------------
local function updateGates()
	local data = State.Data
	local unlocked = if data then data.Zone or 1 else 1
	local map = Workspace:FindFirstChild("Map")
	if not map then
		return
	end
	for _, zone in Zones.List do
		local folder = map:FindFirstChild(zone.Id)
		local gate = folder and folder:FindFirstChild("Gate" .. zone.Index)
		if gate and gate:IsA("BasePart") then
			local open = zone.Index <= unlocked
			if gate.CanCollide == open then
				gate.CanCollide = not open
			end
			gate.Transparency = if open then 0.85 else 0
			local prompt = gate:FindFirstChildOfClass("ProximityPrompt")
			if prompt then
				prompt.Enabled = not open and zone.Index == unlocked + 1
			end
			local sign = folder:FindFirstChild("GateSign")
			if sign then
				for _, gui in sign:GetChildren() do
					local price = gui:FindFirstChild("Price")
					if price and price:IsA("TextLabel") then
						price.Text = if open then "✅ UNLOCKED" else (if zone.Index == unlocked + 1 then "🔒 " else "🔒🔒 ") .. require(Shared:WaitForChild("Format")).Abbreviate(zone.Cost) .. " ⭐"
					end
				end
			end
		end
	end
end

-- ---------------------------------------------------------------------
-- Ambiente por zona + gravedad lunar
-- ---------------------------------------------------------------------
local function applyAmbience()
	local zone = Zones.Get(player:GetAttribute("Zone") or 1)
	local bloodMoon = Workspace:GetAttribute("EventName") == "BloodMoon"
	UI.Tween(Lighting, 1.5, {
		ClockTime = if bloodMoon then 0 else zone.Ambient.ClockTime,
		Brightness = zone.Ambient.Brightness,
		Ambient = if bloodMoon then Color3.fromRGB(150, 50, 50) else zone.Ambient.Ambient,
		OutdoorAmbient = if bloodMoon then Color3.fromRGB(160, 60, 60) else zone.Ambient.Ambient:Lerp(Color3.new(1, 1, 1), 0.2),
	})
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		UI.Tween(atmosphere, 1.5, { Color = if bloodMoon then Color3.fromRGB(200, 60, 60) else zone.Ambient.Fog })
	end
	local correction = Lighting:FindFirstChild("ZoneColor")
	if correction and correction:IsA("ColorCorrectionEffect") then
		UI.Tween(correction, 1.5, { TintColor = if bloodMoon then Color3.fromRGB(255, 170, 170) else Color3.fromRGB(255, 255, 255) })
	end
end

local function updateGravity()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local zone = Zones.Get(player:GetAttribute("Zone") or 1)
	if not root or not root:IsA("BasePart") then
		return
	end
	if zone.LowGravity then
		if not gravityForce or gravityForce.Parent ~= root then
			local attachment = root:FindFirstChild("GravityAttachment") or Instance.new("Attachment")
			attachment.Name = "GravityAttachment"
			attachment.Parent = root
			local force = Instance.new("VectorForce")
			force.Name = "MoonGravity"
			force.Attachment0 = attachment :: Attachment
			force.RelativeTo = Enum.ActuatorRelativeTo.World
			force.ApplyAtCenterOfMass = true
			force.Parent = root
			gravityForce = force
		end
		local mass = root.AssemblyMass
		;(gravityForce :: VectorForce).Force = Vector3.new(0, mass * Workspace.Gravity * (1 - Config.Player.MoonGravityFactor), 0)
	elseif gravityForce then
		gravityForce:Destroy()
		gravityForce = nil
	end
end

-- ---------------------------------------------------------------------
-- Init
-- ---------------------------------------------------------------------
local function track(tag: string, added: (Instance) -> (), removed: (Instance) -> ())
	CollectionService:GetInstanceAddedSignal(tag):Connect(added)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(removed)
	for _, instance in CollectionService:GetTagged(tag) do
		added(instance)
	end
end

function World.Init()
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "LocalFX"
	fxFolder.Parent = Workspace

	track("MeteorMarker", onMarker, onMarkerRemoved)
	track("RainbowPart", function(instance)
		if instance:IsA("BasePart") then
			rainbowParts[instance] = math.random()
		end
	end, function(instance)
		rainbowParts[instance :: BasePart] = nil
	end)
	track("RainbowGradient", function(instance)
		if instance:IsA("UIGradient") then
			gradients[instance] = true
		end
	end, function(instance)
		gradients[instance :: UIGradient] = nil
	end)
	track("Spin", function(instance)
		if instance:IsA("BasePart") then
			spinners[instance] = instance.CFrame
		end
	end, function(instance)
		spinners[instance :: BasePart] = nil
	end)

	RunService.RenderStepped:Connect(function()
		local now = Workspace:GetServerTimeNow()
		local t = os.clock()
		for marker, fall in falls do
			if marker.Parent == nil then
				onMarkerRemoved(marker)
			else
				local total = math.max(0.1, fall.ImpactAt - fall.StartTime)
				local progress = math.clamp(1 - (fall.ImpactAt - now) / total, 0, 1)
				local position = fall.Start:Lerp(fall.Target, progress ^ 1.7)
				fall.Fireball:PivotTo(CFrame.new(position))
				if fall.Countdown then
					fall.Countdown.Text = tostring(math.max(0, math.ceil(fall.ImpactAt - now)))
				end
				marker.Transparency = 0.25 + math.abs(math.sin(t * 6)) * 0.4
			end
		end
		for part, offset in rainbowParts do
			if part.Parent == nil then
				rainbowParts[part] = nil
			else
				part.Color = Color3.fromHSV((t * 0.3 + offset) % 1, 0.6, 1)
			end
		end
		for gradient in gradients do
			if gradient.Parent == nil then
				gradients[gradient] = nil
			else
				gradient.Offset = Vector2.new(((t * 0.6) % 2) - 1, 0)
			end
		end
		for part, base in spinners do
			if part.Parent == nil then
				spinners[part] = nil
			else
				part.CFrame = base * CFrame.new(0, math.sin(t * 2) * 0.4, 0) * CFrame.Angles(0, t * 0.8, 0)
			end
		end
	end)

	State.Changed:Connect(updateGates)
	player:GetAttributeChangedSignal("Zone"):Connect(function()
		applyAmbience()
		updateGravity()
	end)
	Workspace:GetAttributeChangedSignal("EventName"):Connect(applyAmbience)
	player.CharacterAdded:Connect(function()
		gravityForce = nil
		task.wait(1)
		updateGravity()
	end)
	task.spawn(function()
		while true do
			pcall(updateGates)
			pcall(updateGravity)
			task.wait(2)
		end
	end)
	applyAmbience()
end

return World
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="55">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Punto de entrada del cliente: estado, interfaz y controladores.

local Client = script.Parent
local Modules = Client:WaitForChild("Modules")
local Controllers = Client:WaitForChild("Controllers")
local WindowModules = Client:WaitForChild("Windows")

local State = require(Modules:WaitForChild("State"))
local Purchase = require(Modules:WaitForChild("Purchase"))

local Notifications = require(Controllers:WaitForChild("Notifications"))
local Windows = require(Controllers:WaitForChild("Windows"))
local Hatch = require(Controllers:WaitForChild("Hatch"))
local HUD = require(Controllers:WaitForChild("HUD"))
local Effects = require(Controllers:WaitForChild("Effects"))
local World = require(Controllers:WaitForChild("World"))
local Followers = require(Controllers:WaitForChild("Followers"))
local Combat = require(Controllers:WaitForChild("Combat"))

State.Init()
Notifications.Init()
Purchase.Notify = Notifications.Show

Windows.Init()
for _, name in { "Shop", "Critters", "Zones", "Quests", "Rebirth", "Index", "Store", "Gifts", "Daily", "Codes" } do
	Windows.Register(name, require(WindowModules:WaitForChild(name)))
end

Hatch.Init()
HUD.Init()
Effects.Init()
World.Init()
Followers.Init()
Combat.Init()
]]></string>
