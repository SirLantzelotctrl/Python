	local glass = ball(ctx, "Helmet", Vector3.one * math.max(ctx.W, ctx.H) * 1.25, CFrame.new(0, ctx.CY + ctx.H * 0.05, 0), Color3.fromRGB(180, 225, 255), Enum.Material.Glass)
	glass.Transparency = 0.7
end

Features.Crescent = function(ctx)
	local S = ctx.S
	for i = 0, 6 do
		local angle = math.rad(-60 + i * 20)
		local pos = Vector3.new(math.sin(angle) * S * 0.16, ctx.CY + ctx.H * 0.36 + math.cos(angle) * S * 0.16 - S * 0.1, 0)
		local p = surface(ctx, pos - Vector3.new(0, ctx.CY, 0) + Vector3.new(0, 0, -ctx.D), S * 0.01)
		ball(ctx, "Crescent", Vector3.one * S * (0.06 + math.sin(math.rad(i * 30)) * 0.03), CFrame.new(p), GOLD, Enum.Material.Neon)
	end
end

Models.Features = Features

-- ---------------------------------------------------------------------
-- Cara
-- ---------------------------------------------------------------------
local function face(ctx: Ctx)
	local S = ctx.S
	local e = S * 0.26
	ctx.EyeSize = e
	ctx.Eyes = {}
	for _, side in { -1, 1 } do
		local pos = surface(ctx, Vector3.new(side * 0.36, 0.12, -1), e * 0.3)
		table.insert(ctx.Eyes, pos)
		ball(ctx, "Eye", Vector3.new(e, e * 1.15, e * 0.6), CFrame.new(pos), BLACK)
		ball(ctx, "EyeShine", Vector3.new(e * 0.38, e * 0.38, e * 0.15), CFrame.new(pos + Vector3.new(e * 0.14, e * 0.2, -e * 0.3)), WHITE)
		ball(ctx, "EyeShine2", Vector3.new(e * 0.16, e * 0.16, e * 0.1), CFrame.new(pos + Vector3.new(-e * 0.15, -e * 0.18, -e * 0.3)), WHITE)
	end
	ball(ctx, "Mouth", Vector3.new(S * 0.12, S * 0.06, S * 0.05), CFrame.new(surface(ctx, Vector3.new(0, -0.12, -1), -S * 0.01)), Color3.fromRGB(80, 30, 40))
	if not ctx.Silhouette then
		for _, side in { -1, 1 } do
			local cheek = ball(ctx, "Cheek", Vector3.new(S * 0.14, S * 0.08, S * 0.03), CFrame.new(surface(ctx, Vector3.new(side * 0.6, -0.05, -0.8), S * 0.005)) * CFrame.Angles(0, -side * math.rad(35), 0), PINK)
			cheek.Transparency = 0.3
		end
	end
end

-- ---------------------------------------------------------------------
-- API: criaturas
-- ---------------------------------------------------------------------
local RARITY_SCALE = { Common = 1, Uncommon = 1.06, Rare = 1.12, Epic = 1.2, Legendary = 1.3, Mythic = 1.45, Cosmic = 1.6 }

export type CritterOptions = { Shiny: boolean?, NoEffects: boolean?, Silhouette: boolean?, Scale: number? }

function Models.CritterSize(critterId: string, scale: number?): number
	local def = Critters.Get(critterId) or Critters.List[1]
	return 1.8 * (RARITY_SCALE[def.Rarity] or 1) * (scale or 1)
end

function Models.BuildCritter(critterId: string, options: CritterOptions?): Model
	local opts = options or {}
	local def = Critters.Get(critterId) or Critters.List[1]
	local S = Models.CritterSize(def.Id, opts.Scale)
	local W, H, D = S, S * 0.92, S
	if def.Body == "Bean" then
		W, H, D = S * 0.85, S * 1.15, S * 0.85
	elseif def.Body == "Wide" then
		W, H, D = S * 1.25, S * 0.8, S * 1.05
	end
	local model, root = newModel(def.Name, Vector3.new(S * 0.5, 0.2, S * 0.5))
	model:SetAttribute("CritterId", def.Id)
	model:SetAttribute("Rarity", def.Rarity)
	model:SetAttribute("Shiny", opts.Shiny == true)

	local silhouette = opts.Silhouette == true
	local color = def.Color
	if opts.Shiny then
		local h, s, v = color:ToHSV()
		color = Color3.fromHSV((h + 0.13) % 1, math.min(1, s * 0.85 + 0.15), math.min(1, v * 1.1 + 0.05))
	end
	local ctx: Ctx = {
		Model = model,
		Root = root,
		S = S,
		W = W,
		H = H,
		D = D,
		CY = H / 2 + S * 0.08,
		Color = color,
		Accent = lighter(color, 0.35),
		Silhouette = silhouette,
		Effects = not silhouette and not opts.NoEffects,
		Body = nil,
		Eyes = {},
		EyeSize = 0,
	}

	local body = ball(ctx, "Body", Vector3.new(W, H, D), CFrame.new(0, ctx.CY, 0), color, def.Material)
	if def.Material == Enum.Material.Glass and not silhouette then
		body.Transparency = 0.2
	end
	ctx.Body = body
	if def.Body == "Drop" then
		for i = 1, 3 do
			ball(ctx, "Drop", Vector3.one * S * (0.5 - i * 0.12), CFrame.new(0, ctx.CY + H * 0.38 + i * S * 0.1, S * 0.03 * i), color, def.Material).Transparency = body.Transparency
		end
	end
	if not silhouette then
		ball(ctx, "Belly", Vector3.new(W * 0.55, H * 0.45, D * 0.2), CFrame.new(surface(ctx, Vector3.new(0, -0.45, -1), S * 0.06)), lighter(color, 0.35)).Transparency = body.Transparency
	end
	-- Patitas
	for _, side in { -1, 1 } do
		ball(ctx, "Foot", Vector3.new(S * 0.22, S * 0.12, S * 0.28), CFrame.new(side * W * 0.22, S * 0.08, -D * 0.12), darker(color, 0.15))
	end
	face(ctx)
	for _, feature in def.Features do
		local builder = Features[feature]
		if builder then
			builder(ctx)
		else
			warn("[Models] Rasgo desconocido: " .. feature)
		end
	end

	local rarity = Rarities.Get(def.Rarity)
	if ctx.Effects then
		if rarity.Order >= 5 then
			light(ctx, rarity.Color, S * 3, 1)
		end
		if rarity.Order >= 6 then
			particles(ctx, rarity.Color, WHITE, 4, S * 0.08)
		end
		if opts.Shiny then
			local sparkles = Instance.new("Sparkles")
			sparkles.SparkleColor = Color3.fromRGB(255, 250, 200)
			effect(ctx, sparkles)
		end
	end
	if not silhouette then
		tag(body, "CritterBody")
	end
	model:SetAttribute("Height", ctx.CY + H / 2)
	return model
end

-- ---------------------------------------------------------------------
-- API: huevos
-- ---------------------------------------------------------------------
function Models.BuildEgg(eggIndex: number, scale: number?): Model
	local def = Critters.GetEgg(eggIndex) or Critters.Eggs[1]
	local S = 3 * (scale or 1)
	local model, root = newModel(def.Name, Vector3.new(S * 0.5, 0.2, S * 0.5))
	local ctx: Ctx = {
		Model = model,
		Root = root,
		S = S,
		W = S * 0.82,
		H = S,
		D = S * 0.82,
		CY = S / 2,
		Color = def.Color,
		Accent = def.SpotColor,
		Silhouette = false,
		Effects = true,
		Body = nil,
		Eyes = {},
		EyeSize = 0,
	}
	local body = ball(ctx, "Shell", Vector3.new(ctx.W, ctx.H, ctx.D), CFrame.new(0, ctx.CY, 0), def.Color)
	body.Reflectance = 0.1
	ctx.Body = body
	for _, dir in { Vector3.new(0.4, 0.5, -0.7), Vector3.new(-0.6, 0.1, -0.7), Vector3.new(0.7, -0.3, -0.5), Vector3.new(-0.2, 0.8, -0.5), Vector3.new(0.1, -0.2, -1), Vector3.new(0.8, 0.3, 0.4), Vector3.new(-0.8, -0.2, 0.3), Vector3.new(0, 0.3, 1) } do
		local pos = surface(ctx, dir, S * 0.015)
		ball(ctx, "Spot", Vector3.new(S * 0.16, S * 0.16, S * 0.03), CFrame.lookAt(pos, pos + dir), def.SpotColor, if eggIndex >= 4 then Enum.Material.Neon else Enum.Material.SmoothPlastic)
	end
	if eggIndex >= 5 then
		particles(ctx, def.SpotColor, WHITE, 3, S * 0.06)
	end
	tag(body, "EggBody")
	return model
end

-- ---------------------------------------------------------------------
-- API: meteoritos
-- ---------------------------------------------------------------------
export type MeteorOptions = { Comet: boolean? }

function Models.BuildMeteor(rarityName: string, zoneIndex: number, options: MeteorOptions?): Model
	local opts = options or {}
	local rarity = Rarities.Get(rarityName)
	local zone = Zones.Get(zoneIndex)
	local R = if opts.Comet then 13 else rarity.Size
	local model, root = newModel(if opts.Comet then "Comet" else rarity.Name .. " Meteor", Vector3.new(R, 0.2, R))
	local glowColor = if opts.Comet then Color3.fromRGB(140, 230, 255) else rarity.Color
	local rockColor = if opts.Comet then Color3.fromRGB(40, 45, 70) else zone.RockColor:Lerp(rarity.Color, 0.12)
	local ctx: Ctx = {
		Model = model,
		Root = root,
		S = R * 2,
		W = R * 2,
		H = R * 1.6,
		D = R * 2,
		CY = R * 0.65,
		Color = rockColor,
		Accent = glowColor,
		Silhouette = false,
		Effects = true,
		Body = nil,
		Eyes = {},
		EyeSize = 0,
	}
	-- Cráter
	cylinder(ctx, "Crater", 0.3, R * 3.6, CFrame.new(0, 0.12, 0), darker(zone.GroundColor, 0.45))
	cylinder(ctx, "CraterRim", 0.5, R * 2.8, CFrame.new(0, 0.2, 0), darker(zone.GroundColor, 0.25))
	-- Roca principal + bultos
	local body = ball(ctx, "Rock", Vector3.new(ctx.W, ctx.H, ctx.D), CFrame.new(0, ctx.CY, 0), rockColor, Enum.Material.Slate)
	ctx.Body = body
	local seed = Random.new(rarity.Order * 97 + zoneIndex * 13 + (if opts.Comet then 7 else 0))
	for _ = 1, 6 do
		local dir = Vector3.new(seed:NextNumber(-1, 1), seed:NextNumber(-0.1, 1), seed:NextNumber(-1, 1))
		if dir.Magnitude < 0.1 then
			dir = Vector3.new(0, 1, 0)
		end
		local size = R * seed:NextNumber(0.6, 1.0)
		ball(ctx, "Lump", Vector3.new(size, size * 0.8, size), CFrame.new(surface(ctx, dir, size * 0.35)), darker(rockColor, seed:NextNumber(0, 0.2)), Enum.Material.Slate)
	end
	-- Cristales brillantes
	local crystalCount = if opts.Comet then 16 else 4 + rarity.Order
	for i = 1, crystalCount do
		local dir = Vector3.new(seed:NextNumber(-1, 1), seed:NextNumber(0.15, 1), seed:NextNumber(-1, 1))
		local base = surface(ctx, dir, R * 0.15)
		local length = R * seed:NextNumber(0.55, 1.05)
		local width = R * seed:NextNumber(0.24, 0.36)
		local crystal = blockBetween(ctx, "Crystal", base, base + dir.Unit * length, width, width, glowColor, Enum.Material.Neon)
		if rarity.Animated or opts.Comet then
			tag(crystal, "RainbowPart")
		end
		local _ = i
	end
	-- Haz de luz para verlo de lejos
	local beam = cylinder(ctx, "LightPillar", 90, if rarity.Order >= 3 or opts.Comet then 1.4 else 0.7, CFrame.new(0, 45, 0), glowColor, Enum.Material.Neon)
	beam.Transparency = if rarity.Order >= 3 or opts.Comet then 0.45 else 0.75
	light(ctx, glowColor, R * 4, if rarity.Order >= 4 or opts.Comet then 2 else 1)
	if rarity.Order >= 4 or opts.Comet then
		particles(ctx, glowColor, Color3.fromRGB(255, 160, 60), if opts.Comet then 20 else 6, R * 0.2)
	end
	model:SetAttribute("Radius", R)
	model:SetAttribute("Rarity", rarity.Name)
	return model
end

-- Bola de fuego que cae (la usa el cliente para la animación del impacto)
function Models.BuildFireball(rarityName: string, comet: boolean?): Model
	local rarity = Rarities.Get(rarityName)
	local R = if comet then 10 else rarity.Size * 0.8
	local model, root = newModel("Fireball", Vector3.new(1, 1, 1))
	local ctx: Ctx = {
		Model = model,
		Root = root,
		S = R * 2,
		W = R * 2,
		H = R * 2,
		D = R * 2,
		CY = 0,
		Color = rarity.Color,
		Accent = rarity.Color,
		Silhouette = false,
		Effects = true,
		Body = nil,
		Eyes = {},
		EyeSize = 0,
	}
	local core = ball(ctx, "Core", Vector3.one * R * 2, CFrame.new(), Color3.fromRGB(255, 200, 120), Enum.Material.Neon)
	ctx.Body = core
	local glow = ball(ctx, "Glow", Vector3.one * R * 2.8, CFrame.new(), if comet then Color3.fromRGB(140, 230, 255) else rarity.Color, Enum.Material.Neon)
	glow.Transparency = 0.6
	local fire = Instance.new("Fire")
	fire.Size = math.clamp(R * 2, 2, 30)
	fire.Heat = 20
	fire.Color = Color3.fromRGB(255, 140, 40)
	fire.SecondaryColor = if comet then Color3.fromRGB(140, 230, 255) else rarity.Color
	fire.Parent = core
	light(ctx, rarity.Color, R * 6, 3)
	return model
end

return Models
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Products</string>
          <string name="Source"><![CDATA[-- =====================================================================
--  MONETIZACIÓN: crea los Passes / Developer Products en el Creator
--  Dashboard y pega aquí sus IDs (Id = 0 = sin configurar).
-- =====================================================================

export type PassDef = { Key: string, Id: number, Name: string, Icon: string, Description: string, PriceHint: number }
export type ProductDef = { Key: string, Id: number, Name: string, Icon: string, Description: string, PriceHint: number, Kind: string, [string]: any }

local Products = {}

Products.GamePasses = {
	DoubleStardust = { Key = "DoubleStardust", Id = 0, Name = "2x Stardust", Icon = "⭐", Description = "Double ALL stardust forever!", PriceHint = 299 },
	VIP = { Key = "VIP", Id = 0, Name = "VIP", Icon = "👑", Description = "+20% stardust, +10% damage & VIP tag", PriceHint = 199 },
	AutoMine = { Key = "AutoMine", Id = 0, Name = "Auto Mine", Icon = "🤖", Description = "Mine automatically near meteors", PriceHint = 249 },
	ExtraSlots = { Key = "ExtraSlots", Id = 0, Name = "+2 Critter Slots", Icon = "🐾", Description = "Equip 2 more critters", PriceHint = 199 },
	TripleHatch = { Key = "TripleHatch", Id = 0, Name = "Triple Hatch", Icon = "🥚", Description = "Hatch 3 eggs at once", PriceHint = 249 },
	LuckyHatch = { Key = "LuckyHatch", Id = 0, Name = "Lucky Hatch", Icon = "🍀", Description = "x1.5 luck on every egg", PriceHint = 299 },
	RocketBoots = { Key = "RocketBoots", Id = 0, Name = "Rocket Boots", Icon = "🚀", Description = "+10 speed & higher jumps. Arrive first!", PriceHint = 149 },
	GalaxyHammer = { Key = "GalaxyHammer", Id = 0, Name = "Galaxy Hammer", Icon = "🔨", Description = "6,000 damage per hit", PriceHint = 399 },
} :: { [string]: PassDef }

Products.PassOrder = { "DoubleStardust", "AutoMine", "VIP", "TripleHatch", "LuckyHatch", "ExtraSlots", "RocketBoots", "GalaxyHammer" }

Products.DevProducts = {
	CallComet = { Key = "CallComet", Id = 0, Name = "Call the Comet", Icon = "☄️", Description = "A giant COMET crashes NOW for the whole server", PriceHint = 199, Kind = "Comet" },
	SummonMeteor = { Key = "SummonMeteor", Id = 0, Name = "Summon Meteor", Icon = "🌠", Description = "A Legendary+ meteor falls next to you (yours for 15s)", PriceHint = 79, Kind = "Summon" },
	ServerLuck = { Key = "ServerLuck", Id = 0, Name = "Server Luck x2", Icon = "🍀", Description = "2x meteor luck for EVERYONE for 15 min", PriceHint = 99, Kind = "ServerLuck", Seconds = 900 },
	SuperEgg = { Key = "SuperEgg", Id = 0, Name = "Super Egg", Icon = "🥚", Description = "Guaranteed Legendary+ critter from your best egg", PriceHint = 299, Kind = "SuperEgg" },
	PowerBoost = { Key = "PowerBoost", Id = 0, Name = "Power Boost", Icon = "⚡", Description = "x2 damage AND x2 stardust for 20 min", PriceHint = 49, Kind = "PowerBoost", Seconds = 1_200 },
	StardustSmall = { Key = "StardustSmall", Id = 0, Name = "Stardust Pouch", Icon = "✨", Description = "Worth 50 meteors of your best zone", PriceHint = 25, Kind = "Stardust", Meteors = 50, Minimum = 500 },
	StardustMedium = { Key = "StardustMedium", Id = 0, Name = "Stardust Sack", Icon = "💰", Description = "Worth 400 meteors of your best zone", PriceHint = 99, Kind = "Stardust", Meteors = 400, Minimum = 5_000 },
	StardustLarge = { Key = "StardustLarge", Id = 0, Name = "Stardust Vault", Icon = "🏦", Description = "Worth 2,500 meteors of your best zone", PriceHint = 349, Kind = "Stardust", Meteors = 2_500, Minimum = 50_000 },
} :: { [string]: ProductDef }

Products.ProductOrder = { "CallComet", "SummonMeteor", "ServerLuck", "SuperEgg", "PowerBoost", "StardustSmall", "StardustMedium", "StardustLarge" }

function Products.FindPassById(id: number): PassDef?
	if id == 0 then
		return nil
	end
	for _, def in Products.GamePasses do
		if def.Id == id then
			return def
		end
	end
	return nil
end

function Products.FindProductById(id: number): ProductDef?
	if id == 0 then
		return nil
	end
	for _, def in Products.DevProducts do
		if def.Id == id then
			return def
		end
	end
	return nil
end

return Products
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Quests</string>
          <string name="Source"><![CDATA[-- Misiones diarias: 3 al día, distintas para cada jugador, con premio final.

export type QuestTemplate = {
	Kind: string,
	Text: string, -- "%d" = objetivo
	Targets: { number },
	RewardMeteors: number,
}

local Quests = {}

Quests.Pool = {
	{ Kind = "BreakMeteors", Text = "Break %d meteors", Targets = { 15, 25, 40 }, RewardMeteors = 30 },
	{ Kind = "BreakRare", Text = "Break %d Rare+ meteors", Targets = { 3, 5, 8 }, RewardMeteors = 45 },
	{ Kind = "Swings", Text = "Swing your pickaxe %d times", Targets = { 250, 500, 800 }, RewardMeteors = 25 },
	{ Kind = "HatchEggs", Text = "Hatch %d eggs", Targets = { 3, 6, 10 }, RewardMeteors = 35 },
	{ Kind = "BeMVP", Text = "Be the MVP of %d meteors", Targets = { 3, 6, 10 }, RewardMeteors = 50 },
	{ Kind = "Crits", Text = "Land %d critical hits", Targets = { 30, 60, 100 }, RewardMeteors = 30 },
} :: { QuestTemplate }

Quests.PerDay = 3
-- Premio por completar las 3
Quests.Bonus = { CritterRarity = "Epic", Boost = 15 * 60 }

local byKind: { [string]: QuestTemplate } = {}
for _, template in Quests.Pool do
	byKind[template.Kind] = template
end

function Quests.GetTemplate(kind: string): QuestTemplate?
	return byKind[kind]
end

function Quests.Describe(kind: string, target: number): string
	local template = byKind[kind]
	if not template then
		return kind
	end
	return string.format(template.Text, target)
end

-- Genera las misiones del día de forma determinista (mismo día + mismo jugador = mismas misiones)
function Quests.Generate(day: number, userId: number): { { Kind: string, Target: number, Progress: number, Claimed: boolean, RewardMeteors: number } }
	local rng = Random.new(day * 7919 + (userId % 100000) * 31)
	local indices = {}
	for i = 1, #Quests.Pool do
		indices[i] = i
	end
	-- Fisher-Yates
	for i = #indices, 2, -1 do
		local j = rng:NextInteger(1, i)
		indices[i], indices[j] = indices[j], indices[i]
	end
	local list = {}
	for i = 1, Quests.PerDay do
		local template = Quests.Pool[indices[i]]
		local tier = rng:NextInteger(1, #template.Targets)
		table.insert(list, {
			Kind = template.Kind,
			Target = template.Targets[tier],
			Progress = 0,
			Claimed = false,
			RewardMeteors = template.RewardMeteors * (0.8 + tier * 0.2),
		})
	end
	return list
end

return Quests
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Rarities</string>
          <string name="Source"><![CDATA[-- Rarezas compartidas por meteoritos y criaturas.

export type Rarity = {
	Name: string,
	Order: number,
	Color: Color3,
	StrokeColor: Color3,
	Weight: number, -- peso de aparición de meteoritos
	HpMult: number,
	LootMult: number,
	EggChance: number, -- probabilidad de que el MVP reciba un huevo de meteorito
	Size: number, -- radio del meteorito en studs
	Announce: boolean,
	Animated: boolean,
}

local Rarities = {}

Rarities.List = {
	{ Name = "Common", Order = 1, Color = Color3.fromRGB(205, 205, 210), StrokeColor = Color3.fromRGB(35, 35, 40), Weight = 56, HpMult = 1, LootMult = 1, EggChance = 0, Size = 3, Announce = false, Animated = false },
	{ Name = "Uncommon", Order = 2, Color = Color3.fromRGB(85, 225, 95), StrokeColor = Color3.fromRGB(10, 60, 20), Weight = 25, HpMult = 2, LootMult = 2.5, EggChance = 0, Size = 3.5, Announce = false, Animated = false },
	{ Name = "Rare", Order = 3, Color = Color3.fromRGB(70, 155, 255), StrokeColor = Color3.fromRGB(10, 30, 80), Weight = 12, HpMult = 4, LootMult = 6, EggChance = 0.04, Size = 4, Announce = false, Animated = false },
	{ Name = "Epic", Order = 4, Color = Color3.fromRGB(180, 90, 255), StrokeColor = Color3.fromRGB(45, 10, 80), Weight = 4.5, HpMult = 8, LootMult = 15, EggChance = 0.15, Size = 4.8, Announce = false, Animated = false },
	{ Name = "Legendary", Order = 5, Color = Color3.fromRGB(255, 185, 30), StrokeColor = Color3.fromRGB(90, 50, 0), Weight = 1.8, HpMult = 18, LootMult = 45, EggChance = 0.5, Size = 5.6, Announce = true, Animated = false },
	{ Name = "Mythic", Order = 6, Color = Color3.fromRGB(255, 60, 95), StrokeColor = Color3.fromRGB(80, 0, 20), Weight = 0.55, HpMult = 40, LootMult = 140, EggChance = 1, Size = 6.5, Announce = true, Animated = false },
	{ Name = "Cosmic", Order = 7, Color = Color3.fromRGB(120, 245, 255), StrokeColor = Color3.fromRGB(20, 0, 60), Weight = 0.15, HpMult = 90, LootMult = 450, EggChance = 1, Size = 7.5, Announce = true, Animated = true },
} :: { Rarity }

local byName: { [string]: Rarity } = {}
for _, rarity in Rarities.List do
	byName[rarity.Name] = rarity
end

function Rarities.Get(name: string): Rarity
	return byName[name] or Rarities.List[1]
end

function Rarities.Exists(name: string): boolean
	return byName[name] ~= nil
end

function Rarities.Order(name: string): number
	local rarity = byName[name]
	return if rarity then rarity.Order else 0
end

-- Botín medio de un meteorito (para escalar recompensas al progreso del jugador)
function Rarities.AverageLootMult(): number
	local totalWeight, total = 0, 0
	for _, rarity in Rarities.List do
		totalWeight += rarity.Weight
		total += rarity.Weight * rarity.LootMult
	end
	return total / totalWeight
end

-- Color "visible" (Cosmic usa un color claro para textos y luces)
function Rarities.DisplayColor(name: string): Color3
	return Rarities.Get(name).Color
end

return Rarities
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Crea (servidor) u obtiene (cliente) todos los RemoteEvents/RemoteFunctions.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"Notify", -- S->C  { Text, Kind }
	"Announce", -- S->C  { Text, Color, Duration }
	"Sync", -- S->C  vista de datos del jugador
	"Effect", -- S->C  (name, payload)
	"Knockback", -- S->C  (velocity: Vector3)
}

local FUNCTIONS = {
	"Action", -- C->S  (actionName, payload) -> (ok, message)
}

local Remotes = {}

local folder: Folder

if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing then
		folder = existing :: Folder
	else
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		for _, name in EVENTS do
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		for _, name in FUNCTIONS do
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
		folder.Parent = ReplicatedStorage
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Remotes.Event(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

function Remotes.Function(name: string): RemoteFunction
	return folder:WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">RewardInfo</string>
          <string name="Source"><![CDATA[-- Describe recompensas para mostrarlas en la UI antes de reclamarlas.

local Economy = require(script.Parent.Economy)
local Format = require(script.Parent.Format)
local Rarities = require(script.Parent.Rarities)

local RewardInfo = {}

-- Devuelve icono, texto corto y color. rewardBase = valor de un meteorito medio para el jugador.
function RewardInfo.Describe(reward: { [string]: any }, rewardBase: number): (string, string, Color3)
	if reward.CritterRarity then
		local rarity = Rarities.Get(reward.CritterRarity)
		local text = reward.CritterRarity .. " Critter"
		if reward.Boost or reward.DamageBoost then
			text ..= " + Boost"
		end
		return "🐾", text, rarity.Color
	end
	if reward.Stardust or reward.Meteors then
		return "⭐", Format.Abbreviate(Economy.ScaleReward(reward.Stardust, rewardBase, reward.Meteors)), Color3.fromRGB(255, 230, 110)
	end
	if reward.DamageBoost then
		return "⚔️", "2x Damage " .. Format.Duration(reward.DamageBoost), Color3.fromRGB(255, 130, 110)
	end
	if reward.Boost then
		return "⏫", "2x Stardust " .. Format.Duration(reward.Boost), Color3.fromRGB(120, 230, 255)
	end
	return "🎁", "Reward", Color3.fromRGB(255, 255, 255)
end

return RewardInfo
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[-- Signal simple (sin BindableEvent) para comunicación interna.

export type Connection = { Disconnect: (self: Connection) -> (), Connected: boolean }

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} :: { any } }, Signal)
end

function Signal:Connect(fn: (...any) -> ())
	local handlers = self._handlers
	local connection = { Connected = true }
	local entry = { Fn = fn, Connection = connection }
	function connection.Disconnect(conn)
		conn.Connected = false
		local index = table.find(handlers, entry)
		if index then
			table.remove(handlers, index)
		end
	end
	table.insert(handlers, entry)
	return connection
end

function Signal:Once(fn: (...any) -> ())
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal:Fire(...)
	for _, entry in table.clone(self._handlers) do
		if entry.Connection.Connected then
			task.spawn(entry.Fn, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Zones</string>
          <string name="Source"><![CDATA[-- Zonas del mapa (en fila). Cada una tiene meteoritos más duros y con más botín.

export type Zone = {
	Index: number,
	Id: string,
	Name: string,
	Icon: string,
	Cost: number,
	BaseHP: number,
	BaseLoot: number,
	GroundColor: Color3,
	GroundMaterial: Enum.Material,
	RockColor: Color3,
	AccentColor: Color3,
	Decor: string,
	LowGravity: boolean,
	Ambient: { ClockTime: number, Brightness: number, Ambient: Color3, Fog: Color3 },
}

local Zones = {}

Zones.List = {
	{
		Index = 1, Id = "Meadow", Name = "Meadow Crater", Icon = "🌿", Cost = 0, BaseHP = 15, BaseLoot = 8,
		GroundColor = Color3.fromRGB(105, 185, 85), GroundMaterial = Enum.Material.Grass,
		RockColor = Color3.fromRGB(95, 85, 80), AccentColor = Color3.fromRGB(120, 255, 140), Decor = "Trees", LowGravity = false,
		Ambient = { ClockTime = 14.5, Brightness = 2.2, Ambient = Color3.fromRGB(100, 100, 115), Fog = Color3.fromRGB(200, 225, 255) },
	},
	{
		Index = 2, Id = "Dunes", Name = "Dune Desert", Icon = "🏜️", Cost = 2_500, BaseHP = 260, BaseLoot = 55,
		GroundColor = Color3.fromRGB(232, 200, 140), GroundMaterial = Enum.Material.Sand,
		RockColor = Color3.fromRGB(120, 85, 60), AccentColor = Color3.fromRGB(255, 200, 90), Decor = "Cacti", LowGravity = false,
		Ambient = { ClockTime = 15.5, Brightness = 2.6, Ambient = Color3.fromRGB(125, 105, 85), Fog = Color3.fromRGB(255, 225, 180) },
	},
	{
		Index = 3, Id = "Tundra", Name = "Frost Tundra", Icon = "❄️", Cost = 40_000, BaseHP = 3_800, BaseLoot = 600,
		GroundColor = Color3.fromRGB(228, 240, 255), GroundMaterial = Enum.Material.Snow,
		RockColor = Color3.fromRGB(80, 95, 120), AccentColor = Color3.fromRGB(140, 220, 255), Decor = "Pines", LowGravity = false,
		Ambient = { ClockTime = 13, Brightness = 2, Ambient = Color3.fromRGB(110, 125, 150), Fog = Color3.fromRGB(215, 235, 255) },
	},
	{
		Index = 4, Id = "Magma", Name = "Magma Fields", Icon = "🌋", Cost = 650_000, BaseHP = 52_000, BaseLoot = 7_000,
		GroundColor = Color3.fromRGB(62, 48, 46), GroundMaterial = Enum.Material.Basalt,
		RockColor = Color3.fromRGB(35, 28, 28), AccentColor = Color3.fromRGB(255, 110, 30), Decor = "Lava", LowGravity = false,
		Ambient = { ClockTime = 18, Brightness = 1.6, Ambient = Color3.fromRGB(130, 70, 50), Fog = Color3.fromRGB(150, 70, 40) },
	},
	{
		Index = 5, Id = "Moon", Name = "Moon Plateau", Icon = "🌙", Cost = 11_000_000, BaseHP = 750_000, BaseLoot = 85_000,
		GroundColor = Color3.fromRGB(175, 175, 185), GroundMaterial = Enum.Material.Slate,
		RockColor = Color3.fromRGB(70, 70, 82), AccentColor = Color3.fromRGB(200, 220, 255), Decor = "Craters", LowGravity = true,
		Ambient = { ClockTime = 0, Brightness = 1.2, Ambient = Color3.fromRGB(110, 115, 140), Fog = Color3.fromRGB(20, 22, 40) },
	},
	{
		Index = 6, Id = "Nebula", Name = "Nebula Rift", Icon = "🌌", Cost = 220_000_000, BaseHP = 11_000_000, BaseLoot = 1_100_000,
		GroundColor = Color3.fromRGB(50, 30, 80), GroundMaterial = Enum.Material.SmoothPlastic,
		RockColor = Color3.fromRGB(30, 20, 55), AccentColor = Color3.fromRGB(230, 110, 255), Decor = "Crystals", LowGravity = false,
		Ambient = { ClockTime = 0, Brightness = 1, Ambient = Color3.fromRGB(120, 80, 160), Fog = Color3.fromRGB(60, 30, 90) },
	},
} :: { Zone }

function Zones.Get(index: number): Zone
	return Zones.List[math.clamp(index, 1, #Zones.List)]
end

function Zones.Count(): number
	return #Zones.List
end

return Zones
]]></string>
