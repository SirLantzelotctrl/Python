	ball(ctx, "FlameInner", Vector3.new(S * 0.18, S * 0.28, S * 0.18), CFrame.new(base + Vector3.new(0, S * 0.12, -S * 0.05)), Color3.fromRGB(255, 230, 80), Enum.Material.Neon)
