SlimeBuilder.Accessories = Accessories

-- ---------------------------------------------------------------------
-- Cara
-- ---------------------------------------------------------------------
local function buildFace(ctx: Ctx, eyeScale: number)
	local S = ctx.S
	local e = S * 0.2 * eyeScale
	ctx.EyeSize = e
	ctx.Eyes = {}
	for _, side in { -1, 1 } do
		local pos = front(ctx, 0.3 * side * math.min(eyeScale, 1.2), 0.18, e * 0.3)
		table.insert(ctx.Eyes, pos)
		ball(ctx, "Eye", Vector3.new(e, e * 1.1, e * 0.7), CFrame.new(pos), WHITE)
		ball(ctx, "Pupil", Vector3.new(e * 0.55, e * 0.62, e * 0.4), CFrame.new(pos + Vector3.new(0, -e * 0.05, -e * 0.28)), BLACK)
		ball(ctx, "EyeShine", Vector3.new(e * 0.2, e * 0.2, e * 0.12), CFrame.new(pos + Vector3.new(e * 0.12, e * 0.12, -e * 0.45)), WHITE)
	end
	ball(ctx, "Mouth", Vector3.new(S * 0.2, S * 0.08, S * 0.06), CFrame.new(front(ctx, 0, -0.14, S * 0.012)), Color3.fromRGB(70, 20, 35))
	if not ctx.Silhouette then
		for _, side in { -1, 1 } do
			local cheek = ball(ctx, "Cheek", Vector3.new(S * 0.13, S * 0.07, S * 0.03), CFrame.new(front(ctx, 0.52 * side, -0.02, S * 0.008)) * CFrame.Angles(0, -side * math.rad(35), 0), Color3.fromRGB(255, 120, 150))
			cheek.Transparency = 0.35
		end
	end
end

-- ---------------------------------------------------------------------
-- API pública
-- ---------------------------------------------------------------------
function SlimeBuilder.GetDimensions(slimeId: string, scale: number?): (number, number)
	local def = Slimes.Get(slimeId) or Slimes.List[1]
	local S = BASE_SIZE * Rarities.Get(def.Rarity).Scale * (scale or 1)
	return S, S * 0.82
end

function SlimeBuilder.Build(slimeId: string, mutationName: string?, options: BuildOptions?): Model
	local opts: BuildOptions = options or {}
	local def = Slimes.Get(slimeId) or Slimes.List[1]
	local rarity = Rarities.Get(def.Rarity)
	local mutation = Mutations.Get(mutationName)
	local S, H = SlimeBuilder.GetDimensions(def.Id, opts.Scale)

	local model = Instance.new("Model")
	model.Name = def.Name

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(S * 0.6, 0.2, S * 0.6)
	root.CFrame = CFrame.new(0, 0, 0)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Parent = model
	model.PrimaryPart = root

	local silhouette = opts.Silhouette == true
	local ctx: Ctx = {
		Model = model,
		Root = root,
		Def = def,
		S = S,
		H = H,
		A = S / 2,
		B = H / 2,
		Silhouette = silhouette,
		Effects = not silhouette and not opts.NoEffects,
		BodyColor = def.Color,
		Body = nil,
		Eyes = {},
		EyeSize = 0,
	}

	-- Cuerpo según la mutación
	local bodyColor = def.Color
	local material = def.Material or Enum.Material.SmoothPlastic
	local transparency = 0.04
	local reflectance = 0
	if mutation.Name == "Gold" then
		bodyColor = GOLD
		material = Enum.Material.SmoothPlastic
		reflectance = 0.3
	elseif mutation.Name == "Diamond" then
		bodyColor = Color3.fromRGB(165, 235, 255)
		material = Enum.Material.Glass
		transparency = 0.3
		reflectance = 0.2
	elseif mutation.Name == "Galaxy" then
		bodyColor = Color3.fromRGB(55, 22, 110)
		material = Enum.Material.SmoothPlastic
	elseif mutation.Name == "Rainbow" then
		bodyColor = Color3.fromHSV(math.random(), 0.65, 1)
	end
	ctx.BodyColor = bodyColor

	local body = ball(ctx, "Body", Vector3.new(S, H, S), CFrame.new(0, H / 2, 0), bodyColor, material)
	body.Transparency = if silhouette then 0 else transparency
	body.Reflectance = if silhouette then 0 else reflectance
	ctx.Body = body

	local puddle = ball(ctx, "Puddle", Vector3.new(S * 1.14, S * 0.1, S * 1.14), CFrame.new(0, S * 0.03, 0), bodyColor, material)
	puddle.Transparency = body.Transparency

	if not silhouette then
		local shine = ball(ctx, "Shine", Vector3.new(S * 0.2, S * 0.1, S * 0.08), CFrame.new(front(ctx, -0.42, 0.55, S * 0.015)) * CFrame.Angles(math.rad(-30), math.rad(25), math.rad(30)), WHITE)
		shine.Transparency = 0.25
	end

	buildFace(ctx, def.EyeScale or 1)

	for _, accessoryName in def.Accessories do
		local builder = Accessories[accessoryName]
		if builder then
			builder(ctx)
		else
			warn("[SlimeBuilder] Accesorio desconocido: " .. accessoryName)
		end
	end

	-- Efectos por rareza
	if rarity.Order >= 5 then
		light(ctx, if rarity.Name == "Secret" then WHITE else rarity.Color, S * 2.5, 1.2)
	end
	if rarity.Order >= 6 then
		local colors = if rarity.Name == "Secret" then { WHITE, Color3.fromRGB(40, 40, 40) } else { rarity.Color, WHITE }
		particles(ctx, colors, 5, S * 0.1, 0.8)
	end

	-- Efectos por mutación
	if mutation.Name == "Gold" then
		particles(ctx, { GOLD }, 4, S * 0.08, 1)
	elseif mutation.Name == "Diamond" then
		particles(ctx, { WHITE, Color3.fromRGB(150, 230, 255) }, 5, S * 0.08, 1)
	elseif mutation.Name == "Rainbow" then
		if not silhouette then
			tag(body, "RainbowPart")
			tag(puddle, "RainbowPart")
		end
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = WHITE
		addEffect(ctx, sparkles)
	elseif mutation.Name == "Galaxy" then
		particles(ctx, { WHITE, Color3.fromRGB(200, 150, 255) }, 8, S * 0.06, 1)
		light(ctx, Color3.fromRGB(150, 70, 255), S * 2.5, 1.5)
	end

	model:SetAttribute("SlimeId", def.Id)
	model:SetAttribute("Mutation", mutation.Name)
	model:SetAttribute("Rarity", rarity.Name)
	model:SetAttribute("BodyHeight", H)
	if not silhouette then
		tag(body, "SlimeBody")
	end
	return model
end

-- ---------------------------------------------------------------------
-- Cartel flotante (BillboardGui) con nombre, rareza, ingresos y precio
-- ---------------------------------------------------------------------
export type BillboardInfo = {
	Income: number?,
	Price: number?,
	Extra: string?,
	ExtraColor: Color3?,
}

export type BillboardRefs = {
	Gui: BillboardGui,
	Income: TextLabel?,
	Price: TextLabel?,
	Extra: TextLabel?,
}

local function makeLabel(parent: Instance, name: string, text: string, color: Color3, strokeColor: Color3, order: number, heightScale: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, heightScale)
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.LayoutOrder = order
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = strokeColor
	stroke.Parent = label
	label.Parent = parent
	return label
end

function SlimeBuilder.CreateBillboard(model: Model, info: BillboardInfo): BillboardRefs
	local slimeId = model:GetAttribute("SlimeId") :: string
	local mutationName = model:GetAttribute("Mutation") :: string
	local def = Slimes.Get(slimeId) or Slimes.List[1]
	local rarity = Rarities.Get(def.Rarity)
	local mutation = Mutations.Get(mutationName)
	local S, H = SlimeBuilder.GetDimensions(def.Id)

	local lines = 2
	if mutation.Name ~= "Normal" then
		lines += 1
	end
	if info.Income then
		lines += 1
	end
	if info.Price then
		lines += 1
	end
	if info.Extra then
		lines += 1
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.new(8, 0, lines * 0.62, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, H + S * 0.55 + lines * 0.31, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 75
	gui.AlwaysOnTop = false
	gui.ResetOnSpawn = false

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.Parent = gui

	local share = 1 / lines
	local refs: BillboardRefs = { Gui = gui }

	if info.Extra then
		refs.Extra = makeLabel(gui, "Extra", info.Extra, info.ExtraColor or Color3.fromRGB(255, 120, 120), BLACK, 0, share)
	end
	if mutation.Name ~= "Normal" then
		makeLabel(gui, "Mutation", mutation.Icon .. " " .. string.upper(mutation.Name), mutation.Color, BLACK, 1, share)
	end
	makeLabel(gui, "SlimeName", def.Name, WHITE, BLACK, 2, share)
	local rarityLabel = makeLabel(gui, "Rarity", rarity.Name, rarity.Color, rarity.StrokeColor, 3, share)
	if rarity.Animated then
		local gradient = Instance.new("UIGradient")
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 90)),
			ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 230, 90)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 255, 140)),
			ColorSequenceKeypoint.new(0.75, Color3.fromRGB(90, 180, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(230, 90, 255)),
		})
		gradient.Parent = rarityLabel
		rarityLabel.TextColor3 = WHITE
		tag(gradient, "RainbowGradient")
	end
	if info.Income then
		refs.Income = makeLabel(gui, "Income", Format.PerSecond(info.Income), Color3.fromRGB(90, 255, 120), BLACK, 4, share)
	end
	if info.Price then
		refs.Price = makeLabel(gui, "Price", Format.Money(info.Price), Color3.fromRGB(255, 225, 70), BLACK, 5, share)
	end

	gui.Parent = model.PrimaryPart or model
	refs.Gui = gui
	return refs
end

return SlimeBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Slimes</string>
          <string name="Source"><![CDATA[-- Catálogo de slimes. Price = coste en la pasarela, Income = $/s base.
-- Accessories: piezas decorativas que construye SlimeBuilder (ver lista allí).

export type SlimeDef = {
	Id: string,
	Name: string,
	Rarity: string,
	Price: number,
	Income: number,
	Color: Color3,
	Accessories: { string },
	EyeScale: number?,
	Material: Enum.Material?,
}

local Slimes = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

Slimes.List = {
	-- COMMON ------------------------------------------------------------
	{ Id = "blobby", Name = "Blobby", Rarity = "Common", Price = 25, Income = 1, Color = rgb(120, 220, 120), Accessories = {} },
	{ Id = "puddle_pal", Name = "Puddle Pal", Rarity = "Common", Price = 60, Income = 2, Color = rgb(90, 170, 255), Accessories = { "Bow" } },
	{ Id = "gloop_jr", Name = "Gloop Jr.", Rarity = "Common", Price = 120, Income = 4, Color = rgb(255, 150, 60), Accessories = { "Cap" } },
	{ Id = "wobblet", Name = "Wobblet", Rarity = "Common", Price = 250, Income = 8, Color = rgb(255, 130, 200), Accessories = {}, EyeScale = 1.45 },

	-- UNCOMMON ----------------------------------------------------------
	{ Id = "mossy_mo", Name = "Mossy Mo", Rarity = "Uncommon", Price = 500, Income = 15, Color = rgb(95, 145, 60), Accessories = { "Moss", "Sprout" } },
	{ Id = "bubble_bob", Name = "Bubble Bob", Rarity = "Uncommon", Price = 900, Income = 28, Color = rgb(120, 220, 255), Accessories = { "Bubbles" } },
	{ Id = "minty_squish", Name = "Minty Squish", Rarity = "Uncommon", Price = 1_500, Income = 45, Color = rgb(150, 255, 200), Accessories = { "MintLeaf" } },
	{ Id = "pebble_plop", Name = "Pebble Plop", Rarity = "Uncommon", Price = 2_400, Income = 75, Color = rgb(160, 150, 140), Accessories = { "Pebbles" } },

	-- RARE --------------------------------------------------------------
	{ Id = "frosty_flop", Name = "Frosty Flop", Rarity = "Rare", Price = 4_000, Income = 115, Color = rgb(185, 235, 255), Accessories = { "IceCrystals" } },
	{ Id = "lava_lump", Name = "Lava Lump", Rarity = "Rare", Price = 6_500, Income = 180, Color = rgb(230, 70, 30), Accessories = { "Flame" } },
	{ Id = "zappy_zorp", Name = "Zappy Zorp", Rarity = "Rare", Price = 10_000, Income = 280, Color = rgb(255, 235, 60), Accessories = { "Antennae", "Sparkle" } },
	{ Id = "sir_jiggles", Name = "Sir Jiggles", Rarity = "Rare", Price = 16_000, Income = 450, Color = rgb(175, 175, 195), Accessories = { "KnightHelmet" } },

	-- EPIC --------------------------------------------------------------
	{ Id = "ninja_nugget", Name = "Ninja Nugget", Rarity = "Epic", Price = 25_000, Income = 650, Color = rgb(45, 45, 55), Accessories = { "Headband" } },
	{ Id = "disco_drip", Name = "Disco Drip", Rarity = "Epic", Price = 40_000, Income = 1_000, Color = rgb(200, 80, 255), Accessories = { "Shades", "Sparkle" } },
	{ Id = "pirate_plap", Name = "Pirate Plap", Rarity = "Epic", Price = 65_000, Income = 1_600, Color = rgb(100, 200, 140), Accessories = { "PirateHat", "EyePatch" } },
	{ Id = "witchy_wub", Name = "Witchy Wub", Rarity = "Epic", Price = 100_000, Income = 2_500, Color = rgb(135, 95, 205), Accessories = { "WitchHat" } },

	-- LEGENDARY ---------------------------------------------------------
	{ Id = "king_gooberius", Name = "King Gooberius", Rarity = "Legendary", Price = 160_000, Income = 3_600, Color = rgb(255, 90, 90), Accessories = { "Crown", "Cape", "Mustache" } },
	{ Id = "dragoo", Name = "Dragoo", Rarity = "Legendary", Price = 260_000, Income = 5_800, Color = rgb(80, 200, 90), Accessories = { "Horns", "Spikes", "SmallWings" } },
	{ Id = "astro_blob", Name = "Astro Blob", Rarity = "Legendary", Price = 420_000, Income = 9_300, Color = rgb(240, 240, 255), Accessories = { "AstroHelmet", "Antennae" } },
	{ Id = "samurai_splash", Name = "Samurai Splash", Rarity = "Legendary", Price = 680_000, Income = 15_000, Color = rgb(60, 120, 220), Accessories = { "SamuraiHelmet" } },

	-- MYTHIC ------------------------------------------------------------
	{ Id = "cyber_gloop", Name = "Cyber Gloop 3000", Rarity = "Mythic", Price = 1_100_000, Income = 22_000, Color = rgb(45, 65, 85), Accessories = { "Visor", "Antennae" } },
	{ Id = "phoenix_puddle", Name = "Phoenix Puddle", Rarity = "Mythic", Price = 1_800_000, Income = 36_000, Color = rgb(255, 120, 30), Accessories = { "Flame", "Wings" } },
	{ Id = "kraken_jelly", Name = "Kraken Jelly", Rarity = "Mythic", Price = 3_000_000, Income = 60_000, Color = rgb(220, 60, 150), Accessories = { "Tentacles" } },
	{ Id = "pharaoh_plasm", Name = "Pharaoh Plasm", Rarity = "Mythic", Price = 5_000_000, Income = 100_000, Color = rgb(60, 90, 200), Accessories = { "Nemes" } },

	-- DIVINE ------------------------------------------------------------
	{ Id = "angel_ooze", Name = "Angel Ooze", Rarity = "Divine", Price = 8_000_000, Income = 135_000, Color = rgb(255, 250, 230), Accessories = { "Halo", "Wings" } },
	{ Id = "thunder_titan", Name = "Thunder Titan", Rarity = "Divine", Price = 13_000_000, Income = 220_000, Color = rgb(70, 80, 165), Accessories = { "Lightning", "Crown" } },
	{ Id = "celestia_goo", Name = "Celestia Goo", Rarity = "Divine", Price = 21_000_000, Income = 350_000, Color = rgb(255, 200, 255), Accessories = { "StarCrown", "Stars" } },
	{ Id = "chrono_blob", Name = "Chrono Blob", Rarity = "Divine", Price = 35_000_000, Income = 580_000, Color = rgb(205, 175, 95), Accessories = { "Clock" } },

	-- SECRET ------------------------------------------------------------
	{ Id = "the_glitch", Name = "The Glitch", Rarity = "Secret", Price = 60_000_000, Income = 850_000, Color = rgb(0, 255, 120), Accessories = { "GlitchCubes" }, Material = Enum.Material.Neon },
	{ Id = "void_emperor", Name = "Void Emperor", Rarity = "Secret", Price = 100_000_000, Income = 1_400_000, Color = rgb(30, 12, 45), Accessories = { "DarkCrown", "Aura" } },
	{ Id = "galactic_gooliath", Name = "Galactic Gooliath", Rarity = "Secret", Price = 175_000_000, Income = 2_500_000, Color = rgb(70, 35, 150), Accessories = { "Rings", "Stars" } },
	{ Id = "omega_slime", Name = "Omega Slime", Rarity = "Secret", Price = 300_000_000, Income = 4_300_000, Color = rgb(255, 255, 255), Accessories = { "Halo", "Wings", "Crown", "Aura" } },
} :: { SlimeDef }

local byId: { [string]: SlimeDef } = {}
Slimes.ByRarity = {} :: { [string]: { SlimeDef } }

for index, def in Slimes.List do
	assert(byId[def.Id] == nil, "Slime duplicado: " .. def.Id)
	byId[def.Id] = def
	Slimes.ByRarity[def.Rarity] = Slimes.ByRarity[def.Rarity] or {}
	table.insert(Slimes.ByRarity[def.Rarity], def)
	;(def :: any).CatalogIndex = index
end

function Slimes.Get(id: string): SlimeDef?
	return byId[id]
end

function Slimes.Exists(id: string): boolean
	return byId[id] ~= nil
end

function Slimes.Count(): number
	return #Slimes.List
end

return Slimes
]]></string>
        </Properties>
