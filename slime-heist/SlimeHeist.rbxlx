  <Item class="ServerScriptService" referent="16">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="17">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Actions</string>
          <string name="Source"><![CDATA[-- Router de acciones del cliente (un único RemoteFunction "Action").
-- Cada servicio registra sus acciones con Actions.Register(nombre, handler).
-- Incluye límite de peticiones por jugador (anti-spam / anti-exploit).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Actions = {}

type Handler = (player: Player, payload: any) -> (boolean?, string?)

local handlers: { [string]: Handler } = {}
local buckets: { [Player]: { Tokens: number, Last: number } } = {}

local MAX_TOKENS = 12
local REFILL_PER_SECOND = 8

function Actions.Register(name: string, handler: Handler)
	assert(handlers[name] == nil, "Acción duplicada: " .. name)
	handlers[name] = handler
end

local function allow(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if not bucket then
		bucket = { Tokens = MAX_TOKENS, Last = now }
		buckets[player] = bucket
	end
	bucket.Tokens = math.min(MAX_TOKENS, bucket.Tokens + (now - bucket.Last) * REFILL_PER_SECOND)
	bucket.Last = now
	if bucket.Tokens < 1 then
		return false
	end
	bucket.Tokens -= 1
	return true
end

function Actions.Start()
	local remote = Remotes.Function("Action")
	remote.OnServerInvoke = function(player: Player, actionName: any, payload: any)
		if typeof(actionName) ~= "string" then
			return false, "Invalid action"
		end
		local handler = handlers[actionName]
		if not handler then
			return false, "Unknown action"
		end
		if not allow(player) then
			return false, "Slow down!"
		end
		if payload ~= nil and typeof(payload) ~= "table" then
			payload = nil
		end
		local ok, success, message = pcall(handler, player, payload or {})
		if not ok then
			warn(("[Actions] Error en '%s': %s"):format(actionName, tostring(success)))
			return false, "Something went wrong"
		end
		return success == true, message
	end

	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

return Actions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Layout</string>
          <string name="Source"><![CDATA[-- Posiciones fijas del mapa (todo se genera por código).
--
--   Vista desde arriba (X hacia la derecha, Z hacia abajo):
--
--   [Plot1] [Plot2] [Plot3] [Plot4]        <- lado norte (z < 0)
--  PORTAL >>>>>>>>> PASARELA >>>>>>>>> FIN
--   [Plot5] [Plot6] [Plot7] [Plot8]        <- lado sur (z > 0)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Layout = {}

Layout.RunwayY = 1 -- altura de la superficie de la pasarela
Layout.RunwayStart = Vector3.new(-168, 1, 0)
Layout.RunwayEnd = Vector3.new(168, 1, 0)
Layout.RunwayWidth = 16

Layout.SpawnPosition = Vector3.new(-200, 1, 0)
Layout.PortalPosition = Vector3.new(-172, 1, 0)

local PLOT_SPACING = Config.Plots.Width + 8
local PLOT_OFFSET_Z = Layout.RunwayWidth / 2 + 14 + Config.Plots.Depth / 2

Layout.PlotCFrames = {} :: { CFrame }

for side = 1, 2 do
	local zSign = if side == 1 then -1 else 1
	for i = 1, 4 do
		local x = (i - 2.5) * PLOT_SPACING
		local position = Vector3.new(x, 0, zSign * PLOT_OFFSET_Z)
		-- El frente de la base (LookVector) mira hacia la pasarela
		table.insert(Layout.PlotCFrames, CFrame.lookAt(position, Vector3.new(x, 0, 0)))
	end
end

-- Posiciones de los pedestales en coordenadas locales de la base (Y = suelo de la base)
Layout.FloorHeight = 1
Layout.PedestalTop = 2.2

Layout.SlotOffsets = {} :: { Vector3 }
do
	local columns = Config.Plots.Columns
	local rows = Config.Plots.Rows
	local spacingX = 10.5
	local spacingZ = 12
	local backZ = Config.Plots.Depth / 2 - 8
	-- Fila 1 = fondo de la base (lejos de la entrada): los primeros slimes quedan más protegidos
	for row = 1, rows do
		for column = 1, columns do
			local x = (column - (columns + 1) / 2) * spacingX
			local z = backZ - (row - 1) * spacingZ
			table.insert(Layout.SlotOffsets, Vector3.new(x, Layout.PedestalTop, z))
		end
	end
end

return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="20">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Punto de entrada del servidor: carga servicios, construye el mapa y gestiona
-- la entrada/salida de jugadores en el orden correcto.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Crea los Remotes antes que nada
require(ReplicatedStorage.Shared.Remotes)

local Registry = require(script.Parent.Registry)
local Actions = require(script.Parent.Actions)
local Net = require(script.Parent.Net)
local Services = script.Parent.Services

local SERVICE_ORDER = {
	"DataService",
	"MapService",
	"PlotService",
	"MonetizationService",
	"EventService",
	"SlimeService",
	"ConveyorService",
	"StealService",
	"CombatService",
	"ShopService",
	"RebirthService",
	"RewardService",
	"PlayerService",
	"LeaderboardService",
	"AdminService",
}

for _, name in SERVICE_ORDER do
	Registry[name] = require(Services:FindFirstChild(name) :: ModuleScript)
end

for _, name in SERVICE_ORDER do
	local service = Registry[name]
	if service.Init then
		service.Init()
	end
end

-- Construimos el mundo
local map = Registry.MapService.Build()
Registry.PlotService.Build(map:FindFirstChild("Plots"))

Actions.Start()
for _, name in SERVICE_ORDER do
	local service = Registry[name]
	if service.Start then
		service.Start()
	end
end

-- ---------------------------------------------------------------------
-- Entrada y salida de jugadores
-- ---------------------------------------------------------------------
local joined: { [Player]: boolean } = {}

local function onPlayerAdded(player: Player)
	if joined[player] then
		return
	end
	joined[player] = true

	local passesThread = task.spawn(Registry.MonetizationService.LoadPlayer, player)
	local data = Registry.DataService.Load(player)
	if not data or player.Parent ~= Players then
		return
	end
	-- Esperamos a que los passes terminen de cargar (máx. 10s dentro de LoadPlayer)
	while coroutine.status(passesThread) ~= "dead" do
		task.wait(0.1)
	end

	local plot = Registry.PlotService.Assign(player)
	if not plot then
		player:Kick("This server is full. Please join another server!")
		return
	end

	Registry.SlimeService.SetupPlayer(player)
	Registry.RewardService.OnJoin(player)
	Registry.PlayerService.SetupPlayer(player)
	Registry.AdminService.SetupPlayer(player)
	Registry.DataService.MarkDirty(player)

	if not Registry.DataService.IsPersistent() then
		task.delay(3, function()
			Net.Notify(player, "⚠️ Data saving is OFF (Studio without API access). Progress won't save.", "Warning")
		end)
	end
end

local function onPlayerRemoving(player: Player)
	if not joined[player] then
		return
	end
	joined[player] = nil
	local steps = {
		function()
			Registry.StealService.OnPlayerRemoving(player)
		end,
		function()
			Registry.SlimeService.OnPlayerRemoving(player)
		end,
		function()
			Registry.CombatService.OnPlayerRemoving(player)
		end,
		function()
			Registry.RewardService.OnPlayerRemoving(player)
		end,
		function()
			Registry.PlayerService.OnPlayerRemoving(player)
		end,
		function()
			Registry.PlotService.Release(player)
		end,
		function()
			Registry.LeaderboardService.OnPlayerRemoving(player)
		end,
	}
	for _, step in steps do
		local ok, err = pcall(step)
		if not ok then
			warn("[Main] Error al salir " .. player.Name .. ": " .. tostring(err))
		end
	end
	Registry.DataService.Release(player)
	Registry.MonetizationService.OnPlayerRemoving(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

print(("[%s] Servidor listo ✅"):format(require(ReplicatedStorage.Shared.Config).GameName))
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Atajos para enviar mensajes a los clientes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local NotifyEvent = Remotes.Event("Notify")
local AnnounceEvent = Remotes.Event("Announce")
local EffectEvent = Remotes.Event("Effect")

local Net = {}

-- Kind: "Info" | "Success" | "Error" | "Warning" | "Cash"
function Net.Notify(player: Player, text: string, kind: string?)
	if player.Parent ~= Players then
		return
	end
	NotifyEvent:FireClient(player, { Text = text, Kind = kind or "Info" })
end

function Net.NotifyAll(text: string, kind: string?)
	NotifyEvent:FireAllClients({ Text = text, Kind = kind or "Info" })
end

function Net.Announce(text: string, color: Color3?, duration: number?)
	AnnounceEvent:FireAllClients({ Text = text, Color = color or Color3.fromRGB(255, 255, 255), Duration = duration or 4 })
end

function Net.AnnounceTo(player: Player, text: string, color: Color3?, duration: number?)
	if player.Parent ~= Players then
		return
	end
	AnnounceEvent:FireClient(player, { Text = text, Color = color or Color3.fromRGB(255, 255, 255), Duration = duration or 4 })
end

function Net.Effect(player: Player, name: string, payload: { [string]: any }?)
	if player.Parent ~= Players then
		return
	end
	EffectEvent:FireClient(player, name, payload or {})
end

function Net.EffectAll(name: string, payload: { [string]: any }?)
	EffectEvent:FireAllClients(name, payload or {})
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Registry</string>
          <string name="Source"><![CDATA[-- Registro de servicios del servidor. Main.server.luau lo rellena al arrancar.
-- Los servicios acceden a otros con Registry.NombreServicio DENTRO de funciones
-- (nunca al cargar el módulo) para evitar dependencias circulares.

local Registry = {} :: { [string]: any }

return Registry
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="23">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[-- Comandos de administrador por chat (prefijo "!"). En Studio todos son admin.
--   !help                     lista de comandos
--   !cash 1m                  darte dinero
--   !spawn secret [galaxy]    hacer aparecer un slime (rareza o id) en la pasarela
--   !give omega_slime [gold]  mandar un slime directo a tu base
--   !event LuckyStorm [seg]   iniciar evento (LuckyStorm, GoldenHour, SlimeFrenzy, CashParty, MoneyRain)
--   !luck 5 10                suerte x5 durante 10 minutos ("admin abuse")
--   !rebirth                  +1 rebirth gratis
--   !lock                     bloquear tu base ya
--   !reset                    BORRA tus datos

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Slimes = require(Shared.Slimes)
local Rarities = require(Shared.Rarities)
local Mutations = require(Shared.Mutations)

local Registry = require(script.Parent.Parent.Registry)
local Net = require(script.Parent.Parent.Net)

local AdminService = {}

local SUFFIX_MULTIPLIERS = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18 }

local function parseAmount(text: string?): number?
	if not text then
		return nil
	end
	local lower = string.lower(text)
	local number, suffix = string.match(lower, "^([%d%.e%+]+)(%a*)$")
	local value = tonumber(number)
	if not value then
		return nil
	end
	if suffix and suffix ~= "" then
		local mult = SUFFIX_MULTIPLIERS[suffix]
		if not mult then
			return nil
		end
		value *= mult
	end
	return value
end

local function capitalize(text: string): string
	return string.upper(string.sub(text, 1, 1)) .. string.lower(string.sub(text, 2))
end

local function resolveSlime(arg: string?): string?
	if not arg then
		return nil
	end
	local lower = string.lower(arg)
	if Slimes.Exists(lower) then
		return lower
	end
	local rarityName = capitalize(lower)
	if Rarities.Exists(rarityName) then
		return Economy.PickSlimeOfRarity(Random.new(), rarityName)
	end
	return nil
end

local function resolveMutation(arg: string?): string
	if not arg then
		return "Normal"
	end
	local name = capitalize(arg)
	return if Mutations.Exists(name) then name else "Normal"
end

function AdminService.IsAdmin(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	if table.find(Config.Admins, player.UserId) then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank >= 254
end

local commands: { [string]: (Player, { string }) -> string? } = {}

commands.help = function()
	return "!cash <amt>, !spawn <rarity|id> [mut], !give <rarity|id> [mut], !event <name> [sec], !luck <x> <min>, !rebirth, !lock, !reset"
end

commands.cash = function(player, args)
	local amount = parseAmount(args[1])
	if not amount or amount <= 0 then
		return "Usage: !cash 1m"
	end
	Registry.DataService.AddCash(player, amount, false)
	return "Gave " .. Format.Money(amount)
end

commands.spawn = function(_player, args)
	local slimeId = resolveSlime(args[1])
	if not slimeId then
		return "Usage: !spawn <rarity|slime_id> [mutation]"
	end
	local mutation = resolveMutation(args[2])
	Registry.ConveyorService.Spawn(slimeId, mutation, 0, true)
	return "Spawned " .. slimeId .. " (" .. mutation .. ")"
end

commands.give = function(player, args)
	local slimeId = resolveSlime(args[1])
	if not slimeId then
		return "Usage: !give <rarity|slime_id> [mutation]"
	end
	local slot = Registry.SlimeService.GetFreeSlot(player)
	if not slot then
		return "Your base is full"
	end
	Registry.ConveyorService.SendToBase(player, slimeId, resolveMutation(args[2]), slot, nil)
	return "Sending " .. slimeId .. " to your base"
end

commands.event = function(_player, args)
	local wanted = args[1] and string.lower(args[1]) or ""
	for _, name in Registry.EventService.GetEventNames() do
		if string.lower(name) == wanted then
			Registry.EventService.StartEvent(name, tonumber(args[2]))
			return "Started " .. name
		end
	end
	return "Events: " .. table.concat(Registry.EventService.GetEventNames(), ", ")
end

commands.luck = function(_player, args)
	local multiplier = tonumber(args[1]) or 5
	local minutes = tonumber(args[2]) or 10
	Registry.EventService.SetAdminLuck(multiplier, minutes * 60)
	return ("Luck x%s for %d min"):format(tostring(multiplier), minutes)
end

commands.rebirth = function(player)
	local data = Registry.DataService.Get(player)
	if not data then
		return nil
	end
	data.Rebirths = math.min(data.Rebirths + 1, Config.Rebirth.MaxRebirths)
	Registry.DataService.UpdateStatsDisplay(player)
	Registry.SlimeService.RefreshAll(player)
	Registry.SlimeService.InvalidateMultiplier(player)
	Registry.PlayerService.UpdateOverhead(player)
	return "Rebirths: " .. data.Rebirths
end

commands.lock = function(player)
	Registry.PlotService.TryLock(player, true)
	return "Locked"
end

commands.reset = function(player)
	Registry.StealService.CancelAllFor(player)
	Registry.DataService.ResetData(player)
	Registry.SlimeService.ResetPlayer(player)
	Registry.SlimeService.InvalidateMultiplier(player)
	Registry.CombatService.GiveBat(player)
	Registry.PlayerService.UpdateWalkSpeed(player)
	Registry.PlayerService.UpdateOverhead(player)
	return "Your data was reset"
end

function AdminService.Handle(player: Player, message: string)
	if string.sub(message, 1, 1) ~= "!" then
		return
	end
	if not AdminService.IsAdmin(player) then
		return
	end
	local args = string.split(string.sub(message, 2), " ")
	local name = string.lower(table.remove(args, 1) or "")
	local command = commands[name]
	if not command then
		return
	end
	local ok, result = pcall(command, player, args)
	if ok then
		if result then
			Net.Notify(player, "[Admin] " .. result, "Info")
		end
	else
		Net.Notify(player, "[Admin] Error: " .. tostring(result), "Error")
	end
end

function AdminService.SetupPlayer(player: Player)
	player.Chatted:Connect(function(message)
		AdminService.Handle(player, message)
	end)
end

function AdminService.Start()
	local _ = Players
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[-- Bates: todos los jugadores llevan uno. Golpear a un ladrón le hace soltar el slime.
-- La detección del golpe es en el servidor; el empujón (knockback) lo aplica el cliente golpeado.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Gear = require(Shared.Gear)
local Remotes = require(Shared.Remotes)

local Registry = require(script.Parent.Parent.Registry)

local CombatService = {}

local lastSwing: { [Player]: number } = {}

local function playSound(parent: Instance, soundName: string, volume: number?)
	local id = Config.Sounds[soundName]
	if not id then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.6
	sound.RollOffMaxDistance = 80
	sound.Parent = parent
	sound:Play()
	Debris:AddItem(sound, 3)
end

local function buildBat(def: Gear.BatDef): Tool
	local tool = Instance.new("Tool")
	tool.Name = def.Name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = "Hit thieves to make them drop your slime!"
	tool.Grip = CFrame.fromMatrix(Vector3.new(0, 0, -1.6), Vector3.new(0, 1, 0), Vector3.new(0, 0, 1))
	tool:SetAttribute("BatId", def.Id)
	CollectionService:AddTag(tool, "BatTool")

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.45, 0.45, 4.4)
	handle.Color = def.Color
	handle.Material = def.Material
	handle.CanCollide = false
	handle.Massless = true
	handle.TopSurface = Enum.SurfaceType.Smooth
	handle.BottomSurface = Enum.SurfaceType.Smooth
	handle.Parent = tool

	local head = Instance.new("Part")
	head.Name = "BatHead"
	head.Shape = Enum.PartType.Cylinder
	head.Size = Vector3.new(2.4, 0.95, 0.95)
	head.CFrame = handle.CFrame * CFrame.new(0, 0, 1.5) * CFrame.Angles(0, math.pi / 2, 0)
	head.Color = def.Color
	head.Material = def.Material
	head.CanCollide = false
	head.Massless = true
	head.Parent = tool
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = head
	weld.Parent = head

	if def.Id == "Galaxy" or def.Id == "Diamond" then
		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Color = ColorSequence.new(def.Color, Color3.fromRGB(255, 255, 255))
		sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) })
		sparkles.Lifetime = NumberRange.new(0.4, 0.8)
		sparkles.Rate = 12
		sparkles.Speed = NumberRange.new(0.5, 1.5)
		sparkles.LightEmission = 1
		sparkles.Parent = head
	end
	return tool
end

local function swing(player: Player, tool: Tool, def: Gear.BatDef)
	local now = os.clock()
	if (lastSwing[player] or 0) + def.Cooldown > now then
		return
	end
	lastSwing[player] = now
	local character = player.Character
	if not character or tool.Parent ~= character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return
	end

	-- Animación clásica de espada (la reproduce el script Animate por defecto)
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = tool
	Debris:AddItem(anim, 1)
	playSound(root, "Swing", 0.5)

	local hits = 0
	for _, other in Players:GetPlayers() do
		if other ~= player and hits < 3 then
			local otherCharacter = other.Character
			local otherRoot = otherCharacter and otherCharacter:FindFirstChild("HumanoidRootPart")
			local otherHumanoid = otherCharacter and otherCharacter:FindFirstChildOfClass("Humanoid")
			if otherRoot and otherRoot:IsA("BasePart") and otherHumanoid and otherHumanoid.Health > 0 then
				local offset = otherRoot.Position - root.Position
				local distance = offset.Magnitude
				if distance <= def.Range then
					local flat = Vector3.new(offset.X, 0, offset.Z)
					local dir = if flat.Magnitude > 0.1 then flat.Unit else root.CFrame.LookVector
					local facing = root.CFrame.LookVector:Dot(dir)
					if facing > 0.15 or distance < 4 then
						hits += 1
						CombatService.Hit(player, other, dir, def)
					end
				end
			end
		end
	end
end

function CombatService.Hit(attacker: Player, victim: Player, dir: Vector3, def: Gear.BatDef)
	local character = victim.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	-- Bonus: si la víctima lleva un slime robado, el golpe es más fuerte
	local power = def.Knockback * (if Registry.StealService.IsCarrying(victim) then 1.25 else 1)
	local velocity = dir * power + Vector3.new(0, power * 0.45, 0)
	Remotes.Event("Knockback"):FireClient(victim, velocity)
	Registry.StealService.OnHit(victim)
	if root then
		playSound(root, "Hit", 0.7)
	end
	local _ = attacker
end

function CombatService.GiveBat(player: Player)
	local data = Registry.DataService.Get(player)
	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not data or not backpack then
		return
	end
	-- Quitamos bates anteriores
	for _, container in { backpack, character } do
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and CollectionService:HasTag(child, "BatTool") then
					child:Destroy()
				end
			end
		end
	end

	local def = Gear.GetBat(data.EquippedBat) or Gear.Bats[1]
	if def.GamePass and not Registry.MonetizationService.OwnsPass(player, def.GamePass) then
		def = Gear.Bats[1]
	end
	local tool = buildBat(def)
	tool.Activated:Connect(function()
		swing(player, tool, def)
	end)
	tool.Parent = backpack
end

function CombatService.OnPlayerRemoving(player: Player)
	lastSwing[player] = nil
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">ConveyorService</string>
            <string name="Source"><![CDATA[-- Pasarela central: aparecen slimes aleatorios, avanzan y se pueden comprar.
-- Al comprar, el slime camina hasta la base del jugador.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Slimes = require(Shared.Slimes)
local Rarities = require(Shared.Rarities)
local Mutations = require(Shared.Mutations)
local SlimeBuilder = require(Shared.SlimeBuilder)

local Registry = require(script.Parent.Parent.Registry)
local Layout = require(script.Parent.Parent.Layout)
local Net = require(script.Parent.Parent.Net)

local ConveyorService = {}

type Entry = {
	SlimeId: string,
	Mutation: string,
	Model: Model,
	Root: BasePart,
	Distance: number,
	Sold: boolean,
}

local belt: { Entry } = {}
local rng = Random.new()
local beltFolder: Folder
local walkingFolder: Folder

local startPos = Layout.RunwayStart
local endPos = Layout.RunwayEnd
local direction = (endPos - startPos).Unit
local length = (endPos - startPos).Magnitude

local function cframeAt(distance: number): CFrame
	local position = startPos + direction * distance
	return CFrame.lookAt(position, position + direction)
end

function ConveyorService.Start()
	local slimesFolder = workspace:WaitForChild("Slimes")
	beltFolder = Instance.new("Folder")
	beltFolder.Name = "Belt"
	beltFolder.Parent = slimesFolder
	walkingFolder = Instance.new("Folder")
	walkingFolder.Name = "Walking"
	walkingFolder.Parent = slimesFolder

	-- Llenamos la pasarela al arrancar para que no esté vacía
	local spacing = Config.Conveyor.Speed * Config.Conveyor.SpawnInterval
	local distance = length - spacing
	while distance > 0 do
		ConveyorService.SpawnRandom(distance)
		distance -= spacing
	end

	task.spawn(function()
		while true do
			local interval = Config.Conveyor.SpawnInterval / Registry.EventService.GetSpawnRateMultiplier()
			task.wait(interval)
			local ok, err = pcall(ConveyorService.SpawnRandom, 0)
			if not ok then
				warn("[ConveyorService] Error al crear slime: " .. tostring(err))
			end
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		local speed = Config.Conveyor.Speed
		for index = #belt, 1, -1 do
			local entry = belt[index]
			entry.Distance += speed * dt
			if entry.Distance >= length or entry.Model.Parent == nil then
				table.remove(belt, index)
				if entry.Model.Parent then
					entry.Model:Destroy()
				end
			else
				entry.Root.CFrame = cframeAt(entry.Distance)
			end
		end
	end)
end

function ConveyorService.SpawnRandom(distance: number?)
	local rarity = Economy.RollRarity(rng, Registry.EventService.GetLuck())
	local slimeId = Economy.PickSlimeOfRarity(rng, rarity)
	local mutation = Economy.RollMutation(rng, Registry.EventService.GetMutationLuck())
	ConveyorService.Spawn(slimeId, mutation, distance, distance == nil or distance == 0)
end

function ConveyorService.Spawn(slimeId: string, mutation: string, distance: number?, announce: boolean?): Model?
	local def = Slimes.Get(slimeId)
	if not def then
		return nil
	end
	local rarity = Rarities.Get(def.Rarity)
	local price = Economy.GetSlimePrice(slimeId, mutation)

	local model = SlimeBuilder.Build(slimeId, mutation)
	SlimeBuilder.CreateBillboard(model, { Income = Economy.GetSlimeIncome(slimeId, mutation), Price = price })
	local root = model.PrimaryPart :: BasePart
	root.CFrame = cframeAt(distance or 0)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "BuyPrompt"
	prompt.ActionText = "Buy " .. Format.Money(price)
	prompt.ObjectText = def.Name
	prompt.HoldDuration = Config.Conveyor.BuyHoldDuration
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 11
	prompt.RequiresLineOfSight = false
	prompt.Parent = root

	local entry: Entry = {
		SlimeId = slimeId,
		Mutation = mutation,
		Model = model,
		Root = root,
		Distance = distance or 0,
		Sold = false,
	}
	prompt.Triggered:Connect(function(player)
		ConveyorService.TryBuy(player, entry)
	end)
	model.Parent = beltFolder
	table.insert(belt, entry)

	local mutationDef = Mutations.Get(mutation)
	if announce and (rarity.Announce or mutationDef.Multiplier >= 4) then
		local name = (if mutation ~= "Normal" then mutationDef.Name .. " " else "") .. def.Name
		Net.Announce(("%s %s appeared on the runway!"):format(string.upper(rarity.Name), name), if rarity.Name == "Secret" then Color3.fromRGB(255, 255, 255) else rarity.Color, 5)
		Net.EffectAll("Sound", { Name = "Announce" })
	end
	return model
end

function ConveyorService.TryBuy(player: Player, entry: Entry)
	if entry.Sold or not table.find(belt, entry) then
		return
	end
	local data = Registry.DataService.Get(player)
	if not data or not Registry.PlotService.GetPlot(player) then
		return
	end
	local slot = Registry.SlimeService.GetFreeSlot(player)
	if not slot then
		Net.Notify(player, "Your base is full! Sell a slime or Rebirth for more slots.", "Error")
		Net.Effect(player, "Sound", { Name = "Error" })
		return
	end
	local price = Economy.GetSlimePrice(entry.SlimeId, entry.Mutation)
	if not Registry.DataService.SpendCash(player, price) then
		Net.Notify(player, ("Not enough cash! You need %s"):format(Format.Money(price)), "Error")
		Net.Effect(player, "Sound", { Name = "Error" })
		return
	end

	entry.Sold = true
	local index = table.find(belt, entry)
	if index then
		table.remove(belt, index)
	end
	data.Stats.Bought += 1

	local def = Slimes.Get(entry.SlimeId)
	Net.Notify(player, ("Bought %s for %s!"):format(def and def.Name or "slime", Format.Money(price)), "Success")
	Net.Effect(player, "Sound", { Name = "Buy" })
	ConveyorService.SendToBase(player, entry.SlimeId, entry.Mutation, slot, entry.Model)
end

-- Hace caminar un slime hasta la base del jugador y lo registra en sus datos.
-- Si existingModel es nil, el slime sale del portal.
function ConveyorService.SendToBase(player: Player, slimeId: string, mutation: string, slot: number, existingModel: Model?): boolean
	local walker = existingModel
	if not walker then
		walker = SlimeBuilder.Build(slimeId, mutation)
		;(walker.PrimaryPart :: BasePart).CFrame = cframeAt(0)
	end
	local model = walker :: Model
	local root = model.PrimaryPart :: BasePart

	local prompt = root:FindFirstChild("BuyPrompt")
	if prompt then
		prompt:Destroy()
	end
	local oldInfo = root:FindFirstChild("Info")
	if oldInfo then
		oldInfo:Destroy()
	end
	SlimeBuilder.CreateBillboard(model, { Extra = player.DisplayName .. "'s", ExtraColor = Color3.fromRGB(120, 255, 140) })
	model.Parent = walkingFolder

	local addedSlot = Registry.SlimeService.AddSlime(player, slimeId, mutation, { Arriving = model, Slot = slot })
	if not addedSlot then
		model:Destroy()
		return false
	end

	task.spawn(function()
		local path = Registry.PlotService.GetEntrancePath(player, slot)
		for index, target in path do
			if model.Parent == nil then
				return
			end
			local current = root.Position
			local goal = target.Position
			local flat = Vector3.new(goal.X - current.X, 0, goal.Z - current.Z)
			local goalCFrame
			if index == #path then
				goalCFrame = target
			elseif flat.Magnitude > 0.05 then
				goalCFrame = CFrame.lookAt(goal, goal + flat.Unit)
			else
				goalCFrame = CFrame.new(goal) * root.CFrame.Rotation
			end
			if flat.Magnitude > 0.05 then
				root.CFrame = CFrame.lookAt(current, current + flat.Unit)
			end
			local duration = math.max(0.05, (goal - current).Magnitude / Config.Conveyor.WalkSpeed)
			local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = goalCFrame })
			tween:Play()
			task.wait(duration)
		end
		Registry.SlimeService.FinishArrival(player, slot, model)
	end)
	return true
end

return ConveyorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Guardado de datos con DataStore + bloqueo de sesión (evita duplicar slimes
-- si un jugador entra en otro servidor antes de que el anterior guarde).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Economy = require(Shared.Economy)
local Slimes = require(Shared.Slimes)
local Mutations = require(Shared.Mutations)
local Gear = require(Shared.Gear)
local Remotes = require(Shared.Remotes)

local Registry = require(script.Parent.Parent.Registry)

local DataService = {}

local SESSION_TIMEOUT = 10 * 60
local LOAD_ATTEMPTS = 6
local AUTOSAVE_INTERVAL = 120
local MAX_RECEIPTS = 60

local DEFAULT_DATA = {
	Cash = Config.StartingCash,
	TotalEarned = 0,
	Rebirths = 0,
	Slimes = {}, -- ["1"] = { Id = "blobby", Mutation = "Normal" }
	Index = {}, -- [slimeId] = { [mutation] = true }
	OwnedBats = { Wood = true },
	EquippedBat = "Wood",
	Upgrades = { Speed = 0, Lock = 0 },
	Daily = { LastDay = 0, Streak = 0 },
	Codes = {},
	Boosts = { CashX2 = 0 },
	Stats = { Steals = 0, TimesRobbed = 0, Bought = 0, Playtime = 0, Sold = 0 },
	ReceiptIds = {},
	LastOnline = 0,
	Version = 1,
}

local profiles: { [Player]: any } = {}
local saving: { [Player]: boolean } = {}
local dirty: { [Player]: boolean } = {}
local store: DataStore? = nil
local persistent = false

local function deepCopy<T>(value: T): T
	if typeof(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, child in value :: any do
		copy[key] = deepCopy(child)
	end
	return copy :: any
end

local function reconcile(target: { [any]: any }, template: { [any]: any })
	for key, value in template do
		if target[key] == nil then
			target[key] = deepCopy(value)
		elseif typeof(value) == "table" and typeof(target[key]) == "table" and next(value) ~= nil then
			reconcile(target[key], value)
		end
	end
end

local function sanitize(data: any)
	if typeof(data.Cash) ~= "number" or data.Cash ~= data.Cash then
		data.Cash = Config.StartingCash
	end
	data.Rebirths = math.clamp(math.floor(tonumber(data.Rebirths) or 0), 0, Config.Rebirth.MaxRebirths)
	local maxSlots = Economy.GetMaxPhysicalSlots()
	for key, entry in data.Slimes do
		local slot = tonumber(key)
		if typeof(entry) ~= "table" or not slot or slot < 1 or slot > maxSlots or not Slimes.Exists(entry.Id) then
			data.Slimes[key] = nil
		elseif not Mutations.Exists(entry.Mutation or "Normal") then
			entry.Mutation = "Normal"
		end
	end
	if not Gear.GetBat(data.EquippedBat) then
		data.EquippedBat = "Wood"
	end
	data.OwnedBats.Wood = true
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local function setupLeaderstats(player: Player, data: any)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Value = Format.Money(data.Cash)
	cash.Parent = folder
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = data.Rebirths
	rebirths.Parent = folder
	local steals = Instance.new("IntValue")
	steals.Name = "Steals"
	steals.Value = data.Stats.Steals
	steals.Parent = folder
	folder.Parent = player
end

-- ---------------------------------------------------------------------
-- Ciclo de vida
-- ---------------------------------------------------------------------
function DataService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok and result then
		local probeOk, probeError = pcall(function()
			return result:GetAsync("__probe")
		end)
		if probeOk then
			store = result
			persistent = true
		else
			warn("[DataService] DataStore no disponible (¿publicaste el juego y activaste 'Enable Studio Access to API Services'?). Los datos NO se guardarán en esta sesión. " .. tostring(probeError))
		end
	else
		warn("[DataService] No se pudo abrir el DataStore: " .. tostring(result))
	end
end

function DataService.Start()
	local syncEvent = Remotes.Event("Sync")
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.2 then
			return
		end
		elapsed = 0
		for player in dirty do
			dirty[player] = nil
			if profiles[player] and player.Parent == Players then
				local ok, view = pcall(DataService.BuildView, player)
				if ok then
					syncEvent:FireClient(player, view)
				else
					warn("[DataService] Error construyendo la vista: " .. tostring(view))
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.Save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		if not persistent then
			return
		end
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

function DataService.IsPersistent(): boolean
	return persistent
end

function DataService.Load(player: Player): any?
	local data: any = nil
	if store then
		local key = keyFor(player)
		for attempt = 1, LOAD_ATTEMPTS do
			if player.Parent ~= Players then
				return nil
			end
			local wasLocked = false
			local ok, result = pcall(function()
				return (store :: DataStore):UpdateAsync(key, function(old)
					local now = os.time()
					local session = if typeof(old) == "table" then old._Session else nil
					if typeof(session) == "table" and session.JobId ~= game.JobId and now - (session.Time or 0) < SESSION_TIMEOUT and attempt < LOAD_ATTEMPTS then
						wasLocked = true
						return nil
					end
					local value = if typeof(old) == "table" then old else {}
					value._Session = { JobId = game.JobId, Time = now }
					return value
				end)
			end)
			if ok and typeof(result) == "table" then
				data = result
				break
			end
			if not ok then
				warn(("[DataService] Error cargando %s (intento %d): %s"):format(player.Name, attempt, tostring(result)))
			end
			task.wait(if wasLocked then 5 else 2)
		end
		if not data then
			player:Kick("We couldn't load your data. Please rejoin in a moment!")
			return nil
		end
	else
		data = {}
	end

	if player.Parent ~= Players then
		-- Se fue mientras cargábamos: liberamos el bloqueo de sesión
		if store then
			task.spawn(function()
				pcall(function()
					(store :: DataStore):UpdateAsync(keyFor(player), function(old)
						if typeof(old) == "table" and typeof(old._Session) == "table" and old._Session.JobId == game.JobId then
							old._Session = nil
							return old
						end
						return nil
					end)
				end)
			end)
		end
		return nil
	end

	data._Session = nil
	reconcile(data, DEFAULT_DATA)
	sanitize(data)
	profiles[player] = data

	setupLeaderstats(player, data)
	player:SetAttribute("Cash", data.Cash)
	player:SetAttribute("Rebirths", data.Rebirths)
	return data
end

function DataService.Save(player: Player, release: boolean): boolean
	local data = profiles[player]
	if not data or not store then
		return true
	end
	while saving[player] do
		task.wait(0.1)
	end
	saving[player] = true
	data.LastOnline = os.time()
	local snapshot = deepCopy(data)
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(keyFor(player), function(old)
			local session = if typeof(old) == "table" then old._Session else nil
			if typeof(session) == "table" and session.JobId ~= game.JobId and os.time() - (session.Time or 0) < SESSION_TIMEOUT then
				warn("[DataService] Otro servidor tiene la sesión de " .. player.Name .. "; no se sobrescribe.")
				return nil
			end
			snapshot._Session = if release then nil else { JobId = game.JobId, Time = os.time() }
			return snapshot
		end)
	end)
	saving[player] = nil
	if not ok then
		warn("[DataService] Error guardando " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

function DataService.Release(player: Player)
	if not profiles[player] then
		return
	end
	DataService.Save(player, true)
	profiles[player] = nil
	dirty[player] = nil
end

-- ---------------------------------------------------------------------
-- Acceso a datos
-- ---------------------------------------------------------------------
function DataService.Get(player: Player): any?
	return profiles[player]
end

function DataService.GetLoadedPlayers(): { Player }
	local list = {}
	for player in profiles do
		table.insert(list, player)
	end
	return list
end

function DataService.MarkDirty(player: Player)
	if profiles[player] then
		dirty[player] = true
	end
end

function DataService.UpdateCashDisplay(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	player:SetAttribute("Cash", data.Cash)
	local leaderstats = player:FindFirstChild("leaderstats")
	local cashValue = leaderstats and leaderstats:FindFirstChild("Cash")
	if cashValue and cashValue:IsA("StringValue") then
		cashValue.Value = Format.Money(data.Cash)
	end
end

function DataService.UpdateStatsDisplay(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	player:SetAttribute("Rebirths", data.Rebirths)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	local rebirths = leaderstats:FindFirstChild("Rebirths")
	if rebirths and rebirths:IsA("IntValue") then
		rebirths.Value = data.Rebirths
	end
	local steals = leaderstats:FindFirstChild("Steals")
	if steals and steals:IsA("IntValue") then
		steals.Value = data.Stats.Steals
	end
end

function DataService.AddCash(player: Player, amount: number, countsAsEarned: boolean?)
	local data = profiles[player]
	if not data or amount ~= amount or amount <= 0 or amount == math.huge then
		return
	end
	data.Cash += amount
	if countsAsEarned ~= false then
		data.TotalEarned += amount
	end
	DataService.UpdateCashDisplay(player)
end

function DataService.SpendCash(player: Player, amount: number): boolean
	local data = profiles[player]
	if not data or amount ~= amount or amount < 0 then
		return false
	end
	if data.Cash < amount then
		return false
	end
	data.Cash -= amount
	DataService.UpdateCashDisplay(player)
	return true
end

function DataService.HasReceipt(player: Player, receiptId: string): boolean
	local data = profiles[player]
	return data ~= nil and table.find(data.ReceiptIds, receiptId) ~= nil
end

function DataService.AddReceipt(player: Player, receiptId: string)
	local data = profiles[player]
	if not data then
		return
	end
	table.insert(data.ReceiptIds, receiptId)
	while #data.ReceiptIds > MAX_RECEIPTS do
		table.remove(data.ReceiptIds, 1)
	end
end

function DataService.Discover(player: Player, slimeId: string, mutation: string): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	data.Index[slimeId] = data.Index[slimeId] or {}
	if data.Index[slimeId][mutation] then
		return false
	end
	data.Index[slimeId][mutation] = true
	return true
end

function DataService.ResetData(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	local receipts = data.ReceiptIds
	for key in data do
		data[key] = nil
	end
	reconcile(data, DEFAULT_DATA)
	data.ReceiptIds = receipts
	DataService.UpdateCashDisplay(player)
	DataService.UpdateStatsDisplay(player)
	DataService.MarkDirty(player)
end

-- ---------------------------------------------------------------------
-- Vista para el cliente
-- ---------------------------------------------------------------------
function DataService.BuildView(player: Player): { [string]: any }
	local data = profiles[player]
	if not data then
		return {}
	end
	local Monetization = Registry.MonetizationService
	local SlimeService = Registry.SlimeService
	local RewardService = Registry.RewardService

	local passes = if Monetization then Monetization.GetOwnedPasses(player) else {}
	local slotCount = Economy.GetSlotCount(data.Rebirths, passes.ExtraSlots == true)
	local used = 0
	for _ in data.Slimes do
		used += 1
	end

	local view = {
		Cash = data.Cash,
		TotalEarned = data.TotalEarned,
		Rebirths = data.Rebirths,
		Slimes = data.Slimes,
		Index = data.Index,
		OwnedBats = data.OwnedBats,
		EquippedBat = data.EquippedBat,
		Upgrades = data.Upgrades,
		Stats = data.Stats,
		Boosts = data.Boosts,
		Codes = data.Codes,
		Passes = passes,
		SlotCount = slotCount,
		UsedSlots = used,
		RebirthCost = Economy.GetRebirthCost(data.Rebirths),
		LockDuration = Economy.GetLockDuration(data.Rebirths, data.Upgrades.Lock, passes.LongerLock == true),
		IndexCount = Economy.CountIndex(data.Index),
		IndexTotal = Economy.GetIndexTotal(),
		PlotIndex = player:GetAttribute("PlotIndex"),
		IsStudio = RunService:IsStudio(),
		SimulatePurchases = RunService:IsStudio() and Config.SimulatePurchasesInStudio,
		Persistent = persistent,
	}

	if SlimeService then
		local multiplier, breakdown = SlimeService.GetMultiplier(player)
		view.Multiplier = multiplier
		view.MultiplierBreakdown = breakdown
		view.Income = SlimeService.GetIncomePerSecond(player)
	end
	if RewardService then
		RewardService.FillView(player, view)
	end
	return view
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[-- Eventos del servidor: suerte de servidor (producto Robux), eventos automáticos
-- (Lucky Storm, Golden Hour, Slime Frenzy, Cash Party, Money Rain) y monedas que caen.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)
local Layout = require(script.Parent.Parent.Layout)
local Net = require(script.Parent.Parent.Net)

local EventService = {}

export type EventDef = { Title: string, Description: string, Color: Color3 }

EventService.Events = {
	LuckyStorm = { Title = "🍀 LUCKY STORM", Description = "2x luck for everyone!", Color = Color3.fromRGB(90, 255, 120) },
	GoldenHour = { Title = "⭐ GOLDEN HOUR", Description = "3x mutation chance!", Color = Color3.fromRGB(255, 210, 60) },
	SlimeFrenzy = { Title = "⚡ SLIME FRENZY", Description = "Slimes spawn way faster!", Color = Color3.fromRGB(90, 220, 255) },
	CashParty = { Title = "🎉 CASH PARTY", Description = "2x cash for everyone!", Color = Color3.fromRGB(255, 120, 220) },
	MoneyRain = { Title = "💸 MONEY RAIN", Description = "Grab the falling coins!", Color = Color3.fromRGB(120, 255, 160) },
} :: { [string]: EventDef }

local EVENT_ORDER = { "LuckyStorm", "GoldenHour", "SlimeFrenzy", "CashParty", "MoneyRain" }

local serverLuckUntil = 0
local adminLuck = 1
local adminLuckUntil = 0
local current: { Name: string, EndsAt: number }? = nil
local coinsFolder: Folder

local function now(): number
	return workspace:GetServerTimeNow()
end

local function isActive(name: string): boolean
	return current ~= nil and current.Name == name and current.EndsAt > now()
end

function EventService.GetLuck(): number
	local luck = 1
	if serverLuckUntil > now() then
		luck *= Config.ServerLuck.Multiplier
	end
	if isActive("LuckyStorm") then
		luck *= Config.Events.LuckMultiplier
	end
	if adminLuckUntil > now() then
		luck *= adminLuck
	end
	return luck
end

function EventService.GetMutationLuck(): number
	return if isActive("GoldenHour") then Config.Events.MutationMultiplier else 1
end

function EventService.GetSpawnRateMultiplier(): number
	return if isActive("SlimeFrenzy") then Config.Events.FrenzySpawnMultiplier else 1
end

function EventService.GetCashMultiplier(): number
	return if isActive("CashParty") then 2 else 1
end

local function publishLuck()
	workspace:SetAttribute("Luck", EventService.GetLuck())
end

function EventService.AddServerLuck(seconds: number, buyer: Player?)
	local t = now()
	serverLuckUntil = math.min(math.max(serverLuckUntil, t) + seconds, t + Config.ServerLuck.MaxStackSeconds)
	workspace:SetAttribute("ServerLuckEndsAt", serverLuckUntil)
	publishLuck()
	if buyer then
		Net.Announce(("🍀 %s activated SERVER LUCK x%d for everyone!"):format(buyer.DisplayName, Config.ServerLuck.Multiplier), Color3.fromRGB(90, 255, 120), 5)
		Net.EffectAll("Confetti", {})
	end
end

function EventService.SetAdminLuck(multiplier: number, seconds: number)
	adminLuck = math.max(1, multiplier)
	adminLuckUntil = now() + seconds
	workspace:SetAttribute("AdminLuck", adminLuck)
	workspace:SetAttribute("AdminLuckEndsAt", adminLuckUntil)
	publishLuck()
	Net.Announce(("👑 ADMIN LUCK x%s for %s!"):format(tostring(adminLuck), Format.Duration(seconds)), Color3.fromRGB(255, 120, 220), 5)
end

-- ---------------------------------------------------------------------
-- Lluvia de dinero
-- ---------------------------------------------------------------------
local function spawnCoin()
	local rng = Random.new()
	local x = rng:NextNumber(Layout.RunwayStart.X + 10, Layout.RunwayEnd.X - 10)
	local z = rng:NextNumber(-17, 17)
	if math.abs(z) < Layout.RunwayWidth / 2 + 1 then
		z = (if z < 0 then -1 else 1) * (Layout.RunwayWidth / 2 + rng:NextNumber(2, 8))
	end
	local target = CFrame.new(x, 3, z)
	local coin = Instance.new("Part")
	coin.Name = "Coin"
	coin.Shape = Enum.PartType.Cylinder
	coin.Size = Vector3.new(0.5, 3, 3)
	coin.Color = Color3.fromRGB(255, 205, 40)
	coin.Material = Enum.Material.Metal
	coin.Reflectance = 0.2
	coin.Anchored = true
	coin.CanCollide = false
	coin.CFrame = target + Vector3.new(0, 45, 0)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 210, 80)
	light.Range = 8
	light.Brightness = 1.5
	light.Parent = coin
	CollectionService:AddTag(coin, "Coin")
	coin.Parent = coinsFolder
	TweenService:Create(coin, TweenInfo.new(1.6, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out), { CFrame = target }):Play()

	local taken = false
	coin.Touched:Connect(function(hit)
		if taken then
			return
		end
		local model = hit:FindFirstAncestorOfClass("Model")
		local player = model and Players:GetPlayerFromCharacter(model)
		if not player or not Registry.DataService.Get(player) then
			return
		end
		taken = true
		local amount = Economy.ScaleReward(250, Registry.SlimeService.GetIncomePerSecond(player), 20)
		Registry.DataService.AddCash(player, amount)
		Net.Effect(player, "Collect", { Amount = amount, Position = coin.Position })
		coin:Destroy()
	end)
end

local function moneyRain(duration: number)
	local count = Config.Events.MoneyRainCoins
	local interval = (duration * 0.8) / count
	for _ = 1, count do
		if not isActive("MoneyRain") then
			break
		end
		spawnCoin()
		task.wait(interval)
	end
end

-- ---------------------------------------------------------------------
-- Eventos
-- ---------------------------------------------------------------------
function EventService.StartEvent(name: string, duration: number?)
	local def = EventService.Events[name]
	if not def then
		return false
	end
	if current then
		EventService.EndEvent()
	end
	local length = duration or Config.Events.Duration
	local endsAt = now() + length
	current = { Name = name, EndsAt = endsAt }
	workspace:SetAttribute("EventName", name)
	workspace:SetAttribute("EventTitle", def.Title)
	workspace:SetAttribute("EventEndsAt", endsAt)
	publishLuck()
	Net.Announce(def.Title .. " — " .. def.Description, def.Color, 6)
	Net.EffectAll("Sound", { Name = "Announce" })
	if name == "CashParty" then
		Registry.SlimeService.InvalidateAll()
	elseif name == "MoneyRain" then
		task.spawn(moneyRain, length)
	end
	task.delay(length, function()
		if current and current.Name == name and current.EndsAt == endsAt then
			EventService.EndEvent()
		end
	end)
	return true
end

function EventService.EndEvent()
	if not current then
		return
	end
	local name = current.Name
	current = nil
	workspace:SetAttribute("EventName", nil)
	workspace:SetAttribute("EventTitle", nil)
	workspace:SetAttribute("EventEndsAt", nil)
	publishLuck()
	if name == "CashParty" then
		Registry.SlimeService.InvalidateAll()
	end
	if name == "MoneyRain" then
		coinsFolder:ClearAllChildren()
	end
end

function EventService.GetEventNames(): { string }
	return EVENT_ORDER
end

function EventService.Start()
	coinsFolder = Instance.new("Folder")
	coinsFolder.Name = "Coins"
	coinsFolder.Parent = workspace:WaitForChild("Effects")
	publishLuck()

	task.spawn(function()
		task.wait(Config.Events.FirstDelay)
		local lastName = nil
		while true do
			local name
			repeat
				name = EVENT_ORDER[math.random(1, #EVENT_ORDER)]
			until name ~= lastName or #EVENT_ORDER == 1
			lastName = name
			if not current then
				EventService.StartEvent(name)
			end
			task.wait(Config.Events.Interval)
		end
	end)

	-- Mantiene el atributo de suerte actualizado cuando caducan los boosts
	task.spawn(function()
		while true do
			task.wait(5)
			publishLuck()
		end
	end)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- Clasificaciones globales (OrderedDataStore) mostradas en los tablones del mapa.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)

local LeaderboardService = {}

local REFRESH_INTERVAL = 120

type Board = {
	Name: string,
	Store: OrderedDataStore?,
	GetScore: (data: any) -> number,
	FormatValue: (stored: number) -> string,
}

local boards: { Board } = {
	{
		Name = "TopEarned",
		Store = nil,
		GetScore = function(data)
			return Economy.EncodeScore(data.TotalEarned)
		end,
		FormatValue = function(stored)
			return Format.Money(Economy.DecodeScore(stored))
		end,
	},
	{
		Name = "TopRebirths",
		Store = nil,
		GetScore = function(data)
			return data.Rebirths
		end,
		FormatValue = function(stored)
			return tostring(stored)
		end,
	},
	{
		Name = "TopSteals",
		Store = nil,
		GetScore = function(data)
			return data.Stats.Steals
		end,
		FormatValue = function(stored)
			return Format.Abbreviate(stored)
		end,
	},
}

local nameCache: { [number]: string } = {}

local function getName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and name then name else "Player"
	nameCache[userId] = result
	return result
end

local function setRow(boardName: string, rank: number, text: string)
	local gui = Registry.MapService.Boards[boardName]
	local row = gui and gui:FindFirstChild("Row" .. rank)
	if row and row:IsA("TextLabel") then
		row.Text = text
	end
end

function LeaderboardService.Submit(player: Player)
	local data = Registry.DataService.Get(player)
	if not data or player.UserId <= 0 then
		return
	end
	for _, board in boards do
		if board.Store then
			local score = math.floor(board.GetScore(data))
			if score > 0 then
				pcall(function()
					(board.Store :: OrderedDataStore):SetAsync(tostring(player.UserId), score)
				end)
			end
		end
	end
end

function LeaderboardService.Refresh()
	for _, board in boards do
		if board.Store then
			local ok, pages = pcall(function()
				return (board.Store :: OrderedDataStore):GetSortedAsync(false, 10)
			end)
			if ok and pages then
				local entries = pages:GetCurrentPage()
				for rank = 1, 10 do
					local entry = entries[rank]
					if entry then
						local userId = tonumber(entry.key) or 0
						setRow(board.Name, rank, ("  #%d  %s  •  %s"):format(rank, getName(userId), board.FormatValue(entry.value)))
					else
						setRow(board.Name, rank, ("  #%d  ---"):format(rank))
					end
				end
			end
		end
	end
end

function LeaderboardService.Start()
	if not Registry.DataService.IsPersistent() then
		for _, board in boards do
			setRow(board.Name, 1, "  Publish the game to")
			setRow(board.Name, 2, "  enable leaderboards")
		end
		return
	end
	for _, board in boards do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(Config.LeaderboardStorePrefix .. board.Name)
		end)
		if ok then
			board.Store = store
		end
	end
	task.spawn(function()
		task.wait(10)
		while true do
			for _, player in Players:GetPlayers() do
				LeaderboardService.Submit(player)
			end
			LeaderboardService.Refresh()
			task.wait(REFRESH_INTERVAL)
		end
	end)
end

function LeaderboardService.OnPlayerRemoving(player: Player)
	if Registry.DataService.IsPersistent() then
		LeaderboardService.Submit(player)
	end
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[-- Genera el mundo por código: suelo, pasarela, portal, decoración, tablones e iluminación.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(script.Parent.Parent.Layout)

local MapService = {}

MapService.Folder = nil :: Folder?
MapService.Boards = {} :: { [string]: SurfaceGui }

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(95, 95, 110)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 155)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(200, 220, 255)
	atmosphere.Decay = Color3.fromRGB(120, 150, 200)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 26
	bloom.Threshold = 1.6
	bloom.Parent = Lighting

	local color = Instance.new("ColorCorrectionEffect")
	color.Saturation = 0.18
	color.Contrast = 0.06
	color.Brightness = 0.02
	color.Parent = Lighting

	local sunRays = Instance.new("SunRaysEffect")
	sunRays.Intensity = 0.06
	sunRays.Spread = 0.6
	sunRays.Parent = Lighting
end

local function buildTree(parent: Instance, position: Vector3, scale: number)
	local model = Instance.new("Model")
	model.Name = "Tree"
	local trunk = part({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(8 * scale, 2.2 * scale, 2.2 * scale),
		CFrame = CFrame.new(position + Vector3.new(0, 4 * scale, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(120, 80, 50),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	local leafColors = { Color3.fromRGB(70, 170, 70), Color3.fromRGB(90, 190, 80), Color3.fromRGB(60, 150, 65) }
	for i, offset in { Vector3.new(0, 9, 0), Vector3.new(2.2, 7.5, 1), Vector3.new(-2, 7.8, -1.2), Vector3.new(0.5, 11, -0.5) } do
		part({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (6.5 - i * 0.6) * scale,
			CFrame = CFrame.new(position + offset * scale),
			Color = leafColors[(i % #leafColors) + 1],
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = model,
		})
	end
	model.PrimaryPart = trunk
	model.Parent = parent
end

local function buildPortal(parent: Instance)
	local folder = Instance.new("Model")
	folder.Name = "Portal"
	local center = Layout.PortalPosition + Vector3.new(0, 11, 0)
	local radius = 10
	local count = 22
	for i = 0, count - 1 do
		local angle = (i / count) * math.pi * 2
		local offset = Vector3.new(0, math.sin(angle) * radius, math.cos(angle) * radius)
		local color = Color3.fromHSV(i / count, 0.7, 1)
		part({
			Name = "Ring",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 2.4,
			CFrame = CFrame.new(center + offset),
			Color = color,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
	end
	local core = part({
		Name = "Core",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, radius * 2 - 1, radius * 2 - 1),
		CFrame = CFrame.new(center),
		Color = Color3.fromRGB(150, 90, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.45,
		CanCollide = false,
		Parent = folder,
	})
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(Color3.fromRGB(200, 150, 255), Color3.fromRGB(120, 255, 255))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
	emitter.Lifetime = NumberRange.new(1, 2)
	emitter.Rate = 25
	emitter.Speed = NumberRange.new(3, 6)
	emitter.SpreadAngle = Vector2.new(30, 30)
	emitter.LightEmission = 1
	emitter.EmissionDirection = Enum.NormalId.Right
	emitter.Parent = core
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(170, 120, 255)
	light.Range = 30
	light.Brightness = 2
	light.Parent = core

	-- Cartel con el nombre del juego
	local sign = part({
		Name = "TitleSign",
		Size = Vector3.new(1, 8, 34),
		CFrame = CFrame.new(center + Vector3.new(-2, radius + 7, 0)),
		Transparency = 1,
		CanCollide = false,
		Parent = folder,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Right
	gui.LightInfluence = 0
	gui.PixelsPerStud = 40
	gui.Parent = sign
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.fromScale(1, 1)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.Text = string.upper(Config.GameName)
	title.TextColor3 = Color3.fromRGB(140, 255, 120)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 6
	stroke.Color = Color3.fromRGB(20, 60, 20)
	stroke.Parent = title
	title.Parent = gui
	folder.Parent = parent
end

local function buildBoard(parent: Instance, name: string, title: string, position: Vector3, lookAt: Vector3, color: Color3)
	local board = part({
		Name = name,
		Size = Vector3.new(16, 22, 1),
		CFrame = CFrame.lookAt(position + Vector3.new(0, 12, 0), lookAt + Vector3.new(0, 12, 0)),
		Color = Color3.fromRGB(30, 32, 48),
		Parent = parent,
	})
	part({
		Name = "Frame",
		Size = Vector3.new(17, 23, 0.8),
		CFrame = board.CFrame * CFrame.new(0, 0, 0.3),
		Color = color,
		Material = Enum.Material.Neon,
		Parent = parent,
	})
	for _, side in { -1, 1 } do
		part({
			Name = "Leg",
			Size = Vector3.new(1, 2, 1),
			CFrame = board.CFrame * CFrame.new(side * 6, -12, 0),
			Color = Color3.fromRGB(30, 32, 48),
			Parent = parent,
		})
	end

	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.PixelsPerStud = 30
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.Parent = board

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = gui

	local header = Instance.new("TextLabel")
	header.Name = "Header"
	header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, -20, 0, 70)
	header.Font = Enum.Font.FredokaOne
	header.TextScaled = true
	header.Text = title
	header.TextColor3 = color
	header.LayoutOrder = 0
	local headerStroke = Instance.new("UIStroke")
	headerStroke.Thickness = 3
	headerStroke.Parent = header
	header.Parent = gui

	for rank = 1, 10 do
		local row = Instance.new("TextLabel")
		row.Name = "Row" .. rank
		row.BackgroundColor3 = if rank % 2 == 0 then Color3.fromRGB(40, 44, 64) else Color3.fromRGB(48, 52, 74)
		row.BackgroundTransparency = 0.1
		row.Size = UDim2.new(1, -24, 0, 50)
		row.Font = Enum.Font.FredokaOne
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = if rank == 1 then Color3.fromRGB(255, 215, 60) elseif rank == 2 then Color3.fromRGB(220, 220, 230) elseif rank == 3 then Color3.fromRGB(230, 150, 90) else Color3.fromRGB(240, 240, 255)
		row.Text = ("  #%d  ---"):format(rank)
		row.LayoutOrder = rank
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = row
		local padding = Instance.new("UIPadding")
		padding.PaddingTop = UDim.new(0, 6)
		padding.PaddingBottom = UDim.new(0, 6)
		padding.Parent = row
		row.Parent = gui
	end

	MapService.Boards[name] = gui
end

function MapService.Build()
	local map = Instance.new("Folder")
	map.Name = "Map"
	MapService.Folder = map

	-- Suelo
	part({ Name = "Ground", Size = Vector3.new(520, 4, 340), CFrame = CFrame.new(0, -2, 0), Color = Color3.fromRGB(95, 180, 80), Material = Enum.Material.Grass, Parent = map })
	part({ Name = "Plaza", Size = Vector3.new(380, 0.2, 40), CFrame = CFrame.new(0, 0.1, 0), Color = Color3.fromRGB(225, 215, 190), Material = Enum.Material.Concrete, Parent = map })
	part({ Name = "SpawnPlaza", Size = Vector3.new(60, 0.2, 90), CFrame = CFrame.new(Layout.SpawnPosition.X - 8, 0.1, 0), Color = Color3.fromRGB(225, 215, 190), Material = Enum.Material.Concrete, Parent = map })

	-- Pasarela
	local runwayLength = (Layout.RunwayEnd - Layout.RunwayStart).Magnitude + 8
	local runwayCenter = (Layout.RunwayStart + Layout.RunwayEnd) / 2
	part({ Name = "Runway", Size = Vector3.new(runwayLength, 1, Layout.RunwayWidth), CFrame = CFrame.new(runwayCenter.X, 0.5, runwayCenter.Z), Color = Color3.fromRGB(45, 45, 62), Parent = map })
	for _, side in { -1, 1 } do
		part({
			Name = "RunwayEdge",
			Size = Vector3.new(runwayLength, 1.3, 0.8),
			CFrame = CFrame.new(runwayCenter.X, 0.65, side * (Layout.RunwayWidth / 2 + 0.4)),
			Color = if side < 0 then Color3.fromRGB(255, 80, 200) else Color3.fromRGB(80, 220, 255),
			Material = Enum.Material.Neon,
			Parent = map,
		})
	end
	-- Flechas (chevrons) en la pasarela
	local x = Layout.RunwayStart.X + 10
	while x < Layout.RunwayEnd.X - 4 do
		for _, side in { -1, 1 } do
			part({
				Name = "Chevron",
				Size = Vector3.new(0.6, 0.12, 5),
				CFrame = CFrame.new(x, 1.04, side * 1.6) * CFrame.Angles(0, side * math.rad(-40), 0),
				Color = Color3.fromRGB(255, 255, 255),
				Material = Enum.Material.Neon,
				Transparency = 0.55,
				CanCollide = false,
				Parent = map,
			})
		end
		x += 14
	end
	-- Final de la pasarela
	part({
		Name = "Drain",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.2, 14, 14),
		CFrame = CFrame.new(Layout.RunwayEnd.X + 4, 0.6, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(20, 20, 30),
		Material = Enum.Material.Neon,
		Parent = map,
	})

	buildPortal(map)

	-- Spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SpawnLocation"
	spawn.Anchored = true
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.CFrame = CFrame.new(Layout.SpawnPosition.X, 0.5, 0)
	spawn.Color = Color3.fromRGB(120, 255, 140)
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.3
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = map

	-- Tablones de clasificación
	local boards = Instance.new("Folder")
	boards.Name = "Leaderboards"
	boards.Parent = map
	local boardX = Layout.SpawnPosition.X - 26
	buildBoard(boards, "TopEarned", "💰 TOP EARNERS", Vector3.new(boardX, 0, -24), Vector3.new(0, 0, -24), Color3.fromRGB(90, 255, 120))
	buildBoard(boards, "TopRebirths", "♻️ TOP REBIRTHS", Vector3.new(boardX, 0, 24), Vector3.new(0, 0, 24), Color3.fromRGB(255, 200, 60))
	buildBoard(boards, "TopSteals", "😈 TOP THIEVES", Vector3.new(boardX - 4, 0, 0), Vector3.new(0, 0, 0), Color3.fromRGB(255, 90, 110))

	-- Árboles decorativos
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = map
	local rng = Random.new(42)
	for i = 1, 26 do
		local side = if i % 2 == 0 then 1 else -1
		local tx = -230 + (i / 26) * 460 + rng:NextNumber(-6, 6)
		local tz = side * rng:NextNumber(110, 150)
		buildTree(decor, Vector3.new(tx, 0, tz), rng:NextNumber(0.9, 1.4))
	end
	for i = 1, 8 do
		local tz = -140 + i * 31
		buildTree(decor, Vector3.new(235 + rng:NextNumber(-8, 8), 0, tz), rng:NextNumber(0.9, 1.4))
		buildTree(decor, Vector3.new(-245 + rng:NextNumber(-6, 6), 0, tz), rng:NextNumber(0.9, 1.4))
	end

	-- Muros invisibles en el borde del mapa
	for _, wall in {
		{ Vector3.new(0, 50, -168), Vector3.new(520, 100, 2) },
		{ Vector3.new(0, 50, 168), Vector3.new(520, 100, 2) },
		{ Vector3.new(-258, 50, 0), Vector3.new(2, 100, 340) },
		{ Vector3.new(258, 50, 0), Vector3.new(2, 100, 340) },
	} do
		part({ Name = "Boundary", Size = wall[2], CFrame = CFrame.new(wall[1]), Transparency = 1, CanCollide = true, Parent = map })
	end

	local plots = Instance.new("Folder")
	plots.Name = "Plots"
	plots.Parent = map

	local slimes = Instance.new("Folder")
	slimes.Name = "Slimes"
	slimes.Parent = workspace

	local effects = Instance.new("Folder")
	effects.Name = "Effects"
	effects.Parent = workspace

	map.Parent = workspace
	setupLighting()
	return map
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[-- Game Passes y Developer Products (Robux).
-- ProcessReceipt es idempotente: cada compra se registra en los datos del jugador.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Products = require(Shared.Products)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)
local Actions = require(script.Parent.Parent.Actions)
local Net = require(script.Parent.Parent.Net)

local MonetizationService = {}

local owned: { [Player]: { [string]: boolean } } = {}
local EMPTY = table.freeze({})

local function applyPassEffects(player: Player, key: string)
	if key == "DoubleCash" or key == "VIP" then
		Registry.SlimeService.InvalidateMultiplier(player)
	end
	if key == "VIP" then
		Registry.PlayerService.UpdateOverhead(player)
	end
	if key == "ExtraSlots" then
		Registry.SlimeService.RefreshAll(player)
	end
	if key == "SpeedBoost" then
		Registry.PlayerService.UpdateWalkSpeed(player)
	end
	if key == "GalaxyBat" then
		local data = Registry.DataService.Get(player)
		if data then
			data.EquippedBat = "Galaxy"
		end
		Registry.CombatService.GiveBat(player)
	end
	Registry.DataService.MarkDirty(player)
end

function MonetizationService.GrantPass(player: Player, key: string, announce: boolean)
	local def = Products.GamePasses[key]
	if not def then
		return
	end
	owned[player] = owned[player] or {}
	if owned[player][key] then
		return
	end
	owned[player][key] = true
	applyPassEffects(player, key)
	if announce then
		Net.Announce(("⭐ %s bought %s %s!"):format(player.DisplayName, def.Icon, def.Name), Color3.fromRGB(255, 215, 70), 4)
		Net.Effect(player, "Confetti", {})
	end
end

-- Aplica un Developer Product. Devuelve ok y mensaje.
function MonetizationService.ApplyProduct(player: Player, key: string): (boolean, string?)
	local def = Products.DevProducts[key]
	local data = Registry.DataService.Get(player)
	if not def or not data then
		return false, "Invalid product"
	end
	if def.Kind == "Cash" then
		local amount = Economy.ScaleReward(def.Minimum, Registry.SlimeService.GetIncomePerSecond(player), def.Seconds)
		Registry.DataService.AddCash(player, amount)
		Net.Effect(player, "Confetti", {})
		Net.Effect(player, "Sound", { Name = "Cash" })
		return true, "+" .. Format.Money(amount)
	elseif def.Kind == "ServerLuck" then
		Registry.EventService.AddServerLuck(def.Seconds, player)
		return true, "Server Luck activated!"
	elseif def.Kind == "Boost" then
		data.Boosts.CashX2 = (data.Boosts.CashX2 or 0) + def.Seconds
		player:SetAttribute("BoostCashX2", data.Boosts.CashX2)
		Registry.SlimeService.InvalidateMultiplier(player)
		return true, "2x Cash boost active!"
	elseif def.Kind == "Summon" then
		local given, slimeId = Registry.SlimeService.GiveRandomOfRarity(player, def.Rarity, 2)
		if given then
			Net.Announce(("%s %s summoned a %s slime!"):format(def.Icon, player.DisplayName, string.upper(def.Rarity)), Color3.fromRGB(255, 120, 220), 5)
		end
		local _ = slimeId
		return true, "Your slime is on its way!"
	elseif def.Kind == "InstantLock" then
		Registry.PlotService.TryLock(player, true)
		return true, "Base locked!"
	end
	return false, "Unknown product"
end

local function processReceipt(receiptInfo): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = Registry.DataService.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local receiptKey = tostring(receiptInfo.PurchaseId)
	if Registry.DataService.HasReceipt(player, receiptKey) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local def = Products.FindProductById(receiptInfo.ProductId)
	if not def then
		warn("[Monetization] Producto desconocido: " .. tostring(receiptInfo.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, success, message = pcall(MonetizationService.ApplyProduct, player, def.Key)
	if not ok or not success then
		warn("[Monetization] Error aplicando " .. def.Key .. ": " .. tostring(if ok then message else success))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Registry.DataService.AddReceipt(player, receiptKey)
	Registry.DataService.MarkDirty(player)
	task.spawn(Registry.DataService.Save, player, false)
	Net.Notify(player, ("💎 Thanks! %s %s"):format(def.Name, message or ""), "Success")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.Init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local def = Products.FindPassById(passId)
		if def then
			MonetizationService.GrantPass(player, def.Key, true)
		end
	end)

	Actions.Register("SimulatePurchase", function(player, payload)
		if not (RunService:IsStudio() and Config.SimulatePurchasesInStudio) then
			return false, "Purchases are not configured yet"
		end
		local key = tostring(payload.Key)
		if payload.Kind == "Pass" then
			local def = Products.GamePasses[key]
			if not def then
				return false, "Invalid pass"
			end
			MonetizationService.GrantPass(player, key, true)
			return true, "[Studio] Simulated pass: " .. def.Name
		elseif payload.Kind == "Product" then
			local ok, message = MonetizationService.ApplyProduct(player, key)
			return ok, "[Studio] " .. tostring(message)
		end
		return false, "Invalid purchase"
	end)
end

-- Carga los passes del jugador (en paralelo para no retrasar la entrada)
function MonetizationService.LoadPlayer(player: Player)
	owned[player] = owned[player] or {}
	local pending = 0
	for key, def in Products.GamePasses do
		if def.Id ~= 0 then
			pending += 1
			task.spawn(function()
				local ok, has = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.Id)
				end)
				if ok and has and owned[player] then
					owned[player][key] = true
				end
				pending -= 1
			end)
		end
	end
	local started = os.clock()
	while pending > 0 and os.clock() - started < 10 do
		task.wait(0.1)
	end
end

function MonetizationService.OnPlayerRemoving(player: Player)
	owned[player] = nil
end

function MonetizationService.GetOwnedPasses(player: Player): { [string]: boolean }
	return owned[player] or EMPTY :: any
end

function MonetizationService.OwnsPass(player: Player, key: string): boolean
	local passes = owned[player]
	return passes ~= nil and passes[key] == true
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source"><![CDATA[-- Personajes: aparecer en tu base, velocidad, etiqueta sobre la cabeza,
-- bonus de amigos/grupo y teletransporte a casa.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)

local Registry = require(script.Parent.Parent.Registry)
local Actions = require(script.Parent.Parent.Actions)
local Net = require(script.Parent.Parent.Net)

local PlayerService = {}

local friendCounts: { [Player]: number } = {}
local friendPairs: { [Player]: { [Player]: boolean } } = {}
local groupMembers: { [Player]: boolean } = {}
local homeCooldown: { [Player]: number } = {}

-- ---------------------------------------------------------------------
-- Personaje
-- ---------------------------------------------------------------------
function PlayerService.TeleportHome(player: Player): boolean
	local plot = Registry.PlotService.GetPlot(player)
	local character = player.Character
	if not plot or not character or not character:FindFirstChild("HumanoidRootPart") then
		return false
	end
	character:PivotTo(plot.SpawnCFrame)
	return true
end

function PlayerService.UpdateWalkSpeed(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local data = Registry.DataService.Get(player)
	if not humanoid or not data then
		return
	end
	local speed = Economy.GetWalkSpeed(data.Upgrades.Speed or 0, Registry.MonetizationService.OwnsPass(player, "SpeedBoost"))
	if Registry.StealService.IsCarrying(player) then
		speed *= Config.Steal.CarrySpeedMultiplier
	end
	humanoid.WalkSpeed = speed
end

function PlayerService.UpdateOverhead(player: Player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local data = Registry.DataService.Get(player)
	if not head or not data then
		return
	end
	local existing = head:FindFirstChild("Overhead")
	if existing then
		existing:Destroy()
	end
	local isVip = Registry.MonetizationService.OwnsPass(player, "VIP")
	if not isVip and data.Rebirths <= 0 then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Overhead"
	gui.Size = UDim2.new(6, 0, 0.9, 0)
	gui.StudsOffset = Vector3.new(0, 3.2, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 70
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	local parts = {}
	if isVip then
		table.insert(parts, "⭐ VIP")
	end
	if data.Rebirths > 0 then
		table.insert(parts, "♻️ " .. data.Rebirths)
	end
	label.Text = table.concat(parts, "  ")
	label.TextColor3 = if isVip then Color3.fromRGB(255, 215, 60) else Color3.fromRGB(150, 255, 170)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = head
end

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root then
		return
	end
	Registry.PlotService.ApplyOwnerCollision(player, character)
	task.wait(0.1)
	if player.Character ~= character then
		return
	end
	PlayerService.TeleportHome(player)
	Registry.CombatService.GiveBat(player)
	PlayerService.UpdateWalkSpeed(player)
	PlayerService.UpdateOverhead(player)
	humanoid.Died:Connect(function()
		Registry.StealService.OnDeath(player)
	end)
end

-- ---------------------------------------------------------------------
-- Amigos y grupo
-- ---------------------------------------------------------------------
function PlayerService.GetFriendCount(player: Player): number
	return friendCounts[player] or 0
end

function PlayerService.IsInGroup(player: Player): boolean
	return groupMembers[player] == true
end

local function checkFriends(player: Player)
	friendPairs[player] = friendPairs[player] or {}
	for _, other in Players:GetPlayers() do
		if other ~= player and friendPairs[other] and not friendPairs[player][other] then
			local ok, isFriend = pcall(function()
				return player:IsFriendsWith(other.UserId)
			end)
			if ok and isFriend and player.Parent and other.Parent then
				friendPairs[player][other] = true
				friendPairs[other][player] = true
				friendCounts[player] = (friendCounts[player] or 0) + 1
				friendCounts[other] = (friendCounts[other] or 0) + 1
				Registry.SlimeService.InvalidateMultiplier(other)
				Net.Notify(other, ("👋 Your friend %s joined! +%d%% cash"):format(player.DisplayName, math.floor(Config.Income.FriendBonus * 100)), "Success")
			end
		end
	end
	Registry.SlimeService.InvalidateMultiplier(player)
end

-- ---------------------------------------------------------------------
-- Ciclo de vida
-- ---------------------------------------------------------------------
function PlayerService.Init()
	Actions.Register("Home", function(player)
		if Registry.StealService.IsCarrying(player) then
			return false, "You can't teleport while carrying a slime!"
		end
		local now = os.clock()
		if (homeCooldown[player] or 0) > now then
			return false, "Wait a moment..."
		end
		homeCooldown[player] = now + 3
		return PlayerService.TeleportHome(player), nil
	end)

	Actions.Register("RequestSync", function(player)
		Registry.DataService.MarkDirty(player)
		return true
	end)
end

function PlayerService.SetupPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end

	task.spawn(checkFriends, player)
	if Config.GroupId > 0 then
		task.spawn(function()
			local ok, inGroup = pcall(function()
				return player:IsInGroup(Config.GroupId)
			end)
			if ok and inGroup then
				groupMembers[player] = true
				Registry.SlimeService.InvalidateMultiplier(player)
			end
		end)
	end
end

function PlayerService.OnPlayerRemoving(player: Player)
	local friends = friendPairs[player]
	if friends then
		for other in friends do
			if friendPairs[other] then
				friendPairs[other][player] = nil
				friendCounts[other] = math.max(0, (friendCounts[other] or 1) - 1)
				Registry.SlimeService.InvalidateMultiplier(other)
			end
		end
	end
	friendPairs[player] = nil
	friendCounts[player] = nil
	groupMembers[player] = nil
	homeCooldown[player] = nil
end

return PlayerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[-- Bases de los jugadores: construcción, asignación, pedestales, candado y barrera.

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Economy = require(Shared.Economy)

local Registry = require(script.Parent.Parent.Registry)
local Layout = require(script.Parent.Parent.Layout)
local Net = require(script.Parent.Parent.Net)

local PlotService = {}

export type Slot = {
	Index: number,
	CFrame: CFrame,
	Pedestal: Part,
	Glow: Part,
	Pad: Part,
	PadGui: BillboardGui,
	PadLabel: TextLabel,
	LockGui: SurfaceGui,
	Unlocked: boolean,
	LastText: string,
}

export type Plot = {
	Index: number,
	CFrame: CFrame,
	Model: Model,
	Floor: Part,
	Barrier: Part,
	LockPad: Part,
	LockLabel: TextLabel,
	SignName: TextLabel,
	SignIncome: TextLabel,
	SignAvatar: ImageLabel,
	SpawnCFrame: CFrame,
	Owner: Player?,
	LockedUntil: number,
	CooldownUntil: number,
	Slots: { Slot },
	LastLockText: string,
}

local W = Config.Plots.Width
local D = Config.Plots.Depth
local FLOOR_COLORS = {
	Color3.fromRGB(255, 205, 205),
	Color3.fromRGB(200, 228, 255),
	Color3.fromRGB(210, 255, 210),
	Color3.fromRGB(255, 240, 190),
	Color3.fromRGB(232, 212, 255),
	Color3.fromRGB(255, 222, 175),
	Color3.fromRGB(190, 255, 240),
	Color3.fromRGB(255, 208, 236),
}
local EMPTY_GLOW = Color3.fromRGB(120, 125, 140)
local PAD_COLOR = Color3.fromRGB(70, 255, 120)

local plots: { Plot } = {}
local playerPlots: { [Player]: Plot } = {}
local touchDebounce: { [string]: number } = {}

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function label(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = Color3.fromRGB(255, 255, 255)
	for key, value in props do
		(l :: any)[key] = value
	end
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(15, 15, 25)
	stroke.Parent = l
	l.Parent = parent
	return l
end

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	if not model then
		return nil
	end
	return Players:GetPlayerFromCharacter(model)
end

local function debounce(key: string, seconds: number): boolean
	local now = os.clock()
	if (touchDebounce[key] or 0) > now then
		return false
	end
	touchDebounce[key] = now + seconds
	return true
end

-- ---------------------------------------------------------------------
-- Construcción
-- ---------------------------------------------------------------------
local function buildSlot(plot: Plot, index: number, offset: Vector3): Slot
	local cf = plot.CFrame
	local model = plot.Model
	local pedestal = part({
		Name = "Pedestal" .. index,
		Size = Vector3.new(7, 1.2, 6),
		CFrame = cf * CFrame.new(offset.X, Layout.FloorHeight + 0.6, offset.Z),
		Color = Color3.fromRGB(60, 64, 82),
		Parent = model,
	})
	local glow = part({
		Name = "Glow" .. index,
		Size = Vector3.new(7.4, 0.3, 6.4),
		CFrame = cf * CFrame.new(offset.X, Layout.FloorHeight + 0.15, offset.Z),
		Color = EMPTY_GLOW,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
	local pad = part({
		Name = "CollectPad" .. index,
		Size = Vector3.new(5, 0.3, 2.4),
		CFrame = cf * CFrame.new(offset.X, Layout.FloorHeight + 0.15, offset.Z - 4.6),
		Color = PAD_COLOR,
		Material = Enum.Material.Neon,
		Transparency = 0.2,
		CanCollide = false,
		Parent = model,
	})
	pad:SetAttribute("Slot", index)

	local padGui = Instance.new("BillboardGui")
	padGui.Name = "Stored"
	padGui.Size = UDim2.new(5, 0, 1.3, 0)
	padGui.StudsOffset = Vector3.new(0, 1.3, 0)
	padGui.LightInfluence = 0
	padGui.MaxDistance = 55
	padGui.Parent = pad
	local padLabel = label(padGui, { Name = "Amount", Size = UDim2.fromScale(1, 1), Text = "", TextColor3 = Color3.fromRGB(120, 255, 140) })

	local lockGui = Instance.new("SurfaceGui")
	lockGui.Name = "Locked"
	lockGui.Face = Enum.NormalId.Top
	lockGui.LightInfluence = 0
	lockGui.CanvasSize = Vector2.new(140, 120)
	lockGui.Parent = pedestal
	label(lockGui, { Name = "Text", Size = UDim2.fromScale(1, 1), Text = "🔒\nREBIRTH", TextColor3 = Color3.fromRGB(230, 230, 240) })

	return {
		Index = index,
		CFrame = cf * CFrame.new(offset.X, Layout.PedestalTop, offset.Z),
		Pedestal = pedestal,
		Glow = glow,
		Pad = pad,
		PadGui = padGui,
		PadLabel = padLabel,
		LockGui = lockGui,
		Unlocked = true,
		LastText = "",
	}
end

local function buildPlot(index: number, cf: CFrame, parent: Instance): Plot
	local model = Instance.new("Model")
	model.Name = "Plot" .. index
	model:SetAttribute("PlotIndex", index)
	model:SetAttribute("OwnerUserId", 0)

	local wallH = Config.Plots.WallHeight
	local floorY = Layout.FloorHeight
	local wallColor = Color3.fromRGB(245, 245, 252)

	part({ Name = "Base", Size = Vector3.new(W + 2, 0.8, D + 2), CFrame = cf * CFrame.new(0, 0.4, 0), Color = Color3.fromRGB(70, 74, 95), Parent = model })
	local floor = part({ Name = "Floor", Size = Vector3.new(W, 1, D), CFrame = cf * CFrame.new(0, 0.5, 0), Color = FLOOR_COLORS[((index - 1) % #FLOOR_COLORS) + 1], Parent = model })
	model.PrimaryPart = floor

	-- Muros bajos (decorativos: la protección real es la barrera del candado)
	part({ Name = "Wall", Size = Vector3.new(W, wallH, 1), CFrame = cf * CFrame.new(0, floorY + wallH / 2, D / 2 - 0.5), Color = wallColor, Parent = model })
	for _, side in { -1, 1 } do
		part({ Name = "Wall", Size = Vector3.new(1, wallH, D), CFrame = cf * CFrame.new(side * (W / 2 - 0.5), floorY + wallH / 2, 0), Color = wallColor, Parent = model })
		local segment = W / 2 - 8
		part({ Name = "Wall", Size = Vector3.new(segment, wallH, 1), CFrame = cf * CFrame.new(side * (8 + segment / 2), floorY + wallH / 2, -D / 2 + 0.5), Color = wallColor, Parent = model })
		-- Columnas del arco de entrada
		part({ Name = "Pillar", Size = Vector3.new(2, 17, 2), CFrame = cf * CFrame.new(side * 9, floorY + 8.5, -D / 2 + 0.5), Color = Color3.fromRGB(60, 64, 82), Parent = model })
		for corner = -1, 1, 2 do
			part({ Name = "CornerPost", Size = Vector3.new(1.6, wallH + 1, 1.6), CFrame = cf * CFrame.new(side * (W / 2 - 0.5), floorY + (wallH + 1) / 2, corner * (D / 2 - 0.5)), Color = Color3.fromRGB(60, 64, 82), Parent = model })
		end
	end

	-- Cartel de la base
	local sign = part({ Name = "Sign", Size = Vector3.new(24, 7, 1), CFrame = cf * CFrame.new(0, floorY + 20.5, -D / 2 + 0.5), Color = Color3.fromRGB(35, 38, 56), Parent = model })
	part({ Name = "SignFrame", Size = Vector3.new(25, 8, 0.6), CFrame = sign.CFrame * CFrame.new(0, 0, 0.4), Color = FLOOR_COLORS[((index - 1) % #FLOOR_COLORS) + 1], Material = Enum.Material.Neon, Parent = model })
	local signGui = Instance.new("SurfaceGui")
	signGui.Name = "SignGui"
	signGui.Face = Enum.NormalId.Front
	signGui.LightInfluence = 0
	signGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	signGui.PixelsPerStud = 30
	signGui.Parent = sign
	local avatar = Instance.new("ImageLabel")
	avatar.Name = "Avatar"
	avatar.BackgroundColor3 = Color3.fromRGB(60, 64, 90)
	avatar.Size = UDim2.new(0, 170, 0, 170)
	avatar.Position = UDim2.new(0, 20, 0.5, -85)
	avatar.Image = ""
	local avatarCorner = Instance.new("UICorner")
	avatarCorner.CornerRadius = UDim.new(0.5, 0)
	avatarCorner.Parent = avatar
	avatar.Parent = signGui
	local signName = label(signGui, { Name = "OwnerName", Size = UDim2.new(1, -220, 0.55, 0), Position = UDim2.new(0, 205, 0.05, 0), Text = "EMPTY BASE", TextXAlignment = Enum.TextXAlignment.Left })
	local signIncome = label(signGui, { Name = "Income", Size = UDim2.new(1, -220, 0.35, 0), Position = UDim2.new(0, 205, 0.6, 0), Text = "", TextColor3 = Color3.fromRGB(110, 255, 130), TextXAlignment = Enum.TextXAlignment.Left })

	-- Botón del candado
	local lockPad = part({
		Name = "LockPad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 5, 5),
		CFrame = cf * CFrame.new(-W / 2 + 6, floorY + 0.25, -D / 2 + 6) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(255, 70, 70),
		Material = Enum.Material.Neon,
		Parent = model,
	})
	local lockGui = Instance.new("BillboardGui")
	lockGui.Name = "LockInfo"
	lockGui.Size = UDim2.new(7, 0, 1.6, 0)
	lockGui.StudsOffsetWorldSpace = Vector3.new(0, 3.5, 0)
	lockGui.LightInfluence = 0
	lockGui.MaxDistance = 80
	lockGui.Parent = lockPad
	local lockLabel = label(lockGui, { Name = "Status", Size = UDim2.fromScale(1, 1), Text = "🔓 STEP TO LOCK" })

	-- Barrera (visible solo con el candado activo)
	local barrier = part({
		Name = "Barrier",
		Size = Vector3.new(W + 1, 38, D + 1),
		CFrame = cf * CFrame.new(0, floorY + 19, 0),
		Color = Color3.fromRGB(255, 80, 80),
		Material = Enum.Material.ForceField,
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
		CollisionGroup = "Barrier" .. index,
		Parent = model,
	})

	local plot: Plot = {
		Index = index,
		CFrame = cf,
		Model = model,
		Floor = floor,
		Barrier = barrier,
		LockPad = lockPad,
		LockLabel = lockLabel,
		SignName = signName,
		SignIncome = signIncome,
		SignAvatar = avatar,
		SpawnCFrame = cf * CFrame.new(0, floorY + 3.5, -D / 2 + 9),
		Owner = nil,
		LockedUntil = 0,
		CooldownUntil = 0,
		Slots = {},
		LastLockText = "",
	}

	for slotIndex, offset in Layout.SlotOffsets do
		plot.Slots[slotIndex] = buildSlot(plot, slotIndex, offset)
	end

	-- Eventos de contacto
	lockPad.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if player and player == plot.Owner and debounce("lock" .. index, 1) then
			PlotService.TryLock(player, false)
		end
	end)
	for _, slot in plot.Slots do
		slot.Pad.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if player and player == plot.Owner and slot.Unlocked and debounce(("pad%d_%d"):format(index, slot.Index), 0.4) then
				Registry.SlimeService.CollectSlot(player, slot.Index)
			end
		end)
	end

	model.Parent = parent
	return plot
end

-- ---------------------------------------------------------------------
-- Ciclo de vida
-- ---------------------------------------------------------------------
function PlotService.Init()
	for i = 1, Config.Plots.Count do
		for _, groupName in { "Barrier" .. i, "Owner" .. i } do
			pcall(function()
				PhysicsService:RegisterCollisionGroup(groupName)
			end)
		end
		PhysicsService:CollisionGroupSetCollidable("Barrier" .. i, "Owner" .. i, false)
	end
end

function PlotService.Build(parent: Instance)
	for index, cf in Layout.PlotCFrames do
		if index > Config.Plots.Count then
			break
		end
		plots[index] = buildPlot(index, cf, parent)
		PlotService.ResetVisuals(plots[index])
	end
end

function PlotService.Start()
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.2 then
			return
		end
		elapsed = 0
		local now = workspace:GetServerTimeNow()
		for _, plot in plots do
			if plot.Owner then
				if plot.LockedUntil > 0 and now >= plot.LockedUntil then
					PlotService.Unlock(plot)
				elseif plot.LockedUntil > now then
					PlotService.ExpelIntruders(plot)
				end
				PlotService.UpdateLockLabel(plot, now)
			end
		end
	end)
end

-- ---------------------------------------------------------------------
-- Asignación
-- ---------------------------------------------------------------------
function PlotService.Assign(player: Player): Plot?
	for _, plot in plots do
		if not plot.Owner then
			plot.Owner = player
			playerPlots[player] = plot
			player:SetAttribute("PlotIndex", plot.Index)
			plot.Model:SetAttribute("OwnerUserId", player.UserId)
			plot.SignName.Text = string.upper(player.DisplayName) .. "'S BASE"
			plot.SignIncome.Text = "$0/s"
			task.spawn(function()
				local ok, image = pcall(function()
					return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
				end)
				if ok and plot.Owner == player then
					plot.SignAvatar.Image = image
				end
			end)
			if player.Character then
				PlotService.ApplyOwnerCollision(player, player.Character)
			end
			return plot
		end
	end
	return nil
end

function PlotService.Release(player: Player)
	local plot = playerPlots[player]
	if not plot then
		return
	end
	playerPlots[player] = nil
	plot.Owner = nil
	plot.Model:SetAttribute("OwnerUserId", 0)
	PlotService.Unlock(plot)
	plot.LockedUntil = 0
	plot.CooldownUntil = 0
	PlotService.ResetVisuals(plot)
end

function PlotService.ResetVisuals(plot: Plot)
	plot.SignName.Text = "EMPTY BASE"
	plot.SignIncome.Text = ""
	plot.SignAvatar.Image = ""
	plot.LockLabel.Text = ""
	plot.LastLockText = ""
	for _, slot in plot.Slots do
		slot.Glow.Color = EMPTY_GLOW
		slot.PadLabel.Text = ""
		slot.LastText = ""
		PlotService.SetSlotUnlockedVisual(slot, true)
	end
end

function PlotService.ApplyOwnerCollision(player: Player, character: Model)
	local plot = playerPlots[player]
	if not plot then
		return
	end
	local groupName = "Owner" .. plot.Index
	local function apply(descendant: Instance)
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = groupName
		end
	end
	for _, descendant in character:GetDescendants() do
		apply(descendant)
	end
	character.DescendantAdded:Connect(apply)
end

-- ---------------------------------------------------------------------
-- Consultas
-- ---------------------------------------------------------------------
function PlotService.GetPlot(player: Player): Plot?
	return playerPlots[player]
end

function PlotService.GetPlots(): { Plot }
	return plots
end

function PlotService.Contains(plot: Plot, position: Vector3, margin: number?): boolean
	local localPos = plot.CFrame:PointToObjectSpace(position)
	local m = margin or 0.5
	return math.abs(localPos.X) <= W / 2 + m and math.abs(localPos.Z) <= D / 2 + m and localPos.Y > -6 and localPos.Y < 45
end

function PlotService.GetSlot(player: Player, slotIndex: number): Slot?
	local plot = playerPlots[player]
	return plot and plot.Slots[slotIndex]
end

function PlotService.GetSlotCFrame(player: Player, slotIndex: number): CFrame?
	local slot = PlotService.GetSlot(player, slotIndex)
	return slot and slot.CFrame
end

-- Puntos de camino para que un slime entre andando a la base
function PlotService.GetEntrancePath(player: Player, slotIndex: number): { CFrame }
	local plot = playerPlots[player]
	local slot = plot and plot.Slots[slotIndex]
	if not plot or not slot then
		return {}
	end
	local outside = plot.CFrame * CFrame.new(0, Layout.FloorHeight, -D / 2 - 6)
	local inside = plot.CFrame * CFrame.new(0, Layout.FloorHeight, -D / 2 + 4)
	local slotLocal = plot.CFrame:PointToObjectSpace(slot.CFrame.Position)
	local beside = plot.CFrame * CFrame.new(slotLocal.X, Layout.FloorHeight, slotLocal.Z - 6.5)
	return { outside, inside, beside, slot.CFrame }
end

-- ---------------------------------------------------------------------
-- Visuales de los slots
-- ---------------------------------------------------------------------
function PlotService.SetSlotUnlockedVisual(slot: Slot, unlocked: boolean)
	slot.Unlocked = unlocked
	slot.Pedestal.Transparency = if unlocked then 0 else 0.55
	slot.Glow.Transparency = if unlocked then 0 else 0.8
	slot.Pad.Transparency = if unlocked then 0.2 else 1
	slot.PadGui.Enabled = unlocked
	slot.LockGui.Enabled = not unlocked
end

function PlotService.UpdateSlotCount(player: Player, count: number)
	local plot = playerPlots[player]
	if not plot then
		return
	end
	for _, slot in plot.Slots do
		local unlocked = slot.Index <= count
		if slot.Unlocked ~= unlocked then
			PlotService.SetSlotUnlockedVisual(slot, unlocked)
		end
	end
end

function PlotService.SetSlotGlow(player: Player, slotIndex: number, color: Color3?)
	local slot = PlotService.GetSlot(player, slotIndex)
	if slot then
		slot.Glow.Color = color or EMPTY_GLOW
	end
end

function PlotService.SetStoredText(player: Player, slotIndex: number, amount: number?)
	local slot = PlotService.GetSlot(player, slotIndex)
	if not slot then
		return
	end
	local text = if amount and amount >= 1 then Format.Money(amount) else ""
	if text ~= slot.LastText then
		slot.LastText = text
		slot.PadLabel.Text = text
	end
end

function PlotService.SetSignIncome(player: Player, income: number)
	local plot = playerPlots[player]
	if plot then
		local text = Format.PerSecond(income)
		if plot.SignIncome.Text ~= text then
			plot.SignIncome.Text = text
		end
	end
end

-- ---------------------------------------------------------------------
-- Candado
-- ---------------------------------------------------------------------
function PlotService.IsLocked(plot: Plot): boolean
	return plot.LockedUntil > workspace:GetServerTimeNow()
end

function PlotService.IsPlayerLocked(player: Player): boolean
	local plot = playerPlots[player]
	return plot ~= nil and PlotService.IsLocked(plot)
end

function PlotService.TryLock(player: Player, force: boolean): (boolean, string?)
	local plot = playerPlots[player]
	if not plot then
		return false, "You don't have a base"
	end
	local now = workspace:GetServerTimeNow()
	if plot.LockedUntil > now then
		if force then
			-- Producto "Instant Lock" con el candado ya puesto: se extiende
			local data = Registry.DataService.Get(player)
			local passes = Registry.MonetizationService.GetOwnedPasses(player)
			local duration = Economy.GetLockDuration(data and data.Rebirths or 0, data and data.Upgrades.Lock or 0, passes.LongerLock == true)
			plot.LockedUntil += duration
			plot.CooldownUntil = plot.LockedUntil + Config.Lock.Cooldown
			player:SetAttribute("LockEndsAt", plot.LockedUntil)
			player:SetAttribute("LockCooldownEndsAt", plot.CooldownUntil)
			return true
		end
		return false, "Your base is already locked"
	end
	if not force and plot.CooldownUntil > now then
		Net.Notify(player, ("Lock is recharging... %ds"):format(math.ceil(plot.CooldownUntil - now)), "Error")
		return false, "Lock is recharging"
	end

	local data = Registry.DataService.Get(player)
	local passes = Registry.MonetizationService.GetOwnedPasses(player)
	local duration = Economy.GetLockDuration(data and data.Rebirths or 0, data and data.Upgrades.Lock or 0, passes.LongerLock == true)
	plot.LockedUntil = now + duration
	plot.CooldownUntil = plot.LockedUntil + Config.Lock.Cooldown
	player:SetAttribute("LockEndsAt", plot.LockedUntil)
	player:SetAttribute("LockCooldownEndsAt", plot.CooldownUntil)

	plot.Barrier.Transparency = 0
	plot.Barrier.CanCollide = true
	plot.LockPad.Color = Color3.fromRGB(80, 255, 120)
	PlotService.ExpelIntruders(plot)
	Net.Notify(player, ("🔒 Base locked for %ds!"):format(duration), "Success")
	Net.Effect(player, "Sound", { Name = "Lock" })
	return true
end

function PlotService.Unlock(plot: Plot)
	plot.LockedUntil = 0
	plot.Barrier.Transparency = 1
	plot.Barrier.CanCollide = false
	plot.LockPad.Color = Color3.fromRGB(255, 70, 70)
	if plot.Owner then
		plot.Owner:SetAttribute("LockEndsAt", 0)
	end
end

function PlotService.ExpelIntruders(plot: Plot)
	for _, other in Players:GetPlayers() do
		if other ~= plot.Owner then
			local character = other.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if character and root and root:IsA("BasePart") and PlotService.Contains(plot, root.Position, 1) then
				if plot.Owner and Registry.StealService.GetVictim(other) == plot.Owner then
					Registry.StealService.Cancel(other, "locked")
				end
				local outside = plot.CFrame * CFrame.new(math.random(-6, 6), Layout.FloorHeight + 3.5, -D / 2 - 9)
				character:PivotTo(CFrame.lookAt(outside.Position, outside.Position + plot.CFrame.LookVector))
				Net.Notify(other, "🔒 That base is locked!", "Error")
			end
		end
	end
end

function PlotService.UpdateLockLabel(plot: Plot, now: number)
	local text
	if plot.LockedUntil > now then
		text = ("🔒 LOCKED %ds"):format(math.ceil(plot.LockedUntil - now))
	elseif plot.CooldownUntil > now then
		text = ("⏳ RECHARGING %ds"):format(math.ceil(plot.CooldownUntil - now))
	else
		text = "🔓 STEP TO LOCK"
	end
	if text ~= plot.LastLockText then
		plot.LastLockText = text
		plot.LockLabel.Text = text
		plot.LockLabel.TextColor3 = if plot.LockedUntil > now then Color3.fromRGB(120, 255, 140) elseif plot.CooldownUntil > now then Color3.fromRGB(255, 210, 90) else Color3.fromRGB(255, 255, 255)
	end
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[-- Rebirth: reinicia cash y slimes a cambio de +ingresos, +slots y +tiempo de candado permanentes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)
local Actions = require(script.Parent.Parent.Actions)
local Net = require(script.Parent.Parent.Net)

local RebirthService = {}

function RebirthService.DoRebirth(player: Player): (boolean, string?)
	local data = Registry.DataService.Get(player)
	if not data then
		return false, "Data not loaded"
	end
	if data.Rebirths >= Config.Rebirth.MaxRebirths then
		return false, "Max rebirths reached!"
	end
	if Registry.StealService.IsCarrying(player) then
		return false, "You can't rebirth while carrying a slime"
	end
	local cost = Economy.GetRebirthCost(data.Rebirths)
	if data.Cash < cost then
		return false, ("You need %s"):format(Format.Money(cost))
	end

	Registry.StealService.CancelAllFor(player)
	Registry.SlimeService.CollectAll(player)

	data.Rebirths += 1
	data.Cash = Config.StartingCash
	table.clear(data.Slimes)

	Registry.SlimeService.ResetPlayer(player)
	Registry.DataService.UpdateCashDisplay(player)
	Registry.DataService.UpdateStatsDisplay(player)
	Registry.SlimeService.InvalidateMultiplier(player)
	Registry.PlayerService.UpdateOverhead(player)
	Registry.DataService.MarkDirty(player)

	Net.Effect(player, "Rebirth", { Rebirths = data.Rebirths })
	Net.Announce(("♻️ %s reached REBIRTH %d!"):format(player.DisplayName, data.Rebirths), Color3.fromRGB(255, 210, 70), 4)
	task.spawn(Registry.DataService.Save, player, false)
	return true, ("Rebirth %d! Income x%s"):format(data.Rebirths, tostring(1 + data.Rebirths * Config.Rebirth.IncomeBonus))
end

function RebirthService.Init()
	Actions.Register("Rebirth", function(player)
		return RebirthService.DoRebirth(player)
	end)
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[-- Recompensas de retención: diaria con racha, regalos por tiempo jugado, códigos y ganancias offline.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)
local Actions = require(script.Parent.Parent.Actions)
local Net = require(script.Parent.Parent.Net)

local RewardService = {}

type Session = { Start: number, Claimed: { [string]: boolean } }

local sessions: { [Player]: Session } = {}

local function today(): number
	return math.floor(os.time() / 86400)
end

-- Entrega una recompensa (tabla con Cash / IncomeSeconds / Boost / SlimeRarity)
function RewardService.Grant(player: Player, reward: { [string]: any }): string
	local data = Registry.DataService.Get(player)
	if not data then
		return ""
	end
	local parts = {}
	if reward.Cash or reward.IncomeSeconds then
		local income = Registry.SlimeService.GetIncomePerSecond(player)
		local amount = Economy.ScaleReward(reward.Cash, income, reward.IncomeSeconds)
		if amount > 0 then
			Registry.DataService.AddCash(player, amount)
			table.insert(parts, Format.Money(amount))
			Net.Effect(player, "Sound", { Name = "Cash" })
		end
	end
	if reward.Boost then
		data.Boosts.CashX2 = (data.Boosts.CashX2 or 0) + reward.Boost
		player:SetAttribute("BoostCashX2", data.Boosts.CashX2)
		Registry.SlimeService.InvalidateMultiplier(player)
		table.insert(parts, "2x Cash for " .. Format.Duration(reward.Boost))
	end
	if reward.SlimeRarity then
		local given = Registry.SlimeService.GiveRandomOfRarity(player, reward.SlimeRarity, 1)
		table.insert(parts, (if given then "a " else "cash for a ") .. reward.SlimeRarity .. " slime")
	end
	Net.Effect(player, "Confetti", {})
	Registry.DataService.MarkDirty(player)
	return table.concat(parts, " + ")
end

function RewardService.OnJoin(player: Player)
	sessions[player] = { Start = workspace:GetServerTimeNow(), Claimed = {} }
	local data = Registry.DataService.Get(player)
	if not data then
		return
	end
	player:SetAttribute("BoostCashX2", data.Boosts.CashX2 or 0)

	-- Ganancias offline
	if data.LastOnline > 0 then
		local seconds = math.min(os.time() - data.LastOnline, Config.Offline.MaxSeconds)
		if seconds >= Config.Offline.MinSeconds then
			local amount = math.floor(Registry.SlimeService.GetIncomePerSecond(player) * seconds * Config.Offline.Rate)
			if amount > 0 then
				Registry.DataService.AddCash(player, amount)
				Net.Effect(player, "Offline", { Amount = amount, Seconds = seconds })
			end
		end
	end
	data.LastOnline = os.time()

	if data.Daily.LastDay < today() then
		task.delay(4, function()
			if player.Parent then
				Net.Effect(player, "DailyAvailable", {})
			end
		end)
	end
	Registry.DataService.MarkDirty(player)
end

function RewardService.OnPlayerRemoving(player: Player)
	sessions[player] = nil
end

function RewardService.FillView(player: Player, view: { [string]: any })
	local data = Registry.DataService.Get(player)
	local session = sessions[player]
	view.SessionStart = if session then session.Start else workspace:GetServerTimeNow()
	view.GiftsClaimed = if session then session.Claimed else {}
	if not data then
		return
	end
	local t = today()
	local lastDay = data.Daily.LastDay
	local streak = data.Daily.Streak
	local nextStreak
	if lastDay == t then
		nextStreak = streak + 1
	elseif lastDay == t - 1 then
		nextStreak = streak + 1
	else
		nextStreak = 1
	end
	view.DailyAvailable = lastDay < t
	view.DailyStreak = if lastDay >= t - 1 then streak else 0
	view.DailyNextStreak = nextStreak
	view.DailyNextIndex = ((nextStreak - 1) % #Config.DailyRewards) + 1
	view.DailyResetAt = (t + 1) * 86400
end

function RewardService.Init()
	Actions.Register("ClaimDaily", function(player)
		local data = Registry.DataService.Get(player)
		if not data then
			return false, "Data not loaded"
		end
		local t = today()
		if data.Daily.LastDay >= t then
			return false, "Come back tomorrow!"
		end
		local streak = if data.Daily.LastDay == t - 1 then data.Daily.Streak + 1 else 1
		data.Daily.LastDay = t
		data.Daily.Streak = streak
		local reward = Config.DailyRewards[((streak - 1) % #Config.DailyRewards) + 1]
		local description = RewardService.Grant(player, reward)
		return true, ("📅 Day %d reward: %s"):format(streak, description)
	end)

	Actions.Register("ClaimGift", function(player, payload)
		local session = sessions[player]
		local index = tonumber(payload.Index)
		local gift = index and Config.PlaytimeGifts[index]
		if not session or not gift or not index then
			return false, "Invalid gift"
		end
		local key = tostring(index)
		if session.Claimed[key] then
			return false, "Already claimed"
		end
		local elapsed = workspace:GetServerTimeNow() - session.Start
		if elapsed < gift.Minutes * 60 - 2 then
			return false, "Not ready yet"
		end
		session.Claimed[key] = true
		local description = RewardService.Grant(player, gift)
		return true, "🎁 " .. description
	end)

	Actions.Register("RedeemCode", function(player, payload)
		local data = Registry.DataService.Get(player)
		if not data then
			return false, "Data not loaded"
		end
		local raw = tostring(payload.Code or "")
		local code = string.upper((string.gsub(raw, "%s", "")))
		if #code == 0 or #code > 30 then
			return false, "Enter a code"
		end
		local reward = Config.Codes[code]
		if not reward then
			return false, "Invalid code"
		end
		if data.Codes[code] then
			return false, "Code already redeemed"
		end
		data.Codes[code] = true
		local description = RewardService.Grant(player, reward)
		return true, "✅ " .. description
	end)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[-- Tienda con cash: bates y mejoras permanentes (velocidad y duración del candado).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Gear = require(Shared.Gear)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Registry = require(script.Parent.Parent.Registry)
local Actions = require(script.Parent.Parent.Actions)
local Net = require(script.Parent.Parent.Net)

local ShopService = {}

function ShopService.Init()
	Actions.Register("BuyBat", function(player, payload)
		local data = Registry.DataService.Get(player)
		local def = Gear.GetBat(tostring(payload.Id))
		if not data or not def then
			return false, "Invalid bat"
		end
		if data.OwnedBats[def.Id] then
			return false, "Already owned"
		end
		if def.GamePass then
			return false, "This bat is a Game Pass"
		end
		if data.Rebirths < def.RebirthRequired then
			return false, ("Requires Rebirth %d"):format(def.RebirthRequired)
		end
		if not Registry.DataService.SpendCash(player, def.Price) then
			return false, "Not enough cash"
		end
		data.OwnedBats[def.Id] = true
		data.EquippedBat = def.Id
		Registry.CombatService.GiveBat(player)
		Registry.DataService.MarkDirty(player)
		Net.Effect(player, "Sound", { Name = "Buy" })
		return true, "Bought " .. def.Name .. "!"
	end)

	Actions.Register("EquipBat", function(player, payload)
		local data = Registry.DataService.Get(player)
		local def = Gear.GetBat(tostring(payload.Id))
		if not data or not def then
			return false, "Invalid bat"
		end
		local owned = data.OwnedBats[def.Id] == true
		if def.GamePass then
			owned = Registry.MonetizationService.OwnsPass(player, def.GamePass)
		end
		if not owned then
			return false, "You don't own this bat"
		end
		data.EquippedBat = def.Id
		Registry.CombatService.GiveBat(player)
		Registry.DataService.MarkDirty(player)
		return true, "Equipped " .. def.Name
	end)

	Actions.Register("BuyUpgrade", function(player, payload)
		local data = Registry.DataService.Get(player)
		local key = tostring(payload.Key)
		local def = Gear.Upgrades[key]
		if not data or not def then
			return false, "Invalid upgrade"
		end
		local level = data.Upgrades[key] or 0
		if level >= def.MaxLevel then
			return false, "Max level!"
		end
		local cost = Economy.GetUpgradeCost(key, level)
		if not Registry.DataService.SpendCash(player, cost) then
			return false, ("Not enough cash (%s)"):format(Format.Money(cost))
		end
		data.Upgrades[key] = level + 1
		if key == "Speed" then
			Registry.PlayerService.UpdateWalkSpeed(player)
		end
		Registry.DataService.MarkDirty(player)
		Net.Effect(player, "Sound", { Name = "Buy" })
		return true, ("%s upgraded to level %d!"):format(def.Name, level + 1)
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">SlimeService</string>
            <string name="Source"><![CDATA[-- Slimes que posee cada jugador: modelos en los pedestales, ingresos por segundo,
-- recoger dinero, vender y multiplicadores.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Slimes = require(Shared.Slimes)
local Rarities = require(Shared.Rarities)
local Mutations = require(Shared.Mutations)
local SlimeBuilder = require(Shared.SlimeBuilder)

local Registry = require(script.Parent.Parent.Registry)
local Net = require(script.Parent.Parent.Net)

local SlimeService = {}

type PlayerSlimes = {
	Models: { [number]: Model },
	Stored: { [number]: number },
	Arriving: { [number]: Model },
	Hidden: { [number]: boolean },
	Multiplier: number,
	Breakdown: { any },
	MultiplierDirty: boolean,
	IndexCount: number,
}

local states: { [Player]: PlayerSlimes } = {}
local folder: Folder

local function slotKey(slot: number): string
	return tostring(slot)
end

local function getState(player: Player): PlayerSlimes?
	return states[player]
end

-- ---------------------------------------------------------------------
-- Ciclo de vida
-- ---------------------------------------------------------------------
function SlimeService.Start()
	folder = Instance.new("Folder")
	folder.Name = "Owned"
	folder.Parent = workspace:WaitForChild("Slimes")

	task.spawn(function()
		while true do
			task.wait(1)
			for player in states do
				local ok, err = pcall(SlimeService.Tick, player)
				if not ok then
					warn("[SlimeService] Tick error: " .. tostring(err))
				end
			end
		end
	end)
end

function SlimeService.SetupPlayer(player: Player)
	local data = Registry.DataService.Get(player)
	states[player] = {
		Models = {},
		Stored = {},
		Arriving = {},
		Hidden = {},
		Multiplier = 1,
		Breakdown = {},
		MultiplierDirty = true,
		IndexCount = if data then Economy.CountIndex(data.Index) else 0,
	}
	SlimeService.RefreshAll(player)
end

function SlimeService.OnPlayerRemoving(player: Player)
	local state = states[player]
	if not state then
		return
	end
	-- El dinero sin recoger pasa a la cartera antes de guardar
	local total = 0
	for _, amount in state.Stored do
		total += amount
	end
	if total > 0 then
		Registry.DataService.AddCash(player, total, false)
	end
	for _, model in state.Models do
		model:Destroy()
	end
	for _, model in state.Arriving do
		model:Destroy()
	end
	states[player] = nil
end

-- ---------------------------------------------------------------------
-- Modelos
-- ---------------------------------------------------------------------
local function createPrompt(parent: Instance, name: string, actionText: string, objectText: string, hold: number, key: Enum.KeyCode, role: string, ownerId: number): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = hold
	prompt.KeyboardKeyCode = key
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt:SetAttribute("Role", role)
	prompt:SetAttribute("OwnerUserId", ownerId)
	CollectionService:AddTag(prompt, "RolePrompt")
	prompt.Parent = parent
	return prompt
end

function SlimeService.SpawnSlotModel(player: Player, slot: number)
	local state = states[player]
	local data = Registry.DataService.Get(player)
	if not state or not data then
		return
	end
	SlimeService.RemoveSlotModel(player, slot)
	local entry = data.Slimes[slotKey(slot)]
	if not entry or state.Arriving[slot] or state.Hidden[slot] then
		return
	end
	local cframe = Registry.PlotService.GetSlotCFrame(player, slot)
	if not cframe then
		return
	end

	local def = Slimes.Get(entry.Id)
	if not def then
		return
	end
	local model = SlimeBuilder.Build(entry.Id, entry.Mutation)
	model:PivotTo(cframe)
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("Slot", slot)
	CollectionService:AddTag(model, "OwnedSlime")

	local income = Economy.GetSlimeIncome(entry.Id, entry.Mutation) * state.Multiplier
	SlimeBuilder.CreateBillboard(model, { Income = income })

	local root = model.PrimaryPart :: BasePart
	local sellPrice = Economy.GetSellPrice(entry.Id, entry.Mutation)
	local sellPrompt = createPrompt(root, "SellPrompt", "Sell " .. Format.Money(sellPrice), def.Name, 1.2, Enum.KeyCode.F, "Owner", player.UserId)
	local stealPrompt = createPrompt(root, "StealPrompt", "Steal", def.Name, Config.Steal.HoldDuration, Enum.KeyCode.E, "Thief", player.UserId)

	sellPrompt.Triggered:Connect(function(who)
		if who == player then
			SlimeService.SellSlot(player, slot)
		end
	end)
	stealPrompt.Triggered:Connect(function(who)
		if who ~= player then
			Registry.StealService.TryStart(who, player, slot)
		end
	end)

	model.Parent = folder
	state.Models[slot] = model
	Registry.PlotService.SetSlotGlow(player, slot, Rarities.Get(def.Rarity).Color)
end

function SlimeService.RemoveSlotModel(player: Player, slot: number)
	local state = states[player]
	if not state then
		return
	end
	local model = state.Models[slot]
	if model then
		model:Destroy()
		state.Models[slot] = nil
	end
	Registry.PlotService.SetSlotGlow(player, slot, nil)
end

function SlimeService.RefreshAll(player: Player)
	local state = states[player]
	local data = Registry.DataService.Get(player)
	if not state or not data then
		return
	end
	state.MultiplierDirty = true
	SlimeService.GetMultiplier(player)
	Registry.PlotService.UpdateSlotCount(player, SlimeService.GetSlotCount(player))
	for slot = 1, Economy.GetMaxPhysicalSlots() do
		if data.Slimes[slotKey(slot)] then
			if not state.Arriving[slot] and not state.Hidden[slot] then
				SlimeService.SpawnSlotModel(player, slot)
			end
		else
			SlimeService.RemoveSlotModel(player, slot)
			state.Stored[slot] = nil
			Registry.PlotService.SetStoredText(player, slot, 0)
		end
	end
	Registry.DataService.MarkDirty(player)
end

-- Borra todos los modelos y estado temporal (rebirth / reset de datos) y reconstruye
function SlimeService.ResetPlayer(player: Player)
	local state = states[player]
	if not state then
		return
	end
	for _, model in state.Models do
		model:Destroy()
	end
	for _, model in state.Arriving do
		model:Destroy()
	end
	table.clear(state.Models)
	table.clear(state.Arriving)
	table.clear(state.Stored)
	table.clear(state.Hidden)
	local data = Registry.DataService.Get(player)
	state.IndexCount = if data then Economy.CountIndex(data.Index) else 0
	for slot = 1, Economy.GetMaxPhysicalSlots() do
		Registry.PlotService.SetStoredText(player, slot, 0)
		Registry.PlotService.SetSlotGlow(player, slot, nil)
	end
	SlimeService.RefreshAll(player)
	SlimeService.RefreshIncomeLabels(player)
end

-- Actualiza los textos $/s de los carteles cuando cambia el multiplicador
function SlimeService.RefreshIncomeLabels(player: Player)
	local state = states[player]
	if not state then
		return
	end
	for _, model in state.Models do
		local gui = model.PrimaryPart and model.PrimaryPart:FindFirstChild("Info")
		local incomeLabel = gui and gui:FindFirstChild("Income")
		if incomeLabel and incomeLabel:IsA("TextLabel") then
			local income = Economy.GetSlimeIncome(model:GetAttribute("SlimeId"), model:GetAttribute("Mutation")) * state.Multiplier
			incomeLabel.Text = Format.PerSecond(income)
		end
	end
end

-- ---------------------------------------------------------------------
-- Slots
-- ---------------------------------------------------------------------
function SlimeService.GetSlotCount(player: Player): number
	local data = Registry.DataService.Get(player)
	if not data then
		return 0
	end
	local passes = Registry.MonetizationService.GetOwnedPasses(player)
	return Economy.GetSlotCount(data.Rebirths, passes.ExtraSlots == true)
end

function SlimeService.GetFreeSlot(player: Player): number?
	local data = Registry.DataService.Get(player)
	local state = states[player]
	if not data or not state then
		return nil
	end
	for slot = 1, SlimeService.GetSlotCount(player) do
		if data.Slimes[slotKey(slot)] == nil and state.Arriving[slot] == nil then
			return slot
		end
	end
	return nil
end

function SlimeService.GetEntry(player: Player, slot: number): { Id: string, Mutation: string }?
	local data = Registry.DataService.Get(player)
	return data and data.Slimes[slotKey(slot)]
end

-- Añade un slime al primer slot libre. options.Arriving = el modelo llega andando (lo gestiona otro servicio)
function SlimeService.AddSlime(player: Player, slimeId: string, mutation: string, options: { Arriving: Model?, Slot: number? }?): number?
	local data = Registry.DataService.Get(player)
	local state = states[player]
	if not data or not state or not Slimes.Exists(slimeId) then
		return nil
	end
	local slot = (options and options.Slot) or SlimeService.GetFreeSlot(player)
	if not slot or data.Slimes[slotKey(slot)] ~= nil then
		return nil
	end
	data.Slimes[slotKey(slot)] = { Id = slimeId, Mutation = mutation }
	state.Stored[slot] = 0
	local isNew = Registry.DataService.Discover(player, slimeId, mutation)
	if isNew then
		state.IndexCount = Economy.CountIndex(data.Index)
		state.MultiplierDirty = true
		local def = Slimes.Get(slimeId)
		local mutationDef = Mutations.Get(mutation)
		local name = if mutation ~= "Normal" then mutationDef.Name .. " " .. (def and def.Name or slimeId) else (def and def.Name or slimeId)
		Net.Notify(player, "📖 New Index entry: " .. name .. "!", "Success")
	end
	if options and options.Arriving then
		state.Arriving[slot] = options.Arriving
	else
		SlimeService.SpawnSlotModel(player, slot)
	end
	if state.MultiplierDirty then
		SlimeService.GetMultiplier(player)
		SlimeService.RefreshIncomeLabels(player)
	end
	Registry.DataService.MarkDirty(player)
	return slot
end

function SlimeService.FinishArrival(player: Player, slot: number, walker: Model)
	local state = states[player]
	if walker then
		walker:Destroy()
	end
	if not state then
		return
	end
	if state.Arriving[slot] == walker then
		state.Arriving[slot] = nil
	end
	SlimeService.SpawnSlotModel(player, slot)
end

function SlimeService.RemoveSlime(player: Player, slot: number): { Id: string, Mutation: string }?
	local data = Registry.DataService.Get(player)
	local state = states[player]
	if not data or not state then
		return nil
	end
	local entry = data.Slimes[slotKey(slot)]
	if not entry then
		return nil
	end
	data.Slimes[slotKey(slot)] = nil
	-- El dinero acumulado se queda con el dueño
	local stored = state.Stored[slot] or 0
	if stored > 0 then
		Registry.DataService.AddCash(player, stored, false)
	end
	state.Stored[slot] = nil
	state.Hidden[slot] = nil
	SlimeService.RemoveSlotModel(player, slot)
	Registry.PlotService.SetStoredText(player, slot, 0)
	Registry.DataService.MarkDirty(player)
	return entry
end

-- Oculta/muestra un slime mientras lo están robando
function SlimeService.SetHidden(player: Player, slot: number, hidden: boolean)
	local state = states[player]
	if not state then
		return
	end
	state.Hidden[slot] = if hidden then true else nil
	if hidden then
		SlimeService.RemoveSlotModel(player, slot)
	else
		SlimeService.SpawnSlotModel(player, slot)
	end
end

function SlimeService.IsSlotBusy(player: Player, slot: number): boolean
	local state = states[player]
	return state == nil or state.Hidden[slot] == true or state.Arriving[slot] ~= nil
end

function SlimeService.SellSlot(player: Player, slot: number): boolean
	if SlimeService.IsSlotBusy(player, slot) then
		return false
	end
	local entry = SlimeService.GetEntry(player, slot)
	if not entry then
		return false
	end
	local price = Economy.GetSellPrice(entry.Id, entry.Mutation)
	SlimeService.RemoveSlime(player, slot)
	Registry.DataService.AddCash(player, price, false)
	local data = Registry.DataService.Get(player)
	if data then
		data.Stats.Sold += 1
	end
	local def = Slimes.Get(entry.Id)
	Net.Notify(player, ("Sold %s for %s"):format(def and def.Name or "slime", Format.Money(price)), "Cash")
	Net.Effect(player, "Sound", { Name = "Cash" })
	return true
end

-- ---------------------------------------------------------------------
-- Ingresos
-- ---------------------------------------------------------------------
function SlimeService.InvalidateMultiplier(player: Player)
	local state = states[player]
	if state then
		state.MultiplierDirty = true
		SlimeService.GetMultiplier(player)
		SlimeService.RefreshIncomeLabels(player)
		Registry.DataService.MarkDirty(player)
	end
end

function SlimeService.GetMultiplier(player: Player): (number, { any })
	local state = states[player]
	local data = Registry.DataService.Get(player)
	if not state or not data then
		return 1, {}
	end
	if state.MultiplierDirty then
		local passes = Registry.MonetizationService.GetOwnedPasses(player)
		local playerService = Registry.PlayerService
		local multiplier, breakdown = Economy.GetIncomeMultiplier({
			Rebirths = data.Rebirths,
			IndexCount = state.IndexCount,
			DoubleCash = passes.DoubleCash == true,
			VIP = passes.VIP == true,
			Friends = if playerService then playerService.GetFriendCount(player) else 0,
			Premium = player.MembershipType == Enum.MembershipType.Premium,
			InGroup = if playerService then playerService.IsInGroup(player) else false,
			Boost = (data.Boosts.CashX2 or 0) > 0,
			EventMultiplier = Registry.EventService.GetCashMultiplier(),
		})
		state.Multiplier = multiplier
		state.Breakdown = breakdown
		state.MultiplierDirty = false
	end
	return state.Multiplier, state.Breakdown
end

function SlimeService.InvalidateAll()
	for player in states do
		SlimeService.InvalidateMultiplier(player)
	end
end

function SlimeService.GetBaseIncome(player: Player): number
	local data = Registry.DataService.Get(player)
	if not data then
		return 0
	end
	local total = 0
	for _, entry in data.Slimes do
		total += Economy.GetSlimeIncome(entry.Id, entry.Mutation)
	end
	return total
end

function SlimeService.GetIncomePerSecond(player: Player): number
	local multiplier = SlimeService.GetMultiplier(player)
	return SlimeService.GetBaseIncome(player) * multiplier
end

function SlimeService.Tick(player: Player)
	local state = states[player]
	local data = Registry.DataService.Get(player)
	if not state or not data then
		return
	end

	-- Boost temporal x2
	if (data.Boosts.CashX2 or 0) > 0 then
		data.Boosts.CashX2 = math.max(0, data.Boosts.CashX2 - 1)
		player:SetAttribute("BoostCashX2", data.Boosts.CashX2)
		if data.Boosts.CashX2 == 0 then
			SlimeService.InvalidateMultiplier(player)
			Net.Notify(player, "⏫ Your 2x Cash boost ended", "Info")
		end
	end
	data.Stats.Playtime += 1

	local multiplier = SlimeService.GetMultiplier(player)
	local autoCollect = Registry.MonetizationService.OwnsPass(player, "AutoCollect")
	local direct = 0
	local total = 0
	for key, entry in data.Slimes do
		local slot = tonumber(key) :: number
		if not state.Hidden[slot] then
			local amount = Economy.GetSlimeIncome(entry.Id, entry.Mutation) * multiplier
			total += amount
			if autoCollect then
				direct += amount
			else
				state.Stored[slot] = (state.Stored[slot] or 0) + amount
				Registry.PlotService.SetStoredText(player, slot, state.Stored[slot])
			end
		end
	end
	if direct > 0 then
		Registry.DataService.AddCash(player, direct)
	end
	player:SetAttribute("Income", total)
	Registry.PlotService.SetSignIncome(player, total)
end

function SlimeService.CollectSlot(player: Player, slot: number)
	local state = states[player]
	if not state then
		return
	end
	local amount = state.Stored[slot] or 0
	if amount < 1 then
		return
	end
	state.Stored[slot] = 0
	Registry.DataService.AddCash(player, amount)
	Registry.PlotService.SetStoredText(player, slot, 0)
	local slotData = Registry.PlotService.GetSlot(player, slot)
	Net.Effect(player, "Collect", { Amount = amount, Position = if slotData then slotData.Pad.Position else nil })
end

function SlimeService.CollectAll(player: Player): number
	local state = states[player]
	if not state then
		return 0
	end
	local total = 0
	for slot, amount in state.Stored do
		total += amount
		state.Stored[slot] = 0
		Registry.PlotService.SetStoredText(player, slot, 0)
	end
	if total > 0 then
		Registry.DataService.AddCash(player, total)
	end
	return total
end

-- Slime aleatorio de una rareza (regalos, códigos, productos)
function SlimeService.GiveRandomOfRarity(player: Player, rarity: string, mutationLuck: number?): (boolean, string?)
	local rng = Random.new()
	local slimeId = Economy.PickSlimeOfRarity(rng, rarity)
	local mutation = Economy.RollMutation(rng, mutationLuck or 1)
	local def = Slimes.Get(slimeId)
	local slot = SlimeService.GetFreeSlot(player)
	if not slot then
		-- Sin espacio: se compensa con dinero
		local value = Economy.GetSlimePrice(slimeId, mutation)
		Registry.DataService.AddCash(player, value)
		Net.Notify(player, ("Base full! Got %s instead of %s"):format(Format.Money(value), def and def.Name or "a slime"), "Warning")
		return false, slimeId
	end
	Registry.ConveyorService.SendToBase(player, slimeId, mutation, slot, nil)
	return true, slimeId
end

return SlimeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">StealService</string>
            <string name="Source"><![CDATA[-- Robos: coger el slime de otra base, llevarlo encima de la cabeza y llegar a tu base.
-- El slime NO cambia de dueño en los datos hasta que el robo termina (sin duplicados).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Slimes = require(Shared.Slimes)
local Rarities = require(Shared.Rarities)
local Mutations = require(Shared.Mutations)
local SlimeBuilder = require(Shared.SlimeBuilder)

local Registry = require(script.Parent.Parent.Registry)
local Net = require(script.Parent.Parent.Net)

local StealService = {}

type Theft = {
	Thief: Player,
	Victim: Player,
	Slot: number,
	SlimeId: string,
	Mutation: string,
	Model: Model,
	Started: number,
	StartPosition: Vector3,
}

local thefts: { [Player]: Theft } = {}
local cooldowns: { [Player]: number } = {}
local carriedFolder: Folder

local function slimeName(slimeId: string, mutation: string): string
	local def = Slimes.Get(slimeId)
	local name = def and def.Name or slimeId
	if mutation ~= "Normal" then
		name = Mutations.Get(mutation).Name .. " " .. name
	end
	return name
end

local function getRoot(player: Player): (BasePart?, Humanoid?)
	local character = player.Character
	if not character then
		return nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
		return root, humanoid
	end
	return nil, nil
end

function StealService.Start()
	carriedFolder = Instance.new("Folder")
	carriedFolder.Name = "Carried"
	carriedFolder.Parent = workspace:WaitForChild("Slimes")

	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.1 then
			return
		end
		elapsed = 0
		for thief, theft in thefts do
			local ok, err = pcall(StealService.Check, thief, theft)
			if not ok then
				warn("[StealService] " .. tostring(err))
				StealService.Cancel(thief, "error")
			end
		end
	end)
end

function StealService.IsCarrying(player: Player): boolean
	return thefts[player] ~= nil
end

function StealService.GetVictim(thief: Player): Player?
	local theft = thefts[thief]
	return theft and theft.Victim
end

function StealService.IsBeingStolen(victim: Player, slot: number): boolean
	for _, theft in thefts do
		if theft.Victim == victim and theft.Slot == slot then
			return true
		end
	end
	return false
end

function StealService.TryStart(thief: Player, victim: Player, slot: number)
	if thief == victim or thefts[thief] then
		if thefts[thief] then
			Net.Notify(thief, "You're already carrying a slime!", "Error")
		end
		return
	end
	if (cooldowns[thief] or 0) > os.clock() then
		return
	end
	local victimPlot = Registry.PlotService.GetPlot(victim)
	local thiefPlot = Registry.PlotService.GetPlot(thief)
	if not victimPlot or not thiefPlot then
		return
	end
	if Registry.PlotService.IsLocked(victimPlot) then
		Net.Notify(thief, "🔒 That base is locked!", "Error")
		return
	end
	if Registry.SlimeService.IsSlotBusy(victim, slot) or StealService.IsBeingStolen(victim, slot) then
		return
	end
	local entry = Registry.SlimeService.GetEntry(victim, slot)
	if not entry then
		return
	end
	if not Registry.SlimeService.GetFreeSlot(thief) then
		Net.Notify(thief, "Your base is full! Sell a slime first.", "Error")
		Net.Effect(thief, "Sound", { Name = "Error" })
		return
	end
	local root = getRoot(thief)
	local slotCFrame = Registry.PlotService.GetSlotCFrame(victim, slot)
	if not root or not slotCFrame or (root.Position - slotCFrame.Position).Magnitude > 16 then
		return
	end

	-- Construimos el slime que va encima de la cabeza
	local model = SlimeBuilder.Build(entry.Id, entry.Mutation, { Scale = 0.75 })
	local modelRoot = model.PrimaryPart :: BasePart
	modelRoot.CFrame = root.CFrame * CFrame.new(0, 2.7, 0)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.Massless = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = modelRoot
	weld.Parent = modelRoot
	SlimeBuilder.CreateBillboard(model, { Extra = "😈 STOLEN!", ExtraColor = Color3.fromRGB(255, 80, 80) })
	model.Parent = carriedFolder

	Registry.SlimeService.SetHidden(victim, slot, true)

	thefts[thief] = {
		Thief = thief,
		Victim = victim,
		Slot = slot,
		SlimeId = entry.Id,
		Mutation = entry.Mutation,
		Model = model,
		Started = os.clock(),
		StartPosition = root.Position,
	}

	local name = slimeName(entry.Id, entry.Mutation)
	thief:SetAttribute("Carrying", name)
	Registry.PlayerService.UpdateWalkSpeed(thief)
	Net.Notify(thief, ("😈 You grabbed %s! Run back to YOUR base!"):format(name), "Warning")
	Net.Effect(thief, "Sound", { Name = "Steal" })
	Net.Effect(victim, "StealAlarm", { Thief = thief.DisplayName, Slime = name })
	Net.Notify(victim, ("⚠️ %s is stealing your %s! Hit them with your bat!"):format(thief.DisplayName, name), "Error")
end

function StealService.Check(thief: Player, theft: Theft)
	if thief.Parent ~= Players or theft.Victim.Parent ~= Players then
		StealService.Cancel(thief, "left")
		return
	end
	local root = getRoot(thief)
	if not root then
		StealService.Cancel(thief, "died")
		return
	end
	if theft.Model.Parent == nil then
		StealService.Cancel(thief, "lost")
		return
	end
	if os.clock() - theft.Started > Config.Steal.Timeout then
		StealService.Cancel(thief, "timeout")
		return
	end
	local thiefPlot = Registry.PlotService.GetPlot(thief)
	if thiefPlot and Registry.PlotService.Contains(thiefPlot, root.Position) then
		-- Anti-teleport: no se puede llegar más rápido de lo que permite la velocidad de andar
		local humanoid = thief.Character and thief.Character:FindFirstChildOfClass("Humanoid")
		local speed = math.max(humanoid and humanoid.WalkSpeed or 16, 16)
		local distance = (root.Position - theft.StartPosition).Magnitude
		local minimumTime = distance / (speed * 1.6 + 6)
		if os.clock() - theft.Started < minimumTime then
			warn(("[StealService] Robo sospechoso de %s (%.0f studs en %.1fs)"):format(thief.Name, distance, os.clock() - theft.Started))
			StealService.Cancel(thief, "suspicious")
			return
		end
		StealService.Complete(thief)
	end
end

local function cleanupThief(thief: Player, theft: Theft)
	thefts[thief] = nil
	if theft.Model then
		theft.Model:Destroy()
	end
	if thief.Parent == Players then
		thief:SetAttribute("Carrying", nil)
		Registry.PlayerService.UpdateWalkSpeed(thief)
	end
end

function StealService.Complete(thief: Player)
	local theft = thefts[thief]
	if not theft then
		return
	end
	cleanupThief(thief, theft)
	local victim = theft.Victim

	local entry = Registry.SlimeService.GetEntry(victim, theft.Slot)
	if not entry or entry.Id ~= theft.SlimeId or entry.Mutation ~= theft.Mutation then
		Registry.SlimeService.SetHidden(victim, theft.Slot, false)
		return
	end
	local freeSlot = Registry.SlimeService.GetFreeSlot(thief)
	if not freeSlot then
		Registry.SlimeService.SetHidden(victim, theft.Slot, false)
		Net.Notify(thief, "Your base is full! The slime ran back home.", "Error")
		Net.Effect(victim, "StealResolved", { Stolen = false })
		return
	end

	-- Transferencia atómica (sin yields entre quitar y dar)
	Registry.SlimeService.RemoveSlime(victim, theft.Slot)
	Registry.SlimeService.AddSlime(thief, theft.SlimeId, theft.Mutation, { Slot = freeSlot })

	local thiefData = Registry.DataService.Get(thief)
	local victimData = Registry.DataService.Get(victim)
	if thiefData then
		thiefData.Stats.Steals += 1
		Registry.DataService.UpdateStatsDisplay(thief)
	end
	if victimData then
		victimData.Stats.TimesRobbed += 1
	end

	local name = slimeName(theft.SlimeId, theft.Mutation)
	Net.Notify(thief, ("💰 You stole %s from %s!"):format(name, victim.DisplayName), "Success")
	Net.Effect(thief, "Sound", { Name = "Cash" })
	Net.Effect(thief, "Confetti", {})
	Net.Notify(victim, ("😭 %s stole your %s!"):format(thief.DisplayName, name), "Error")
	Net.Effect(victim, "StealResolved", { Stolen = true })

	local def = Slimes.Get(theft.SlimeId)
	local rarity = def and Rarities.Get(def.Rarity)
	if rarity and rarity.Order >= Config.Steal.AnnounceMinRarityOrder then
		Net.Announce(("😈 %s stole a %s %s from %s!"):format(thief.DisplayName, string.upper(rarity.Name), name, victim.DisplayName), if rarity.Name == "Secret" then Color3.fromRGB(255, 255, 255) else rarity.Color, 5)
	end
	Registry.DataService.MarkDirty(thief)
	Registry.DataService.MarkDirty(victim)
end

function StealService.Cancel(thief: Player, reason: string)
	local theft = thefts[thief]
	if not theft then
		return
	end
	cleanupThief(thief, theft)
	cooldowns[thief] = os.clock() + Config.Steal.FailCooldown
	local victim = theft.Victim
	if victim.Parent == Players then
		Registry.SlimeService.SetHidden(victim, theft.Slot, false)
		Net.Effect(victim, "StealResolved", { Stolen = false })
		if reason ~= "left" then
			Net.Notify(victim, ("🛡️ Your %s is back home!"):format(slimeName(theft.SlimeId, theft.Mutation)), "Success")
		end
	end
	if thief.Parent == Players then
		local message = if reason == "hit"
			then "💥 You got hit and dropped the slime!"
			elseif reason == "timeout" then "⏱️ Too slow! The slime escaped."
			elseif reason == "locked" then "🔒 The base locked! The slime ran back home."
			elseif reason == "died" then "The slime escaped!"
			else nil
		if message then
			Net.Notify(thief, message, "Error")
		end
	end
end

function StealService.OnHit(target: Player)
	if thefts[target] then
		StealService.Cancel(target, "hit")
	end
end

function StealService.OnDeath(player: Player)
	if thefts[player] then
		StealService.Cancel(player, "died")
	end
end

function StealService.OnPlayerRemoving(player: Player)
	if thefts[player] then
		StealService.Cancel(player, "left")
	end
	for thief, theft in thefts do
		if theft.Victim == player then
			StealService.Cancel(thief, "left")
			Net.Notify(thief, "The owner left. The slime vanished!", "Error")
		end
	end
	cooldowns[player] = nil
end

-- Cancela robos de un jugador concreto (p.ej. al hacer rebirth)
function StealService.CancelAllFor(victim: Player)
	for thief, theft in thefts do
		if theft.Victim == victim then
			StealService.Cancel(thief, "reset")
		end
	end
end

return StealService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="39">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="40">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">90</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="41">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="43">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">Animator</string>
              <string name="Source"><![CDATA[-- Animaciones locales (no cuestan red): slimes que botan, arcoíris, glitch,
-- textos con degradado animado y monedas girando.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Animator = {}

type BodyEntry = { Mesh: SpecialMesh, Part: BasePart, Phase: number, Speed: number }

local bodies: { [BasePart]: BodyEntry } = {}
local rainbowParts: { [BasePart]: number } = {}
local glitchParts: { [BasePart]: boolean } = {}
local gradients: { [UIGradient]: boolean } = {}
local coins: { [BasePart]: CFrame } = {}

local MAX_ANIM_DISTANCE = 140

local function track(tagName: string, onAdded: (Instance) -> (), onRemoved: (Instance) -> ())
	CollectionService:GetInstanceAddedSignal(tagName):Connect(onAdded)
	CollectionService:GetInstanceRemovedSignal(tagName):Connect(onRemoved)
	for _, instance in CollectionService:GetTagged(tagName) do
		onAdded(instance)
	end
end

function Animator.Init()
	track("SlimeBody", function(instance)
		if instance:IsA("BasePart") then
			local mesh = instance:FindFirstChildOfClass("SpecialMesh")
			if mesh then
				bodies[instance] = { Mesh = mesh, Part = instance, Phase = math.random() * math.pi * 2, Speed = 3 + math.random() * 1.5 }
			end
		end
	end, function(instance)
		bodies[instance :: BasePart] = nil
	end)

	track("RainbowPart", function(instance)
		if instance:IsA("BasePart") then
			rainbowParts[instance] = math.random()
		end
	end, function(instance)
		rainbowParts[instance :: BasePart] = nil
	end)

	track("GlitchPart", function(instance)
		if instance:IsA("BasePart") then
			glitchParts[instance] = true
		end
	end, function(instance)
		glitchParts[instance :: BasePart] = nil
	end)

	track("RainbowGradient", function(instance)
		if instance:IsA("UIGradient") then
			gradients[instance] = true
		end
	end, function(instance)
		gradients[instance :: UIGradient] = nil
	end)

	track("Coin", function(instance)
		if instance:IsA("BasePart") then
			coins[instance] = instance.CFrame
		end
	end, function(instance)
		coins[instance :: BasePart] = nil
	end)

	local glitchTimer = 0
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		local camera = Workspace.CurrentCamera
		local cameraPos = if camera then camera.CFrame.Position else Vector3.zero

		for part, entry in bodies do
			if part.Parent == nil then
				bodies[part] = nil
			elseif (part.Position - cameraPos).Magnitude < MAX_ANIM_DISTANCE then
				local s = math.sin(t * entry.Speed + entry.Phase) * 0.06
				entry.Mesh.Scale = Vector3.new(1 + s, 1 - s, 1 + s)
			end
		end

		for part, offset in rainbowParts do
			if part.Parent == nil then
				rainbowParts[part] = nil
			else
				part.Color = Color3.fromHSV((t * 0.25 + offset) % 1, 0.65, 1)
			end
		end

		for gradient in gradients do
			if gradient.Parent == nil then
				gradients[gradient] = nil
			else
				gradient.Offset = Vector2.new(((t * 0.6) % 2) - 1, 0)
			end
		end

		for coin in coins do
			if coin.Parent == nil then
				coins[coin] = nil
			else
				coin.CFrame = CFrame.new(coin.Position) * CFrame.Angles(0, t * 3, 0)
			end
		end

		glitchTimer += dt
		if glitchTimer > 0.12 then
			glitchTimer = 0
			for part in glitchParts do
				if part.Parent == nil then
					glitchParts[part] = nil
				else
					part.Transparency = if math.random() < 0.3 then 1 else 0
				end
			end
		end
	end)
end

return Animator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">Combat</string>
              <string name="Source"><![CDATA[-- Aplica el empujón (knockback) cuando otro jugador te golpea con el bate.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

local Modules = script.Parent.Parent.Modules
local Sound = require(Modules.Sound)

local Combat = {}

local player = Players.LocalPlayer
local stunnedUntil = 0

function Combat.Init()
	Remotes.Event("Knockback").OnClientEvent:Connect(function(velocity)
		if typeof(velocity) ~= "Vector3" then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not humanoid then
			return
		end
		Sound.Play("Hit", 0.6)
		stunnedUntil = os.clock() + 1.1
		humanoid.PlatformStand = true
		root.AssemblyLinearVelocity = velocity
		root.AssemblyAngularVelocity = Vector3.new(math.random(-8, 8), math.random(-4, 4), math.random(-8, 8))
		task.delay(1.15, function()
			if os.clock() >= stunnedUntil and humanoid.Parent then
				humanoid.PlatformStand = false
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)
	end)
end

return Combat
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- Efectos visuales y de sonido que pide el servidor (remote "Effect").

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Format"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local Sound = require(Modules.Sound)

local Windows = require(script.Parent.Windows)
local HUD = require(script.Parent.HUD)
local Notifications = require(script.Parent.Notifications)

local Effects = {}

local effectsRoot: Frame
local CONFETTI_COLORS = {
	Color3.fromRGB(255, 90, 90),
	Color3.fromRGB(255, 220, 80),
	Color3.fromRGB(90, 255, 140),
	Color3.fromRGB(90, 180, 255),
	Color3.fromRGB(220, 110, 255),
}

function Effects.FloatingText(position: Vector3, text: string, color: Color3?)
	local attachment = Instance.new("Attachment")
	attachment.WorldPosition = position
	attachment.Parent = Workspace.Terrain
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(6, 0, 1.6, 0)
	gui.StudsOffset = Vector3.new(0, 2, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = attachment
	local label = UI.Text({ Text = text, TextColor3 = color or UI.Colors.Cash, StrokeThickness = 3, Parent = gui })
	UI.Tween(gui, 1, { StudsOffset = Vector3.new(0, 6, 0) })
	task.delay(0.5, function()
		UI.Tween(label, 0.5, { TextTransparency = 1 })
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			UI.Tween(stroke, 0.5, { Transparency = 1 })
		end
	end)
	task.delay(1.1, function()
		attachment:Destroy()
	end)
end

function Effects.Confetti(amount: number?)
	local count = amount or 45
	for _ = 1, count do
		local size = math.random(10, 18)
		local piece = UI.New("Frame", {
			BackgroundColor3 = CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)],
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(size, size * 0.6),
			Position = UDim2.new(math.random(), 0, 0, -20),
			Rotation = math.random(0, 360),
			Parent = effectsRoot,
		})
		local duration = 1.6 + math.random() * 1.2
		UI.Tween(piece, duration, {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1, 40),
			Rotation = piece.Rotation + math.random(-360, 360),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(duration, function()
			piece:Destroy()
		end)
	end
end

function Effects.Flash(color: Color3)
	local flash = UI.New("Frame", {
		BackgroundColor3 = color,
		BackgroundTransparency = 0.2,
		Size = UDim2.fromScale(1, 1),
		Parent = effectsRoot,
	})
	UI.Tween(flash, 0.8, { BackgroundTransparency = 1 })
	task.delay(0.85, function()
		flash:Destroy()
	end)
end

local handlers: { [string]: (payload: { [string]: any }) -> () } = {}

handlers.Sound = function(payload)
	if typeof(payload.Name) == "string" then
		Sound.Play(payload.Name, 0.5)
	end
end

handlers.Collect = function(payload)
	Sound.Play("Cash", 0.45)
	if typeof(payload.Position) == "Vector3" and typeof(payload.Amount) == "number" then
		Effects.FloatingText(payload.Position, "+" .. Format.Money(payload.Amount))
	end
end

handlers.Confetti = function()
	Effects.Confetti()
end

handlers.Rebirth = function(payload)
	Sound.Play("Rebirth", 0.7)
	Effects.Flash(Color3.fromRGB(255, 240, 180))
	Effects.Confetti(70)
	Notifications.Announce(("♻️ REBIRTH %d!"):format(payload.Rebirths or 1), UI.Colors.Yellow, 4)
end

handlers.Offline = function(payload)
	local amount = payload.Amount or 0
	local seconds = payload.Seconds or 0
	task.delay(1.5, function()
		Windows.ShowMessage("💤 WELCOME BACK!", ("While you were away (%s) your slimes made\n%s!"):format(Format.Duration(seconds), Format.Money(amount)), "Collect!", UI.Colors.Green, function()
			Sound.Play("Cash", 0.6)
			Effects.Confetti(30)
		end)
	end)
end

handlers.DailyAvailable = function()
	Notifications.Show("📅 Your daily reward is ready! Open Daily.", "Success")
end

handlers.StealAlarm = function(payload)
	HUD.ShowAlarm(tostring(payload.Thief or "Someone"), tostring(payload.Slime or "slime"))
end

handlers.StealResolved = function()
	HUD.HideAlarm()
end

function Effects.Init()
	local _, root = UI.Screen("SlimeHeistEffects", 25)
	effectsRoot = root
	Remotes.Event("Effect").OnClientEvent:Connect(function(name, payload)
		local handler = handlers[name]
		if handler then
			local ok, err = pcall(handler, if typeof(payload) == "table" then payload else {})
			if not ok then
				warn("[Effects] " .. tostring(err))
			end
		end
	end)
	local _ = Players
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[-- HUD principal: dinero, ingresos, botones del menú, estado del candado, eventos,
-- aviso de robo y guía (rayo) hacia tu base cuando llevas un slime robado.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Config = require(Shared:WaitForChild("Config"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local State = require(Modules.State)
local Sound = require(Modules.Sound)

local Windows = require(script.Parent.Windows)

local HUD = {}

local player = Players.LocalPlayer

local cashLabel: TextLabel
local incomeLabel: TextLabel
local boostLabel: TextLabel
local eventFrame: Frame
local eventLabels: { TextLabel } = {}
local lockLabel: TextLabel
local carryBanner: Frame
local carryLabel: TextLabel
local alarmFrame: Frame
local alarmLabel: TextLabel
local badges: { [string]: Frame } = {}

local hintPanel: Frame
local hintLabel: TextLabel
local displayedCash = 0
local stealHintUntil = 0
local alarmActive = false
local homeBeam: Beam? = nil
local beamAttachments: { Attachment } = {}

local MENU_BUTTONS = {
	{ Name = "Shop", Icon = "🛒", Label = "Shop", Color = UI.Colors.Green },
	{ Name = "Store", Icon = "💎", Label = "Store", Color = UI.Colors.Pink },
	{ Name = "Rebirth", Icon = "♻️", Label = "Rebirth", Color = UI.Colors.Yellow },
	{ Name = "Index", Icon = "📖", Label = "Index", Color = UI.Colors.Purple },
	{ Name = "Gifts", Icon = "🎁", Label = "Gifts", Color = UI.Colors.Orange },
	{ Name = "Daily", Icon = "📅", Label = "Daily", Color = UI.Colors.Blue },
	{ Name = "Codes", Icon = "🎟️", Label = "Codes", Color = UI.Colors.Cyan },
}

local function menuButton(parent: Instance, def: { [string]: any }, order: number)
	local button = UI.Button({
		Name = def.Name,
		Text = "",
		Color = def.Color,
		Size = UDim2.fromOffset(84, 84),
		LayoutOrder = order,
		OnClick = function()
			Windows.Toggle(def.Name)
		end,
		Parent = parent,
	})
	UI.Text({ Name = "Icon", Text = def.Icon, Size = UDim2.new(1, 0, 0.55, 0), Position = UDim2.fromScale(0, 0.06), StrokeThickness = 0, Parent = button })
	UI.Text({ Name = "Caption", Text = def.Label, Size = UDim2.new(1, -6, 0.3, 0), Position = UDim2.new(0, 3, 0.64, 0), Parent = button })

	local badge = UI.Panel({
		Name = "Badge",
		Color = UI.Colors.Red,
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.new(1, 6, 0, -6),
		AnchorPoint = Vector2.new(1, 0),
		CornerRadius = 14,
		Visible = false,
		ZIndex = 3,
		Parent = button,
	})
	UI.Text({ Name = "Count", Text = "!", Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 4, Parent = badge })
	badges[def.Name] = badge
end

function HUD.SetBadge(name: string, text: string?)
	local badge = badges[name]
	if not badge then
		return
	end
	badge.Visible = text ~= nil
	local count = badge:FindFirstChild("Count")
	if count and count:IsA("TextLabel") and text then
		count.Text = text
	end
end

-- ---------------------------------------------------------------------
-- Construcción
-- ---------------------------------------------------------------------
local function buildCashPanel(root: Frame)
	local panel = UI.Panel({
		Name = "CashPanel",
		Color = UI.Colors.PanelDark,
		Size = UDim2.fromOffset(330, 92),
		Position = UDim2.new(0.5, 0, 0, 10),
		AnchorPoint = Vector2.new(0.5, 0),
		CornerRadius = 18,
		BackgroundTransparency = 0.15,
		Parent = root,
	})
	cashLabel = UI.Text({ Name = "Cash", Text = "$0", Size = UDim2.new(1, -20, 0, 48), Position = UDim2.new(0.5, 0, 0, 6), AnchorPoint = Vector2.new(0.5, 0), TextColor3 = UI.Colors.Cash, StrokeThickness = 3, Parent = panel })
	incomeLabel = UI.Text({ Name = "Income", Text = "+$0/s", Size = UDim2.new(0.6, 0, 0, 26), Position = UDim2.new(0.5, 0, 0, 56), AnchorPoint = Vector2.new(0.5, 0), TextColor3 = Color3.fromRGB(255, 255, 255), Parent = panel })
	boostLabel = UI.Text({ Name = "Boost", Text = "", Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0.5, 0, 1, 6), AnchorPoint = Vector2.new(0.5, 0), TextColor3 = UI.Colors.Yellow, Visible = false, Parent = panel })
end

local function buildEventFrame(root: Frame)
	eventFrame = UI.New("Frame", {
		Name = "Events",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(460, 64),
		Position = UDim2.new(0.5, 0, 0, 132),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = root,
	})
	UI.List(Enum.FillDirection.Vertical, 2).Parent = eventFrame
	for i = 1, 3 do
		local label = UI.Text({ Name = "Event" .. i, Text = "", Size = UDim2.new(1, 0, 0, 22), LayoutOrder = i, Visible = false, Parent = eventFrame })
		eventLabels[i] = label
	end
end

local function buildMenu(root: Frame)
	local menu = UI.New("Frame", {
		Name = "Menu",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(186, 380),
		Position = UDim2.new(0, 14, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Parent = root,
	})
	local grid = UI.Grid(UDim2.fromOffset(84, 84), 12)
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Left
	grid.Parent = menu
	for index, def in MENU_BUTTONS do
		menuButton(menu, def, index)
	end
end

local function buildRightSide(root: Frame)
	local side = UI.New("Frame", {
		Name = "Right",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(190, 160),
		Position = UDim2.new(1, -14, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Parent = root,
	})
	UI.List(Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Right).Parent = side
	UI.Button({
		Name = "Home",
		Text = "🏠 Home",
		Color = UI.Colors.Blue,
		Size = UDim2.fromOffset(170, 58),
		LayoutOrder = 1,
		OnClick = function()
			local ok, message = State.Action("Home")
			if not ok and message then
				require(script.Parent.Notifications).Show(message, "Error")
			end
		end,
		Parent = side,
	})
	local lockPanel = UI.Panel({ Name = "LockStatus", Color = UI.Colors.PanelDark, Size = UDim2.fromOffset(170, 50), LayoutOrder = 2, BackgroundTransparency = 0.15, Parent = side })
	lockLabel = UI.Text({ Text = "🔓 Base open", Size = UDim2.new(1, -16, 0.7, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = lockPanel })
end

local function buildCarryBanner(root: Frame)
	carryBanner = UI.Panel({
		Name = "Carry",
		Color = Color3.fromRGB(200, 40, 60),
		Size = UDim2.fromOffset(520, 56),
		Position = UDim2.new(0.5, 0, 0, 210),
		AnchorPoint = Vector2.new(0.5, 0),
		Visible = false,
		Parent = root,
	})
	carryLabel = UI.Text({ Text = "", Size = UDim2.new(1, -20, 0.7, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = carryBanner })
end

local function buildAlarm(root: Frame)
	alarmFrame = UI.New("Frame", {
		Name = "Alarm",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = root,
	})
	local border = UI.Stroke(18, Color3.fromRGB(255, 30, 50), true)
	border.Parent = alarmFrame
	alarmLabel = UI.Text({
		Text = "",
		TextColor3 = Color3.fromRGB(255, 90, 90),
		Size = UDim2.new(0.8, 0, 0, 46),
		Position = UDim2.new(0.5, 0, 0, 262),
		AnchorPoint = Vector2.new(0.5, 0),
		StrokeThickness = 3,
		Parent = alarmFrame,
	})
end

local function buildHint(root: Frame)
	hintPanel = UI.Panel({
		Name = "Hint",
		Color = UI.Colors.PanelDark,
		Size = UDim2.fromOffset(620, 54),
		Position = UDim2.new(0.5, 0, 1, -36),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = root,
	})
	hintLabel = UI.Text({ Text = "", Size = UDim2.new(1, -24, 0.7, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), TextColor3 = UI.Colors.Yellow, Parent = hintPanel })
end

-- Pistas para jugadores nuevos (se ocultan solas al completar cada paso)
local function updateHint(now: number)
	local data = State.Data
	local text: string? = nil
	if data and data.Stats then
		local bought = data.Stats.Bought or 0
		if bought == 0 and (data.Rebirths or 0) == 0 then
			text = "👉 Go to the runway and press E on a slime to BUY it!"
		elseif bought <= 2 and (data.TotalEarned or 0) < 60 and (data.Rebirths or 0) == 0 then
			text = "💵 Step on the GREEN pad in front of your slime to collect cash!"
		elseif bought >= 3 and (data.Stats.Steals or 0) == 0 and (data.Rebirths or 0) == 0 then
			if stealHintUntil == 0 then
				stealHintUntil = now + 25
			end
			if now < stealHintUntil then
				text = "😈 Steal slimes from other bases! 🔒 Step on your red button to lock yours."
			end
		end
	end
	hintPanel.Visible = text ~= nil and player:GetAttribute("Carrying") == nil
	if text then
		hintLabel.Text = text
	end
end

-- ---------------------------------------------------------------------
-- Rayo guía hacia tu base
-- ---------------------------------------------------------------------
local function clearBeam()
	if homeBeam then
		homeBeam:Destroy()
		homeBeam = nil
	end
	for _, attachment in beamAttachments do
		attachment:Destroy()
	end
	table.clear(beamAttachments)
end

local function showBeam()
	clearBeam()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local plotIndex = player:GetAttribute("PlotIndex")
	local map = Workspace:FindFirstChild("Map")
	local plots = map and map:FindFirstChild("Plots")
	local plot = plots and plots:FindFirstChild("Plot" .. tostring(plotIndex))
	local floor = plot and plot:FindFirstChild("Floor")
	if not root or not floor then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, 3, 0)
	a1.Parent = floor
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0 = 1.2
	beam.Width1 = 1.2
	beam.FaceCamera = true
	beam.Color = ColorSequence.new(Color3.fromRGB(90, 255, 120))
	beam.Transparency = NumberSequence.new(0.25)
	beam.LightEmission = 1
	beam.Segments = 1
	beam.Parent = a0
	homeBeam = beam
	beamAttachments = { a0, a1 }
end

-- ---------------------------------------------------------------------
-- Actualizaciones
-- ---------------------------------------------------------------------
local function updateCarry()
	local carrying = player:GetAttribute("Carrying")
	if typeof(carrying) == "string" then
		carryBanner.Visible = true
		carryLabel.Text = "😈 RUN TO YOUR BASE! Carrying " .. carrying
		showBeam()
	else
		carryBanner.Visible = false
		clearBeam()
	end
end

function HUD.ShowAlarm(thief: string, slime: string)
	alarmActive = true
	alarmFrame.Visible = true
	alarmLabel.Text = ("⚠️ %s IS STEALING YOUR %s!"):format(string.upper(thief), string.upper(slime))
	task.spawn(function()
		while alarmActive do
			Sound.Play("Alarm", 0.5)
			local border = alarmFrame:FindFirstChildOfClass("UIStroke")
			if border then
				border.Transparency = 0
				UI.Tween(border, 0.5, { Transparency = 0.7 })
			end
			task.wait(0.6)
		end
	end)
end

function HUD.HideAlarm()
	alarmActive = false
	alarmFrame.Visible = false
end

local function updateTimers()
	local now = Workspace:GetServerTimeNow()

	-- Candado
	local lockEnds = player:GetAttribute("LockEndsAt") or 0
	local cooldownEnds = player:GetAttribute("LockCooldownEndsAt") or 0
	if lockEnds > now then
		lockLabel.Text = ("🔒 Locked %ds"):format(math.ceil(lockEnds - now))
		lockLabel.TextColor3 = UI.Colors.Cash
	elseif cooldownEnds > now then
		lockLabel.Text = ("⏳ Lock in %ds"):format(math.ceil(cooldownEnds - now))
		lockLabel.TextColor3 = UI.Colors.Yellow
	else
		lockLabel.Text = "🔓 Base open"
		lockLabel.TextColor3 = Color3.fromRGB(255, 140, 140)
	end

	-- Boost
	local boost = player:GetAttribute("BoostCashX2") or 0
	boostLabel.Visible = boost > 0
	if boost > 0 then
		boostLabel.Text = "⏫ 2x CASH " .. Format.Clock(boost)
	end

	-- Eventos
	local lines = {}
	local luckEnds = Workspace:GetAttribute("ServerLuckEndsAt") or 0
	if luckEnds > now then
		table.insert(lines, { Text = ("🍀 SERVER LUCK x%d  •  %s"):format(Config.ServerLuck.Multiplier, Format.Clock(luckEnds - now)), Color = Color3.fromRGB(110, 255, 140) })
	end
	local adminEnds = Workspace:GetAttribute("AdminLuckEndsAt") or 0
	if adminEnds > now then
		table.insert(lines, { Text = ("👑 ADMIN LUCK x%s  •  %s"):format(tostring(Workspace:GetAttribute("AdminLuck") or 1), Format.Clock(adminEnds - now)), Color = Color3.fromRGB(255, 130, 230) })
	end
	local eventTitle = Workspace:GetAttribute("EventTitle")
	local eventEnds = Workspace:GetAttribute("EventEndsAt") or 0
	if typeof(eventTitle) == "string" and eventEnds > now then
		table.insert(lines, { Text = ("%s  •  %s"):format(eventTitle, Format.Clock(eventEnds - now)), Color = Color3.fromRGB(255, 225, 90) })
	end
	for i, label in eventLabels do
		local line = lines[i]
		label.Visible = line ~= nil
		if line then
			label.Text = line.Text
			label.TextColor3 = line.Color
		end
	end

	updateHint(now)

	-- Insignias
	local data = State.Data
	if data then
		local ready = 0
		local elapsed = now - (data.SessionStart or now)
		for index, gift in Config.PlaytimeGifts do
			if not (data.GiftsClaimed and data.GiftsClaimed[tostring(index)]) and elapsed >= gift.Minutes * 60 then
				ready += 1
			end
		end
		HUD.SetBadge("Gifts", if ready > 0 then tostring(ready) else nil)
		HUD.SetBadge("Daily", if data.DailyAvailable then "!" else nil)
		local cost = data.RebirthCost or math.huge
		HUD.SetBadge("Rebirth", if State.Cash() >= cost then "!" else nil)
	end
end

function HUD.Init()
	local _, root = UI.Screen("SlimeHeistHUD", 5)
	buildCashPanel(root)
	buildEventFrame(root)
	buildMenu(root)
	buildRightSide(root)
	buildCarryBanner(root)
	buildAlarm(root)
	buildHint(root)

	player:GetAttributeChangedSignal("Income"):Connect(function()
		incomeLabel.Text = "+" .. Format.PerSecond(player:GetAttribute("Income") or 0)
	end)
	player:GetAttributeChangedSignal("Carrying"):Connect(updateCarry)
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		updateCarry()
	end)

	-- Contador de dinero animado
	displayedCash = State.Cash()
	RunService.RenderStepped:Connect(function(dt)
		local target = State.Cash()
		if math.abs(target - displayedCash) < 1 then
			displayedCash = target
		else
			displayedCash += (target - displayedCash) * math.clamp(dt * 10, 0, 1)
		end
		cashLabel.Text = Format.Money(displayedCash)
	end)

	State.Observe(function(data)
		incomeLabel.Text = "+" .. Format.PerSecond(data.Income or 0)
	end)

	task.spawn(function()
		while true do
			local ok, err = pcall(updateTimers)
			if not ok then
				warn("[HUD] " .. tostring(err))
			end
			task.wait(0.25)
		end
	end)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[-- Notificaciones (toasts abajo) y anuncios grandes (arriba, para rarezas/eventos).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local Sound = require(Modules.Sound)

local Notifications = {}

local KIND_COLORS = {
	Info = UI.Colors.Blue,
	Success = UI.Colors.Green,
	Error = UI.Colors.Red,
	Warning = UI.Colors.Orange,
	Cash = Color3.fromRGB(70, 200, 110),
}

local toastContainer: Frame
local announceContainer: Frame
local MAX_TOASTS = 5
local toastOrder = 0

function Notifications.Show(text: string, kind: string?)
	local color = KIND_COLORS[kind or "Info"] or UI.Colors.Blue
	toastOrder += 1
	local toast = UI.Panel({
		Name = "Toast",
		Color = UI.Darken(color, 0.15),
		Size = UDim2.new(1, 0, 0, 44),
		LayoutOrder = toastOrder,
		BackgroundTransparency = 0.05,
		CornerRadius = 12,
		Parent = toastContainer,
	})
	UI.Gradient(Color3.fromRGB(255, 255, 255), Color3.fromRGB(205, 205, 205)).Parent = toast
	local label = UI.Text({
		Text = text,
		Size = UDim2.new(1, -20, 0.72, 0),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = toast,
	})
	local scale = UI.New("UIScale", { Scale = 0.6, Parent = toast })
	UI.Tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)

	if kind == "Error" then
		Sound.Play("Error", 0.4)
	end

	local toasts = {}
	for _, child in toastContainer:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > MAX_TOASTS then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for i = 1, #toasts - MAX_TOASTS do
			toasts[i]:Destroy()
		end
	end

	task.delay(3.6, function()
		if toast.Parent then
			UI.Tween(toast, 0.35, { BackgroundTransparency = 1 })
			UI.Tween(label, 0.35, { TextTransparency = 1 })
			local stroke = label:FindFirstChildOfClass("UIStroke")
			if stroke then
				UI.Tween(stroke, 0.35, { Transparency = 1 })
			end
			local border = toast:FindFirstChildOfClass("UIStroke")
			if border then
				UI.Tween(border, 0.35, { Transparency = 1 })
			end
			task.wait(0.4)
			toast:Destroy()
		end
	end)
end

function Notifications.Announce(text: string, color: Color3?, duration: number?)
	announceContainer:ClearAllChildren()
	local label = UI.Text({
		Name = "Announcement",
		Text = text,
		TextColor3 = color or UI.Colors.Text,
		Size = UDim2.fromScale(1, 1),
		StrokeThickness = 3,
		Parent = announceContainer,
	})
	local scale = UI.New("UIScale", { Scale = 0.3, Parent = label })
	UI.Tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(duration or 4, function()
		if label.Parent then
			UI.Tween(label, 0.4, { TextTransparency = 1 })
			local stroke = label:FindFirstChildOfClass("UIStroke")
			if stroke then
				UI.Tween(stroke, 0.4, { Transparency = 1 })
			end
			task.wait(0.45)
			label:Destroy()
		end
	end)
end

function Notifications.Init()
	local _, root = UI.Screen("SlimeHeistNotifications", 30)

	toastContainer = UI.New("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -100),
		Size = UDim2.fromOffset(560, 260),
		Parent = root,
	})
	UI.List(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom).Parent = toastContainer

	announceContainer = UI.New("Frame", {
		Name = "Announcements",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 175),
		Size = UDim2.new(0.8, 0, 0, 48),
		Parent = root,
	})

	Remotes.Event("Notify").OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" and typeof(payload.Text) == "string" then
			Notifications.Show(payload.Text, payload.Kind)
		end
	end)
	Remotes.Event("Announce").OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" and typeof(payload.Text) == "string" then
			Notifications.Announce(payload.Text, payload.Color, payload.Duration)
		end
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Prompts</string>
              <string name="Source"><![CDATA[-- Muestra a cada jugador solo los prompts que le tocan:
-- el dueño ve "Sell", los demás ven "Steal".

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Prompts = {}

local player = Players.LocalPlayer

local function apply(prompt: Instance)
	if not prompt:IsA("ProximityPrompt") then
		return
	end
	local role = prompt:GetAttribute("Role")
	local ownerId = prompt:GetAttribute("OwnerUserId")
	local isOwner = ownerId == player.UserId
	if role == "Owner" then
		prompt.Enabled = isOwner
	elseif role == "Thief" then
		prompt.Enabled = not isOwner
	end
end

function Prompts.Init()
	CollectionService:GetInstanceAddedSignal("RolePrompt"):Connect(apply)
	for _, prompt in CollectionService:GetTagged("RolePrompt") do
		apply(prompt)
	end
end

return Prompts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Windows</string>
              <string name="Source"><![CDATA[-- Gestor de ventanas (una abierta a la vez) con el marco común: cabecera, título y botón de cerrar.

local Modules = script.Parent.Parent.Modules
local UI = require(Modules.UI)
local State = require(Modules.State)

local Windows = {}

export type Window = {
	Name: string,
	Frame: Frame,
	Content: Frame,
	Header: Frame,
	Title: TextLabel,
	Scale: UIScale,
}

export type WindowModule = {
	Title: string,
	Color: Color3,
	Size: UDim2?,
	Build: (window: Window) -> (),
	Refresh: ((data: { [string]: any }) -> ())?,
	Tick: (() -> ())?,
	OnOpen: (() -> ())?,
}

type Entry = { Module: WindowModule, Window: Window? }

local entries: { [string]: Entry } = {}
local current: string? = nil
local root: Frame
local dim: TextButton

Windows.Opened = nil :: ((name: string?) -> ())?

local function createWindow(name: string, module: WindowModule): Window
	local frame = UI.Panel({
		Name = name,
		Size = module.Size or UDim2.fromOffset(660, 450),
		Position = UDim2.fromScale(0.5, 0.52),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = UI.Colors.Panel,
		CornerRadius = 20,
		Visible = false,
		ZIndex = 2,
		Parent = root,
	})
	UI.Gradient(Color3.fromRGB(255, 255, 255), Color3.fromRGB(215, 215, 228)).Parent = frame

	local header = UI.New("Frame", {
		Name = "Header",
		BackgroundColor3 = module.Color,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 60),
		ZIndex = 2,
		Parent = frame,
	})
	UI.Corner(20).Parent = header
	UI.Gradient(Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 190, 190)).Parent = header
	-- Relleno para que las esquinas de abajo de la cabecera queden rectas
	UI.New("Frame", {
		Name = "Filler",
		BackgroundColor3 = module.Color,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 1, -20),
		ZIndex = 2,
		Parent = header,
	}, { UI.Gradient(Color3.fromRGB(205, 205, 205), Color3.fromRGB(190, 190, 190)) })

	local title = UI.Text({
		Name = "Title",
		Text = module.Title,
		Size = UDim2.new(1, -90, 0, 40),
		Position = UDim2.new(0, 20, 0, 10),
		TextXAlignment = Enum.TextXAlignment.Left,
		StrokeThickness = 3,
		ZIndex = 3,
		Parent = header,
	})

	local close = UI.Button({
		Name = "Close",
		Text = "X",
		Color = UI.Colors.Red,
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.new(1, -10, 0, 7),
		AnchorPoint = Vector2.new(1, 0),
		OnClick = function()
			Windows.Close()
		end,
		Parent = header,
	})
	close.ZIndex = 3

	local content = UI.New("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 72),
		Size = UDim2.new(1, -32, 1, -86),
		ZIndex = 2,
		Parent = frame,
	})

	local scale = UI.New("UIScale", { Scale = 1, Parent = frame })
	return { Name = name, Frame = frame, Content = content, Header = header, Title = title, Scale = scale }
end

function Windows.Register(name: string, module: WindowModule)
	entries[name] = { Module = module, Window = nil }
end

function Windows.GetWindow(name: string): Window?
	local entry = entries[name]
	return entry and entry.Window
end

function Windows.IsOpen(name: string): boolean
	return current == name
end

function Windows.Open(name: string)
	local entry = entries[name]
	if not entry or current == name then
		return
	end
	if current then
		Windows.Close(true)
	end
	if not entry.Window then
		entry.Window = createWindow(name, entry.Module)
		entry.Module.Build(entry.Window :: Window)
	end
	local window = entry.Window :: Window
	current = name
	dim.Visible = true
	UI.Tween(dim, 0.2, { BackgroundTransparency = 0.55 })
	window.Frame.Visible = true
	window.Scale.Scale = 0.6
	UI.Tween(window.Scale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
	if entry.Module.OnOpen then
		entry.Module.OnOpen()
	end
	if entry.Module.Refresh and State.Data then
		entry.Module.Refresh(State.Data)
	end
	if Windows.Opened then
		Windows.Opened(name)
	end
end

function Windows.Close(instant: boolean?)
	if not current then
		return
	end
	local entry = entries[current]
	current = nil
	local window = entry and entry.Window
	if window then
		if instant then
			window.Frame.Visible = false
		else
			local tween = UI.Tween(window.Scale, 0.15, { Scale = 0.7 })
			tween.Completed:Once(function()
				if current ~= window.Name then
					window.Frame.Visible = false
				end
			end)
		end
	end
	if not instant then
		UI.Tween(dim, 0.15, { BackgroundTransparency = 1 })
		task.delay(0.16, function()
			if not current then
				dim.Visible = false
			end
		end)
	end
	if Windows.Opened then
		Windows.Opened(nil)
	end
end

function Windows.Toggle(name: string)
	if current == name then
		Windows.Close()
	else
		Windows.Open(name)
	end
end

-- Ventana de mensaje genérica (ganancias offline, avisos...)
local messageModule: WindowModule
local messageBody: TextLabel
local messageButton: TextButton
local messageButtonLabel: TextLabel
local messageCallback: (() -> ())? = nil

messageModule = {
	Title = "MESSAGE",
	Color = UI.Colors.Blue,
	Size = UDim2.fromOffset(500, 300),
	Build = function(window)
		messageBody = UI.Text({
			Name = "Body",
			Text = "",
			Size = UDim2.new(1, -20, 0, 120),
			Position = UDim2.new(0.5, 0, 0, 10),
			AnchorPoint = Vector2.new(0.5, 0),
			TextWrapped = true,
			Parent = window.Content,
		})
		messageButton, messageButtonLabel = UI.Button({
			Text = "OK",
			Color = UI.Colors.Green,
			Size = UDim2.fromOffset(200, 56),
			Position = UDim2.new(0.5, 0, 1, -8),
			AnchorPoint = Vector2.new(0.5, 1),
			OnClick = function()
				Windows.Close()
				if messageCallback then
					messageCallback()
				end
			end,
			Parent = window.Content,
		})
	end,
}

function Windows.ShowMessage(title: string, body: string, buttonText: string?, color: Color3?, callback: (() -> ())?)
	if current == "Message" then
		Windows.Close(true)
	end
	Windows.Open("Message")
	local window = Windows.GetWindow("Message")
	if not window then
		return
	end
	window.Title.Text = title
	window.Header.BackgroundColor3 = color or UI.Colors.Blue
	local filler = window.Header:FindFirstChild("Filler")
	if filler and filler:IsA("Frame") then
		filler.BackgroundColor3 = color or UI.Colors.Blue
	end
	messageBody.Text = body
	messageButtonLabel.Text = buttonText or "OK"
	messageCallback = callback
	local _ = messageButton
end

function Windows.Init()
	local _, screenRoot = UI.Screen("SlimeHeistWindows", 10)
	root = screenRoot
	dim = UI.New("TextButton", {
		Name = "Dim",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Visible = false,
		ZIndex = 1,
		Parent = root,
	})
	dim.Activated:Connect(function()
		Windows.Close()
	end)

	Windows.Register("Message", messageModule)

	State.Changed:Connect(function(data)
		if current then
			local entry = entries[current]
			if entry and entry.Window and entry.Module.Refresh then
				entry.Module.Refresh(data)
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			if current then
				local entry = entries[current]
				if entry and entry.Window and entry.Module.Tick then
					local ok, err = pcall(entry.Module.Tick)
					if not ok then
						warn("[Windows] Tick error: " .. tostring(err))
					end
				end
			end
		end
	end)
end

return Windows
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="51">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Punto de entrada del cliente: inicializa estado, UI y controladores.

local Client = script.Parent
local Modules = Client:WaitForChild("Modules")
local Controllers = Client:WaitForChild("Controllers")
local WindowModules = Client:WaitForChild("Windows")

local State = require(Modules:WaitForChild("State"))
local Purchase = require(Modules:WaitForChild("Purchase"))

local Notifications = require(Controllers:WaitForChild("Notifications"))
local Windows = require(Controllers:WaitForChild("Windows"))
local HUD = require(Controllers:WaitForChild("HUD"))
local Effects = require(Controllers:WaitForChild("Effects"))
local Prompts = require(Controllers:WaitForChild("Prompts"))
local Animator = require(Controllers:WaitForChild("Animator"))
local Combat = require(Controllers:WaitForChild("Combat"))

State.Init()
Notifications.Init()
Purchase.Notify = Notifications.Show

Windows.Init()
for _, name in { "Shop", "Store", "Rebirth", "Index", "Gifts", "Daily", "Codes" } do
	Windows.Register(name, require(WindowModules:WaitForChild(name)))
end

HUD.Init()
Effects.Init()
Prompts.Init()
Animator.Init()
Combat.Init()
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="52">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Purchase</string>
              <string name="Source"><![CDATA[-- Compras con Robux desde el cliente (con simulación en Studio si el Id es 0).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared:WaitForChild("Products"))

local State = require(script.Parent.State)

local Purchase = {}

local player = Players.LocalPlayer
local priceCache: { [string]: number } = {}
local pending: { [string]: boolean } = {}

-- Se asigna desde Main para poder mostrar mensajes sin dependencias circulares
Purchase.Notify = nil :: ((text: string, kind: string?) -> ())?

local function notify(text: string, kind: string?)
	if Purchase.Notify then
		Purchase.Notify(text, kind)
	end
end

function Purchase.PromptPass(key: string)
	local def = Products.GamePasses[key]
	if not def then
		return
	end
	if def.Id ~= 0 then
		MarketplaceService:PromptGamePassPurchase(player, def.Id)
	elseif State.Data and State.Data.SimulatePurchases then
		local ok, message = State.Action("SimulatePurchase", { Kind = "Pass", Key = key })
		notify(message or "Done", if ok then "Success" else "Error")
	else
		notify("Coming soon!", "Info")
	end
end

function Purchase.PromptProduct(key: string)
	local def = Products.DevProducts[key]
	if not def then
		return
	end
	if def.Id ~= 0 then
		MarketplaceService:PromptProductPurchase(player, def.Id)
	elseif State.Data and State.Data.SimulatePurchases then
		local ok, message = State.Action("SimulatePurchase", { Kind = "Product", Key = key })
		notify(message or "Done", if ok then "Success" else "Error")
	else
		notify("Coming soon!", "Info")
	end
end

-- Precio en Robux (real si hay Id, si no el PriceHint). Llama a callback cuando lo sabe.
function Purchase.GetPrice(kind: string, key: string, callback: (price: number) -> ())
	local def: any = if kind == "Pass" then Products.GamePasses[key] else Products.DevProducts[key]
	if not def then
		return
	end
	local cacheKey = kind .. key
	if priceCache[cacheKey] then
		callback(priceCache[cacheKey])
		return
	end
	callback(def.PriceHint)
	if def.Id == 0 or pending[cacheKey] then
		return
	end
	pending[cacheKey] = true
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(def.Id, if kind == "Pass" then Enum.InfoType.GamePass else Enum.InfoType.Product)
		end)
		if ok and info and typeof(info.PriceInRobux) == "number" then
			priceCache[cacheKey] = info.PriceInRobux
			callback(info.PriceInRobux)
		end
	end)
end

return Purchase
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Sound</string>
              <string name="Source"><![CDATA[-- Sonidos locales (solo los oye este jugador).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Sound = {}

local cache: { [string]: Sound } = {}
local lastPlayed: { [string]: number } = {}

function Sound.Play(name: string, volume: number?)
	local id = Config.Sounds[name]
	if not id then
		return
	end
	local now = os.clock()
	if (lastPlayed[name] or 0) + 0.05 > now then
		return
	end
	lastPlayed[name] = now
	local sound = cache[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = name
		sound.SoundId = id
		sound.Parent = SoundService
		cache[name] = sound
	end
	sound.Volume = volume or 0.5
	SoundService:PlayLocalSound(sound)
end

return Sound
]]></string>
