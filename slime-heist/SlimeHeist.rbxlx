      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[-- Fórmulas de economía (puras, sin efectos secundarios). Las usan servidor y cliente.

local Config = require(script.Parent.Config)
local Rarities = require(script.Parent.Rarities)
local Mutations = require(script.Parent.Mutations)
local Slimes = require(script.Parent.Slimes)
local Gear = require(script.Parent.Gear)

local Economy = {}

export type MultiplierContext = {
	Rebirths: number,
	IndexCount: number,
	DoubleCash: boolean,
	VIP: boolean,
	Friends: number,
	Premium: boolean,
	InGroup: boolean,
	Boost: boolean,
	EventMultiplier: number,
}

-- ---------------------------------------------------------------------
-- Slimes
-- ---------------------------------------------------------------------
function Economy.GetSlimePrice(slimeId: string, mutation: string?): number
	local def = Slimes.Get(slimeId)
	if not def then
		return 0
	end
	return def.Price * Mutations.Get(mutation).Multiplier
end

function Economy.GetSlimeIncome(slimeId: string, mutation: string?): number
	local def = Slimes.Get(slimeId)
	if not def then
		return 0
	end
	return def.Income * Mutations.Get(mutation).Multiplier
end

function Economy.GetSellPrice(slimeId: string, mutation: string?): number
	return math.floor(Economy.GetSlimePrice(slimeId, mutation) * Config.Sell.Ratio)
end

-- ---------------------------------------------------------------------
-- Progresión
-- ---------------------------------------------------------------------
function Economy.GetRebirthCost(rebirths: number): number
	return Config.Rebirth.BaseCost * (Config.Rebirth.CostGrowth ^ rebirths)
end

function Economy.GetMaxPhysicalSlots(): number
	return Config.Plots.Columns * Config.Plots.Rows
end

function Economy.GetSlotCount(rebirths: number, hasExtraSlotsPass: boolean): number
	local slots = math.min(Config.Slots.Base + rebirths * Config.Slots.PerRebirth, Config.Slots.MaxFromRebirths)
	if hasExtraSlotsPass then
		slots += Config.Slots.ExtraFromPass
	end
	return math.min(slots, Economy.GetMaxPhysicalSlots())
end

function Economy.GetLockDuration(rebirths: number, lockLevel: number, hasLongerLockPass: boolean): number
	local duration = Config.Lock.BaseDuration + rebirths * Config.Lock.PerRebirth + lockLevel * Config.Lock.PerUpgradeLevel
	if hasLongerLockPass then
		duration += Config.Lock.PassBonus
	end
	return duration
end

function Economy.GetWalkSpeed(speedLevel: number, hasSpeedPass: boolean): number
	local speed = Config.Player.BaseWalkSpeed + speedLevel * Gear.SpeedPerLevel
	if hasSpeedPass then
		speed += Config.Player.SpeedPassBonus
	end
	return speed
end

function Economy.GetUpgradeCost(upgradeKey: string, level: number): number
	local def = Gear.Upgrades[upgradeKey]
	if not def then
		return math.huge
	end
	return math.floor(def.BaseCost * (def.CostGrowth ^ level))
end

-- ---------------------------------------------------------------------
-- Multiplicador de ingresos
-- ---------------------------------------------------------------------
function Economy.GetIncomeMultiplier(ctx: MultiplierContext): (number, { { Label: string, Value: string } })
	local breakdown = {}
	local additive = 1

	if ctx.Rebirths > 0 then
		local bonus = ctx.Rebirths * Config.Rebirth.IncomeBonus
		additive += bonus
		table.insert(breakdown, { Label = "Rebirths", Value = "+" .. math.floor(bonus * 100 + 0.5) .. "%" })
	end
	if ctx.IndexCount > 0 then
		local bonus = ctx.IndexCount * Config.Income.IndexBonusPerEntry
		additive += bonus
		table.insert(breakdown, { Label = "Index", Value = "+" .. string.format("%.1f", bonus * 100) .. "%" })
	end
	if ctx.Friends > 0 then
		local bonus = math.min(ctx.Friends * Config.Income.FriendBonus, Config.Income.MaxFriendBonus)
		additive += bonus
		table.insert(breakdown, { Label = "Friends", Value = "+" .. math.floor(bonus * 100 + 0.5) .. "%" })
	end
	if ctx.VIP then
		additive += Config.Income.VipBonus
		table.insert(breakdown, { Label = "VIP", Value = "+" .. math.floor(Config.Income.VipBonus * 100 + 0.5) .. "%" })
	end
	if ctx.Premium then
		additive += Config.Income.PremiumBonus
		table.insert(breakdown, { Label = "Premium", Value = "+" .. math.floor(Config.Income.PremiumBonus * 100 + 0.5) .. "%" })
	end
	if ctx.InGroup then
		additive += Config.Income.GroupBonus
		table.insert(breakdown, { Label = "Group", Value = "+" .. math.floor(Config.Income.GroupBonus * 100 + 0.5) .. "%" })
	end

	local total = additive
	if ctx.DoubleCash then
		total *= Config.Income.DoubleCash
		table.insert(breakdown, { Label = "2x Cash Pass", Value = "x" .. Config.Income.DoubleCash })
	end
	if ctx.Boost then
		total *= Config.Income.BoostMultiplier
		table.insert(breakdown, { Label = "Cash Boost", Value = "x" .. Config.Income.BoostMultiplier })
	end
	if ctx.EventMultiplier ~= 1 then
		total *= ctx.EventMultiplier
		table.insert(breakdown, { Label = "Event", Value = "x" .. ctx.EventMultiplier })
	end
	return total, breakdown
end

-- ---------------------------------------------------------------------
-- Tiradas aleatorias (rng = Random)
-- ---------------------------------------------------------------------
function Economy.GetRarityWeights(luck: number): { { Name: string, Weight: number } }
	local weights = {}
	for _, rarity in Rarities.List do
		local exponent = (rarity.Order - 1) / 3
		table.insert(weights, { Name = rarity.Name, Weight = rarity.Weight * (luck ^ exponent) })
	end
	return weights
end

function Economy.GetRarityChances(luck: number): { [string]: number }
	local weights = Economy.GetRarityWeights(luck)
	local total = 0
	for _, entry in weights do
		total += entry.Weight
	end
	local chances = {}
	for _, entry in weights do
		chances[entry.Name] = entry.Weight / total
	end
	return chances
end

function Economy.RollRarity(rng: Random, luck: number): string
	local weights = Economy.GetRarityWeights(luck)
	local total = 0
	for _, entry in weights do
		total += entry.Weight
	end
	local roll = rng:NextNumber() * total
	for _, entry in weights do
		roll -= entry.Weight
		if roll <= 0 then
			return entry.Name
		end
	end
	return weights[1].Name
end

-- Dentro de una rareza, los slimes más baratos salen más a menudo.
function Economy.PickSlimeOfRarity(rng: Random, rarityName: string): string
	local list = Slimes.ByRarity[rarityName]
	if not list or #list == 0 then
		return Slimes.List[1].Id
	end
	local total = 0
	for index = 1, #list do
		total += (#list - index + 1)
	end
	local roll = rng:NextNumber() * total
	for index, def in list do
		roll -= (#list - index + 1)
		if roll <= 0 then
			return def.Id
		end
	end
	return list[#list].Id
end

function Economy.RollMutation(rng: Random, mutationLuck: number): string
	local roll = rng:NextNumber()
	local cumulative = 0
	for _, mutation in Mutations.List do
		cumulative += mutation.Chance * mutationLuck
		if roll < cumulative then
			return mutation.Name
		end
	end
	return "Normal"
end

-- ---------------------------------------------------------------------
-- Index
-- ---------------------------------------------------------------------
function Economy.CountIndex(index: { [string]: { [string]: boolean } }?): number
	local count = 0
	if not index then
		return 0
	end
	for slimeId, mutations in index do
		if Slimes.Exists(slimeId) then
			for mutationName, discovered in mutations do
				if discovered and (mutationName == "Normal" or Mutations.Exists(mutationName)) then
					count += 1
				end
			end
		end
	end
	return count
end

function Economy.GetIndexTotal(): number
	return #Slimes.List * (#Mutations.List + 1)
end

-- ---------------------------------------------------------------------
-- Recompensas que escalan con tus ingresos (siguen siendo útiles en late game)
-- ---------------------------------------------------------------------
function Economy.ScaleReward(minimum: number?, incomePerSecond: number, seconds: number?): number
	local base = minimum or 0
	local scaled = if seconds then incomePerSecond * seconds else 0
	return math.floor(math.max(base, scaled))
end

-- OrderedDataStore solo acepta enteros: guardamos log10 para soportar números enormes.
function Economy.EncodeScore(value: number): number
	if value <= 0 then
		return 0
	end
	return math.floor(math.log10(value + 1) * 1e10)
end

function Economy.DecodeScore(encoded: number): number
	if encoded <= 0 then
		return 0
	end
	return math.max(0, 10 ^ (encoded / 1e10) - 1)
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[-- Utilidades de formato: números abreviados ($1.25M), tiempos, etc.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "Ud", "Dd", "Td" }

local function stripZeros(text: string): string
	if string.find(text, ".", 1, true) then
		text = (string.gsub(text, "0+$", ""))
		text = (string.gsub(text, "%.$", ""))
	end
	return text
end

function Format.Abbreviate(n: number): string
	if n ~= n or n == math.huge or n == -math.huge then
		return "0"
	end
	local negative = n < 0
	local value = math.abs(n)
	local text: string
	if value < 1000 then
		if value < 10 and value % 1 ~= 0 then
			text = stripZeros(string.format("%.1f", math.floor(value * 10) / 10))
		else
			text = tostring(math.floor(value))
		end
	else
		local tier = math.floor(math.log10(value) / 3)
		if tier >= #SUFFIXES then
			text = string.format("%.2e", value)
		else
			local scaled = value / (10 ^ (tier * 3))
			if scaled >= 100 then
				text = tostring(math.floor(scaled))
			elseif scaled >= 10 then
				text = stripZeros(string.format("%.1f", math.floor(scaled * 10) / 10))
			else
				text = stripZeros(string.format("%.2f", math.floor(scaled * 100) / 100))
			end
			text ..= SUFFIXES[tier + 1]
		end
	end
	return (if negative then "-" else "") .. text
end

function Format.Money(n: number): string
	return "$" .. Format.Abbreviate(n)
end

function Format.PerSecond(n: number): string
	return "$" .. Format.Abbreviate(n) .. "/s"
end

function Format.Commas(n: number): string
	local text = tostring(math.floor(math.abs(n)))
	local result = string.reverse((string.gsub(string.reverse(text), "(%d%d%d)", "%1,")))
	if string.sub(result, 1, 1) == "," then
		result = string.sub(result, 2)
	end
	return (if n < 0 then "-" else "") .. result
end

-- 75 -> "1:15", 3725 -> "1:02:05"
function Format.Clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

-- 90 -> "1m 30s", 7200 -> "2h 0m"
function Format.Duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return if m > 0 then string.format("%dh %dm", h, m) else string.format("%dh", h)
	elseif m > 0 then
		return if s > 0 then string.format("%dm %ds", m, s) else string.format("%dm", m)
	end
	return string.format("%ds", s)
end

function Format.Percent(fraction: number): string
	return stripZeros(string.format("%.1f", fraction * 100)) .. "%"
end

function Format.Multiplier(mult: number): string
	return "x" .. stripZeros(string.format("%.2f", mult))
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Gear</string>
          <string name="Source"><![CDATA[-- Equipamiento comprable con cash: bates (para golpear ladrones) y mejoras permanentes.

export type BatDef = {
	Id: string,
	Name: string,
	Price: number,
	RebirthRequired: number,
	GamePass: string?,
	Knockback: number,
	Cooldown: number,
	Range: number,
	Color: Color3,
	Material: Enum.Material,
	Icon: string,
}

export type UpgradeDef = {
	Key: string,
	Name: string,
	Icon: string,
	Description: string,
	MaxLevel: number,
	BaseCost: number,
	CostGrowth: number,
}

local Gear = {}

Gear.Bats = {
	{ Id = "Wood", Name = "Wooden Bat", Price = 0, RebirthRequired = 0, Knockback = 55, Cooldown = 1.0, Range = 9, Color = Color3.fromRGB(160, 110, 60), Material = Enum.Material.Wood, Icon = "🪵" },
	{ Id = "Iron", Name = "Iron Bat", Price = 15_000, RebirthRequired = 0, Knockback = 75, Cooldown = 0.85, Range = 10, Color = Color3.fromRGB(150, 155, 165), Material = Enum.Material.Metal, Icon = "⚙️" },
	{ Id = "Gold", Name = "Golden Bat", Price = 750_000, RebirthRequired = 1, Knockback = 95, Cooldown = 0.7, Range = 11, Color = Color3.fromRGB(255, 200, 40), Material = Enum.Material.Metal, Icon = "🏆" },
	{ Id = "Diamond", Name = "Diamond Bat", Price = 25_000_000, RebirthRequired = 3, Knockback = 120, Cooldown = 0.6, Range = 12, Color = Color3.fromRGB(120, 230, 255), Material = Enum.Material.Glass, Icon = "💎" },
	{ Id = "Galaxy", Name = "Galaxy Bat", Price = 0, RebirthRequired = 0, GamePass = "GalaxyBat", Knockback = 160, Cooldown = 0.5, Range = 13, Color = Color3.fromRGB(150, 70, 255), Material = Enum.Material.Neon, Icon = "🌌" },
} :: { BatDef }

Gear.Upgrades = {
	Speed = { Key = "Speed", Name = "Walk Speed", Icon = "👟", Description = "+1.5 walk speed per level", MaxLevel = 10, BaseCost = 2_000, CostGrowth = 3.2 },
	Lock = { Key = "Lock", Name = "Lock Time", Icon = "🔒", Description = "+5s base lock per level", MaxLevel = 10, BaseCost = 5_000, CostGrowth = 3.4 },
} :: { [string]: UpgradeDef }

Gear.UpgradeOrder = { "Speed", "Lock" }

Gear.SpeedPerLevel = 1.5

local batById: { [string]: BatDef } = {}
for index, bat in Gear.Bats do
	batById[bat.Id] = bat
	;(bat :: any).Tier = index
end

function Gear.GetBat(id: string): BatDef?
	return batById[id]
end

return Gear
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Mutations</string>
          <string name="Source"><![CDATA[-- Mutaciones: multiplican precio e ingresos y cambian el aspecto del slime.

export type Mutation = {
	Name: string,
	Multiplier: number,
	Chance: number,
	Color: Color3,
	Icon: string,
}

local Mutations = {}

-- Ordenadas de más rara a menos rara (importante para la tirada)
Mutations.List = {
	{ Name = "Galaxy", Multiplier = 8, Chance = 0.004, Color = Color3.fromRGB(170, 90, 255), Icon = "🌌" },
	{ Name = "Rainbow", Multiplier = 4, Chance = 0.01, Color = Color3.fromRGB(255, 120, 200), Icon = "🌈" },
	{ Name = "Diamond", Multiplier = 2, Chance = 0.025, Color = Color3.fromRGB(130, 230, 255), Icon = "💎" },
	{ Name = "Gold", Multiplier = 1.5, Chance = 0.06, Color = Color3.fromRGB(255, 205, 40), Icon = "🪙" },
} :: { Mutation }

Mutations.Normal = { Name = "Normal", Multiplier = 1, Chance = 0, Color = Color3.fromRGB(255, 255, 255), Icon = "" } :: Mutation

-- Orden de visualización en el Index (Normal primero)
Mutations.DisplayOrder = { "Normal", "Gold", "Diamond", "Rainbow", "Galaxy" }

local byName: { [string]: Mutation } = { Normal = Mutations.Normal }
for _, mutation in Mutations.List do
	byName[mutation.Name] = mutation
end

function Mutations.Get(name: string?): Mutation
	if name == nil then
		return Mutations.Normal
	end
	return byName[name] or Mutations.Normal
end

function Mutations.Exists(name: string): boolean
	return byName[name] ~= nil
end

return Mutations
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Products</string>
          <string name="Source"><![CDATA[-- =====================================================================
--  MONETIZACIÓN
--  1) Crea los Game Passes y Developer Products en el Creator Dashboard.
--  2) Pega aquí sus IDs (Id = 0 significa "no configurado").
--  PriceHint solo se usa para mostrar un precio si aún no hay Id.
-- =====================================================================

export type PassDef = {
	Key: string,
	Id: number,
	Name: string,
	Icon: string,
	Description: string,
	PriceHint: number,
}

export type ProductDef = {
	Key: string,
	Id: number,
	Name: string,
	Icon: string,
	Description: string,
	PriceHint: number,
	Kind: string,
	[string]: any,
}

local Products = {}

Products.GamePasses = {
	VIP = { Key = "VIP", Id = 0, Name = "VIP", Icon = "⭐", Description = "+25% cash forever, VIP tag & golden name", PriceHint = 199 },
	DoubleCash = { Key = "DoubleCash", Id = 0, Name = "2x Cash", Icon = "💵", Description = "Double ALL cash forever!", PriceHint = 299 },
	AutoCollect = { Key = "AutoCollect", Id = 0, Name = "Auto Collect", Icon = "🧲", Description = "Cash goes straight to your wallet", PriceHint = 149 },
	ExtraSlots = { Key = "ExtraSlots", Id = 0, Name = "+6 Slots", Icon = "📦", Description = "6 extra slime slots in your base", PriceHint = 249 },
	LongerLock = { Key = "LongerLock", Id = 0, Name = "Longer Lock", Icon = "🔒", Description = "+30 seconds every time you lock", PriceHint = 99 },
	SpeedBoost = { Key = "SpeedBoost", Id = 0, Name = "Speed Boost", Icon = "⚡", Description = "+8 walk speed. Escape thieves!", PriceHint = 149 },
	GalaxyBat = { Key = "GalaxyBat", Id = 0, Name = "Galaxy Bat", Icon = "🌌", Description = "The strongest bat. MASSIVE knockback", PriceHint = 399 },
} :: { [string]: PassDef }

Products.PassOrder = { "DoubleCash", "VIP", "AutoCollect", "ExtraSlots", "SpeedBoost", "LongerLock", "GalaxyBat" }

Products.DevProducts = {
	CashSmall = { Key = "CashSmall", Id = 0, Name = "Pile of Cash", Icon = "💵", Description = "10 minutes of income", PriceHint = 25, Kind = "Cash", Seconds = 600, Minimum = 2_500 },
	CashMedium = { Key = "CashMedium", Id = 0, Name = "Bag of Cash", Icon = "💰", Description = "1 hour of income", PriceHint = 99, Kind = "Cash", Seconds = 3_600, Minimum = 25_000 },
	CashLarge = { Key = "CashLarge", Id = 0, Name = "Vault of Cash", Icon = "🏦", Description = "5 hours of income", PriceHint = 349, Kind = "Cash", Seconds = 18_000, Minimum = 250_000 },
	ServerLuck = { Key = "ServerLuck", Id = 0, Name = "Server Luck x2", Icon = "🍀", Description = "2x luck for EVERYONE for 15 min", PriceHint = 99, Kind = "ServerLuck", Seconds = 900 },
	CashBoost = { Key = "CashBoost", Id = 0, Name = "2x Cash 30m", Icon = "⏫", Description = "Double cash for 30 minutes", PriceHint = 49, Kind = "Boost", Seconds = 1_800 },
	SummonMythic = { Key = "SummonMythic", Id = 0, Name = "Mythic Slime", Icon = "🔥", Description = "A random MYTHIC slime walks into your base", PriceHint = 149, Kind = "Summon", Rarity = "Mythic" },
	SummonSecret = { Key = "SummonSecret", Id = 0, Name = "Secret Slime", Icon = "🔮", Description = "A random SECRET slime walks into your base", PriceHint = 799, Kind = "Summon", Rarity = "Secret" },
	InstantLock = { Key = "InstantLock", Id = 0, Name = "Instant Lock", Icon = "🛡️", Description = "Lock your base NOW, skip the cooldown", PriceHint = 19, Kind = "InstantLock" },
} :: { [string]: ProductDef }

Products.ProductOrder = { "ServerLuck", "SummonSecret", "SummonMythic", "CashBoost", "CashSmall", "CashMedium", "CashLarge", "InstantLock" }

function Products.FindPassById(id: number): PassDef?
	if id == 0 then
		return nil
	end
	for _, def in Products.GamePasses do
		if def.Id == id then
			return def
		end
	end
	return nil
end

function Products.FindProductById(id: number): ProductDef?
	if id == 0 then
		return nil
	end
	for _, def in Products.DevProducts do
		if def.Id == id then
			return def
		end
	end
	return nil
end

return Products
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Rarities</string>
          <string name="Source"><![CDATA[-- Rarezas: orden, color, peso de aparición en la pasarela y escala visual.

export type Rarity = {
	Name: string,
	Order: number,
	Color: Color3,
	StrokeColor: Color3,
	Weight: number,
	Scale: number,
	Announce: boolean,
	Animated: boolean,
}

local Rarities = {}

Rarities.List = {
	{ Name = "Common", Order = 1, Color = Color3.fromRGB(215, 215, 215), StrokeColor = Color3.fromRGB(40, 40, 40), Weight = 50, Scale = 1.0, Announce = false, Animated = false },
	{ Name = "Uncommon", Order = 2, Color = Color3.fromRGB(85, 225, 95), StrokeColor = Color3.fromRGB(10, 60, 20), Weight = 25, Scale = 1.08, Announce = false, Animated = false },
	{ Name = "Rare", Order = 3, Color = Color3.fromRGB(70, 155, 255), StrokeColor = Color3.fromRGB(10, 30, 80), Weight = 13, Scale = 1.16, Announce = false, Animated = false },
	{ Name = "Epic", Order = 4, Color = Color3.fromRGB(180, 90, 255), StrokeColor = Color3.fromRGB(45, 10, 80), Weight = 7, Scale = 1.26, Announce = false, Animated = false },
	{ Name = "Legendary", Order = 5, Color = Color3.fromRGB(255, 185, 30), StrokeColor = Color3.fromRGB(90, 50, 0), Weight = 3.2, Scale = 1.38, Announce = true, Animated = false },
	{ Name = "Mythic", Order = 6, Color = Color3.fromRGB(255, 60, 95), StrokeColor = Color3.fromRGB(80, 0, 20), Weight = 1.3, Scale = 1.5, Announce = true, Animated = false },
	{ Name = "Divine", Order = 7, Color = Color3.fromRGB(120, 245, 255), StrokeColor = Color3.fromRGB(0, 60, 90), Weight = 0.4, Scale = 1.65, Announce = true, Animated = true },
	{ Name = "Secret", Order = 8, Color = Color3.fromRGB(25, 25, 25), StrokeColor = Color3.fromRGB(255, 255, 255), Weight = 0.1, Scale = 1.85, Announce = true, Animated = true },
} :: { Rarity }

local byName: { [string]: Rarity } = {}
for _, rarity in Rarities.List do
	byName[rarity.Name] = rarity
end

function Rarities.Get(name: string): Rarity
	return byName[name] or Rarities.List[1]
end

function Rarities.Exists(name: string): boolean
	return byName[name] ~= nil
end

function Rarities.Order(name: string): number
	local rarity = byName[name]
	return if rarity then rarity.Order else 0
end

return Rarities
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Crea (servidor) u obtiene (cliente) todos los RemoteEvents/RemoteFunctions.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"Notify", -- S->C  { Text, Kind }
	"Announce", -- S->C  { Text, Color, Duration }
	"Sync", -- S->C  vista de datos del jugador
	"Effect", -- S->C  (name, payload)
	"Knockback", -- S->C  (velocity: Vector3)
}

local FUNCTIONS = {
	"Action", -- C->S  (actionName, payload) -> (ok, message)
}

local Remotes = {}

local folder: Folder

if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing then
		folder = existing :: Folder
	else
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		for _, name in EVENTS do
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		for _, name in FUNCTIONS do
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
		folder.Parent = ReplicatedStorage
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Remotes.Event(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

function Remotes.Function(name: string): RemoteFunction
	return folder:WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">RewardInfo</string>
          <string name="Source"><![CDATA[-- Describe recompensas (para mostrarlas en la UI antes de reclamarlas).

local Economy = require(script.Parent.Economy)
local Format = require(script.Parent.Format)
local Rarities = require(script.Parent.Rarities)

local RewardInfo = {}

-- Devuelve icono, texto corto y color
function RewardInfo.Describe(reward: { [string]: any }, incomePerSecond: number): (string, string, Color3)
	if reward.SlimeRarity then
		local rarity = Rarities.Get(reward.SlimeRarity)
		local color = if rarity.Name == "Secret" then Color3.fromRGB(255, 255, 255) else rarity.Color
		local text = reward.SlimeRarity .. " Slime"
		if reward.Boost then
			text ..= " + 2x"
		end
		return "🧪", text, color
	end
	if reward.Cash or reward.IncomeSeconds then
		local amount = Economy.ScaleReward(reward.Cash, incomePerSecond, reward.IncomeSeconds)
		return "💵", Format.Money(amount), Color3.fromRGB(120, 255, 140)
	end
	if reward.Boost then
		return "⏫", "2x Cash " .. Format.Duration(reward.Boost), Color3.fromRGB(255, 210, 70)
	end
	return "🎁", "Reward", Color3.fromRGB(255, 255, 255)
end

return RewardInfo
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[-- Signal simple (sin BindableEvent) para comunicación interna.

export type Connection = { Disconnect: (self: Connection) -> (), Connected: boolean }

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} :: { any } }, Signal)
end

function Signal:Connect(fn: (...any) -> ())
	local handlers = self._handlers
	local connection = { Connected = true }
	local entry = { Fn = fn, Connection = connection }
	function connection.Disconnect(conn)
		conn.Connected = false
		local index = table.find(handlers, entry)
		if index then
			table.remove(handlers, index)
		end
	end
	table.insert(handlers, entry)
	return connection
end

function Signal:Once(fn: (...any) -> ())
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal:Fire(...)
	for _, entry in table.clone(self._handlers) do
		if entry.Connection.Connected then
			task.spawn(entry.Fn, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">SlimeBuilder</string>
          <string name="Source"><![CDATA[-- Construye los modelos 3D de los slimes con piezas básicas (no necesita assets).
-- El modelo se construye en el origen: Root = punto en el suelo, el frente mira a -Z.

local CollectionService = game:GetService("CollectionService")

local Slimes = require(script.Parent.Slimes)
local Rarities = require(script.Parent.Rarities)
local Mutations = require(script.Parent.Mutations)
local Format = require(script.Parent.Format)

local SlimeBuilder = {}

local BASE_SIZE = 3.2
local WHITE = Color3.fromRGB(255, 255, 255)
local BLACK = Color3.fromRGB(20, 20, 25)
local GOLD = Color3.fromRGB(255, 200, 45)
local SILHOUETTE = Color3.fromRGB(18, 18, 28)

export type BuildOptions = {
	NoEffects: boolean?,
	Silhouette: boolean?,
	Scale: number?,
}

type Ctx = {
	Model: Model,
	Root: BasePart,
	Def: any,
	S: number,
	H: number,
	A: number,
	B: number,
	Silhouette: boolean,
	Effects: boolean,
	BodyColor: Color3,
	Body: BasePart?,
	Eyes: { Vector3 },
	EyeSize: number,
}

-- ---------------------------------------------------------------------
-- Helpers de geometría
-- ---------------------------------------------------------------------
local function preparePart(ctx: Ctx, part: BasePart, name: string, color: Color3, material: Enum.Material?)
	part.Name = name
	part.Color = if ctx.Silhouette then SILHOUETTE else color
	part.Material = if ctx.Silhouette then Enum.Material.SmoothPlastic else (material or Enum.Material.SmoothPlastic)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.Anchored = false
	part.CastShadow = false
	part.Parent = ctx.Model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = ctx.Root
	weld.Part1 = part
	weld.Parent = part
end

-- Elipsoide (Part + SpecialMesh esfera)
local function ball(ctx: Ctx, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Size = size
	part.CFrame = cframe
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	preparePart(ctx, part, name, color, material)
	return part
end

local function block(ctx: Ctx, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Size = size
	part.CFrame = cframe
	preparePart(ctx, part, name, color, material)
	return part
end

-- CFrame cuyo eje Y apunta en "dir"
local function alongDir(center: Vector3, dir: Vector3): CFrame
	if math.abs(dir.Unit.Y) > 0.999 then
		if dir.Y > 0 then
			return CFrame.new(center)
		end
		return CFrame.new(center) * CFrame.Angles(math.pi, 0, 0)
	end
	return CFrame.lookAt(center, center + dir) * CFrame.Angles(-math.pi / 2, 0, 0)
end

-- Cilindro cuyo eje es el eje Y del cframe dado
local function cylinder(ctx: Ctx, name: string, height: number, diameter: number, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(height, diameter, diameter)
	part.CFrame = cframe * CFrame.Angles(0, 0, math.pi / 2)
	preparePart(ctx, part, name, color, material)
	return part
end

local function cylBetween(ctx: Ctx, name: string, p0: Vector3, p1: Vector3, diameter: number, color: Color3, material: Enum.Material?): Part
	local delta = p1 - p0
	return cylinder(ctx, name, delta.Magnitude, diameter, alongDir((p0 + p1) / 2, delta), color, material)
end

local function blockBetween(ctx: Ctx, name: string, p0: Vector3, p1: Vector3, width: number, depth: number, color: Color3, material: Enum.Material?): Part
	local delta = p1 - p0
	return block(ctx, name, Vector3.new(width, delta.Magnitude, depth), alongDir((p0 + p1) / 2, delta), color, material)
end

-- Punto en la superficie frontal del cuerpo (xf, yf en fracciones de los radios)
local function front(ctx: Ctx, xf: number, yf: number, inset: number?): Vector3
	local inside = 1 - xf * xf - yf * yf
	local zf = if inside > 0 then math.sqrt(inside) else 0
	return Vector3.new(xf * ctx.A, ctx.B + yf * ctx.B, -zf * ctx.A + (inset or 0))
end

-- Punto en la parte superior del cuerpo (xf, zf en fracciones del radio horizontal)
local function top(ctx: Ctx, xf: number, zf: number, lift: number?): Vector3
	local inside = 1 - xf * xf - zf * zf
	local yf = if inside > 0 then math.sqrt(inside) else 0
	return Vector3.new(xf * ctx.A, ctx.B + yf * ctx.B + (lift or 0), zf * ctx.A)
end

local function addEffect(ctx: Ctx, instance: Instance, parent: Instance?)
	if not ctx.Effects then
		instance:Destroy()
		return
	end
	instance.Parent = parent or ctx.Body or ctx.Root
end

local function particles(ctx: Ctx, colors: { Color3 }, rate: number, size: number, lightEmission: number?)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Particles"
	if #colors == 1 then
		emitter.Color = ColorSequence.new(colors[1])
	else
		emitter.Color = ColorSequence.new(colors[1], colors[2])
	end
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new(0.1)
	emitter.Lifetime = NumberRange.new(0.9, 1.6)
	emitter.Rate = rate
	emitter.Speed = NumberRange.new(1, 2.5)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.LightEmission = lightEmission or 0.7
	emitter.Drag = 1
	addEffect(ctx, emitter)
end

local function light(ctx: Ctx, color: Color3, range: number, brightness: number)
	local pointLight = Instance.new("PointLight")
	pointLight.Color = color
	pointLight.Range = range
	pointLight.Brightness = brightness
	pointLight.Shadows = false
	addEffect(ctx, pointLight)
end

local function tag(instance: Instance, tagName: string)
	CollectionService:AddTag(instance, tagName)
end

local function darker(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

local function crown(ctx: Ctx, bandColor: Color3, jewelColor: Color3, material: Enum.Material)
	local S, H = ctx.S, ctx.H
	local y = H * 0.97
	cylinder(ctx, "CrownBand", S * 0.16, S * 0.5, CFrame.new(0, y, 0), bandColor, material)
	for i = 0, 4 do
		local angle = math.rad(i * 72 + 90)
		local pos = Vector3.new(math.cos(angle) * S * 0.22, y + S * 0.12, math.sin(angle) * S * 0.22)
		block(ctx, "CrownSpike", Vector3.new(S * 0.08, S * 0.16, S * 0.08), CFrame.new(pos) * CFrame.Angles(0, -angle, math.rad(45)), bandColor, material)
		ball(ctx, "CrownJewel", Vector3.one * S * 0.07, CFrame.new(Vector3.new(math.cos(angle) * S * 0.255, y, math.sin(angle) * S * 0.255)), jewelColor, Enum.Material.Neon)
	end
end

local function ring(ctx: Ctx, name: string, y: number, yf: number, height: number, color: Color3, material: Enum.Material?)
	-- Anillo que rodea el cuerpo a la altura relativa yf
	local radius = ctx.A * math.sqrt(math.max(0, 1 - yf * yf))
	return cylinder(ctx, name, height, radius * 2 * 1.04, CFrame.new(0, y, 0), color, material)
end

local function wings(ctx: Ctx, size: Vector3, color: Color3, material: Enum.Material?)
	local S, H = ctx.S, ctx.H
	for _, side in { -1, 1 } do
		-- Alas hacia arriba, hacia fuera y ligeramente hacia atrás
		local cf = CFrame.new(side * S * 0.5, H * 0.72, S * 0.32) * CFrame.Angles(0, side * math.rad(-30), side * math.rad(28))
		ball(ctx, "Wing", size, cf, color, material)
		ball(ctx, "WingTip", size * Vector3.new(0.6, 0.6, 1.1), cf * CFrame.new(side * size.X * 0.32, size.Y * 0.25, 0), color, material)
	end
end

-- ---------------------------------------------------------------------
-- Accesorios
-- ---------------------------------------------------------------------
local Accessories: { [string]: (Ctx) -> () } = {}

Accessories.Bow = function(ctx)
	local S, H = ctx.S, ctx.H
	local color = Color3.fromRGB(255, 85, 160)
	local base = CFrame.new(S * 0.2, H * 0.93, -S * 0.05) * CFrame.Angles(0, 0, math.rad(-20))
	ball(ctx, "BowL", Vector3.new(S * 0.22, S * 0.16, S * 0.08), base * CFrame.new(-S * 0.1, 0, 0) * CFrame.Angles(0, 0, math.rad(20)), color)
	ball(ctx, "BowR", Vector3.new(S * 0.22, S * 0.16, S * 0.08), base * CFrame.new(S * 0.1, 0, 0) * CFrame.Angles(0, 0, math.rad(-20)), color)
	ball(ctx, "BowKnot", Vector3.one * S * 0.09, base, darker(color, 0.15))
end

Accessories.Cap = function(ctx)
	local S, H = ctx.S, ctx.H
	local color = Color3.fromRGB(220, 40, 50)
	ball(ctx, "CapDome", Vector3.new(S * 0.66, S * 0.34, S * 0.66), CFrame.new(0, H * 0.9, S * 0.02), color)
	ball(ctx, "CapBrim", Vector3.new(S * 0.44, S * 0.05, S * 0.36), CFrame.new(0, H * 0.88, -S * 0.3) * CFrame.Angles(math.rad(-8), 0, 0), color)
	ball(ctx, "CapButton", Vector3.one * S * 0.07, CFrame.new(0, H * 0.9 + S * 0.17, S * 0.02), WHITE)
end

Accessories.Moss = function(ctx)
	local S = ctx.S
	local color = Color3.fromRGB(55, 105, 35)
	for _, p in { { -0.4, 0.1 }, { 0.3, 0.35 }, { 0.05, 0.55 }, { -0.25, -0.35 }, { 0.5, -0.1 } } do
		local pos = top(ctx, p[1], p[2])
		ball(ctx, "Moss", Vector3.new(S * 0.24, S * 0.07, S * 0.2), CFrame.new(pos) * CFrame.Angles(p[2] * 0.8, 0, -p[1] * 0.8), color, Enum.Material.Grass)
	end
end

Accessories.Sprout = function(ctx)
	local S, H = ctx.S, ctx.H
	local green = Color3.fromRGB(70, 200, 70)
	local stemTop = Vector3.new(0, H + S * 0.22, 0)
	cylBetween(ctx, "Stem", Vector3.new(0, H * 0.95, 0), stemTop, S * 0.05, green)
	for _, side in { -1, 1 } do
		ball(ctx, "Leaf", Vector3.new(S * 0.22, S * 0.05, S * 0.12), CFrame.new(stemTop + Vector3.new(side * S * 0.1, S * 0.02, 0)) * CFrame.Angles(0, 0, side * math.rad(25)), green)
	end
end

Accessories.Bubbles = function(ctx)
	local S, H = ctx.S, ctx.H
	for index, p in { { -0.62, 0.35, -0.1, 0.18 }, { 0.6, 0.6, 0.1, 0.14 }, { -0.45, 1.05, 0.2, 0.12 }, { 0.4, 1.12, -0.15, 0.2 }, { 0.05, 1.3, 0.1, 0.1 } } do
		local bubble = ball(ctx, "Bubble" .. index, Vector3.one * S * p[4], CFrame.new(p[1] * S, p[2] * H, p[3] * S), Color3.fromRGB(190, 240, 255), Enum.Material.Glass)
		bubble.Transparency = 0.45
	end
end

Accessories.MintLeaf = function(ctx)
	local S, H = ctx.S, ctx.H
	local green = Color3.fromRGB(50, 190, 100)
	cylBetween(ctx, "Stem", Vector3.new(0, H * 0.95, 0), Vector3.new(0, H + S * 0.12, 0), S * 0.05, darker(green, 0.2))
	ball(ctx, "MintLeaf", Vector3.new(S * 0.42, S * 0.05, S * 0.2), CFrame.new(S * 0.16, H + S * 0.15, 0) * CFrame.Angles(0, math.rad(15), math.rad(20)), green)
	ball(ctx, "MintLeaf2", Vector3.new(S * 0.32, S * 0.05, S * 0.16), CFrame.new(-S * 0.13, H + S * 0.12, 0) * CFrame.Angles(0, math.rad(-15), math.rad(-20)), green)
end

Accessories.Pebbles = function(ctx)
	local S = ctx.S
	local color = Color3.fromRGB(120, 115, 110)
	for _, p in { { -0.3, 0.1, 0.16 }, { 0.2, -0.15, 0.13 }, { 0.05, 0.35, 0.11 }, { 0.4, 0.2, 0.1 }, { -0.1, -0.4, 0.12 } } do
		ball(ctx, "Pebble", Vector3.new(S * p[3], S * p[3] * 0.8, S * p[3]), CFrame.new(top(ctx, p[1], p[2])), color, Enum.Material.Slate)
	end
end

